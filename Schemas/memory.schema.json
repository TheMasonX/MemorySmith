{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorysmith.local/schemas/memory.schema.json",
  "title": "MemoryRecord",
  "description": "A single memory record in the MemorySmith system",
  "type": "object",
  "required": ["id", "content", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (GUID)"
    },
    "title": {
      "type": "string",
      "description": "Short human-readable title"
    },
    "content": {
      "type": "string",
      "description": "Memory content (100-300 tokens)"
    },
    "status": {
      "type": "string",
      "enum": ["Unconsolidated", "Working", "Core", "Deprecated"],
      "description": "Lifecycle state"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score [0,1]"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of other memories this one references"
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of memories that conflict with this one"
    },
    "usageCount": {
      "type": "integer",
      "minimum": 0
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    }
  }
}
