<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
    <MemorySmithOnnxRuntimeFlavor Condition="'$(MemorySmithOnnxRuntimeFlavor)' == ''">Cpu</MemorySmithOnnxRuntimeFlavor>
    <MemorySmithOnnxRuntimeVersion>1.24.1</MemorySmithOnnxRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="0.2.2" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.1.62" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup Condition="'$(MemorySmithOnnxRuntimeFlavor)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(MemorySmithOnnxRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(MemorySmithOnnxRuntimeFlavor)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(MemorySmithOnnxRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(MemorySmithOnnxRuntimeFlavor)' == 'OpenVino'">
    <PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" Version="$(MemorySmithOnnxRuntimeVersion)" />
  </ItemGroup>

  <Target Name="ValidateMemorySmithOnnxRuntimeFlavor" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(MemorySmithOnnxRuntimeFlavor)' != 'Cpu' and '$(MemorySmithOnnxRuntimeFlavor)' != 'Cuda' and '$(MemorySmithOnnxRuntimeFlavor)' != 'OpenVino'"
           Text="MemorySmithOnnxRuntimeFlavor must be one of: Cpu, Cuda, OpenVino." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MemorySmith.Core\MemorySmith.Core.csproj" />
    <ProjectReference Include="..\MemorySmith.Storage\MemorySmith.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\MemorySmith.Core\Docs\Prompts\wiki-chat-agent.md" Link="Prompts\wiki-chat-agent.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\MemorySmith.Core\Docs\Prompts\maintenance-agent-task.md" Link="Prompts\maintenance-agent-task.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\MemorySmith.Core\Docs\Prompts\maintenance-proposal-generation.md" Link="Prompts\maintenance-proposal-generation.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\MemorySmith.Core\Docs\Prompts\maintenance-revision-cycle.md" Link="Prompts\maintenance-revision-cycle.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.LocalOverrides.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>