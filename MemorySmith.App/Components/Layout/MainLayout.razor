@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Default" Class="app-titlebar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"
                       aria-label="Toggle primary navigation"
                       title="Toggle primary navigation" />
        <MudText Typo="Typo.h6" Class="ml-3">MemorySmith</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="authState">
                <MudButton Href="/profile" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle" Class="mr-2">
                    @(authState.User.Identity?.Name ?? "Profile")
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudText Typo="Typo.body2" Class="mr-3">Not signed in</MudText>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Width="220px"
               Class="app-drawer">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="app-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#007acc",
            Secondary = "#4ec9b0",
            Info = "#3794ff",
            Success = "#89d185",
            Warning = "#cca700",
            Error = "#f14c4c",
            Background = "#1e1e1e",
            Surface = "#252526",
            DrawerBackground = "#252526",
            DrawerText = "#cccccc",
            AppbarBackground = "#2d2d30",
            AppbarText = "#ffffff",
            TextPrimary = "#d4d4d4",
            TextSecondary = "#9d9d9d",
            Divider = "#3c3c3c",
            LinesDefault = "#3c3c3c",
            TableLines = "#3c3c3c"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "3px"
        }
    };
}