<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    <MudNavGroup Title="Workspace" Icon="@Icons.Material.Filled.Workspaces" Expanded="true">
        <MudNavLink Href="/pages" Icon="@Icons.Material.Filled.Article">
            Pages
        </MudNavLink>
        <MudNavLink Href="/memories" Icon="@Icons.Material.Filled.Memory">
            Memories
        </MudNavLink>
        <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">
            Chat
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Operations" Icon="@Icons.Material.Filled.FactCheck" Expanded="true">
        <MudNavLink Href="/tasks" Icon="@Icons.Material.Filled.TaskAlt">
            Tasks
        </MudNavLink>
        <AuthorizeView Policy="@MemorySmithPolicies.CanApproveAgentWrites">
            <Authorized>
                <MudNavLink Href="/proposals" Icon="@Icons.Material.Filled.RuleFolder">
                    Proposals
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="/health" Icon="@Icons.Material.Filled.MonitorHeart">
            Health
        </MudNavLink>
    </MudNavGroup>

    <AuthorizeView Policy="@MemorySmithPolicies.CanAdminMemorySmith">
        <Authorized>
            <MudNavGroup Title="Governance" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                <MudNavLink Href="/tags" Icon="@Icons.Material.Filled.LocalOffer">
                    Tags
                </MudNavLink>
                <MudNavLink Href="/maintenance" Icon="@Icons.Material.Filled.Engineering">
                    Maintenance
                </MudNavLink>
                <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.SettingsApplications">
                    Admin
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <MudNavLink Href="/about" Icon="@Icons.Material.Filled.Info">
        About
    </MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.AccountCircle">
                Profile
            </MudNavLink>
            <form method="post" action="/api/auth/logout?returnUrl=/" class="nav-auth-form">
                <button type="submit" class="mud-nav-link mud-ripple nav-auth-button">
                    <span class="mud-nav-link-icon mud-nav-link-icon-default"><MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" /></span>
                    <span class="mud-nav-link-text">Sign out</span>
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
                Sign in
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>