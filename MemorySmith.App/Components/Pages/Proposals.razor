@page "/proposals"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MemorySmithPolicies.CanApproveAgentWrites)]
@inject MaintenanceProposalWorkflow ProposalWorkflow
@inject MaintenanceAgentService Agent
@inject MaintenanceTopicMapService TopicMapService
@inject ISnackbar Snackbar

<PageTitle>Proposals - MemorySmith</PageTitle>

<div class="wiki-workbench proposals-workbench">
    <section class="wiki-commandbar proposals-commandbar" aria-label="Maintenance proposals">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Proposals</MudText>
            <span class="wiki-count">Maintenance agent review queue</span>
        </div>
        <div class="wiki-search-strip">
            <MudSelect T="string" Value="@_statusFilter" ValueChanged="@((string value) => _statusFilter = value)" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="wiki-filter">
                <MudSelectItem T="string" Value="@AllFilterValue">All</MudSelectItem>
                @foreach (var status in StatusOptions)
                {
                    <MudSelectItem T="string" Value="@status">@StatusLabel(status)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Value="@_selectedTask" ValueChanged="@((string value) => _selectedTask = value)" Label="Task" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="wiki-filter">
                @foreach (var task in TaskOptions)
                {
                    <MudSelectItem T="string" Value="@task">@TaskLabel(task)</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_isBusy" OnClick="LoadAsync">Refresh</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Psychology" Disabled="@_isBusy" OnClick="RunNowAsync">Run Now</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@_isBusy" OnClick="RunTaskAsync">Run Task</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountTree" Disabled="@_isBusy" OnClick="RefreshTopicMapAsync">Topic Map</MudButton>
            @if (CurrentActiveRun is not null)
            {
                <div class="proposal-active-run" role="status" aria-live="polite">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                    <span>@ActiveRunLabel(CurrentActiveRun) started @CurrentActiveRun.StartedAtUtc.ToLocalTime().ToString("t")</span>
                    <small>@ActiveRunDetail(CurrentActiveRun)</small>
                </div>
            }
        </div>
    </section>

    <section class="proposals-body @(_isListPaneCollapsed ? "is-list-collapsed" : string.Empty)">
        <div class="wiki-results-pane proposals-list-pane">
            <div class="wiki-pane-header">
                <strong>@FilteredProposals.Count proposal(s)</strong>
                @if (_lastRun is not null)
                {
                    <span class="wiki-muted">Last run: @_lastRun.Trigger</span>
                }
                <MudSpacer />
                <MudTooltip Text="Collapse proposal list" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.MenuOpen"
                                   Size="Size.Small"
                                   OnClick="CollapseListPane"
                                   aria-label="Collapse proposal list" />
                </MudTooltip>
            </div>
            @if (_lastRun?.Warnings.Count > 0)
            {
                <div class="proposal-run-warnings">
                    @foreach (var warning in _lastRun.Warnings.Take(3))
                    {
                        <span>@warning</span>
                    }
                </div>
            }
            <div class="maintenance-activity-panel" aria-label="Recent maintenance task activity">
                <header>
                    <strong>Recent task activity</strong>
                    <span>@_activity.Count logged</span>
                </header>
                @if (_activity.Count == 0)
                {
                    <span class="wiki-muted">No maintenance task activity has been logged yet.</span>
                }
                else
                {
                    <div class="maintenance-activity-list">
                        @foreach (var activity in _activity.Take(6))
                        {
                            <div class="maintenance-activity-row @(activity.Skipped ? "is-skipped" : null)">
                                <span class="maintenance-activity-main">
                                    <strong>@ActivitySummary(activity)</strong>
                                    <small>@activity.FinishedAtUtc.ToLocalTime().ToString("g")</small>
                                </span>
                                <span>@activity.FindingCount finding(s) - @activity.ProposalCount proposal(s)</span>
                                @if (activity.ProposalIds.Count > 0)
                                {
                                    <div class="maintenance-activity-proposals" aria-label="Maintenance proposals from this run">
                                        @foreach (var proposalId in activity.ProposalIds.Take(5))
                                        {
                                            <button type="button" @onclick="@(() => SelectProposalByIdAsync(proposalId))">@proposalId</button>
                                        }
                                        @if (activity.ProposalIds.Count > 5)
                                        {
                                            <small>+@(activity.ProposalIds.Count - 5) more</small>
                                        }
                                    </div>
                                }
                                @if (activity.Warnings.Count > 0)
                                {
                                    <small class="maintenance-activity-warning">@activity.Warnings.First()</small>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="wiki-results-list">
                @foreach (var proposal in FilteredProposals)
                {
                    <button class="proposal-row @(proposal.ProposalId == _selectedProposal?.ProposalId ? "is-selected" : null)" @onclick="@(() => SelectProposal(proposal))">
                        <span class="proposal-row-main">
                            <strong>@proposal.Metadata.Task</strong>
                            <small>@proposal.ProposalId</small>
                        </span>
                        <span class="proposal-row-meta">
                            <span class="proposal-status @StatusClass(proposal.Status)">@StatusLabel(proposal.Status)</span>
                            <span class="proposal-risk @RiskClass(proposal.RiskLevel)">@proposal.RiskLevel</span>
                            <span>@proposal.Changes.Count change(s)</span>
                        </span>
                    </button>
                }
            </div>
        </div>

        <div class="wiki-detail-pane proposals-detail-pane">
            @if (_selectedProposal is null)
            {
                <div class="proposal-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.RuleFolder" Size="Size.Large" />
                    <span>Select a proposal or run maintenance.</span>
                </div>
            }
            else
            {
                <div class="wiki-pane-header proposal-detail-header">
                    <div class="wiki-title-block">
                        <MudText Typo="Typo.h6">@_selectedProposal.Metadata.Task</MudText>
                        <span class="wiki-count">@_selectedProposal.ProposalId</span>
                    </div>
                    @if (_isListPaneCollapsed)
                    {
                        <MudTooltip Text="Show proposal list" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                           Size="Size.Small"
                                           OnClick="ExpandListPane"
                                           aria-label="Show proposal list" />
                        </MudTooltip>
                    }
                    <span class="proposal-status @StatusClass(_selectedProposal.Status)">@StatusLabel(_selectedProposal.Status)</span>
                    <span class="proposal-risk @RiskClass(_selectedProposal.RiskLevel)">@_selectedProposal.RiskLevel</span>
                </div>

                <div class="proposal-detail-scroll">
                    <section class="proposal-human-summary" aria-label="Proposal summary for human review">
                        <strong>Quick summary</strong>
                        <p>@ProposalQuickSummary(_selectedProposal)</p>
                        <div>
                            <span>@_selectedProposal.Changes.Count change(s)</span>
                            <span>@_selectedProposal.Evidence.Count evidence item(s)</span>
                            <span>@StatusLabel(_selectedProposal.Status)</span>
                        </div>
                    </section>

                    <div class="proposal-metadata-grid">
                        <span>Confidence</span><strong>@_selectedProposal.Confidence.ToString("P0")</strong>
                        <span>Related</span><strong>@(_selectedProposal.RelatedRecords.Count == 0 ? "-" : string.Join(", ", _selectedProposal.RelatedRecords))</strong>
                        <span>Supersedes</span><strong>@(_selectedProposal.Metadata.Supersedes.Count == 0 ? "-" : string.Join(", ", _selectedProposal.Metadata.Supersedes))</strong>
                        <span>Batch</span><strong>@LineageValue(_selectedProposal.Metadata.BatchId)</strong>
                        <span>Parent</span><strong>@LineageValue(_selectedProposal.Metadata.ParentProposalId)</strong>
                        <span>Attempt</span><strong>@LineageAttempt(_selectedProposal.Metadata.Attempt)</strong>
                        <span>Updated</span><strong>@_selectedProposal.UpdatedAtUtc.ToLocalTime().ToString("g")</strong>
                    </div>

                    <MudTabs Rounded="false" Elevation="0" Class="proposal-tabs">
                        <MudTabPanel Text="Diff" Icon="@Icons.Material.Filled.Difference">
                            @foreach (var change in _selectedProposal.Changes)
                            {
                                <details class="proposal-change" open>
                                    <summary>@change.Path</summary>
                                    <ProposalDiffViewer Change="@change" />
                                </details>
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="Evidence" Icon="@Icons.Material.Filled.FactCheck">
                            @if (_selectedProposal.Evidence.Count == 0)
                            {
                                <span class="wiki-muted">No evidence bundle was supplied.</span>
                            }
                            else
                            {
                                <div class="proposal-evidence-list">
                                    @foreach (var evidence in _selectedProposal.Evidence)
                                    {
                                        <div class="proposal-evidence-item">
                                            <strong>@evidence.Kind</strong>
                                            <span>@evidence.Citation</span>
                                            @if (!string.IsNullOrWhiteSpace(evidence.SourceLink))
                                            {
                                                <small>@evidence.SourceLink</small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(evidence.Excerpt))
                                            {
                                                <p>@evidence.Excerpt</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="Comments" Icon="@Icons.Material.Filled.Forum">
                            <ProposalCommentThread Proposal="@_selectedProposal" />
                        </MudTabPanel>
                        <MudTabPanel Text="Topic Map" Icon="@Icons.Material.Filled.Hub">
                            <TopicMapVisualization TopicMap="@_topicMap" />
                        </MudTabPanel>
                    </MudTabs>
                </div>

                <div class="proposal-actions">
                    <div class="proposal-comment-row">
                        <MudTextField T="string" Value="@_comment" ValueChanged="@((string value) => _comment = value)" Placeholder="Comment for respond/reject/approve history" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="proposal-comment-input" />
                    </div>
                    <div class="proposal-action-row">
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.RateReview" Disabled="@(_isBusy || IsClosed(_selectedProposal))" OnClick="RequestAgentReviewAsync">Request Agent Review</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" Disabled="@(_isBusy || !IsOpen(_selectedProposal))" OnClick="ApproveAsync">Approve</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Reply" Disabled="@(_isBusy || !IsOpen(_selectedProposal))" OnClick="RespondAsync">Respond</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" Disabled="@(_isBusy || IsClosed(_selectedProposal))" OnClick="RejectAsync">Reject</MudButton>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private const string AllFilterValue = "__all__";
    private static readonly IReadOnlyList<string> StatusOptions = [MaintenanceProposalStatuses.Open, MaintenanceProposalStatuses.NeedsRevision, MaintenanceProposalStatuses.Approved, MaintenanceProposalStatuses.Rejected];
    private static readonly IReadOnlyList<string> TaskOptions = ["staleness_scan", "relationship_integrity", "topic_map", "embedding_chunking_maintenance", "spot_checks", "consistency_checks", "synthesis"];
    private IReadOnlyList<MaintenanceWriteProposal> _proposals = [];
    private MaintenanceWriteProposal? _selectedProposal;
    private TopicMapDocument? _topicMap;
    private MaintenanceRunResult? _lastRun;
    private IReadOnlyList<MaintenanceRunActivity> _activity = [];
    private string _statusFilter = AllFilterValue;
    private string _selectedTask = "staleness_scan";
    private string _comment = string.Empty;
    private bool _isBusy;
    private bool _isListPaneCollapsed;
    private MaintenanceActiveRunSnapshot? _activeRun;
    private MaintenanceActiveRunSnapshot? _localActiveRun;

    private MaintenanceActiveRunSnapshot? CurrentActiveRun => _activeRun ?? _localActiveRun;

    private IReadOnlyList<MaintenanceWriteProposal> FilteredProposals => _proposals
        .Where(proposal => _statusFilter == AllFilterValue || string.Equals(proposal.Status, _statusFilter, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(proposal => proposal.UpdatedAtUtc)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _topicMap = await TopicMapService.LoadCachedAsync(CancellationToken.None);
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        try
        {
            _proposals = await ProposalWorkflow.ListAsync(CancellationToken.None);
            _activity = await Agent.ListRecentActivityAsync(20, CancellationToken.None);
            _activeRun = Agent.GetActiveRun();
            if (_selectedProposal is not null)
            {
                _selectedProposal = _proposals.FirstOrDefault(item => item.ProposalId == _selectedProposal.ProposalId);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void SelectProposal(MaintenanceWriteProposal proposal)
    {
        _selectedProposal = proposal;
        _comment = string.Empty;
    }

    private async Task SelectProposalByIdAsync(string proposalId)
    {
        var proposal = _proposals.FirstOrDefault(item => string.Equals(item.ProposalId, proposalId, StringComparison.OrdinalIgnoreCase));
        if (proposal is null)
        {
            await LoadAsync();
            proposal = _proposals.FirstOrDefault(item => string.Equals(item.ProposalId, proposalId, StringComparison.OrdinalIgnoreCase));
        }

        if (proposal is null)
        {
            Snackbar.Add($"Proposal {proposalId} is no longer available.", Severity.Warning);
            return;
        }

        SelectProposal(proposal);
    }

    private void CollapseListPane() => _isListPaneCollapsed = true;

    private void ExpandListPane() => _isListPaneCollapsed = false;

    private async Task RunNowAsync()
    {
        await BeginRunAsync("run_maintenance_now", null);
        try
        {
            _lastRun = await Agent.RunMaintenanceNowAsync(CancellationToken.None);
            _topicMap = await TopicMapService.LoadCachedAsync(CancellationToken.None);
            await LoadAsync();
            Snackbar.Add(RunSummary(_lastRun), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            EndRun();
        }
    }

    private async Task RunTaskAsync()
    {
        await BeginRunAsync("run_maintenance_on_demand", _selectedTask);
        try
        {
            _lastRun = await Agent.RunMaintenanceOnDemandAsync(_selectedTask, CancellationToken.None);
            _topicMap = await TopicMapService.LoadCachedAsync(CancellationToken.None);
            await LoadAsync();
            Snackbar.Add(RunSummary(_lastRun), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            EndRun();
        }
    }

    private async Task BeginRunAsync(string trigger, string? task)
    {
        _isBusy = true;
        _localActiveRun = new MaintenanceActiveRunSnapshot(Guid.NewGuid().ToString("N"), trigger, task, DateTimeOffset.UtcNow);
        _activeRun = Agent.GetActiveRun();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private void EndRun()
    {
        _isBusy = false;
        _localActiveRun = null;
        _activeRun = Agent.GetActiveRun();
    }

    private async Task RefreshTopicMapAsync()
    {
        _isBusy = true;
        try
        {
            _topicMap = await TopicMapService.BuildAsync(CancellationToken.None);
            Snackbar.Add("Topic map refreshed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (_selectedProposal is null)
        {
            return;
        }

        await ActAsync(() => ProposalWorkflow.ApproveAsync(_selectedProposal.ProposalId, _comment, CancellationToken.None), "Proposal approved.");
    }

    private async Task RespondAsync()
    {
        if (_selectedProposal is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_comment))
        {
            Snackbar.Add("Respond requires a comment.", Severity.Warning);
            return;
        }

        await ActAsync(() => ProposalWorkflow.RespondAsync(_selectedProposal.ProposalId, _comment, CancellationToken.None), "Proposal marked as needing revision.");
    }

    private async Task RequestAgentReviewAsync()
    {
        if (_selectedProposal is null)
        {
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Agent.ReviewProposalAsync(_selectedProposal.ProposalId, _comment, CancellationToken.None);
            _selectedProposal = result.Proposal;
            _comment = string.Empty;
            await LoadAsync();
            if (result.Warnings.Count > 0)
            {
                Snackbar.Add(string.Join(" ", result.Warnings), Severity.Warning);
            }
            else if (result.RevisedProposal is not null)
            {
                Snackbar.Add($"Agent review completed and proposed revision {result.RevisedProposal.ProposalId}.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Agent review completed.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RejectAsync()
    {
        if (_selectedProposal is null)
        {
            return;
        }

        await ActAsync(() => ProposalWorkflow.RejectAsync(_selectedProposal.ProposalId, _comment, CancellationToken.None), "Proposal rejected.");
    }

    private async Task ActAsync(Func<Task<MaintenanceWriteProposal>> action, string successMessage)
    {
        _isBusy = true;
        try
        {
            _selectedProposal = await action();
            _comment = string.Empty;
            await LoadAsync();
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static bool IsClosed(MaintenanceWriteProposal proposal) =>
        string.Equals(proposal.Status, MaintenanceProposalStatuses.Approved, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(proposal.Status, MaintenanceProposalStatuses.Rejected, StringComparison.OrdinalIgnoreCase);

    private static bool IsOpen(MaintenanceWriteProposal proposal) =>
        string.Equals(proposal.Status, MaintenanceProposalStatuses.Open, StringComparison.OrdinalIgnoreCase);

    private static string StatusLabel(string status) => status.Replace('_', ' ');
    private static string TaskLabel(string task) => task.Replace('_', ' ');
    private static string LineageValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    private static string LineageAttempt(int attempt) => attempt <= 0 ? "-" : attempt.ToString();
    private static string StatusClass(string status) => "is-" + status.Replace('_', '-');
    private static string RiskClass(string risk) => "is-" + risk.ToLowerInvariant();
    private static string ProposalQuickSummary(MaintenanceWriteProposal proposal)
    {
        var distinctPaths = proposal.Changes
            .Select(change => string.IsNullOrWhiteSpace(change.Path) ? "unknown path" : change.Path)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var leadingPaths = distinctPaths.Take(3).ToList();
        var pathText = leadingPaths.Count switch
        {
            0 => "no file paths",
            1 => leadingPaths[0],
            _ => string.Join(", ", leadingPaths)
        };
        var remaining = distinctPaths.Count - leadingPaths.Count;
        if (remaining > 0)
        {
            pathText += $" and {remaining} more";
        }

        var leadChange = proposal.Changes.FirstOrDefault();
        var leadSummary = SummarizeChange(leadChange);
        var additionalChanges = proposal.Changes.Count - 1;
        var additionalText = additionalChanges > 0
            ? $" plus {additionalChanges} more change{(additionalChanges == 1 ? string.Empty : "s")}" 
            : string.Empty;
        return $"{TaskLabel(proposal.Metadata.Task)} proposes {leadSummary}{additionalText} at {pathText}.";
    }

    private static string SummarizeChange(MaintenanceProposalChange? change)
    {
        if (change is null)
        {
            return "content updates";
        }

        var hasBefore = !string.IsNullOrWhiteSpace(change.Before);
        var hasAfter = !string.IsNullOrWhiteSpace(change.After);
        var heading = ExtractHeading(change.After);

        if (!hasBefore && hasAfter)
        {
            return heading is null ? "a new file" : $"a new page titled '{heading}'";
        }

        if (hasBefore && !hasAfter)
        {
            return "a file removal";
        }

        if (!string.IsNullOrWhiteSpace(change.Diff))
        {
            var lines = change.Diff.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var added = lines.Count(line => line.StartsWith('+') && !line.StartsWith("+++", StringComparison.Ordinal));
            var removed = lines.Count(line => line.StartsWith('-') && !line.StartsWith("---", StringComparison.Ordinal));
            if (added > 0 || removed > 0)
            {
                return $"content edits (+{added}/-{removed} lines)";
            }
        }

        return heading is null ? "file updates" : $"updates to '{heading}'";
    }

    private static string? ExtractHeading(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return null;
        }

        foreach (var rawLine in markdown.Split('\n'))
        {
            var line = rawLine.Trim();
            if (!line.StartsWith("#", StringComparison.Ordinal))
            {
                continue;
            }

            var heading = line.TrimStart('#').Trim();
            if (!string.IsNullOrWhiteSpace(heading))
            {
                return heading;
            }
        }

        return null;
    }

    private static string ActivitySummary(MaintenanceRunActivity activity)
    {
        var status = activity.Skipped ? "Skipped" : "Completed";
        var tasks = activity.Tasks.Count == 0 ? "No tasks" : string.Join(", ", activity.Tasks.Select(TaskLabel));
        return $"{status}: {tasks}";
    }

    private static string ActiveRunLabel(MaintenanceActiveRunSnapshot activeRun) => activeRun.Trigger switch
    {
        "run_maintenance_now" => "Maintenance review",
        "run_maintenance_weekly" => "Weekly maintenance review",
        "run_maintenance_on_demand" when !string.IsNullOrWhiteSpace(activeRun.Task) => TaskLabel(activeRun.Task),
        _ => activeRun.Trigger
    };

    private static string ActiveRunDetail(MaintenanceActiveRunSnapshot activeRun)
    {
        var trigger = activeRun.Trigger switch
        {
            "run_maintenance_now" => "manual run",
            "run_maintenance_weekly" => "scheduled run",
            "run_maintenance_on_demand" => "single task",
            _ => activeRun.Trigger
        };

        return string.IsNullOrWhiteSpace(activeRun.Task)
            ? $"{trigger} in progress"
            : $"{trigger}: {TaskLabel(activeRun.Task)}";
    }

    private static string RunSummary(MaintenanceRunResult run) =>
        $"Maintenance run completed with {run.Outputs.Sum(output => output.Findings.Count)} finding(s) and {run.Outputs.Sum(output => output.Proposals.Count)} proposal(s).";
}