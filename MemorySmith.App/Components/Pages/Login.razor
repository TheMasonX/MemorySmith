@page "/login"
@rendermode InteractiveServer
@inject MemorySmithLocalAuthService Auth
@inject NavigationManager Navigation
@inject IOptions<MemorySmithOptions> MsOptions
@using Microsoft.Extensions.Options

<PageTitle>Sign In - MemorySmith</PageTitle>

<div class="wiki-workbench admin-workbench">
    <section class="wiki-commandbar" aria-label="Account access">
        <AuthorizeView>
            <Authorized Context="authState">
                <div class="wiki-title-block">
                    <MudText Typo="Typo.h5">Already Signed In</MudText>
                    <span class="wiki-count">@(authState.User.Identity?.Name ?? "Authenticated session")</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="wiki-title-block">
                    <MudText Typo="Typo.h5">Sign In</MudText>
                    <span class="wiki-count">Local password</span>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </section>

    <section class="admin-panel-grid">
        <div class="health-lower-card admin-form-panel">
            <AuthorizeView>
                <Authorized Context="authState">
                    <MudAlert Severity="Severity.Success" Dense="true">You are already signed in as @(authState.User.Identity?.Name ?? "this user").</MudAlert>
                    <div class="admin-form-stack">
                        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home">Open MemorySmith</MudButton>
                        <MudButton Href="/profile" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountCircle">Open profile</MudButton>
                        <form method="post" action="/api/auth/logout?returnUrl=/" class="nav-auth-form">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    @if (_needsSetup is null)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (_needsSetup == true)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">No administrator exists yet.</MudAlert>
                        <MudButton Href="/admin/setup" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AdminPanelSettings">Set up admin</MudButton>
                    }
                    else
                    {
                        @if (ShowError)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">Invalid username or password.</MudAlert>
                        }
                        <form method="post" action="@LoginAction" class="admin-form-stack">
                            <label class="admin-input-label" for="login-user">User or email</label>
                            <input id="login-user" name="UserNameOrEmail" class="admin-input" autocomplete="username" />
                            <label class="admin-input-label" for="login-password">Password</label>
                            <input id="login-password" name="Password" type="password" class="admin-input" autocomplete="current-password" />
                            <label class="admin-checkbox"><input type="checkbox" name="RememberMe" value="true" /> Remember me</label>
                            <input type="hidden" name="ReturnUrl" value="@SanitizedReturnUrl" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">Sign in</MudButton>
                        </form>
                        @if (_githubEnabled)
                        {
                            <div style="margin-top:1rem;">
                                <hr style="margin-bottom:1rem;" />
                                <a href="/api/auth/challenge?scheme=GitHub&returnUrl=@Uri.EscapeDataString(SanitizedReturnUrl)" class="mud-button-root mud-button mud-button-filled mud-button-filled-secondary mud-ripple" style="display:inline-flex;align-items:center;gap:.5rem;text-decoration:none;padding:.5rem 1.25rem;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                                    Sign in with GitHub
                                </a>
                            </div>
                        }
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private bool? _needsSetup;
    private bool _githubEnabled;
    private bool ShowError => Error == "1";
    private string SanitizedReturnUrl => MemorySmithLocalAuthService.SanitizeReturnUrl(ReturnUrl);
    private string LoginAction => $"/api/auth/login?returnUrl={Uri.EscapeDataString(SanitizedReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        var providers = MsOptions.Value.Auth.Providers;
        _githubEnabled = providers.GitHub.Enabled && !string.IsNullOrEmpty(providers.GitHub.ClientId);
        _needsSetup = await Auth.NeedsSetupAsync(CancellationToken.None);
        if (_needsSetup == true && !Navigation.Uri.Contains("/admin/setup", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"/admin/setup?returnUrl={Uri.EscapeDataString(SanitizedReturnUrl)}");
        }
    }
}
