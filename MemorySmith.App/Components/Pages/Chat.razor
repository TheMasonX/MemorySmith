    }

    private async Task RerunToolAsync(string turnId, string entryId)
    {
        if (_isRerunningTool || FindTurn(turnId) is not { } turn || turn.TraceEntries.FirstOrDefault(entry => entry.Id == entryId) is not { } entry || string.IsNullOrWhiteSpace(entry.ToolName))
        {
            return;
        }

        JsonObject arguments;
        try
        {
            arguments = JsonNode.Parse(entry.ToolArgumentsDraft) as JsonObject ?? new JsonObject();
        }
        catch (Exception ex)
        {
            AddTraceEntry(turn, ChatTraceKinds.ToolResult, $"Retry failed: {entry.ToolName}", ex.Message, IsError: true, toolName: entry.ToolName);
            return;
        }

        if (!ToolCatalog.TryGet(entry.ToolName, out var tool) || !ChatToolCatalog.IsAvailableInMode(tool, _mode))
        {
            AddTraceEntry(turn, ChatTraceKinds.ToolResult, $"Retry failed: {entry.ToolName}", $"Tool '{entry.ToolName}' is not available in chat.", IsError: true, toolName: entry.ToolName);
            return;
        }

        _isRerunningTool = true;
        var started = DateTimeOffset.UtcNow;
        try
        {
            _agentStatus = $"Running {entry.ToolName}";
            var result = await tool.Execute(arguments, new ChatToolExecutionContext(Memories, Pages, "chat-ui-retry", CurrentUser: CurrentUser, Auth: Options.CurrentValue.Auth, DefaultPageMinimumRole: Options.CurrentValue.Pages.DefaultMinimumRole, Tasks: Tasks), CancellationToken.None);
            var duration = (long)Math.Max(0, (DateTimeOffset.UtcNow - started).TotalMilliseconds);
            AddTraceEntry(turn, ChatTraceKinds.ToolResult, $"Retry result: {entry.ToolName}", result.Text, result.IsError, entry.ToolName, duration);
            if (result.ContextItems is { Count: > 0 })
            {
                MergeTurnContext(turn, result.ContextItems.Select(item => item with { Origin = ChatContextOrigins.Tool }));
            }
            _agentStatus = $"Ran {entry.ToolName}";
            ActiveSession.UpdatedUtc = DateTimeOffset.UtcNow;
            await SaveSessionsAsync();
        }
        catch (Exception ex)
        {
            AddTraceEntry(turn, ChatTraceKinds.ToolResult, $"Retry failed: {entry.ToolName}", ex.Message, IsError: true, toolName: entry.ToolName);
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isRerunningTool = false;
        }
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        var maxCharacters = Math.Clamp(Options.CurrentValue.Chat.MaxAttachmentCharacters, 1000, 2_000_000);
        var maxBytes = Math.Clamp(Options.CurrentValue.Chat.MaxAttachmentBytes, 1024, 64L * 1024 * 1024);
        foreach (var file in args.GetMultipleFiles(8))
        {
            try
            {
                var attachment = await ReadAttachmentAsync(file, maxCharacters, maxBytes);
                _attachments.RemoveAll(item => string.Equals(item.Name, file.Name, StringComparison.OrdinalIgnoreCase));
                _attachments.Add(attachment);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }

        PersistActiveDraft();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        _agentStatus = "Ready";
    }

    private static async Task<ChatAttachment> ReadAttachmentAsync(IBrowserFile file, int maxCharacters, long maxBytes)
    {
        if (IsImageAttachment(file))
        {
            if (file.Size > maxBytes)
            {
                throw new InvalidOperationException($"{file.Name} is {FormatBytes(file.Size)}, above the configured {FormatBytes(maxBytes)} attachment limit.");
            }

            await using var imageStream = file.OpenReadStream(maxAllowedSize: maxBytes);
            using var imageMemory = new MemoryStream();
            await imageStream.CopyToAsync(imageMemory);
            var imageBytes = imageMemory.ToArray();
            var tempPath = await ChatAttachmentFiles.SaveTempAsync(file.Name, imageBytes);
            return new ChatAttachment(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "image" : file.ContentType,
                "Image attachment supplied as an image payload to the provider.",
                file.Size,
                Convert.ToBase64String(imageBytes),
                IsImage: true,
                LocalPath: tempPath);
        }

        if (!IsTextAttachment(file))
        {
            return new ChatAttachment(file.Name, file.ContentType, $"Binary attachment supplied: {file.Name} ({file.ContentType}, {file.Size} bytes).", file.Size);
        }

        var readBytes = Math.Min(file.Size, maxBytes);
        await using var stream = file.OpenReadStream(maxAllowedSize: Math.Max(readBytes, 1));
        using var reader = new StreamReader(stream);
        var buffer = new char[maxCharacters];
        var read = await reader.ReadBlockAsync(buffer, 0, buffer.Length);
        return new ChatAttachment(file.Name, file.ContentType, new string(buffer, 0, read), file.Size, IsTruncated: file.Size > readBytes || read == maxCharacters);
    }

    [JSInvokable]
    public async Task AttachClipboardImage(string name, string contentType, string base64Data, long size)
    {
        var maxBytes = Math.Clamp(Options.CurrentValue.Chat.MaxAttachmentBytes, 1024, 64L * 1024 * 1024);
        if (size > maxBytes)
        {
            Snackbar.Add($"Clipboard image is {FormatBytes(size)}, above the configured {FormatBytes(maxBytes)} attachment limit.", Severity.Warning);
            return;
        }

        byte[] imageBytes;
        try
        {
            imageBytes = Convert.FromBase64String(base64Data);
        }
        catch (FormatException)
        {
            Snackbar.Add("Clipboard image data could not be read.", Severity.Warning);
            return;
        }

        var tempPath = await ChatAttachmentFiles.SaveTempAsync(name, imageBytes);
        var attachment = new ChatAttachment(name, contentType, "Image attachment supplied as an image payload to the provider.", size == 0 ? imageBytes.Length : size, base64Data, IsImage: true, LocalPath: tempPath);
        _attachments.RemoveAll(item => string.Equals(item.Name, name, StringComparison.OrdinalIgnoreCase));
        _attachments.Add(attachment);
        PersistActiveDraft();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        _agentStatus = "Ready";
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsImageAttachment(IBrowserFile file) =>
        file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsTextAttachment(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);
        return file.ContentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase) ||
            extension is ".md" or ".txt" or ".json" or ".xml" or ".csv" or ".cs" or ".razor" or ".css" or ".js" or ".ts" or ".ps1";
    }

    private async Task RemoveAttachment(string name)
    {
        var removed = _attachments.Where(attachment => string.Equals(attachment.Name, name, StringComparison.OrdinalIgnoreCase)).ToList();
        _attachments.RemoveAll(attachment => string.Equals(attachment.Name, name, StringComparison.OrdinalIgnoreCase));
        PersistActiveDraft();
        LogAttachmentCleanupResult("remove", ChatAttachmentFiles.DeleteTempFiles(removed, RetainedPendingAttachments()));
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        _agentStatus = "Ready";
    }

    private void CleanupStaleAttachmentTempFiles(ChatOptions chatOptions)
    {
        var retentionHours = Math.Clamp(chatOptions.AttachmentTempFileRetentionHours, 1, 720);
        var result = ChatAttachmentFiles.DeleteStaleTempFiles(TimeSpan.FromHours(retentionHours));
        LogAttachmentCleanupResult("stale", result);
    }

    private IReadOnlyList<ChatAttachment> RetainedPendingAttachments() =>
        _sessions.SelectMany(session => session.PendingAttachments).ToList();

    private void LogAttachmentCleanupResult(string reason, ChatAttachmentCleanupResult result)
    {
        if (result.DeletedCount + result.RetainedCount + result.MissingCount + result.RefusedCount + result.FailedCount == 0)
        {
            return;
        }

        Logger.LogInformation(
            "Chat attachment temp cleanup {Reason}: deleted {DeletedCount}, retained {RetainedCount}, missing {MissingCount}, refused {RefusedCount}, failed {FailedCount}.",
            reason,
            result.DeletedCount,
            result.RetainedCount,
            result.MissingCount,
            result.RefusedCount,
            result.FailedCount);
    }

    private async Task SaveSessionsAsync()
    {
        _draftPersistCts?.Cancel();

        if (!_hasLoadedSessions)
        {
            return;
        }

        PersistActiveDraft();

        var retained = _sessions
            .Where(session => session.Id == _activeSessionId || session.Turns.Count > 0 || !string.IsNullOrWhiteSpace(session.Draft) || session.PendingAttachments.Count > 0)
            .OrderByDescending(session => session.UpdatedUtc)
            .Take(MaxStoredChatSessions)
            .ToList();
        _sessions.Clear();
        _sessions.AddRange(retained);

        var compactSnapshot = retained
            .Select(session => CloneSessionForStorage(session, includeContext: true, includeAttachments: true))
            .ToList();
        if (await TrySaveSessionSnapshotAsync(compactSnapshot))
        {
            return;
        }

        var minimalSnapshot = retained
            .Take(MaxCompactStoredChatSessions)
            .Select(session => CloneSessionForStorage(session, includeContext: false, includeAttachments: false))
            .ToList();
        if (await TrySaveSessionSnapshotAsync(minimalSnapshot))
        {
            if (!_storageWarningShown)
            {
                _storageWarningShown = true;
                Snackbar.Add("Chat history was saved in compact mode because browser storage is nearly full.", Severity.Warning);
            }
            return;
        }

        if (!_storageWarningShown)
        {
            _storageWarningShown = true;
            Snackbar.Add("Chat history was too large to persist in browser storage. Current in-page draft is still retained.", Severity.Warning);
        }
    }

    private async Task<bool> TrySaveSessionSnapshotAsync(IReadOnlyList<ChatSessionState> sessions) =>
        await JS.InvokeAsync<bool>("memorySmith.storage.setJson", ChatStorageKey, sessions);

    private static ChatSessionState CloneSessionForStorage(ChatSessionState session, bool includeContext, bool includeAttachments) =>
        new()
        {
            Id = session.Id,
            Title = session.Title,
            CreatedUtc = session.CreatedUtc,
            UpdatedUtc = session.UpdatedUtc,
            Draft = TrimForStorage(session.Draft, MaxStoredTurnCharacters),
            PendingAttachments = includeAttachments
                ? session.PendingAttachments.Select(TrimAttachmentForStorage).ToList()
                : [],
            Turns = session.Turns.Select(turn => TrimTurnForStorage(turn, includeContext, includeAttachments)).ToList(),
            History = session.History
                .TakeLast(MaxStoredHistoryMessages)
                .Select(message => new ChatMessage(message.Role, TrimForStorage(message.Content, MaxStoredTurnCharacters)))
                .ToList()
        };

    private static ChatTurnState TrimTurnForStorage(ChatTurnState turn, bool includeContext, bool includeAttachments) =>
        new()
        {
            Id = turn.Id,
            Role = turn.Role,
            Content = TrimForStorage(turn.Content, MaxStoredTurnCharacters),
            CreatedUtc = turn.CreatedUtc,
            Thinking = TrimNullableForStorage(turn.Thinking, MaxStoredThinkingCharacters),
            Context = includeContext
                ? turn.Context.Select(item => new ChatContextItem(
                    item.Kind,
                    item.Id,
                    item.Title,
                    TrimForStorage(item.Snippet, MaxStoredContextSnippetCharacters),
                    item.Origin)).ToList()
                : [],
            ProposedMemoryWrites = turn.ProposedMemoryWrites
                .Select(proposal => proposal with { Content = TrimForStorage(proposal.Content, MaxStoredTurnCharacters) })
                .ToList(),
            ProposedPageWrites = turn.ProposedPageWrites
                .Select(proposal => proposal with { Markdown = TrimForStorage(proposal.Markdown, MaxStoredTurnCharacters) })
                .ToList(),
            ResponseCommentDraft = TrimForStorage(turn.ResponseCommentDraft, MaxStoredTurnCharacters),
            QuestionOtherDraft = TrimForStorage(turn.QuestionOtherDraft, MaxStoredTurnCharacters),
            TraceEntries = turn.TraceEntries
                .TakeLast(MaxStoredTraceEntries)
                .Select(entry => new ChatTraceEntryState
                {
                    Id = entry.Id,
                    Kind = entry.Kind,
                    Title = entry.Title,
                    Content = TrimForStorage(entry.Content, MaxStoredTraceCharacters),
                    IsError = entry.IsError,
                    IsActive = false,
                    CreatedUtc = entry.CreatedUtc,
                    ToolName = entry.ToolName,
                    ToolArgumentsJson = TrimNullableForStorage(entry.ToolArgumentsJson, MaxStoredTraceCharacters),
                    ToolArgumentsDraft = TrimNullableForStorage(entry.ToolArgumentsDraft, MaxStoredTraceCharacters) ?? string.Empty,
                    DurationMilliseconds = entry.DurationMilliseconds,
                    EstimatedTokens = entry.EstimatedTokens
                }).ToList(),
            TraceDrawerOpen = false,
            WrittenMemories = turn.WrittenMemories.ToList(),
            WrittenPages = turn.WrittenPages.ToList(),
            SubmittedProposalIds = turn.SubmittedProposalIds.ToList(),
            Attachments = includeAttachments ? turn.Attachments.Select(TrimAttachmentForStorage).ToList() : [],
            ProviderName = turn.ProviderName,
            Model = turn.Model,
            Usage = turn.Usage,
            DurationMilliseconds = turn.DurationMilliseconds,
            ThinkingActive = false
        };

    private static ChatAttachment TrimAttachmentForStorage(ChatAttachment attachment) =>
        attachment with
        {
            Text = TrimForStorage(attachment.Text, MaxStoredAttachmentTextCharacters),
            Base64Data = TrimNullableForStorage(attachment.Base64Data, MaxStoredAttachmentImageCharacters)
        };

    private static string TrimForStorage(string? value, int maxCharacters)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= maxCharacters)
        {
            return value ?? string.Empty;
        }

        return value[..maxCharacters].TrimEnd() + "...";
    }

    private static string? TrimNullableForStorage(string? value, int maxCharacters) =>
        value is null ? null : TrimForStorage(value, maxCharacters);

    private async Task SavePreferencesAsync()
    {
        if (!_hasLoadedSessions)
        {
            return;
        }

        await JS.InvokeVoidAsync("memorySmith.storage.setJson", ChatPreferencesStorageKey, new ChatPreferencesState
        {
            Provider = _selectedProvider,
            Model = _selectedModel,
            ModelProfileId = _selectedModelProfileId,
            Mode = _mode.ToString(),
