    private async Task ApproveAllWritesAsync(string turnId)
    {
        if (_isApprovingWrites || FindTurn(turnId) is not { } turn)
        {
            return;
        }

        _isApprovingWrites = true;
        try
        {
            var results = new List<string>();
            foreach (var proposal in turn.ProposedMemoryWrites.ToList())
            {
                results.Add(await ApproveProposalWithOutcomeAsync(turn, [proposal], [], $"memory:{proposal.Id}"));
            }

            foreach (var proposal in turn.ProposedPageWrites.ToList())
            {
                results.Add(await ApproveProposalWithOutcomeAsync(turn, [], [proposal], $"page:{proposal.Slug}"));
            }

            UpdatePendingWriteStatus();
            if (results.Count > 0)
            {
                AddTraceEntry(
                    turn,
                    ChatTraceKinds.Write,
                    "Accept all results",
                    string.Join(Environment.NewLine, results.Select(result => $"- {result}")),
                    IsError: results.Any(result => result.Contains("blocked", StringComparison.OrdinalIgnoreCase) || result.Contains("failed", StringComparison.OrdinalIgnoreCase)));
            }

            ActiveSession.UpdatedUtc = DateTimeOffset.UtcNow;
            await SaveSessionsAsync();
        }
        finally
        {
            _isApprovingWrites = false;
        }
    }

