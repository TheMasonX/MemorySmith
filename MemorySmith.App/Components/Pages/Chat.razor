    private async Task RejectMemoryWriteAsync(string turnId, string memoryId)
    {
        if (FindTurn(turnId) is not { } turn)
        {
            return;
        }

        turn.ProposedMemoryWrites.RemoveAll(item => string.Equals(item.Id, memoryId, StringComparison.OrdinalIgnoreCase));
        AddTraceEntry(turn, ChatTraceKinds.Write, "Agent memory write rejected", $"Rejected memory:{memoryId}.");
        UpdatePendingWriteStatus();
        await SaveSessionsAsync();
    }

    private async Task RejectPageWriteAsync(string turnId, string slug)
    {
        if (FindTurn(turnId) is not { } turn)
        {
            return;
        }

        turn.ProposedPageWrites.RemoveAll(item => string.Equals(item.Slug, slug, StringComparison.OrdinalIgnoreCase));
        AddTraceEntry(turn, ChatTraceKinds.Write, "Agent page write rejected", $"Rejected page:{slug}.");
        UpdatePendingWriteStatus();
