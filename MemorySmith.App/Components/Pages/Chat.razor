    private static string BuildAssistantHistoryContent(string content)
    {
        if (TryParseQuestionCard(content) is not { } questionCard)
        {
            return content;
        }

        var lines = new List<string>
        {
            questionCard.Question,
            $"Options: {string.Join("; ", questionCard.Options)}{(questionCard.AllowOther ? "; Other: freeform" : string.Empty)}"
        };

        if (!string.IsNullOrWhiteSpace(questionCard.DetailsMarkdown))
        {
            lines.Add(questionCard.DetailsMarkdown);
        }

        return string.Join(Environment.NewLine, lines);
    }

    private static ChatQuestionCard? TryParseQuestionCard(string? content)
    {
        var candidate = content?.Trim();
        if (string.IsNullOrWhiteSpace(candidate) || candidate[0] != '{' || !candidate.Contains("\"questionCard\"", StringComparison.Ordinal))
        {
            return null;
        }

        JsonObject? root;
        try
        {
            root = JsonNode.Parse(candidate) as JsonObject;
        }
        catch
        {
            return null;
        }

        if (root?["questionCard"] is not JsonObject questionCard)
        {
            return null;
        }

        var question = ReadJsonString(questionCard, "question");
        var options = ReadQuestionCardOptions(questionCard);
        if (string.IsNullOrWhiteSpace(question) || options.Count == 0)
        {
            return null;
        }

        var other = questionCard["other"] as JsonObject;
        return new ChatQuestionCard(
            question.Trim(),
            ReadJsonString(questionCard, "detailsMarkdown") ?? ReadJsonString(questionCard, "details"),
            options,
            ReadJsonString(questionCard, "responsePrefix") ?? "Answer to follow-up question",
            other is not null,
            ReadJsonString(other ?? new JsonObject(), "label") ?? "Other",
            ReadJsonString(other ?? new JsonObject(), "placeholder") ?? "Type your answer");
    }

    private static IReadOnlyList<string> ReadQuestionCardOptions(JsonObject questionCard)
    {
        if (GetJsonArray(questionCard, "options") is not { } options)
        {
            return [];
        }

        var labels = new List<string>();
        foreach (var option in options)
        {
            switch (option)
            {
                case JsonValue value when value.TryGetValue<string>(out var text) && !string.IsNullOrWhiteSpace(text):
                    labels.Add(text.Trim());
                    break;
                case JsonObject optionObject:
                    var label = ReadJsonString(optionObject, "label") ?? ReadJsonString(optionObject, "value");
                    if (!string.IsNullOrWhiteSpace(label))
                    {
                        labels.Add(label.Trim());
                    }
                    break;
            }
        }

        return labels;
    }

