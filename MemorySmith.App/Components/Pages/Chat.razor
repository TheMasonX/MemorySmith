        turn.TraceEntries.Any(entry => entry.IsActive) ? "chat-trace-drawer is-active" : "chat-trace-drawer";

    private static string TraceEntryClass(ChatTraceEntryState entry)
    {
        var tone = entry.IsError ? "is-error" : entry.Kind switch
        {
            ChatTraceKinds.Reasoning => "is-reasoning",
            ChatTraceKinds.ToolCall => "is-tool-call",
            ChatTraceKinds.ToolResult => "is-tool-result",
            ChatTraceKinds.Write => "is-write",
            ChatTraceKinds.System => "is-system",
            _ => "is-assistant"
        };

        return entry.IsActive
            ? $"chat-trace-entry {tone} is-active"
            : $"chat-trace-entry {tone}";
    }

    private ChatTurnState? FindTurn(string turnId) =>
        ActiveSession.Turns.FirstOrDefault(turn => string.Equals(turn.Id, turnId, StringComparison.Ordinal));

    private static bool CanRerunTool(ChatTraceEntryState entry) =>
        string.Equals(entry.Kind, ChatTraceKinds.ToolCall, StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrWhiteSpace(entry.ToolName) &&
        !string.IsNullOrWhiteSpace(entry.ToolArgumentsJson);

    private static bool ShouldOpenTraceEntry(ChatTraceEntryState entry) =>
        !string.Equals(entry.Kind, ChatTraceKinds.ToolResult, StringComparison.OrdinalIgnoreCase);

    private static void UpdateToolArgumentsDraft(ChatTraceEntryState entry, string value)
    {
        entry.ToolArgumentsDraft = value;
    }

    private static string FormatTraceMeta(ChatTraceEntryState entry)
    {
        var parts = new List<string> { entry.CreatedUtc.ToLocalTime().ToString("HH:mm:ss") };
        if (entry.DurationMilliseconds is > 0)
        {
            parts.Add(FormatDuration(TimeSpan.FromMilliseconds(entry.DurationMilliseconds.Value)));
        }
        if (entry.EstimatedTokens is > 0)
        {
            parts.Add($"~{FormatTokenCount(entry.EstimatedTokens.Value)} tok");
        }

        return string.Join(" · ", parts);
    }

    private static void AddTraceEntry(
        ChatTurnState turn,
        string kind,
        string title,
        string content,
        bool IsError = false,
        string? toolName = null,
        long? durationMilliseconds = null)
    {
        turn.TraceEntries.Add(new ChatTraceEntryState
        {
            Kind = kind,
            Title = title,
            Content = content,
            IsError = IsError,
            CreatedUtc = DateTimeOffset.UtcNow,
            ToolName = toolName,
            DurationMilliseconds = durationMilliseconds,
            EstimatedTokens = EstimateTraceTokens(content)
        });
    }

    private static void MergeTurnContext(ChatTurnState turn, IEnumerable<ChatContextItem> contextItems)
    {
        var seen = turn.Context.Select(item => $"{item.Kind}:{item.Id}").ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var item in contextItems)
        {
            if (seen.Add($"{item.Kind}:{item.Id}"))
            {
                turn.Context.Add(item);
            }
        }
    }

    private static string FormatPendingWriteSummary(ChatTurnState turn)
    {
        var lines = new List<string>();
        lines.AddRange(turn.ProposedMemoryWrites.Select(proposal => $"- memory:{proposal.Id} - {proposal.Title}"));
        lines.AddRange(turn.ProposedPageWrites.Select(proposal => $"- page:{proposal.Slug} - {proposal.Title}"));
        return lines.Count == 0 ? "No writes pending." : string.Join(Environment.NewLine, lines);
    }

    private static string FormatAppliedWriteSummary(AgentWriteApplyResult result)
    {
        var lines = new List<string>();
        lines.AddRange(result.WrittenMemories.Select(id => $"- memory:{id}"));
        lines.AddRange(result.WrittenPages.Select(slug => $"- page:{slug}"));
        return lines.Count == 0 ? "No writes were applied." : string.Join(Environment.NewLine, lines);
    }

    private static int EstimateTraceTokens(string? value) =>
        string.IsNullOrWhiteSpace(value) ? 0 : Math.Max(1, (int)Math.Ceiling(value.Length / 4.0));

    private static void AppendTraceDelta(ChatTurnState turn, string kind, string title, string delta)
    {
        if (string.IsNullOrEmpty(delta))
        {
            return;
        }

        if (turn.TraceEntries.LastOrDefault() is { } last &&
            string.Equals(last.Kind, kind, StringComparison.OrdinalIgnoreCase) &&
            !last.IsError)
        {
            last.Content += delta;
            last.IsActive = true;
            last.EstimatedTokens = EstimateTraceTokens(last.Content);
            return;
        }

        FinalizeActiveTraceEntries(turn);
        turn.TraceEntries.Add(new ChatTraceEntryState
        {
            Kind = kind,
            Title = title,
            Content = delta,
            CreatedUtc = DateTimeOffset.UtcNow,
            IsActive = true,
            EstimatedTokens = EstimateTraceTokens(delta)
        });
    }

    private static void AppendTraceEvents(ChatTurnState turn, IReadOnlyList<ChatTraceEvent> events)
    {
        if (events.Count == 0)
        {
            return;
        }

        FinalizeActiveTraceEntries(turn);
        foreach (var traceEvent in events)
        {
            turn.TraceEntries.Add(new ChatTraceEntryState
            {
                Kind = string.IsNullOrWhiteSpace(traceEvent.Kind) ? ChatTraceKinds.System : traceEvent.Kind,
                Title = string.IsNullOrWhiteSpace(traceEvent.Title) ? "Trace event" : traceEvent.Title,
                Content = traceEvent.Content,
                IsError = traceEvent.IsError,
                CreatedUtc = traceEvent.TimestampUtc ?? DateTimeOffset.UtcNow,
                ToolName = traceEvent.ToolName,
                ToolArgumentsJson = traceEvent.ToolArgumentsJson,
                ToolArgumentsDraft = traceEvent.ToolArgumentsJson ?? string.Empty,
                DurationMilliseconds = traceEvent.DurationMilliseconds,
                EstimatedTokens = traceEvent.EstimatedTokens ?? EstimateTraceTokens(traceEvent.Content),
                IsActive = false
            });
        }
    }

    private static void FinalizeActiveTraceEntries(ChatTurnState turn)
    {
        foreach (var entry in turn.TraceEntries)
        {
            entry.IsActive = false;
        }
    }

    private static string FormatTurnModel(ChatTurnState turn) =>
        string.IsNullOrWhiteSpace(turn.ProviderName) ? turn.Model ?? string.Empty : $"{turn.ProviderName} / {turn.Model}";

    private ChatUsageSummary? SelectedModelUsage()
    {
        var model = _models.FirstOrDefault(item => string.Equals(item.Name, _selectedModel, StringComparison.OrdinalIgnoreCase));
        if (model is null || (model.ContextWindowTokens is null && string.IsNullOrWhiteSpace(model.RateLimit)))
        {
            return null;
        }

        return new ChatUsageSummary(0, 0, ContextWindowTokens: model.ContextWindowTokens, RateLimit: model.RateLimit);
    }

    private static string FormatUsageMeter(ChatUsageSummary? usage)
    {
        if (usage is null)
        {
            return "Context: pending";
        }

        var contextTokens = usage.ContextTokens ?? usage.InputTokens;
        var estimated = usage.IsEstimate && contextTokens > 0 ? "~" : string.Empty;
        var text = contextTokens > 0 ? $"Context {estimated}{FormatTokenCount(contextTokens)}" : "Context";
        if (usage.ContextWindowTokens is > 0)
        {
            text += $" / {FormatTokenCount(usage.ContextWindowTokens.Value)}";
            if (contextTokens > 0)
            {
                text += $" ({(double)contextTokens / usage.ContextWindowTokens.Value:P1})";
            }
        }

        if (usage.OutputTokens > 0)
        {
            text += $" · out {FormatTokenCount(usage.OutputTokens)}";
        }

        if (!string.IsNullOrWhiteSpace(usage.RateLimit))
        {
            text += $" · {usage.RateLimit}";
        }

        return text;
    }

    private static string FormatUsageTitle(ChatUsageSummary? usage)
    {
        if (usage is null)
        {
            return "Context usage is estimated after the next request starts.";
        }

        var contextTokens = usage.ContextTokens ?? usage.InputTokens;
        var source = usage.IsEstimate ? "Estimated" : "Provider-reported";
        var text = $"{source} context tokens: {contextTokens:N0}; input tokens: {usage.InputTokens:N0}; output tokens: {usage.OutputTokens:N0}";
        if (usage.ContextWindowTokens is > 0)
        {
            text += $"; context window: {usage.ContextWindowTokens.Value:N0}";
        }

        if (!string.IsNullOrWhiteSpace(usage.RateLimit))
        {
            text += $"; rate/quota: {usage.RateLimit}";
        }

        return text;
    }

    private static string FormatTokenCount(int value) =>
        value >= 1_000_000 ? $"{value / 1_000_000.0:0.#}M" :
        value >= 1_000 ? $"{value / 1_000.0:0.#}K" :
        value.ToString();

    private static string BuildSessionTitle(ChatSessionState session, string message)
    {
        if (!string.Equals(session.Title, "New chat", StringComparison.Ordinal))
        {
            return session.Title;
        }

        return message.Length <= 44 ? message : message[..44] + "...";
    }

