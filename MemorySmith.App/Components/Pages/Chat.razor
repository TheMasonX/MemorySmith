@page "/chat"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using System.Text.Json
@using System.Text.Json.Nodes
@using MemorySmith.Core.Models
@using MemorySmith.App.Services.Training
@using Microsoft.Extensions.Options
@inject IChatAgent ChatAgent
@inject ChatToolCatalog ToolCatalog
@inject ChatModelProfileService ModelProfiles
@inject MemoryApplicationService Memories
@inject IPageService Pages
@inject ITaskService Tasks
@inject IEnumerable<IChatProvider> ChatProviders
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ICurrentUserContext CurrentUser
@inject IDialogService Dialogs
@inject ILogger<Chat> Logger
@inject MaintenanceProposalWorkflow ProposalWorkflow
@inject IChatFeedbackStore FeedbackStore

<PageTitle>Chat - MemorySmith</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasPendingDraft" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<div class="@ChatWorkbenchClass">
    <section class="chat-shell" aria-label="MemorySmith chat">
        <div class="chat-toolbar">
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="chat-mode-toggle">
                <MudButton Variant="@ModeButtonVariant(MemoryChatMode.Chat)" Color="@ModeButtonColor(MemoryChatMode.Chat)" Class="@ModeButtonClass(MemoryChatMode.Chat)" OnClick="@(() => SetModeAsync(MemoryChatMode.Chat))">Chat</MudButton>
                <MudButton Variant="@ModeButtonVariant(MemoryChatMode.Agent)" Color="@ModeButtonColor(MemoryChatMode.Agent)" Class="@ModeButtonClass(MemoryChatMode.Agent)" Disabled="@(!CanUseAgentMode)" OnClick="@(() => SetModeAsync(MemoryChatMode.Agent))">Agent</MudButton>
            </MudButtonGroup>

            <div class="chat-model-controls">
                <div class="chat-model-profile-with-info">
                    <MudSelect T="string" Value="_selectedModelProfileId" ValueChanged="OnModelProfileChanged" Label="Model Profile" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="chat-model-profile-select" Disabled="@(!CanSelectModelProfile)">
                        @foreach (var profile in _modelProfiles)
                        {
                            <MudSelectItem T="string" Value="@profile.Id">
                                <span class="chat-model-profile-option">
                                    <span class="chat-model-profile-option-label">@profile.Name</span>
                                    <span class="chat-model-profile-option-info-wrap" tabindex="0" aria-label="Details for @profile.Name">
                                        <span class="admin-help-icon chat-model-profile-option-info">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                        </span>
                                        <span class="chat-model-profile-tooltip-panel" role="tooltip">
                                            <strong>@profile.Name</strong>
                                            <span><strong>Provider:</strong> @profile.Provider</span>
                                            <span><strong>Model:</strong> @profile.Model</span>
                                            <span><strong>Context Window:</strong> @FormatProfileContextWindow(profile)</span>
                                            <span><strong>Allowed Roles:</strong> @FormatProfileRoles(profile)</span>
                                            <span><strong>Default Assignments:</strong> @FormatProfileDefaults(profile)</span>
                                            @if (!string.IsNullOrWhiteSpace(profile.Description))
                                            {
                                                <span><strong>Description:</strong> @profile.Description</span>
                                            }
                                        </span>
                                    </span>
                                </span>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <MudSelect T="string" Value="_mermaidThemeMode" ValueChanged="SetMermaidThemeModeAsync" Label="Diagram" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="chat-mermaid-theme-select">
                    <MudSelectItem T="string" Value="@MermaidThemeAuto">Auto</MudSelectItem>
                    <MudSelectItem T="string" Value="@MermaidThemeLight">Light</MudSelectItem>
                    <MudSelectItem T="string" Value="@MermaidThemeDark">Dark</MudSelectItem>
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" Disabled="@_isLoadingModels" OnClick="RefreshModelsAsync" aria-label="Refresh models" title="Refresh models" />
            </div>

            <MudIconButton Icon="@(_sidebarOpen ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.Menu)" Size="Size.Small" OnClick="ToggleSidebar" aria-label="Toggle sidebar" title="Toggle sidebar" />
        </div>

        <div class="chat-status-strip">
            <span>@_agentStatus</span>
            @if (!string.IsNullOrWhiteSpace(_modelError))
            {
                <span class="chat-status-error">@_modelError</span>
            }
            @if (!string.IsNullOrWhiteSpace(ModelSetupMessage))
            {
                <span class="chat-status-error">@ModelSetupMessage</span>
            }
            @if (_attachments.Count > 0)
            {
                <span>@_attachments.Count attachment(s) queued</span>
            }
            @if (_isSending)
            {
                <span>@FormatDuration(_responseElapsed) elapsed</span>
                <span>@_streamedCharacters chars</span>
            }
        </div>
        @if (_isSending)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <div class="chat-transcript" @ref="_transcriptPane">
            @if (ActiveSession.Turns.Count == 0)
            {
                <div class="wiki-empty-state">No messages yet.</div>
            }
            else
            {
                @foreach (var turn in ActiveSession.Turns)
                {
                    <article class="chat-message @turn.Role">
                        <div class="chat-message-topline">
                            <span class="chat-message-role">@turn.Role</span>
                            <span class="chat-message-meta">
                                @if (!string.IsNullOrWhiteSpace(turn.Model))
                                {
                                    <span class="chat-message-model">@FormatTurnModel(turn)</span>
                                }
                                <span>@turn.CreatedUtc.ToLocalTime().ToString("HH:mm")@if (turn.DurationMilliseconds is not null) { <span> · @FormatDuration(TimeSpan.FromMilliseconds(turn.DurationMilliseconds.Value))</span> }@if (TryFormatTurnThroughput(turn) is { } throughput) { <span> · @throughput</span> }</span>
                            </span>
                            @if (FeedbackEnabled && string.Equals(turn.Role, "assistant", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="chat-message-feedback">
                                    <MudTooltip Text="Helpful response">
                                        <MudIconButton Icon="@Icons.Material.Filled.ThumbUp"
                                                       Size="Size.Small"
                                                       Color="@FeedbackButtonColor(turn, 1)"
                                                       Disabled="@_isSending"
                                                       OnClick="@(() => SetFeedbackAsync(turn, 1))"
                                                       aria-label="Thumbs up"
                                                       title="Thumbs up" />
                                    </MudTooltip>
                                    <MudTooltip Text="Needs improvement">
                                        <MudIconButton Icon="@Icons.Material.Filled.ThumbDown"
                                                       Size="Size.Small"
                                                       Color="@FeedbackButtonColor(turn, -1)"
                                                       Disabled="@_isSending"
                                                       OnClick="@(() => SetFeedbackAsync(turn, -1))"
                                                       aria-label="Thumbs down"
                                                       title="Thumbs down" />
                                    </MudTooltip>
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(turn.Thinking))
                        {
                            <details class="@ThinkingClass(turn)" open="@turn.ThinkingActive">
                                <summary>Thinking<span class="chat-thinking-activity" aria-hidden="true"></span></summary>
                                <pre>@turn.Thinking</pre>
                            </details>
                        }
                        @if (turn.TraceEntries.Count > 0)
                        {
                            <details class="@TraceDrawerClass(turn)" open="@turn.TraceDrawerOpen">
                                <summary>Trace (@turn.TraceEntries.Count)</summary>
                                <div class="chat-trace-list">
                                    @foreach (var entry in turn.TraceEntries)
                                    {
                                        <details class="@TraceEntryClass(entry)" open="@ShouldOpenTraceEntry(entry)">
                                            <summary class="chat-trace-header">
                                                <span>@entry.Title</span>
                                                <small>@entry.CreatedUtc.ToLocalTime().ToString("HH:mm:ss")</small>
                                            </summary>
                                            <pre>@entry.Content</pre>
                                        </details>
                                    }
                                </div>
                            </details>
                        }
                        <div class="chat-message-body chat-message-markdown">
                            @if (TryParseQuestionCard(turn.Content) is { } questionCard)
                            {
                                <div class="chat-question-card">
                                    <div class="chat-question-card-title">@questionCard.Question</div>
                                    @if (!string.IsNullOrWhiteSpace(questionCard.DetailsMarkdown))
                                    {
                                        <div class="chat-question-card-details chat-message-markdown">@RenderQuestionCardDetails(questionCard)</div>
                                    }
                                    <div class="chat-question-card-options">
                                        @foreach (var option in questionCard.Options)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@_isSending"
                                                       OnClick="@(() => SendQuestionOptionAsync(turn, questionCard, option))">@option</MudButton>
                                        }
                                    </div>
                                    @if (questionCard.AllowOther)
                                    {
                                        <div class="chat-question-card-other">
                                            <MudTextField T="string"
                                                          Value="@turn.QuestionOtherDraft"
                                                          ValueChanged="@((string value) => OnQuestionOtherDraftChanged(turn, value))"
                                                          Label="@questionCard.OtherLabel"
                                                          Placeholder="@questionCard.OtherPlaceholder"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Disabled="@_isSending" />
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@(_isSending || string.IsNullOrWhiteSpace(turn.QuestionOtherDraft))"
                                                       OnClick="@(() => SendQuestionOtherAsync(turn, questionCard))">Send other</MudButton>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @RenderTurnContent(turn)
                            }
                        </div>

                        @if (turn.Attachments.Count > 0)
                        {
                            <div class="chat-context-list">
                                @foreach (var attachment in turn.Attachments)
                                {
                                    <span class="wiki-tag" title="@AttachmentTitle(attachment)">file:@attachment.Name</span>
                                }
                            </div>
                        }

                        @if (turn.Context.Count > 0 || turn.WrittenMemories.Count > 0 || turn.WrittenPages.Count > 0 || turn.SubmittedProposalIds.Count > 0)
                        {
                            <details class="chat-context-drawer">
                                <summary>References (@TurnReferenceCount(turn))</summary>
                                <div class="chat-context-list">
                                    @foreach (var item in turn.Context)
                                    {
                                        <span class="chat-context-reference">
                                            <a class="@ContextResourceClass(item)" href="@ContextHref(item)" target="_blank" rel="noopener noreferrer" title="@item.Snippet">@item.Kind:@item.Title</a>
                                            @foreach (var diagnostic in WarningDiagnostics(item).Take(2))
                                            {
                                                <span class="wiki-diagnostic-chip @DiagnosticClass(diagnostic)" title="@diagnostic.Message">@diagnostic.Code</span>
                                            }
                                        </span>
                                    }
                                    @foreach (var id in turn.WrittenMemories)
                                    {
                                        <a class="wiki-status is-working chat-resource" href="@MemoryHref(id)" target="_blank" rel="noopener noreferrer">memory:@id</a>
                                    }
                                    @foreach (var slug in turn.WrittenPages)
                                    {
                                        <a class="wiki-status is-core chat-resource" href="@PageHref(slug)" target="_blank" rel="noopener noreferrer">page:@slug</a>
                                    }
                                    @foreach (var proposalId in turn.SubmittedProposalIds)
                                    {
                                        <a class="wiki-status is-working chat-resource" href="/proposals" target="_blank" rel="noopener noreferrer">proposal:@proposalId</a>
                                    }
                                </div>
                            </details>
                        }
                    </article>
                }
            }
        </div>

        <div class="chat-attachment-row">
            <MudTooltip Text="Attach files">
                <label class="chat-attachment-button" for="chat-file-input" title="Attach files">
                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                    <span>Attach</span>
                    <InputFile id="chat-file-input" OnChange="OnFilesSelectedAsync" multiple class="chat-file-input" aria-label="Attach files" />
                </label>
            </MudTooltip>
            @foreach (var attachment in _attachments)
            {
                <span class="wiki-tag chat-attachment-chip" title="@AttachmentTitle(attachment)">
                    @if (attachment.IsImage && !string.IsNullOrWhiteSpace(attachment.Base64Data))
                    {
                        <img class="chat-attachment-thumb" src="@AttachmentDataUrl(attachment)" alt="" />
                    }
                    <span class="chat-attachment-name">@attachment.Name</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" Class="chat-attachment-remove" OnClick="@(() => RemoveAttachment(attachment.Name))" aria-label="Remove attachment" title="Remove attachment" />
                </span>
            }
        </div>

        <div class="chat-composer">
            <textarea @ref="_composerInput"
                      class="chat-composer-input"
                      aria-label="Message"
                      placeholder="Message"
                      value="@_draft"
                      @oninput="OnDraftInput"></textarea>
            <div class="chat-composer-side">
                <div class="chat-usage-meter" title="@FormatUsageTitle(ActiveUsage, ActiveUsageDurationMilliseconds, ActiveUsageProviderName)" aria-live="polite">@FormatUsageMeter(ActiveUsage, ActiveUsageDurationMilliseconds, ActiveUsageProviderName)</div>
                <div class="chat-composer-actions">
                    <MudCheckBox T="bool" Value="_sendOnEnter" ValueChanged="SetSendOnEnterAsync" Label="Send on Enter" Size="Size.Small" />
                    <MudTooltip Text="Finish current step">
                        <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small" Color="Color.Warning" Class="chat-composer-icon" Disabled="@(!_isSending || _activeRunControl?.StopAfterCurrentStepRequested == true)" OnClick="StopAfterCurrentStepAsync" aria-label="Finish current step" title="Finish current step" />
                    </MudTooltip>
                    <MudTooltip Text="Stop generation">
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Error" Class="chat-composer-icon" Disabled="@(!_isSending)" OnClick="StopGeneratingAsync" aria-label="Stop generation" title="Stop generation" />
                    </MudTooltip>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@(!CanSendChat)" OnClick="SendAsync">Send</MudButton>
                </div>
            </div>
        </div>
    </section>

    @if (_sidebarOpen)
    {
        <aside class="chat-side-panel" aria-label="Chat sidebar">
            <div class="chat-side-tabs">
                <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="chat-side-tab-group">
                    <MudButton Variant="@SidebarTabVariant(ChatSidebarTab.History)" Color="@SidebarTabColor(ChatSidebarTab.History)" Class="@SidebarTabClass(ChatSidebarTab.History)" OnClick="@(() => ShowSidebarTab(ChatSidebarTab.History))">History</MudButton>
                    <MudButton Variant="@SidebarTabVariant(ChatSidebarTab.Trace)" Color="@SidebarTabColor(ChatSidebarTab.Trace)" Class="@SidebarTabClass(ChatSidebarTab.Trace)" OnClick="@(() => ShowSidebarTab(ChatSidebarTab.Trace))">Trace</MudButton>
                </MudButtonGroup>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" OnClick="ToggleSidebar" aria-label="Close sidebar" title="Close sidebar" />
            </div>

            @if (_sidebarTab == ChatSidebarTab.History)
            {
                <section class="chat-history-panel" aria-label="Chat history">
                    <div class="chat-history-header">
                        <MudText Typo="Typo.subtitle2">History</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Success" OnClick="StartNewChatAsync" aria-label="New chat" title="New chat" />
                    </div>

                    <div class="chat-history-list">
                        @foreach (var session in _sessions)
                        {
                            <div class="@SessionButtonClass(session)">
                                <button type="button" class="chat-history-select" @onclick="@(() => SelectSessionAsync(session.Id))">
                                    <span>@session.Title</span>
                                    <small>@session.UpdatedUtc.ToLocalTime().ToString("M/d HH:mm")</small>
                                </button>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@_isSending" OnClick="@(() => DeleteSessionAsync(session.Id))" aria-label="Delete chat" title="Delete chat" />
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="chat-trace-panel" aria-label="Chat trace panel">
                    <div class="chat-trace-panel-header">
                        <div>
                            <h2>Trace</h2>
                            <span>@TracePanelSubtitle</span>
                        </div>
                    </div>

                    @if (SelectedTraceTurn is null)
                    {
                        <div class="wiki-empty-state">No trace events.</div>
                    }
                    else
                    {
                        var selectedTurn = SelectedTraceTurn;
                        <div class="chat-trace-turn-select">
                            <MudSelect T="string" Value="@SelectedTraceTurnValue" ValueChanged="SelectTraceTurnFromPicker" Label="Turn" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var turn in TraceTurns)
                                {
                                    <MudSelectItem T="string" Value="@turn.Id">@FormatTraceTurnLabel(turn)</MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        <div class="chat-trace-filters" aria-label="Trace filters">
                            <MudTooltip Text="@TraceFilterTooltipText("Reasoning", _traceShowReasoning)">
                                <MudIconButton Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Variant="Variant.Outlined" Color="@TraceFilterColor(_traceShowReasoning)" Class="chat-trace-filter-button" OnClick="ToggleTraceReasoning" aria-label="Toggle reasoning filter" title='@TraceFilterTooltipText("Reasoning", _traceShowReasoning)' />
                            </MudTooltip>
                            <MudTooltip Text="@TraceFilterTooltipText("Tools", _traceShowTools)">
                                <MudIconButton Icon="@Icons.Material.Filled.Build" Size="Size.Small" Variant="Variant.Outlined" Color="@TraceFilterColor(_traceShowTools)" Class="chat-trace-filter-button" OnClick="ToggleTraceTools" aria-label="Toggle tools filter" title='@TraceFilterTooltipText("Tools", _traceShowTools)' />
                            </MudTooltip>
                            <MudTooltip Text="@TraceFilterTooltipText("Answer", _traceShowAssistant)">
                                <MudIconButton Icon="@Icons.Material.Filled.QuestionAnswer" Size="Size.Small" Variant="Variant.Outlined" Color="@TraceFilterColor(_traceShowAssistant)" Class="chat-trace-filter-button" OnClick="ToggleTraceAssistant" aria-label="Toggle answer filter" title='@TraceFilterTooltipText("Answer", _traceShowAssistant)' />
                            </MudTooltip>
                            <MudTooltip Text="@TraceFilterTooltipText("System", _traceShowSystem)">
                                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Variant="Variant.Outlined" Color="@TraceFilterColor(_traceShowSystem)" Class="chat-trace-filter-button" OnClick="ToggleTraceSystem" aria-label="Toggle system filter" title='@TraceFilterTooltipText("System", _traceShowSystem)' />
                            </MudTooltip>
                            <MudTooltip Text="@TraceFilterTooltipText("Errors", _traceErrorsOnly)">
                                <MudIconButton Icon="@Icons.Material.Filled.Error" Size="Size.Small" Variant="Variant.Outlined" Color="@TraceFilterColor(_traceErrorsOnly, Color.Error)" Class="chat-trace-filter-button" OnClick="ToggleTraceErrors" aria-label="Toggle errors-only filter" title='@TraceFilterTooltipText("Errors", _traceErrorsOnly)' />
                            </MudTooltip>
                        </div>

                        <div class="chat-trace-graph" aria-label="Turn graph">
                            @foreach (var node in BuildTraceGraph(selectedTurn, FilteredTraceEntries(selectedTurn)))
                            {
                                <span class="@node.ClassName">@node.Label</span>
                            }
                        </div>

                        @if (selectedTurn.ProposedMemoryWrites.Count > 0 || selectedTurn.ProposedPageWrites.Count > 0)
                        {
                            <section class="chat-approval-panel">
                                <header>
                                    <span>Pending writes</span>
                                    <button type="button" title="Accept all pending writes in this turn" disabled="@_isApprovingWrites" @onclick="@(() => ApproveAllWritesAsync(selectedTurn.Id))">Accept all</button>
                                </header>
                                <div class="chat-approval-comment-row">
                                    <label for="@($"chat-response-note-{selectedTurn.Id}")">Revision note</label>
                                    <textarea id="@($"chat-response-note-{selectedTurn.Id}")"
                                              class="chat-approval-comment-input"
                                              rows="2"
                                              placeholder="Required for Respond. Example: keep the change, but add the source page."
                                              aria-label="Revision note for respond actions"
                                              value="@selectedTurn.ResponseCommentDraft"
                                              @oninput="@(args => OnResponseCommentInput(selectedTurn, args))"></textarea>
                                    <small>Respond keeps the proposal diff and records this note in proposal history. Accept and Reject do not use it.</small>
                                </div>
                                @foreach (var proposal in selectedTurn.ProposedMemoryWrites)
                                {
                                    <div class="chat-approval-item">
                                        <strong>memory:@proposal.Id</strong>
                                        <span>@proposal.Title</span>
                                        <div>
                                            <button type="button" title="Accept memory write proposal" @onclick="@(() => ApproveMemoryWriteAsync(selectedTurn.Id, proposal.Id))">Accept</button>
                                            <button type="button" title="Request a revision for this memory write proposal" @onclick="@(() => RespondMemoryWriteAsync(selectedTurn.Id, proposal.Id))">Respond</button>
                                            <button type="button" title="Reject memory write proposal" @onclick="@(() => RejectMemoryWriteAsync(selectedTurn.Id, proposal.Id))">Reject</button>
                                        </div>
                                    </div>
                                }
                                @foreach (var proposal in selectedTurn.ProposedPageWrites)
                                {
                                    <div class="chat-approval-item">
                                        <strong>page:@proposal.Slug</strong>
                                        <span>@proposal.Title</span>
                                        <div>
                                            <button type="button" title="Accept page write proposal" @onclick="@(() => ApprovePageWriteAsync(selectedTurn.Id, proposal.Slug))">Accept</button>
                                            <button type="button" title="Request a revision for this page write proposal" @onclick="@(() => RespondPageWriteAsync(selectedTurn.Id, proposal.Slug))">Respond</button>
                                            <button type="button" title="Reject page write proposal" @onclick="@(() => RejectPageWriteAsync(selectedTurn.Id, proposal.Slug))">Reject</button>
                                        </div>
                                    </div>
                                }
                            </section>
                        }

                        <div class="chat-trace-panel-list" @ref="_tracePanelList">
                            @foreach (var entry in FilteredTraceEntries(selectedTurn))
                            {
                                <details class="@TraceEntryClass(entry)" open="@ShouldOpenTraceEntry(entry)">
                                    <summary class="chat-trace-header">
                                        <span>@entry.Title</span>
                                        <small>@FormatTraceMeta(entry)</small>
                                    </summary>
                                    <pre>@entry.Content</pre>
                                    @if (CanRerunTool(entry))
                                    {
                                        <div class="chat-tool-rerun">
                                            <textarea aria-label="Tool arguments" value="@entry.ToolArgumentsDraft" @oninput="@(args => UpdateToolArgumentsDraft(entry, args.Value?.ToString() ?? string.Empty))"></textarea>
                                            <button type="button" disabled="@_isRerunningTool" @onclick="@(() => RerunToolAsync(selectedTurn.Id, entry.Id))">Run Tool</button>
                                        </div>
                                    }
                                </details>
                            }
                        </div>
                    }
                </section>
            }
        </aside>
    }
</div>

@code {
    private const string ChatStorageKey = "memorysmith.chat.sessions.v1";
    private const string ChatDraftStorageKey = "memorysmith.chat.active-draft.v1";
    private const string ChatPreferencesStorageKey = "memorysmith.chat.preferences.v1";
    private const string MermaidThemeAuto = "auto";
    private const string MermaidThemeLight = "light";
    private const string MermaidThemeDark = "dark";
    private const int MaxStoredChatSessions = 30;
    private const int MaxCompactStoredChatSessions = 12;
    private const int MaxStoredHistoryMessages = 40;
    private const int MaxStoredTurnCharacters = 16000;
    private const int MaxStoredThinkingCharacters = 6000;
    private const int MaxStoredContextSnippetCharacters = 600;
    private const int MaxStoredTraceEntries = 80;
    private const int MaxStoredTraceCharacters = 3000;
    private const int MaxStoredAttachmentTextCharacters = 6000;
    private const int MaxStoredAttachmentImageCharacters = 12000;
    private const int NarrowChatViewportWidth = 640;
    private const int MaxTurnRenderCacheEntries = 512;
    private static readonly TimeSpan StreamRenderInterval = TimeSpan.FromMilliseconds(150);
    private static readonly TimeSpan DraftPersistDebounce = TimeSpan.FromMilliseconds(800);
    private static readonly JsonSerializerOptions StorageJsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };
    private readonly List<ChatSessionState> _sessions = [];
    private readonly List<ChatModelSummary> _models = [];
    private readonly List<ChatModelProfileView> _modelProfiles = [];
    private readonly List<string> _availableProviders = [];
    private readonly List<ChatAttachment> _attachments = [];
    private DotNetObjectReference<Chat>? _dotNetRef;
    private ElementReference _composerInput;
    private ElementReference _transcriptPane;
    private ElementReference _tracePanelList;
    private MemoryChatMode _mode = MemoryChatMode.Chat;
    private string _activeSessionId = string.Empty;
    private string _draft = string.Empty;
    private string _selectedModelProfileId = string.Empty;
    private string _selectedProvider = "Ollama";
    private string _selectedModel = string.Empty;
    private string _mermaidThemeMode = MermaidThemeAuto;
    private string _agentStatus = "Ready";
    private string? _preferredActiveSessionId;
    private string? _modelError;
    private bool _sidebarOpen;
    private ChatSidebarTab _sidebarTab = ChatSidebarTab.History;
    private bool _sendOnEnter = true;
    private bool _isSending;
    private bool _isLoadingModels;
    private bool _hasLoadedSessions;
    private bool _sessionLoadFailed;
    private bool _composerRegistered;
    private bool _scrollPending;
    private bool _storageWarningShown;
    private bool _traceShowReasoning = true;
    private bool _traceShowTools = true;
    private bool _traceShowAssistant = true;
    private bool _traceShowSystem = true;
    private bool _traceErrorsOnly;
    private bool _isApprovingWrites;
    private bool _isRerunningTool;
    private string? _selectedTraceTurnId;
    private CancellationTokenSource? _responseTimerCts;
    private CancellationTokenSource? _sendCts;
    private CancellationTokenSource? _draftPersistCts;
    private ChatRunControl? _activeRunControl;
    private DateTimeOffset? _responseStartedUtc;
    private TimeSpan _responseElapsed = TimeSpan.Zero;
    private int _streamedCharacters;
    private ChatUsageSummary? _currentUsage;
    private readonly Dictionary<string, MarkupString> _turnRenderCache = new(StringComparer.Ordinal);

    private ChatSessionState ActiveSession =>
        _sessions.FirstOrDefault(session => session.Id == _activeSessionId) ?? _sessions.First();

    private string ChatWorkbenchClass => _sidebarOpen
        ? $"chat-workbench is-sidebar-open {(_sidebarTab == ChatSidebarTab.Trace ? "is-trace-open" : "is-history-open")}"
        : "chat-workbench";
    private bool HasPendingDraft => !string.IsNullOrWhiteSpace(_draft) || _attachments.Count > 0;
    private ChatModelProfileView? SelectedModelProfile => _modelProfiles.FirstOrDefault(profile => string.Equals(profile.Id, _selectedModelProfileId, StringComparison.OrdinalIgnoreCase));
    private ChatModelProfileView? DefaultModelProfile => ModelProfiles.GetDefaultProfileForRoles(CurrentUser.Roles);
    private bool HasDefaultModelProfile => DefaultModelProfile is not null;
    private bool CanSelectModelProfile => HasDefaultModelProfile && _modelProfiles.Count > 0 && !_isSending;
    private bool CanSendChat => !_isSending && HasDefaultModelProfile && SelectedModelProfile is not null && !string.IsNullOrWhiteSpace(_selectedModel);
    private bool FeedbackEnabled => Options.CurrentValue.Training.FeedbackEnabled;
    private string? ModelSetupMessage => HasDefaultModelProfile ? null : "Chat is disabled until an Admin defines an enabled default model profile.";
    private ChatTurnState? SelectedTraceTurn =>
        ActiveSession.Turns.FirstOrDefault(turn => string.Equals(turn.Id, _selectedTraceTurnId, StringComparison.Ordinal))
        ?? ActiveSession.Turns.LastOrDefault(TurnHasInspectableState);
    private string TracePanelSubtitle => SelectedTraceTurn is { } turn
        ? $"{turn.Role} · {turn.CreatedUtc.ToLocalTime():HH:mm} · {turn.TraceEntries.Count} event(s)"
        : "No turn selected";
    private IReadOnlyList<ChatTurnState> TraceTurns => ActiveSession.Turns.Where(TurnHasInspectableState).ToList();
    private string SelectedTraceTurnValue => SelectedTraceTurn?.Id ?? string.Empty;
    private ChatUsageSummary? ActiveUsage =>
        _currentUsage
        ?? (_sessions.Count == 0 ? null : ActiveSession.Turns.LastOrDefault(turn => turn.Usage is not null)?.Usage)
        ?? SelectedModelUsage();
    private ChatTurnState? ActiveUsageTurn =>
        _sessions.Count == 0
            ? null
            : ActiveSession.Turns.LastOrDefault(turn => turn.Usage is not null)
              ?? ActiveSession.Turns.LastOrDefault();
    private long? ActiveUsageDurationMilliseconds => _isSending
        ? (long)Math.Max(0, _responseElapsed.TotalMilliseconds)
        : ActiveUsageTurn?.DurationMilliseconds;
    private string? ActiveUsageProviderName => _isSending
        ? SelectedModelProfile?.Provider ?? ActiveUsageTurn?.ProviderName
        : ActiveUsageTurn?.ProviderName ?? SelectedModelProfile?.Provider;
    private bool CanUseAgentMode =>
        Options.CurrentValue.Chat.AgentWritesEnabled &&
        CurrentUser.IsAuthenticated &&
        CurrentUser.Roles.Any(role =>
            string.Equals(role, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(role, MemorySmithRoles.Editor, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        var chatOptions = Options.CurrentValue.Chat;
        CleanupStaleAttachmentTempFiles(chatOptions);
        LoadModelProfiles();
        _availableProviders.Clear();
        _availableProviders.AddRange(ChatProviders.Select(provider => provider.Name).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(provider => provider));
        if (_availableProviders.Count == 0)
        {
            _availableProviders.Add(chatOptions.Provider);
        }

        ApplySelectedModelProfile(DefaultModelProfile ?? _modelProfiles.FirstOrDefault(), persistStatus: false);
        StartNewChat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await TryInvokeVoidAsync("memorySmith.chat.registerComposer", _composerInput, _dotNetRef, _sendOnEnter, Options.CurrentValue.Chat.ClipboardFetchExternalImagesEnabled);
            _composerRegistered = true;
            await LoadPreferencesAsync();
            await CollapseSidebarOnNarrowViewportAsync();
            await LoadSessionsAsync();
            await RefreshModelsAsync(silent: true);
            StateHasChanged();
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await TryInvokeVoidAsync("memorySmith.chat.scrollToBottom", _transcriptPane);
            await TryInvokeVoidAsync("memorySmith.chat.scrollToBottom", _tracePanelList);
        }

        await TryInvokeVoidAsync("memorySmith.markdown.renderEnhancements", _transcriptPane, new
        {
            skipMermaid = _isSending,
            mermaidEnabled = Options.CurrentValue.Markdown.MermaidEnabled,
            mermaidRestrictionMode = Options.CurrentValue.Markdown.MermaidRestrictionMode
        });
    }

    private async Task TryInvokeVoidAsync(string identifier, params object?[] args)
    {
        await SafeJsInterop.TryInvokeVoidAsync(JS, identifier, args);
    }

    private async Task LoadPreferencesAsync()
    {
        var preferences = await LoadStorageJsonAsync<ChatPreferencesState>(ChatPreferencesStorageKey, warnOnFailure: false);
        if (preferences is null)
        {
            _mermaidThemeMode = NormalizeMermaidThemeMode(await JS.InvokeAsync<string?>("memorySmith.markdown.getMermaidThemeMode"));
            await JS.InvokeVoidAsync("memorySmith.markdown.setMermaidThemeMode", _mermaidThemeMode);
            return;
        }

        if (!string.IsNullOrWhiteSpace(preferences.ModelProfileId) && _modelProfiles.FirstOrDefault(profile => string.Equals(profile.Id, preferences.ModelProfileId, StringComparison.OrdinalIgnoreCase)) is { } preferredProfile && HasDefaultModelProfile)
        {
            ApplySelectedModelProfile(preferredProfile, persistStatus: false);
        }
        else if (!string.IsNullOrWhiteSpace(preferences.Provider) && !string.IsNullOrWhiteSpace(preferences.Model) && _modelProfiles.FirstOrDefault(profile => ProviderMatches(profile.Provider, preferences.Provider) && string.Equals(profile.Model, preferences.Model, StringComparison.OrdinalIgnoreCase)) is { } legacyPreferredProfile && HasDefaultModelProfile)
        {
            ApplySelectedModelProfile(legacyPreferredProfile, persistStatus: false);
        }

        if (!string.IsNullOrWhiteSpace(preferences.Mode) && Enum.TryParse<MemoryChatMode>(preferences.Mode, ignoreCase: true, out var mode))
        {
            _mode = mode;
        }

        if (_mode == MemoryChatMode.Agent && !CanUseAgentMode)
        {
            _mode = MemoryChatMode.Chat;
        }

        _mermaidThemeMode = NormalizeMermaidThemeMode(preferences.MermaidThemeMode);
        if (string.IsNullOrWhiteSpace(preferences.MermaidThemeMode))
        {
            _mermaidThemeMode = NormalizeMermaidThemeMode(await JS.InvokeAsync<string?>("memorySmith.markdown.getMermaidThemeMode"));
        }

        await JS.InvokeVoidAsync("memorySmith.markdown.setMermaidThemeMode", _mermaidThemeMode);

        _preferredActiveSessionId = preferences.ActiveSessionId;
    }

    private async Task CollapseSidebarOnNarrowViewportAsync()
    {
        if (await JS.InvokeAsync<bool>("memorySmith.chat.isNarrowViewport", NarrowChatViewportWidth))
        {
            _sidebarOpen = false;
        }
    }

    private async Task LoadSessionsAsync()
    {
        _sessionLoadFailed = false;
        var raw = await LoadStorageTextAsync(ChatStorageKey, warnOnFailure: true);
        var saved = string.IsNullOrWhiteSpace(raw) ? null : ParseStoredSessions(raw);
        if (_sessionLoadFailed)
        {
            _sessions.Clear();
            StartNewChat();
            _hasLoadedSessions = true;
            await SavePreferencesAsync();
            return;
        }

        _sessions.Clear();
        if (saved is not null)
        {
            _sessions.AddRange(saved.Where(session => !string.IsNullOrWhiteSpace(session.Id)));
        }

        if (_sessions.Count == 0)
        {
            StartNewChat();
        }
        else
        {
            var active = _sessions.FirstOrDefault(session => string.Equals(session.Id, _preferredActiveSessionId, StringComparison.Ordinal))
                ?? _sessions.OrderByDescending(session => session.UpdatedUtc).First();
            _activeSessionId = active.Id;
            RestoreSessionDraft(active);
            SelectDefaultTraceTurn(active);
            _currentUsage = null;
            UpdatePendingWriteStatus(active, "Ready");
            _scrollPending = true;
        }

        _hasLoadedSessions = true;
        await RestoreActiveDraftSnapshotAsync();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private async Task<T?> LoadStorageJsonAsync<T>(string key, bool warnOnFailure)
    {
        var raw = await LoadStorageTextAsync(key, warnOnFailure);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return default;
        }

        try
        {
            return JsonSerializer.Deserialize<T>(raw, StorageJsonOptions);
        }
        catch (Exception)
        {
            MarkStorageLoadFailed(warnOnFailure);
            return default;
        }
    }

    private async Task<string?> LoadStorageTextAsync(string key, bool warnOnFailure)
    {
        try
        {
            return await JS.InvokeAsync<string?>("memorySmith.storage.getJsonString", key);
        }
        catch
        {
            MarkStorageLoadFailed(warnOnFailure);
            return default;
        }
    }

    private void MarkStorageLoadFailed(bool warnOnFailure)
    {
        if (!warnOnFailure)
        {
            return;
        }

        _sessionLoadFailed = true;
        Snackbar.Add("Saved chat history could not be read. A fresh local chat session was started without overwriting existing browser storage.", Severity.Warning);
    }

    private List<ChatSessionState>? ParseStoredSessions(string raw)
    {
        try
        {
            if (JsonNode.Parse(raw) is not JsonArray array)
            {
                return null;
            }

            return array.OfType<JsonObject>()
                .Select(ParseStoredSession)
                .Where(session => session is not null)
                .Select(session => session!)
                .ToList();
        }
        catch (Exception)
        {
            MarkStorageLoadFailed(warnOnFailure: true);
            return default;
        }
    }

    private static ChatSessionState? ParseStoredSession(JsonObject item)
    {
        var id = ReadJsonString(item, "id");
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        var created = ReadJsonDateTimeOffset(item, "createdUtc", DateTimeOffset.UtcNow);
        return new ChatSessionState
        {
            Id = id,
            Title = ReadJsonString(item, "title") ?? "New chat",
            CreatedUtc = created,
            UpdatedUtc = ReadJsonDateTimeOffset(item, "updatedUtc", created),
            Draft = ReadJsonString(item, "draft") ?? string.Empty,
            PendingAttachments = ReadJsonObjects(item, "pendingAttachments").Select(ParseStoredAttachment).Where(attachment => attachment is not null).Select(attachment => attachment!).ToList(),
            Turns = ReadJsonObjects(item, "turns").Select(ParseStoredTurn).ToList(),
            History = ReadJsonObjects(item, "history").Select(ParseStoredMessage).Where(message => message is not null).Select(message => message!).ToList()
        };
    }

    private static ChatTurnState ParseStoredTurn(JsonObject item)
    {
        var created = ReadJsonDateTimeOffset(item, "createdUtc", DateTimeOffset.UtcNow);
        return new ChatTurnState
        {
            Id = ReadJsonString(item, "id") ?? Guid.NewGuid().ToString("N"),
            Role = ReadJsonString(item, "role") ?? string.Empty,
            Content = ReadJsonString(item, "content") ?? string.Empty,
            CreatedUtc = created,
            Thinking = ReadJsonString(item, "thinking"),
            Context = ReadJsonObjects(item, "context").Select(ParseStoredContextItem).ToList(),
            ProposedMemoryWrites = ReadJsonObjects(item, "proposedMemoryWrites").Select(ParseStoredMemoryWriteProposal).Where(proposal => proposal is not null).Select(proposal => proposal!).ToList(),
            ProposedPageWrites = ReadJsonObjects(item, "proposedPageWrites").Select(ParseStoredPageWriteProposal).Where(proposal => proposal is not null).Select(proposal => proposal!).ToList(),
            ResponseCommentDraft = ReadJsonString(item, "responseCommentDraft") ?? string.Empty,
            QuestionOtherDraft = ReadJsonString(item, "questionOtherDraft") ?? string.Empty,
            WrittenMemories = ReadJsonStrings(item, "writtenMemories"),
            WrittenPages = ReadJsonStrings(item, "writtenPages"),
            SubmittedProposalIds = ReadJsonStrings(item, "submittedProposalIds"),
            Attachments = ReadJsonObjects(item, "attachments").Select(ParseStoredAttachment).Where(attachment => attachment is not null).Select(attachment => attachment!).ToList(),
            ProviderName = ReadJsonString(item, "providerName"),
            Model = ReadJsonString(item, "model"),
            Usage = ParseStoredUsage(item),
            DurationMilliseconds = ReadJsonLong(item, "durationMilliseconds"),
            TraceEntries = ReadJsonObjects(item, "traceEntries").Select(ParseStoredTraceEntry).Where(entry => entry is not null).Select(entry => entry!).ToList(),
            TraceDrawerOpen = false,
            ThinkingActive = false
        };
    }

    private static ChatTraceEntryState? ParseStoredTraceEntry(JsonObject item)
    {
        var kind = ReadJsonString(item, "kind") ?? string.Empty;
        var title = ReadJsonString(item, "title") ?? string.Empty;
        var content = ReadJsonString(item, "content") ?? string.Empty;
        if (string.IsNullOrWhiteSpace(kind) || string.IsNullOrWhiteSpace(content))
        {
            return null;
        }

        return new ChatTraceEntryState
        {
            Kind = kind,
            Title = string.IsNullOrWhiteSpace(title) ? kind : title,
            Content = content,
            Id = ReadJsonString(item, "id") ?? Guid.NewGuid().ToString("N"),
            IsError = ReadJsonBool(item, "isError"),
            IsActive = false,
            CreatedUtc = ReadJsonDateTimeOffset(item, "createdUtc", DateTimeOffset.UtcNow),
            ToolName = ReadJsonString(item, "toolName"),
            ToolArgumentsJson = ReadJsonString(item, "toolArgumentsJson"),
            ToolArgumentsDraft = ReadJsonString(item, "toolArgumentsJson") ?? string.Empty,
            DurationMilliseconds = ReadJsonLong(item, "durationMilliseconds"),
            EstimatedTokens = ReadJsonInt(item, "estimatedTokens")
        };
    }

    private static AgentMemoryWriteProposal? ParseStoredMemoryWriteProposal(JsonObject item)
    {
        var id = ReadJsonString(item, "id");
        var content = ReadJsonString(item, "content");
        if (string.IsNullOrWhiteSpace(id) || string.IsNullOrWhiteSpace(content))
        {
            return null;
        }

        return new AgentMemoryWriteProposal(
            id,
            ReadJsonString(item, "title") ?? id,
            content,
            ReadJsonStrings(item, "tags"),
            Enum.TryParse<MemoryStatus>(ReadJsonString(item, "status"), ignoreCase: true, out var status) ? status : MemoryStatus.Working,
            ReadJsonDouble(item, "confidence") ?? 0.7);
    }

    private static AgentPageWriteProposal? ParseStoredPageWriteProposal(JsonObject item)
    {
        var markdown = ReadJsonString(item, "markdown");
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return null;
        }

        var slug = ReadJsonString(item, "slug") ?? string.Empty;
        return new AgentPageWriteProposal(slug, ReadJsonString(item, "title") ?? slug, markdown);
    }

    private static ChatMessage? ParseStoredMessage(JsonObject item)
    {
        var role = ReadJsonString(item, "role");
        var content = ReadJsonString(item, "content");
        return string.IsNullOrWhiteSpace(role) || content is null ? null : new ChatMessage(role, content);
    }

    private static ChatContextItem ParseStoredContextItem(JsonObject item) =>
        new(
            ReadJsonString(item, "kind") ?? string.Empty,
            ReadJsonString(item, "id") ?? string.Empty,
            ReadJsonString(item, "title") ?? string.Empty,
            ReadJsonString(item, "snippet") ?? string.Empty,
            ReadJsonString(item, "origin") ?? ChatContextOrigins.Preloaded);

    private static ChatAttachment? ParseStoredAttachment(JsonObject item)
    {
        var name = ReadJsonString(item, "name");
        return string.IsNullOrWhiteSpace(name)
            ? null
            : new ChatAttachment(
                name,
                ReadJsonString(item, "contentType") ?? string.Empty,
                ReadJsonString(item, "text") ?? string.Empty,
                ReadJsonLong(item, "size") ?? 0,
                ReadJsonString(item, "base64Data"),
                ReadJsonBool(item, "isImage"),
                ReadJsonBool(item, "isTruncated"),
                ReadJsonString(item, "localPath"));
    }

    private static ChatUsageSummary? ParseStoredUsage(JsonObject item)
    {
        if (GetJsonObject(item, "usage") is not { } usage)
        {
            return null;
        }

        return new ChatUsageSummary(
            ReadJsonInt(usage, "inputTokens") ?? 0,
            ReadJsonInt(usage, "outputTokens") ?? 0,
            ReadJsonInt(usage, "contextTokens"),
            ReadJsonInt(usage, "contextWindowTokens"),
            ReadJsonString(usage, "rateLimit"),
            ReadJsonBool(usage, "isEstimate", defaultValue: true));
    }

    private static IEnumerable<JsonObject> ReadJsonObjects(JsonObject item, string name) =>
        GetJsonArray(item, name)?.OfType<JsonObject>() ?? [];

    private static List<string> ReadJsonStrings(JsonObject item, string name) =>
        GetJsonArray(item, name)?.OfType<JsonValue>()
            .Select(value => value.TryGetValue<string>(out var text) ? text : string.Empty)
            .Where(text => !string.IsNullOrWhiteSpace(text))
            .ToList() ?? [];

    private static JsonArray? GetJsonArray(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) ? node as JsonArray : null;

    private static JsonObject? GetJsonObject(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) ? node as JsonObject : null;

    private static string? ReadJsonString(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<string>(out var text)
            ? text
            : null;

    private static int? ReadJsonInt(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<int>(out var number)
            ? number
            : null;

    private static long? ReadJsonLong(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<long>(out var number)
            ? number
            : null;

    private static double? ReadJsonDouble(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<double>(out var number)
            ? number
            : null;

    private static bool ReadJsonBool(JsonObject item, string name, bool defaultValue = false) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<bool>(out var flag)
            ? flag
            : defaultValue;

    private static DateTimeOffset ReadJsonDateTimeOffset(JsonObject item, string name, DateTimeOffset fallback) =>
        DateTimeOffset.TryParse(ReadJsonString(item, name), out var value) ? value : fallback;

