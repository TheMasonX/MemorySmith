    private static void MergeTurnContext(ChatTurnState turn, IEnumerable<ChatContextItem> contextItems)
    {
        var seen = turn.Context.Select(item => $"{item.Kind}:{item.Id}").ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var item in contextItems)
        {
            if (seen.Add($"{item.Kind}:{item.Id}"))
            {
                turn.Context.Add(item);
            }
        }
    }

    private static string FormatPendingWriteSummary(ChatTurnState turn)
    {
        var lines = new List<string>();
