        await ApplyApprovedWritesAsync(turn, turn.ProposedMemoryWrites.ToList(), turn.ProposedPageWrites.ToList());
    }

    private async Task ApproveMemoryWriteAsync(string turnId, string memoryId)
    {
        if (FindTurn(turnId) is not { } turn)
        {
            return;
        }

        var proposal = turn.ProposedMemoryWrites.FirstOrDefault(item => string.Equals(item.Id, memoryId, StringComparison.OrdinalIgnoreCase));
        if (proposal is not null)
        {
            await ApplyApprovedWritesAsync(turn, [proposal], []);
        }
    }

    private async Task ApprovePageWriteAsync(string turnId, string slug)
    {
        if (FindTurn(turnId) is not { } turn)
        {
            return;
        }

        var proposal = turn.ProposedPageWrites.FirstOrDefault(item => string.Equals(item.Slug, slug, StringComparison.OrdinalIgnoreCase));
        if (proposal is not null)
        {
            await ApplyApprovedWritesAsync(turn, [], [proposal]);
        }
    }

    private async Task ApplyApprovedWritesAsync(ChatTurnState turn, IReadOnlyList<AgentMemoryWriteProposal> memories, IReadOnlyList<AgentPageWriteProposal> pages)
    {
        try
        {
            var result = await ChatAgent.ApplyAgentWritesAsync(memories, pages, CancellationToken.None);
            turn.WrittenMemories.AddRange(result.WrittenMemories.Where(id => !turn.WrittenMemories.Contains(id, StringComparer.OrdinalIgnoreCase)));
            turn.WrittenPages.AddRange(result.WrittenPages.Where(slug => !turn.WrittenPages.Contains(slug, StringComparer.OrdinalIgnoreCase)));
            turn.ProposedMemoryWrites.RemoveAll(proposal => result.WrittenMemories.Contains(proposal.Id, StringComparer.OrdinalIgnoreCase));
            turn.ProposedPageWrites.RemoveAll(proposal => result.WrittenPages.Contains(proposal.Slug, StringComparer.OrdinalIgnoreCase));
            AddTraceEntry(turn, ChatTraceKinds.Write, "Agent writes approved", FormatAppliedWriteSummary(result), IsError: false);
            _agentStatus = $"Applied {result.WrittenMemories.Count + result.WrittenPages.Count} approved write(s)";
            ActiveSession.UpdatedUtc = DateTimeOffset.UtcNow;
            await SaveSessionsAsync();
        }
        catch (Exception ex)
        {
            AddTraceEntry(turn, ChatTraceKinds.Write, "Agent write approval failed", ex.Message, IsError: true);
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

