    private static bool TurnHasInspectableState(ChatTurnState turn) =>
        turn.TraceEntries.Count > 0 ||
        turn.Context.Count > 0 ||
        turn.ProposedMemoryWrites.Count > 0 ||
        turn.ProposedPageWrites.Count > 0 ||
        turn.WrittenMemories.Count > 0 ||
        turn.WrittenPages.Count > 0 ||
        turn.SubmittedProposalIds.Count > 0 ||
        turn.Usage is not null;

    private IEnumerable<ChatTraceEntryState> FilteredTraceEntries(ChatTurnState turn) =>
        turn.TraceEntries.Where(entry =>
            (!_traceErrorsOnly || entry.IsError) &&
            (entry.Kind switch
            {
                ChatTraceKinds.Reasoning => _traceShowReasoning,
                ChatTraceKinds.ToolCall or ChatTraceKinds.ToolResult => _traceShowTools,
                ChatTraceKinds.Assistant => _traceShowAssistant,
                ChatTraceKinds.System or ChatTraceKinds.Write => _traceShowSystem,
                _ => _traceShowSystem
            }));

    private IReadOnlyList<TraceGraphNode> BuildTraceGraph(ChatTurnState turn, IEnumerable<ChatTraceEntryState> entries)
    {
        var nodes = new List<TraceGraphNode>();
        if (_traceShowSystem && turn.Context.Any(item => string.Equals(item.Origin, ChatContextOrigins.Preloaded, StringComparison.OrdinalIgnoreCase)))
        {
            nodes.Add(new TraceGraphNode("Preload", "chat-trace-node is-system"));
        }

        foreach (var entry in entries)
        {
            var label = entry.Kind switch
            {
                ChatTraceKinds.Reasoning => "Reason",
                ChatTraceKinds.ToolCall => "Tool call",
                ChatTraceKinds.ToolResult => "Tool result",
                ChatTraceKinds.Write => "Approval",
                ChatTraceKinds.Assistant => "Answer",
                _ => "System"
            };
            var css = entry.Kind switch
            {
                ChatTraceKinds.Reasoning => "chat-trace-node is-reasoning",
                ChatTraceKinds.ToolCall => "chat-trace-node is-tool-call",
                ChatTraceKinds.ToolResult => "chat-trace-node is-tool-result",
                ChatTraceKinds.Write => "chat-trace-node is-write",
                ChatTraceKinds.Assistant => "chat-trace-node is-assistant",
                _ => "chat-trace-node is-system"
            };
            nodes.Add(new TraceGraphNode(label, css));
        }

        return nodes.Count == 0 ? [new TraceGraphNode("No trace", "chat-trace-node is-system")] : nodes;
    }

    private async Task StartNewChatAsync()
    {
        PersistActiveDraft();
        StartNewChat();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private void StartNewChat()
    {
        var now = DateTimeOffset.UtcNow;
        var session = new ChatSessionState
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "New chat",
            CreatedUtc = now,
            UpdatedUtc = now
        };
        _sessions.Insert(0, session);
        _activeSessionId = session.Id;
        RestoreSessionDraft(session);
        SelectDefaultTraceTurn(session);
        _currentUsage = null;
        _agentStatus = "Ready";
        _scrollPending = true;
    }

    private async Task SelectSessionAsync(string id)
    {
        if (_sessions.FirstOrDefault(session => session.Id == id) is { } session)
        {
            PersistActiveDraft();
            _activeSessionId = id;
            RestoreSessionDraft(session);
            SelectDefaultTraceTurn(session);
            _currentUsage = null;
            UpdatePendingWriteStatus(session, _mode == MemoryChatMode.Agent ? "Agent ready" : "Chat ready");
            _scrollPending = true;
            await SaveSessionsAsync();
            await SavePreferencesAsync();
        }
    }

    private async Task DeleteSessionAsync(string id)
    {
        if (_sessions.FirstOrDefault(session => session.Id == id) is not { } session)
        {
            return;
        }

        var title = string.IsNullOrWhiteSpace(session.Title) ? "this chat" : session.Title;
        if (!await Dialogs.ConfirmDestructiveActionAsync(
            "Delete chat?",
            $"Delete chat \"{title}\". This removes the saved chat session from this browser profile and cannot be undone.",
            "Delete chat"))
        {
            return;
        }

        var wasActive = string.Equals(_activeSessionId, id, StringComparison.Ordinal);
        var pendingAttachments = session.PendingAttachments.ToList();
        _sessions.Remove(session);
        if (_sessions.Count == 0)
        {
            StartNewChat();
        }
        else if (wasActive)
        {
            var next = _sessions.OrderByDescending(item => item.UpdatedUtc).First();
            _activeSessionId = next.Id;
            RestoreSessionDraft(next);
            SelectDefaultTraceTurn(next);
            _currentUsage = null;
        }

        LogAttachmentCleanupResult("session-delete", ChatAttachmentFiles.DeleteTempFiles(pendingAttachments, RetainedPendingAttachments()));
        UpdatePendingWriteStatus(ActiveSession, "Chat deleted");
        Snackbar.Add("Chat deleted.", Severity.Success);
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private async Task SetModeAsync(MemoryChatMode mode)
    {
        if (mode == MemoryChatMode.Agent && !CanUseAgentMode)
        {
            Snackbar.Add("Agent writes require an Editor or Admin role and enabled AgentWrites configuration.", Severity.Warning);
            return;
        }

        _mode = mode;
        _agentStatus = mode == MemoryChatMode.Agent ? "Agent ready" : "Chat ready";
        await SavePreferencesAsync();
    }

    private void SelectDefaultTraceTurn(ChatSessionState session)
    {
        _selectedTraceTurnId = session.Turns.LastOrDefault(TurnHasInspectableState)?.Id;
    }

    private void LoadModelProfiles()
    {
        _modelProfiles.Clear();
        _modelProfiles.AddRange(ModelProfiles.ListEnabledProfilesForRoles(CurrentUser.Roles));
    }

    private async Task OnModelProfileChanged(string profileId)
    {
        if (_modelProfiles.FirstOrDefault(profile => string.Equals(profile.Id, profileId, StringComparison.OrdinalIgnoreCase)) is not { } profile)
        {
            return;
        }

        ApplySelectedModelProfile(profile, persistStatus: true);
        _currentUsage = null;
        await SavePreferencesAsync();
        await RefreshModelsAsync(silent: true);
    }

    private void ApplySelectedModelProfile(ChatModelProfileView? profile, bool persistStatus)
    {
        if (profile is null)
        {
            _selectedModelProfileId = string.Empty;
            _selectedProvider = string.Empty;
            _selectedModel = string.Empty;
            if (persistStatus)
            {
                _agentStatus = "No default model profile configured";
            }

            return;
        }

        _selectedModelProfileId = profile.Id;
        _selectedProvider = profile.Provider;
        _selectedModel = profile.Model;
