    private static bool TurnHasInspectableState(ChatTurnState turn) =>
        turn.TraceEntries.Count > 0 ||
        turn.Context.Count > 0 ||
        turn.ProposedMemoryWrites.Count > 0 ||
        turn.ProposedPageWrites.Count > 0 ||
        turn.WrittenMemories.Count > 0 ||
        turn.WrittenPages.Count > 0 ||
        turn.Usage is not null;

    private IEnumerable<ChatTraceEntryState> FilteredTraceEntries(ChatTurnState turn) =>
        turn.TraceEntries.Where(entry =>
            (!_traceErrorsOnly || entry.IsError) &&
            (entry.Kind switch
            {
                ChatTraceKinds.Reasoning => _traceShowReasoning,
                ChatTraceKinds.ToolCall or ChatTraceKinds.ToolResult => _traceShowTools,
                ChatTraceKinds.Assistant => _traceShowAssistant,
                ChatTraceKinds.System or ChatTraceKinds.Write => _traceShowSystem,
                _ => _traceShowSystem
            }));

    private IReadOnlyList<TraceGraphNode> BuildTraceGraph(ChatTurnState turn, IEnumerable<ChatTraceEntryState> entries)
    {
        var nodes = new List<TraceGraphNode>();
        if (_traceShowSystem && turn.Context.Any(item => string.Equals(item.Origin, ChatContextOrigins.Preloaded, StringComparison.OrdinalIgnoreCase)))
        {
            nodes.Add(new TraceGraphNode("Preload", "chat-trace-node is-system"));
        }

        foreach (var entry in entries)
        {
            var label = entry.Kind switch
            {
                ChatTraceKinds.Reasoning => "Reason",
                ChatTraceKinds.ToolCall => "Tool call",
                ChatTraceKinds.ToolResult => "Tool result",
                ChatTraceKinds.Write => "Approval",
                ChatTraceKinds.Assistant => "Answer",
                _ => "System"
            };
            var css = entry.Kind switch
            {
                ChatTraceKinds.Reasoning => "chat-trace-node is-reasoning",
                ChatTraceKinds.ToolCall => "chat-trace-node is-tool-call",
                ChatTraceKinds.ToolResult => "chat-trace-node is-tool-result",
                ChatTraceKinds.Write => "chat-trace-node is-write",
                ChatTraceKinds.Assistant => "chat-trace-node is-assistant",
                _ => "chat-trace-node is-system"
            };
            nodes.Add(new TraceGraphNode(label, css));
        }

        return nodes.Count == 0 ? [new TraceGraphNode("No trace", "chat-trace-node is-system")] : nodes;
    }

