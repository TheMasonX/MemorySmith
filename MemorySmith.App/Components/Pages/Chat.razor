@page "/chat"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.Extensions.Options
@inject IChatAgent ChatAgent
@inject IEnumerable<IChatProvider> ChatProviders
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Chat</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasPendingDraft" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<div class="@ChatWorkbenchClass">
    <aside class="@HistorySidebarClass" aria-label="Chat history">
        <div class="chat-history-header">
            <MudText Typo="Typo.subtitle2">History</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Success" OnClick="StartNewChatAsync" aria-label="New chat" />
        </div>

        @if (_historyOpen)
        {
            <div class="chat-history-list">
                @foreach (var session in _sessions)
                {
                    <div class="@SessionButtonClass(session)">
                        <button type="button" class="chat-history-select" @onclick="@(() => SelectSessionAsync(session.Id))">
                            <span>@session.Title</span>
                            <small>@session.UpdatedUtc.ToLocalTime().ToString("M/d HH:mm")</small>
                        </button>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@_isSending" OnClick="@(() => DeleteSessionAsync(session.Id))" aria-label="Delete chat" />
                    </div>
                }
            </div>
        }
    </aside>

    <section class="chat-shell" aria-label="MemorySmith chat">
        <div class="chat-toolbar">
            <MudIconButton Icon="@(_historyOpen ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.Menu)" Size="Size.Small" OnClick="ToggleHistory" aria-label="Toggle history" />

            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="chat-mode-toggle">
                <MudButton Variant="@ModeButtonVariant(MemoryChatMode.Chat)" Color="@ModeButtonColor(MemoryChatMode.Chat)" Class="@ModeButtonClass(MemoryChatMode.Chat)" OnClick="@(() => SetModeAsync(MemoryChatMode.Chat))">Chat</MudButton>
                <MudButton Variant="@ModeButtonVariant(MemoryChatMode.Agent)" Color="@ModeButtonColor(MemoryChatMode.Agent)" Class="@ModeButtonClass(MemoryChatMode.Agent)" OnClick="@(() => SetModeAsync(MemoryChatMode.Agent))">Agent</MudButton>
            </MudButtonGroup>

            <div class="chat-model-controls">
                <MudSelect T="string" Value="_selectedProvider" ValueChanged="OnProviderChanged" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="chat-provider-select">
                    @foreach (var provider in _availableProviders)
                    {
                        <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_selectedModel" ValueChanged="OnModelChanged" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="chat-model-select">
                    @if (_models.Count == 0 && !string.IsNullOrWhiteSpace(_selectedModel))
                    {
                        <MudSelectItem T="string" Value="@_selectedModel">@_selectedModel</MudSelectItem>
                    }
                    @foreach (var model in _models)
                    {
                        <MudSelectItem T="string" Value="@model.Name">@FormatModelLabel(model)</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" Disabled="@_isLoadingModels" OnClick="RefreshModelsAsync" aria-label="Refresh models" />
            </div>
        </div>

        <div class="chat-status-strip">
            <span>@_agentStatus</span>
            @if (!string.IsNullOrWhiteSpace(_modelError))
            {
                <span class="chat-status-error">@_modelError</span>
            }
            @if (_attachments.Count > 0)
            {
                <span>@_attachments.Count attachment(s) queued</span>
            }
            @if (_isSending)
            {
                <span>@FormatDuration(_responseElapsed) elapsed</span>
                <span>@_streamedCharacters chars</span>
            }
        </div>
        @if (_isSending)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <div class="chat-transcript" @ref="_transcriptPane">
            @if (ActiveSession.Turns.Count == 0)
            {
                <div class="wiki-empty-state">No messages yet.</div>
            }
            else
            {
                @foreach (var turn in ActiveSession.Turns)
                {
                    <article class="chat-message @turn.Role">
                        <div class="chat-message-topline">
                            <span class="chat-message-role">@turn.Role</span>
                            <span class="chat-message-meta">
                                @if (!string.IsNullOrWhiteSpace(turn.Model))
                                {
                                    <span class="chat-message-model">@FormatTurnModel(turn)</span>
                                }
                                <span>@turn.CreatedUtc.ToLocalTime().ToString("HH:mm")@if (turn.DurationMilliseconds is not null) { <span> · @FormatDuration(TimeSpan.FromMilliseconds(turn.DurationMilliseconds.Value))</span> }</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(turn.Thinking))
                        {
                            <details class="@ThinkingClass(turn)" open="@turn.ThinkingActive">
                                <summary>Thinking<span class="chat-thinking-activity" aria-hidden="true"></span></summary>
                                <pre>@turn.Thinking</pre>
                            </details>
                        }
                        <div class="chat-message-body">@turn.Content</div>

                        @if (turn.Attachments.Count > 0)
                        {
                            <div class="chat-context-list">
                                @foreach (var attachment in turn.Attachments)
                                {
                                    <span class="wiki-tag" title="@AttachmentTitle(attachment)">file:@attachment.Name</span>
                                }
                            </div>
                        }

                        @if (turn.Context.Count > 0 || turn.WrittenMemories.Count > 0 || turn.WrittenPages.Count > 0)
                        {
                            <div class="chat-context-list">
                                @foreach (var item in turn.Context)
                                {
                                    <a class="wiki-tag chat-resource" href="@ContextHref(item)" target="_blank" rel="noopener noreferrer" title="@item.Snippet">@item.Kind:@item.Title</a>
                                }
                                @foreach (var id in turn.WrittenMemories)
                                {
                                    <a class="wiki-status is-working chat-resource" href="@MemoryHref(id)" target="_blank" rel="noopener noreferrer">memory:@id</a>
                                }
                                @foreach (var slug in turn.WrittenPages)
                                {
                                    <a class="wiki-status is-core chat-resource" href="@PageHref(slug)" target="_blank" rel="noopener noreferrer">page:@slug</a>
                                }
                            </div>
                        }
                    </article>
                }
            }
        </div>

        <div class="chat-attachment-row">
            <InputFile id="chat-file-input" OnChange="OnFilesSelectedAsync" multiple class="chat-file-input" />
            @foreach (var attachment in _attachments)
            {
                <span class="wiki-tag chat-attachment-chip" title="@AttachmentTitle(attachment)">
                    @if (attachment.IsImage && !string.IsNullOrWhiteSpace(attachment.Base64Data))
                    {
                        <img class="chat-attachment-thumb" src="@AttachmentDataUrl(attachment)" alt="" />
                    }
                    <span class="chat-attachment-name">@attachment.Name</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" Class="chat-attachment-remove" OnClick="@(() => RemoveAttachment(attachment.Name))" aria-label="Remove attachment" title="Remove attachment" />
                </span>
            }
        </div>

        <div class="chat-composer">
            <textarea @ref="_composerInput"
                      class="chat-composer-input"
                      aria-label="Message"
                      placeholder="Message"
                      value="@_draft"
                      @oninput="OnDraftInput"></textarea>
            <div class="chat-composer-side">
                <div class="chat-usage-meter" title="@FormatUsageTitle(ActiveUsage)" aria-live="polite">@FormatUsageMeter(ActiveUsage)</div>
                <div class="chat-composer-actions">
                    <MudCheckBox T="bool" Value="_sendOnEnter" ValueChanged="SetSendOnEnterAsync" Label="Send on Enter" Size="Size.Small" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" Disabled="@(!_isSending)" OnClick="StopGeneratingAsync">Stop</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@_isSending" OnClick="SendAsync">Send</MudButton>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private const string ChatStorageKey = "memorysmith.chat.sessions.v1";
    private const string ChatPreferencesStorageKey = "memorysmith.chat.preferences.v1";
    private readonly List<ChatSessionState> _sessions = [];
    private readonly List<ChatModelSummary> _models = [];
    private readonly List<string> _availableProviders = [];
    private readonly List<ChatAttachment> _attachments = [];
    private DotNetObjectReference<Chat>? _dotNetRef;
    private ElementReference _composerInput;
    private ElementReference _transcriptPane;
    private MemoryChatMode _mode = MemoryChatMode.Chat;
    private string _activeSessionId = string.Empty;
    private string _draft = string.Empty;
    private string _selectedProvider = "Ollama";
    private string _selectedModel = string.Empty;
    private string _agentStatus = "Ready";
    private string? _preferredActiveSessionId;
    private string? _modelError;
    private bool _historyOpen = true;
    private bool _sendOnEnter = true;
    private bool _isSending;
    private bool _isLoadingModels;
    private bool _hasLoadedSessions;
    private bool _composerRegistered;
    private bool _scrollPending;
    private bool _storageWarningShown;
    private CancellationTokenSource? _responseTimerCts;
    private CancellationTokenSource? _sendCts;
    private DateTimeOffset? _responseStartedUtc;
    private TimeSpan _responseElapsed = TimeSpan.Zero;
    private int _streamedCharacters;
    private ChatUsageSummary? _currentUsage;

    private ChatSessionState ActiveSession =>
        _sessions.FirstOrDefault(session => session.Id == _activeSessionId) ?? _sessions.First();

    private string HistorySidebarClass => _historyOpen ? "chat-history-pane" : "chat-history-pane is-collapsed";
    private string ChatWorkbenchClass => _historyOpen ? "chat-workbench" : "chat-workbench is-history-collapsed";
    private bool HasPendingDraft => !string.IsNullOrWhiteSpace(_draft) || _attachments.Count > 0;
    private ChatUsageSummary? ActiveUsage =>
        _currentUsage
        ?? (_sessions.Count == 0 ? null : ActiveSession.Turns.LastOrDefault(turn => turn.Usage is not null)?.Usage)
        ?? SelectedModelUsage();

    protected override void OnInitialized()
    {
        var chatOptions = Options.CurrentValue.Chat;
        _availableProviders.Clear();
        _availableProviders.AddRange(ChatProviders.Select(provider => provider.Name).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(provider => provider));
        if (_availableProviders.Count == 0)
        {
            _availableProviders.Add(chatOptions.Provider);
        }

        _selectedProvider = _availableProviders.FirstOrDefault(provider => ProviderMatches(provider, chatOptions.Provider)) ?? _availableProviders[0];
        _selectedModel = DefaultModelForProvider(_selectedProvider);
        StartNewChat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("memorySmith.chat.registerComposer", _composerInput, _dotNetRef, _sendOnEnter);
            _composerRegistered = true;
            await LoadPreferencesAsync();
            await LoadSessionsAsync();
            await RefreshModelsAsync(silent: true);
            StateHasChanged();
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("memorySmith.chat.scrollToBottom", _transcriptPane);
        }
    }

    private async Task LoadPreferencesAsync()
    {
        var preferences = await JS.InvokeAsync<ChatPreferencesState?>("memorySmith.storage.getJson", ChatPreferencesStorageKey);
        if (preferences is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(preferences.Provider) && _availableProviders.Any(provider => ProviderMatches(provider, preferences.Provider)))
        {
            _selectedProvider = _availableProviders.First(provider => ProviderMatches(provider, preferences.Provider));
        }

        if (!string.IsNullOrWhiteSpace(preferences.Model))
        {
            _selectedModel = preferences.Model;
        }

        if (!string.IsNullOrWhiteSpace(preferences.Mode) && Enum.TryParse<MemoryChatMode>(preferences.Mode, ignoreCase: true, out var mode))
        {
            _mode = mode;
        }

        _preferredActiveSessionId = preferences.ActiveSessionId;
    }

    private async Task LoadSessionsAsync()
    {
        var saved = await JS.InvokeAsync<List<ChatSessionState>?>("memorySmith.storage.getJson", ChatStorageKey);
        _sessions.Clear();
        if (saved is not null)
        {
            _sessions.AddRange(saved.Where(session => !string.IsNullOrWhiteSpace(session.Id)));
        }

        if (_sessions.Count == 0)
        {
            StartNewChat();
        }
        else
        {
            var active = _sessions.FirstOrDefault(session => string.Equals(session.Id, _preferredActiveSessionId, StringComparison.Ordinal))
                ?? _sessions.OrderByDescending(session => session.UpdatedUtc).First();
            _activeSessionId = active.Id;
            RestoreSessionDraft(active);
            _currentUsage = null;
            _agentStatus = "Ready";
            _scrollPending = true;
        }

        _hasLoadedSessions = true;
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private void ToggleHistory()
    {
        _historyOpen = !_historyOpen;
    }

    private async Task StartNewChatAsync()
    {
        PersistActiveDraft();
        StartNewChat();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private void StartNewChat()
    {
        var now = DateTimeOffset.UtcNow;
        var session = new ChatSessionState
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "New chat",
            CreatedUtc = now,
            UpdatedUtc = now
        };
        _sessions.Insert(0, session);
        _activeSessionId = session.Id;
        RestoreSessionDraft(session);
        _currentUsage = null;
        _agentStatus = "Ready";
        _scrollPending = true;
    }

    private async Task SelectSessionAsync(string id)
    {
        if (_sessions.FirstOrDefault(session => session.Id == id) is { } session)
        {
            PersistActiveDraft();
            _activeSessionId = id;
            RestoreSessionDraft(session);
            _currentUsage = null;
            _scrollPending = true;
            await SaveSessionsAsync();
            await SavePreferencesAsync();
        }
    }

    private async Task DeleteSessionAsync(string id)
    {
        if (_sessions.FirstOrDefault(session => session.Id == id) is not { } session)
        {
            return;
        }

        var title = string.IsNullOrWhiteSpace(session.Title) ? "this chat" : session.Title;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete chat '{title}'? This cannot be undone."))
        {
            return;
        }

        var wasActive = string.Equals(_activeSessionId, id, StringComparison.Ordinal);
        _sessions.Remove(session);
        if (_sessions.Count == 0)
        {
            StartNewChat();
        }
        else if (wasActive)
        {
            var next = _sessions.OrderByDescending(item => item.UpdatedUtc).First();
            _activeSessionId = next.Id;
            RestoreSessionDraft(next);
            _currentUsage = null;
        }

        _agentStatus = "Chat deleted";
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private async Task SetModeAsync(MemoryChatMode mode)
    {
        _mode = mode;
        _agentStatus = mode == MemoryChatMode.Agent ? "Agent ready" : "Chat ready";
        await SavePreferencesAsync();
    }

    private async Task OnProviderChanged(string provider)
    {
        _selectedProvider = provider;
        _selectedModel = DefaultModelForProvider(provider);
        _currentUsage = null;
        _agentStatus = $"Using {_selectedProvider} / {_selectedModel}";
        await SavePreferencesAsync();
        await RefreshModelsAsync(silent: true);
    }

    private async Task OnModelChanged(string model)
    {
        _selectedModel = model;
        _currentUsage = null;
        _agentStatus = $"Using {_selectedProvider} / {_selectedModel}";
        await SavePreferencesAsync();
    }

    private async Task RefreshModelsAsync()
    {
        await RefreshModelsAsync(silent: false);
    }

    private async Task RefreshModelsAsync(bool silent)
    {
        _isLoadingModels = true;
        _modelError = null;
        try
        {
            var provider = ResolveProvider(_selectedProvider);
            var models = await provider.ListModelsAsync(CancellationToken.None);
            _models.Clear();
            _models.AddRange(models);
            if (_models.Count > 0 && !_models.Any(model => string.Equals(model.Name, _selectedModel, StringComparison.OrdinalIgnoreCase)))
            {
                var defaultModel = DefaultModelForProvider(_selectedProvider);
                _selectedModel = _models.FirstOrDefault(model => string.Equals(model.Name, defaultModel, StringComparison.OrdinalIgnoreCase))?.Name
                    ?? _models.FirstOrDefault(model => model.IsPreferred)?.Name
                    ?? _models[0].Name;
            }

            _agentStatus = $"{_models.Count} model(s) available";
            await SavePreferencesAsync();
        }
        catch (Exception ex)
        {
            _modelError = ex.Message;
            if (!silent)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
        finally
        {
            _isLoadingModels = false;
        }
    }

    private async Task OnDraftInput(ChangeEventArgs args)
    {
        _draft = args.Value?.ToString() ?? string.Empty;
        PersistActiveDraft();
        await SaveSessionsAsync();
    }

    private async Task SetSendOnEnterAsync(bool enabled)
    {
        _sendOnEnter = enabled;
        if (_composerRegistered)
        {
            await JS.InvokeVoidAsync("memorySmith.chat.setSendOnEnter", _composerInput, enabled);
        }
    }

    [JSInvokable]
    public Task SendFromKeyboard(string message)
    {
        return SendAsync(message);
    }

    private async Task SendAsync()
    {
        await SendAsync(_draft);
    }

    private async Task SendAsync(string? explicitMessage)
    {
        var message = (explicitMessage ?? _draft).Trim();
        if (string.IsNullOrWhiteSpace(message) || _isSending)
        {
            return;
        }

        var session = ActiveSession;
        var attachments = _attachments.ToList();
        var displayAttachments = attachments.Select(ToDisplayAttachment).ToList();
        var historyForRequest = session.History.ToList();
        _draft = string.Empty;
        _attachments.Clear();
        session.Draft = string.Empty;
        session.PendingAttachments.Clear();
        session.Turns.Add(new ChatTurnState("user", message, DateTimeOffset.UtcNow, null, [], [], [], displayAttachments));
        session.History.Add(new ChatMessage("user", message));
        session.Title = BuildSessionTitle(session, message);
        session.UpdatedUtc = DateTimeOffset.UtcNow;
        _isSending = true;
        _responseStartedUtc = DateTimeOffset.UtcNow;
        _responseElapsed = TimeSpan.Zero;
        _streamedCharacters = 0;
        _agentStatus = _mode == MemoryChatMode.Agent ? "Agent thinking" : "Waiting for first token";
        _currentUsage = null;
        var requestProvider = _selectedProvider;
        var requestModel = _selectedModel;
        var pendingTurn = new ChatTurnState("assistant pending", "Waiting for first token...", DateTimeOffset.UtcNow, null, [], [], [], [])
        {
            ProviderName = requestProvider,
            Model = requestModel
        };
        session.Turns.Add(pendingTurn);
        _scrollPending = true;
        StartResponseTimer();
        await SaveSessionsAsync();
        var lastStreamPersistUtc = DateTimeOffset.UtcNow;
        var sendCts = new CancellationTokenSource();
        _sendCts = sendCts;

        try
        {
            MemoryChatResponse? finalResponse = null;
            await foreach (var update in ChatAgent.StreamAsync(new MemoryChatRequest(message, _mode, historyForRequest, requestModel, attachments, requestProvider), sendCts.Token))
            {
                var turnChanged = false;
                if (!string.IsNullOrEmpty(update.Status))
                {
                    _agentStatus = update.Status;
                }
                if (update.Usage is not null)
                {
                    _currentUsage = update.Usage;
                    pendingTurn.Usage = update.Usage;
                }
                if (!string.IsNullOrEmpty(update.ContentDelta))
                {
                    if (!string.Equals(pendingTurn.Role, "assistant", StringComparison.Ordinal))
                    {
                        pendingTurn.Content = string.Empty;
                    }

                    pendingTurn.Role = "assistant";
                    pendingTurn.Content += update.ContentDelta;
                    pendingTurn.ProviderName = requestProvider;
                    pendingTurn.Model = requestModel;
                    pendingTurn.ThinkingActive = false;
                    _streamedCharacters = pendingTurn.Content.Length;
                    _agentStatus = $"Streaming {requestProvider} / {requestModel}";
                    turnChanged = true;
                }
                if (!string.IsNullOrEmpty(update.ThinkingDelta))
                {
                    pendingTurn.Thinking = (pendingTurn.Thinking ?? string.Empty) + update.ThinkingDelta;
                    pendingTurn.ProviderName = requestProvider;
                    pendingTurn.Model = requestModel;
                    pendingTurn.ThinkingActive = true;
                    _agentStatus = $"Thinking {requestProvider} / {requestModel}";
                    turnChanged = true;
                }
                if (update.Response is not null)
                {
                    finalResponse = update.Response;
                    pendingTurn.ThinkingActive = false;
                }

                _scrollPending = true;
                await InvokeAsync(StateHasChanged);
                if (turnChanged && DateTimeOffset.UtcNow - lastStreamPersistUtc >= TimeSpan.FromSeconds(2))
                {
                    session.UpdatedUtc = DateTimeOffset.UtcNow;
                    await SaveSessionsAsync();
                    lastStreamPersistUtc = DateTimeOffset.UtcNow;
                }
            }

            var response = finalResponse ?? throw new InvalidOperationException("The provider stream completed without a final response.");
            pendingTurn.Role = "assistant";
            pendingTurn.Content = response.Reply;
            pendingTurn.Thinking = response.Thinking;
            pendingTurn.ThinkingActive = false;
            pendingTurn.ProviderName = response.ProviderName;
            pendingTurn.Model = response.Model;
            pendingTurn.Context = response.Context.ToList();
            pendingTurn.WrittenMemories = response.WrittenMemories.ToList();
            pendingTurn.WrittenPages = response.WrittenPages.ToList();
            pendingTurn.Usage = response.Usage;
            pendingTurn.DurationMilliseconds = (long)Math.Max(0, (DateTimeOffset.UtcNow - (_responseStartedUtc ?? DateTimeOffset.UtcNow)).TotalMilliseconds);
            session.History.Add(new ChatMessage("assistant", response.Reply));
            session.UpdatedUtc = DateTimeOffset.UtcNow;
            _agentStatus = $"{response.ProviderName} / {response.Model}: {response.Context.Count} resource(s), {response.WrittenMemories.Count + response.WrittenPages.Count} write(s)";
            _selectedProvider = response.ProviderName;
            _selectedModel = response.Model;
            _currentUsage = response.Usage;
        }
        catch (OperationCanceledException) when (sendCts.IsCancellationRequested)
        {
            pendingTurn.Role = "assistant";
            pendingTurn.Content = string.IsNullOrWhiteSpace(pendingTurn.Content) || string.Equals(pendingTurn.Content, "Waiting for first token...", StringComparison.Ordinal)
                ? "Generation stopped before the first token."
                : pendingTurn.Content.TrimEnd();
            pendingTurn.ProviderName = requestProvider;
            pendingTurn.Model = requestModel;
            pendingTurn.Usage ??= _currentUsage;
            pendingTurn.ThinkingActive = false;
            pendingTurn.DurationMilliseconds = (long)Math.Max(0, (DateTimeOffset.UtcNow - (_responseStartedUtc ?? DateTimeOffset.UtcNow)).TotalMilliseconds);
            if (!string.IsNullOrWhiteSpace(pendingTurn.Content) && !pendingTurn.Content.StartsWith("Generation stopped", StringComparison.Ordinal))
            {
                session.History.Add(new ChatMessage("assistant", pendingTurn.Content));
            }

            session.UpdatedUtc = DateTimeOffset.UtcNow;
            _agentStatus = "Generation stopped";
        }
        catch (Exception ex)
        {
            var errorMessage = ChatErrorMessages.Format(ex, requestProvider, requestModel);
            session.Turns.Remove(pendingTurn);
            Snackbar.Add(errorMessage, Severity.Error);
            session.Turns.Add(new ChatTurnState("assistant", errorMessage, DateTimeOffset.UtcNow, null, [], [], [], [])
            {
                ProviderName = requestProvider,
                Model = requestModel,
                Usage = _currentUsage,
                DurationMilliseconds = (long)Math.Max(0, (DateTimeOffset.UtcNow - (_responseStartedUtc ?? DateTimeOffset.UtcNow)).TotalMilliseconds)
            });
            _agentStatus = "Request failed";
        }
        finally
        {
            if (ReferenceEquals(_sendCts, sendCts))
            {
                _sendCts = null;
            }

            sendCts.Dispose();
            StopResponseTimer();
            _isSending = false;
            _scrollPending = true;
            await InvokeAsync(StateHasChanged);
            await SaveSessionsAsync();
            await SavePreferencesAsync();
        }
    }

    private Task StopGeneratingAsync()
    {
        if (!_isSending || _sendCts is null || _sendCts.IsCancellationRequested)
        {
            return Task.CompletedTask;
        }

        _agentStatus = "Stopping generation";
        _sendCts.Cancel();
        return Task.CompletedTask;
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        var maxCharacters = Math.Clamp(Options.CurrentValue.Chat.MaxAttachmentCharacters, 1000, 2_000_000);
        var maxBytes = Math.Clamp(Options.CurrentValue.Chat.MaxAttachmentBytes, 1024, 64L * 1024 * 1024);
        foreach (var file in args.GetMultipleFiles(8))
        {
            try
            {
                var attachment = await ReadAttachmentAsync(file, maxCharacters, maxBytes);
                _attachments.RemoveAll(item => string.Equals(item.Name, file.Name, StringComparison.OrdinalIgnoreCase));
                _attachments.Add(attachment);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }

        PersistActiveDraft();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        _agentStatus = "Ready";
    }

    private static async Task<ChatAttachment> ReadAttachmentAsync(IBrowserFile file, int maxCharacters, long maxBytes)
    {
        if (IsImageAttachment(file))
        {
            if (file.Size > maxBytes)
            {
                throw new InvalidOperationException($"{file.Name} is {FormatBytes(file.Size)}, above the configured {FormatBytes(maxBytes)} attachment limit.");
            }

            await using var imageStream = file.OpenReadStream(maxAllowedSize: maxBytes);
            using var imageMemory = new MemoryStream();
            await imageStream.CopyToAsync(imageMemory);
            var imageBytes = imageMemory.ToArray();
            var tempPath = await ChatAttachmentFiles.SaveTempAsync(file.Name, imageBytes);
            return new ChatAttachment(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "image" : file.ContentType,
                "Image attachment supplied as an image payload to the provider.",
                file.Size,
                Convert.ToBase64String(imageBytes),
                IsImage: true,
                LocalPath: tempPath);
        }

        if (!IsTextAttachment(file))
        {
            return new ChatAttachment(file.Name, file.ContentType, $"Binary attachment supplied: {file.Name} ({file.ContentType}, {file.Size} bytes).", file.Size);
        }

        var readBytes = Math.Min(file.Size, maxBytes);
        await using var stream = file.OpenReadStream(maxAllowedSize: Math.Max(readBytes, 1));
        using var reader = new StreamReader(stream);
        var buffer = new char[maxCharacters];
        var read = await reader.ReadBlockAsync(buffer, 0, buffer.Length);
        return new ChatAttachment(file.Name, file.ContentType, new string(buffer, 0, read), file.Size, IsTruncated: file.Size > readBytes || read == maxCharacters);
    }

    [JSInvokable]
    public async Task AttachClipboardImage(string name, string contentType, string base64Data, long size)
    {
        var maxBytes = Math.Clamp(Options.CurrentValue.Chat.MaxAttachmentBytes, 1024, 64L * 1024 * 1024);
        if (size > maxBytes)
        {
            Snackbar.Add($"Clipboard image is {FormatBytes(size)}, above the configured {FormatBytes(maxBytes)} attachment limit.", Severity.Warning);
            return;
        }

        byte[] imageBytes;
        try
        {
            imageBytes = Convert.FromBase64String(base64Data);
        }
        catch (FormatException)
        {
            Snackbar.Add("Clipboard image data could not be read.", Severity.Warning);
            return;
        }

        var tempPath = await ChatAttachmentFiles.SaveTempAsync(name, imageBytes);
        var attachment = new ChatAttachment(name, contentType, "Image attachment supplied as an image payload to the provider.", size == 0 ? imageBytes.Length : size, base64Data, IsImage: true, LocalPath: tempPath);
        _attachments.RemoveAll(item => string.Equals(item.Name, name, StringComparison.OrdinalIgnoreCase));
        _attachments.Add(attachment);
        PersistActiveDraft();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        _agentStatus = "Ready";
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsImageAttachment(IBrowserFile file) =>
        file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsTextAttachment(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);
        return file.ContentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase) ||
            extension is ".md" or ".txt" or ".json" or ".xml" or ".csv" or ".cs" or ".razor" or ".css" or ".js" or ".ts" or ".ps1";
    }

    private async Task RemoveAttachment(string name)
    {
        _attachments.RemoveAll(attachment => string.Equals(attachment.Name, name, StringComparison.OrdinalIgnoreCase));
        PersistActiveDraft();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        _agentStatus = "Ready";
    }

    private async Task SaveSessionsAsync()
    {
        if (!_hasLoadedSessions)
        {
            return;
        }

        PersistActiveDraft();

        var retained = _sessions
            .Where(session => session.Id == _activeSessionId || session.Turns.Count > 0 || !string.IsNullOrWhiteSpace(session.Draft) || session.PendingAttachments.Count > 0)
            .OrderByDescending(session => session.UpdatedUtc)
            .Take(30)
            .ToList();
        _sessions.Clear();
        _sessions.AddRange(retained);
        var stored = await JS.InvokeAsync<bool>("memorySmith.storage.setJson", ChatStorageKey, _sessions);
        if (!stored && !_storageWarningShown)
        {
            _storageWarningShown = true;
            Snackbar.Add("Chat history was too large to persist in browser storage. Current in-page draft is still retained.", Severity.Warning);
        }
    }

    private async Task SavePreferencesAsync()
    {
        if (!_hasLoadedSessions)
        {
            return;
        }

        await JS.InvokeVoidAsync("memorySmith.storage.setJson", ChatPreferencesStorageKey, new ChatPreferencesState
        {
            Provider = _selectedProvider,
            Model = _selectedModel,
            Mode = _mode.ToString(),
            ActiveSessionId = _activeSessionId
        });
    }

    private void PersistActiveDraft()
    {
        if (_sessions.FirstOrDefault(session => session.Id == _activeSessionId) is not { } session)
        {
            return;
        }

        session.Draft = _draft;
        session.PendingAttachments = _attachments.Select(ToStoredAttachment).ToList();
        if (HasPendingDraft)
        {
            session.UpdatedUtc = DateTimeOffset.UtcNow;
        }
    }

    private void RestoreSessionDraft(ChatSessionState session)
    {
        _draft = session.Draft ?? string.Empty;
        _attachments.Clear();
        _attachments.AddRange(session.PendingAttachments ?? []);
    }

    private async Task ConfirmInternalNavigation(LocationChangingContext context)
    {
        PersistActiveDraft();
        await SaveSessionsAsync();
        await SavePreferencesAsync();
        if (HasPendingDraft && !await JS.InvokeAsync<bool>("confirm", "Leave chat with an unsent draft or queued attachment?"))
        {
            context.PreventNavigation();
        }
    }

    private string SessionButtonClass(ChatSessionState session) =>
        string.Equals(session.Id, _activeSessionId, StringComparison.Ordinal)
            ? "chat-history-item is-selected"
            : "chat-history-item";

    private Variant ModeButtonVariant(MemoryChatMode mode) => _mode == mode ? Variant.Filled : Variant.Outlined;

    private Color ModeButtonColor(MemoryChatMode mode) => _mode == mode ? Color.Primary : Color.Default;

    private string ModeButtonClass(MemoryChatMode mode) =>
        _mode == mode ? "chat-mode-button is-selected" : "chat-mode-button";

    private static string ThinkingClass(ChatTurnState turn) =>
        turn.ThinkingActive ? "chat-thinking is-active" : "chat-thinking";

    private static string FormatTurnModel(ChatTurnState turn) =>
        string.IsNullOrWhiteSpace(turn.ProviderName) ? turn.Model ?? string.Empty : $"{turn.ProviderName} / {turn.Model}";

    private ChatUsageSummary? SelectedModelUsage()
    {
        var model = _models.FirstOrDefault(item => string.Equals(item.Name, _selectedModel, StringComparison.OrdinalIgnoreCase));
        if (model is null || (model.ContextWindowTokens is null && string.IsNullOrWhiteSpace(model.RateLimit)))
        {
            return null;
        }

        return new ChatUsageSummary(0, 0, ContextWindowTokens: model.ContextWindowTokens, RateLimit: model.RateLimit);
    }

    private static string FormatUsageMeter(ChatUsageSummary? usage)
    {
        if (usage is null)
        {
            return "Context: pending";
        }

        var contextTokens = usage.ContextTokens ?? usage.InputTokens;
        var estimated = usage.IsEstimate && contextTokens > 0 ? "~" : string.Empty;
        var text = contextTokens > 0 ? $"Context {estimated}{FormatTokenCount(contextTokens)}" : "Context";
        if (usage.ContextWindowTokens is > 0)
        {
            text += $" / {FormatTokenCount(usage.ContextWindowTokens.Value)}";
            if (contextTokens > 0)
            {
                text += $" ({(double)contextTokens / usage.ContextWindowTokens.Value:P1})";
            }
        }

        if (usage.OutputTokens > 0)
        {
            text += $" · out {FormatTokenCount(usage.OutputTokens)}";
        }

        if (!string.IsNullOrWhiteSpace(usage.RateLimit))
        {
            text += $" · {usage.RateLimit}";
        }

        return text;
    }

    private static string FormatUsageTitle(ChatUsageSummary? usage)
    {
        if (usage is null)
        {
            return "Context usage is estimated after the next request starts.";
        }

        var contextTokens = usage.ContextTokens ?? usage.InputTokens;
        var source = usage.IsEstimate ? "Estimated" : "Provider-reported";
        var text = $"{source} context tokens: {contextTokens:N0}; input tokens: {usage.InputTokens:N0}; output tokens: {usage.OutputTokens:N0}";
        if (usage.ContextWindowTokens is > 0)
        {
            text += $"; context window: {usage.ContextWindowTokens.Value:N0}";
        }

        if (!string.IsNullOrWhiteSpace(usage.RateLimit))
        {
            text += $"; rate/quota: {usage.RateLimit}";
        }

        return text;
    }

    private static string FormatTokenCount(int value) =>
        value >= 1_000_000 ? $"{value / 1_000_000.0:0.#}M" :
        value >= 1_000 ? $"{value / 1_000.0:0.#}K" :
        value.ToString();

    private static string BuildSessionTitle(ChatSessionState session, string message)
    {
        if (!string.Equals(session.Title, "New chat", StringComparison.Ordinal))
        {
            return session.Title;
        }

        return message.Length <= 44 ? message : message[..44] + "...";
    }

    private static string ContextHref(ChatContextItem item) =>
        string.Equals(item.Kind, "page", StringComparison.OrdinalIgnoreCase)
            ? PageHref(item.Id)
            : MemoryHref(item.Id);

    private static string PageHref(string slug) =>
        "/pages/" + string.Join('/', slug.Split('/', StringSplitOptions.RemoveEmptyEntries).Select(Uri.EscapeDataString));

    private static string MemoryHref(string id) =>
        "/api/memories/" + Uri.EscapeDataString(id);

    private IChatProvider ResolveProvider(string providerName)
    {
        var provider = ChatProviders.FirstOrDefault(candidate => ProviderMatches(candidate.Name, providerName));
        return provider ?? ChatProviders.First();
    }

    private string DefaultModelForProvider(string providerName)
    {
        var chatOptions = Options.CurrentValue.Chat;
        return ProviderMatches(providerName, "GitHub") ? chatOptions.GitHubModel : chatOptions.OllamaModel;
    }

    private static bool ProviderMatches(string left, string right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(left, "GitHub", StringComparison.OrdinalIgnoreCase) && string.Equals(right, "Copilot", StringComparison.OrdinalIgnoreCase));

    private static string FormatModelLabel(ChatModelSummary model)
    {
        var preferred = model.IsPreferred ? " *" : string.Empty;
        var multiplier = model.ChatMultiplier is null ? string.Empty : model.ChatMultiplier <= 0 ? " free" : $" x{model.ChatMultiplier:0.##}";
        return $"{model.Name}{preferred}{multiplier}";
    }

    private static ChatAttachment ToDisplayAttachment(ChatAttachment attachment) =>
        attachment with
        {
            Text = attachment.IsImage ? string.Empty : string.Empty,
            Base64Data = null,
            LocalPath = null
        };

    private static ChatAttachment ToStoredAttachment(ChatAttachment attachment) =>
        attachment.IsImage && !string.IsNullOrWhiteSpace(attachment.LocalPath)
            ? attachment with { Base64Data = null }
            : attachment;

    private static string AttachmentTitle(ChatAttachment attachment)
    {
        var truncated = attachment.IsTruncated ? ", truncated" : string.Empty;
        var kind = attachment.IsImage ? "image" : attachment.ContentType;
        return $"{kind}, {FormatBytes(attachment.Size)}{truncated}";
    }

    private static string AttachmentDataUrl(ChatAttachment attachment) =>
        $"{(attachment.ContentType.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ? attachment.ContentType : $"data:{attachment.ContentType};base64")},{attachment.Base64Data}";

    private static string FormatBytes(long value)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        var size = (double)value;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.#} {units[unit]}";
    }

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalMinutes >= 1 ? $"{duration.TotalMinutes:0.0}m" : $"{duration.TotalSeconds:0.0}s";

    private void StartResponseTimer()
    {
        StopResponseTimer();
        _responseTimerCts = new CancellationTokenSource();
        _ = RunResponseTimerAsync(_responseTimerCts.Token);
    }

    private void StopResponseTimer()
    {
        _responseTimerCts?.Cancel();
        _responseTimerCts?.Dispose();
        _responseTimerCts = null;
        if (_responseStartedUtc is not null)
        {
            _responseElapsed = DateTimeOffset.UtcNow - _responseStartedUtc.Value;
        }
    }

    private async Task RunResponseTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_responseStartedUtc is not null)
                {
                    _responseElapsed = DateTimeOffset.UtcNow - _responseStartedUtc.Value;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = null;
        StopResponseTimer();
        if (_composerRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("memorySmith.chat.unregisterComposer", _composerInput);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }

    private sealed class ChatPreferencesState
    {
        public string Provider { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public string Mode { get; set; } = string.Empty;
        public string? ActiveSessionId { get; set; }
    }

    private sealed class ChatSessionState
    {
        public string Id { get; set; } = string.Empty;
        public string Title { get; set; } = "New chat";
        public DateTimeOffset CreatedUtc { get; set; }
        public DateTimeOffset UpdatedUtc { get; set; }
        public string Draft { get; set; } = string.Empty;
        public List<ChatAttachment> PendingAttachments { get; set; } = [];
        public List<ChatTurnState> Turns { get; set; } = [];
        public List<ChatMessage> History { get; set; } = [];
    }

    private sealed class ChatTurnState
    {
        public ChatTurnState()
        {
        }

        public ChatTurnState(
            string role,
            string content,
            DateTimeOffset createdUtc,
            string? thinking,
            List<ChatContextItem> context,
            List<string> writtenMemories,
            List<string> writtenPages,
            List<ChatAttachment> attachments)
        {
            Role = role;
            Content = content;
            CreatedUtc = createdUtc;
            Thinking = thinking;
            Context = context;
            WrittenMemories = writtenMemories;
            WrittenPages = writtenPages;
            Attachments = attachments;
        }

        public string Role { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTimeOffset CreatedUtc { get; set; }
        public string? Thinking { get; set; }
        public List<ChatContextItem> Context { get; set; } = [];
        public List<string> WrittenMemories { get; set; } = [];
        public List<string> WrittenPages { get; set; } = [];
        public List<ChatAttachment> Attachments { get; set; } = [];
        public string? ProviderName { get; set; }
        public string? Model { get; set; }
        public ChatUsageSummary? Usage { get; set; }
        public long? DurationMilliseconds { get; set; }
        public bool ThinkingActive { get; set; }
    }
}