@page "/chat"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Nodes
@using MemorySmith.Core.Models
@using Microsoft.Extensions.Options
@inject IChatAgent ChatAgent
@inject ChatToolCatalog ToolCatalog
@inject MemoryApplicationService Memories
@inject IPageService Pages
@inject IEnumerable<IChatProvider> ChatProviders
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Chat</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasPendingDraft" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<div class="@ChatWorkbenchClass">
    <aside class="@HistorySidebarClass" aria-label="Chat history">
        <div class="chat-history-header">
            <MudText Typo="Typo.subtitle2">History</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Success" OnClick="StartNewChatAsync" aria-label="New chat" />
        </div>

        @if (_historyOpen)
        {
            <div class="chat-history-list">
                @foreach (var session in _sessions)
                {
                    <div class="@SessionButtonClass(session)">
                        <button type="button" class="chat-history-select" @onclick="@(() => SelectSessionAsync(session.Id))">
                            <span>@session.Title</span>
                            <small>@session.UpdatedUtc.ToLocalTime().ToString("M/d HH:mm")</small>
                        </button>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@_isSending" OnClick="@(() => DeleteSessionAsync(session.Id))" aria-label="Delete chat" />
                    </div>
                }
            </div>
        }
    </aside>

    <section class="chat-shell" aria-label="MemorySmith chat">
        <div class="chat-toolbar">
            <MudIconButton Icon="@(_historyOpen ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.Menu)" Size="Size.Small" OnClick="ToggleHistory" aria-label="Toggle history" />
            <MudButton Variant="@(_tracePanelOpen ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Menu" OnClick="ToggleTracePanel">Trace</MudButton>

            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="chat-mode-toggle">
                <MudButton Variant="@ModeButtonVariant(MemoryChatMode.Chat)" Color="@ModeButtonColor(MemoryChatMode.Chat)" Class="@ModeButtonClass(MemoryChatMode.Chat)" OnClick="@(() => SetModeAsync(MemoryChatMode.Chat))">Chat</MudButton>
                <MudButton Variant="@ModeButtonVariant(MemoryChatMode.Agent)" Color="@ModeButtonColor(MemoryChatMode.Agent)" Class="@ModeButtonClass(MemoryChatMode.Agent)" OnClick="@(() => SetModeAsync(MemoryChatMode.Agent))">Agent</MudButton>
            </MudButtonGroup>

            <div class="chat-model-controls">
                <MudSelect T="string" Value="_selectedProvider" ValueChanged="OnProviderChanged" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="chat-provider-select">
                    @foreach (var provider in _availableProviders)
                    {
                        <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_selectedModel" ValueChanged="OnModelChanged" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="chat-model-select">
                    @if (_models.Count == 0 && !string.IsNullOrWhiteSpace(_selectedModel))
                    {
                        <MudSelectItem T="string" Value="@_selectedModel">@_selectedModel</MudSelectItem>
                    }
                    @foreach (var model in _models)
                    {
                        <MudSelectItem T="string" Value="@model.Name">@FormatModelLabel(model)</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" Disabled="@_isLoadingModels" OnClick="RefreshModelsAsync" aria-label="Refresh models" />
            </div>
        </div>

        <div class="chat-status-strip">
            <span>@_agentStatus</span>
            @if (!string.IsNullOrWhiteSpace(_modelError))
            {
                <span class="chat-status-error">@_modelError</span>
            }
            @if (_attachments.Count > 0)
            {
                <span>@_attachments.Count attachment(s) queued</span>
            }
            @if (_isSending)
            {
                <span>@FormatDuration(_responseElapsed) elapsed</span>
                <span>@_streamedCharacters chars</span>
            }
        </div>
        @if (_isSending)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <div class="chat-transcript" @ref="_transcriptPane">
            @if (ActiveSession.Turns.Count == 0)
            {
                <div class="wiki-empty-state">No messages yet.</div>
            }
            else
            {
                @foreach (var turn in ActiveSession.Turns)
                {
                    <article class="chat-message @turn.Role">
                        <div class="chat-message-topline">
                            <span class="chat-message-role">@turn.Role</span>
                            <span class="chat-message-meta">
                                @if (TurnHasInspectableState(turn))
                                {
                                    <button type="button" class="chat-trace-open-button" @onclick="@(() => SelectTraceTurn(turn.Id))">Trace</button>
                                }
                                @if (!string.IsNullOrWhiteSpace(turn.Model))
                                {
                                    <span class="chat-message-model">@FormatTurnModel(turn)</span>
                                }
                                <span>@turn.CreatedUtc.ToLocalTime().ToString("HH:mm")@if (turn.DurationMilliseconds is not null) { <span> · @FormatDuration(TimeSpan.FromMilliseconds(turn.DurationMilliseconds.Value))</span> }</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(turn.Thinking))
                        {
                            <details class="@ThinkingClass(turn)" open="@turn.ThinkingActive">
                                <summary>Thinking<span class="chat-thinking-activity" aria-hidden="true"></span></summary>
                                <pre>@turn.Thinking</pre>
                            </details>
                        }
                        @if (turn.TraceEntries.Count > 0)
                        {
                            <details class="@TraceDrawerClass(turn)" open="@turn.TraceDrawerOpen">
                                <summary>Trace (@turn.TraceEntries.Count)</summary>
                                <div class="chat-trace-list">
                                    @foreach (var entry in turn.TraceEntries)
                                    {
                                        <section class="@TraceEntryClass(entry)">
                                            <header class="chat-trace-header">
                                                <span>@entry.Title</span>
                                                <small>@entry.CreatedUtc.ToLocalTime().ToString("HH:mm:ss")</small>
                                            </header>
                                            <pre>@entry.Content</pre>
                                        </section>
                                    }
                                </div>
                            </details>
                        }
                        <div class="chat-message-body">@turn.Content</div>

                        @if (turn.Attachments.Count > 0)
                        {
                            <div class="chat-context-list">
                                @foreach (var attachment in turn.Attachments)
                                {
                                    <span class="wiki-tag" title="@AttachmentTitle(attachment)">file:@attachment.Name</span>
                                }
                            </div>
                        }

                        @if (turn.Context.Count > 0 || turn.WrittenMemories.Count > 0 || turn.WrittenPages.Count > 0)
                        {
                            <div class="chat-context-list">
                                @foreach (var item in turn.Context)
                                {
                                    <a class="@ContextResourceClass(item)" href="@ContextHref(item)" target="_blank" rel="noopener noreferrer" title="@item.Snippet">@item.Kind:@item.Title</a>
                                }
                                @foreach (var id in turn.WrittenMemories)
                                {
                                    <a class="wiki-status is-working chat-resource" href="@MemoryHref(id)" target="_blank" rel="noopener noreferrer">memory:@id</a>
                                }
                                @foreach (var slug in turn.WrittenPages)
                                {
                                    <a class="wiki-status is-core chat-resource" href="@PageHref(slug)" target="_blank" rel="noopener noreferrer">page:@slug</a>
                                }
                            </div>
                        }
                    </article>
                }
            }
        </div>

        <div class="chat-attachment-row">
            <InputFile id="chat-file-input" OnChange="OnFilesSelectedAsync" multiple class="chat-file-input" />
            @foreach (var attachment in _attachments)
            {
                <span class="wiki-tag chat-attachment-chip" title="@AttachmentTitle(attachment)">
                    @if (attachment.IsImage && !string.IsNullOrWhiteSpace(attachment.Base64Data))
                    {
                        <img class="chat-attachment-thumb" src="@AttachmentDataUrl(attachment)" alt="" />
                    }
                    <span class="chat-attachment-name">@attachment.Name</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" Class="chat-attachment-remove" OnClick="@(() => RemoveAttachment(attachment.Name))" aria-label="Remove attachment" title="Remove attachment" />
                </span>
            }
        </div>

        <div class="chat-composer">
            <textarea @ref="_composerInput"
                      class="chat-composer-input"
                      aria-label="Message"
                      placeholder="Message"
                      value="@_draft"
                      @oninput="OnDraftInput"></textarea>
            <div class="chat-composer-side">
                <div class="chat-usage-meter" title="@FormatUsageTitle(ActiveUsage)" aria-live="polite">@FormatUsageMeter(ActiveUsage)</div>
                <div class="chat-composer-actions">
                    <MudCheckBox T="bool" Value="_sendOnEnter" ValueChanged="SetSendOnEnterAsync" Label="Send on Enter" Size="Size.Small" />
                    <MudTooltip Text="Finish current step">
                        <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small" Color="Color.Warning" Class="chat-composer-icon" Disabled="@(!_isSending || _activeRunControl?.StopAfterCurrentStepRequested == true)" OnClick="StopAfterCurrentStepAsync" aria-label="Finish current step" />
                    </MudTooltip>
                    <MudTooltip Text="Stop generation">
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Error" Class="chat-composer-icon" Disabled="@(!_isSending)" OnClick="StopGeneratingAsync" aria-label="Stop generation" />
                    </MudTooltip>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@_isSending" OnClick="SendAsync">Send</MudButton>
                </div>
            </div>
        </div>
    </section>

    @if (_tracePanelOpen)
    {
        <aside class="chat-trace-panel" aria-label="Chat trace panel">
            <div class="chat-trace-panel-header">
                <div>
                    <h2>Trace</h2>
                    <span>@TracePanelSubtitle</span>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" OnClick="ToggleTracePanel" aria-label="Close trace panel" />
            </div>

            @if (SelectedTraceTurn is null)
            {
                <div class="wiki-empty-state">Select a chat turn to inspect its execution.</div>
            }
            else
            {
                var selectedTurn = SelectedTraceTurn;
                <div class="chat-trace-filters">
                    <MudCheckBox T="bool" Value="_traceShowReasoning" ValueChanged="@(value => _traceShowReasoning = value)" Label="Reasoning" Size="Size.Small" />
                    <MudCheckBox T="bool" Value="_traceShowTools" ValueChanged="@(value => _traceShowTools = value)" Label="Tools" Size="Size.Small" />
                    <MudCheckBox T="bool" Value="_traceShowAssistant" ValueChanged="@(value => _traceShowAssistant = value)" Label="Answer" Size="Size.Small" />
                    <MudCheckBox T="bool" Value="_traceShowSystem" ValueChanged="@(value => _traceShowSystem = value)" Label="System" Size="Size.Small" />
                    <MudCheckBox T="bool" Value="_traceErrorsOnly" ValueChanged="@(value => _traceErrorsOnly = value)" Label="Errors" Size="Size.Small" />
                </div>

                <div class="chat-trace-graph" aria-label="Turn graph">
                    @foreach (var node in BuildTraceGraph(selectedTurn, FilteredTraceEntries(selectedTurn)))
                    {
                        <span class="@node.ClassName">@node.Label</span>
                    }
                </div>

                @if (selectedTurn.ProposedMemoryWrites.Count > 0 || selectedTurn.ProposedPageWrites.Count > 0)
                {
                    <section class="chat-approval-panel">
                        <header>
                            <span>Pending writes</span>
                            <button type="button" @onclick="@(() => ApproveAllWritesAsync(selectedTurn.Id))">Approve all</button>
                        </header>
                        @foreach (var proposal in selectedTurn.ProposedMemoryWrites)
                        {
                            <div class="chat-approval-item">
                                <strong>memory:@proposal.Id</strong>
                                <span>@proposal.Title</span>
                                <div>
                                    <button type="button" @onclick="@(() => ApproveMemoryWriteAsync(selectedTurn.Id, proposal.Id))">Approve</button>
                                    <button type="button" @onclick="@(() => RejectMemoryWriteAsync(selectedTurn.Id, proposal.Id))">Reject</button>
                                </div>
                            </div>
                        }
                        @foreach (var proposal in selectedTurn.ProposedPageWrites)
                        {
                            <div class="chat-approval-item">
                                <strong>page:@proposal.Slug</strong>
                                <span>@proposal.Title</span>
                                <div>
                                    <button type="button" @onclick="@(() => ApprovePageWriteAsync(selectedTurn.Id, proposal.Slug))">Approve</button>
                                    <button type="button" @onclick="@(() => RejectPageWriteAsync(selectedTurn.Id, proposal.Slug))">Reject</button>
                                </div>
                            </div>
                        }
                    </section>
                }

                <div class="chat-trace-panel-list">
                    @foreach (var entry in FilteredTraceEntries(selectedTurn))
                    {
                        <details class="@TraceEntryClass(entry)" open="@ShouldOpenTraceEntry(entry)">
                            <summary class="chat-trace-header">
                                <span>@entry.Title</span>
                                <small>@FormatTraceMeta(entry)</small>
                            </summary>
                            <pre>@entry.Content</pre>
                            @if (CanRerunTool(entry))
                            {
                                <div class="chat-tool-rerun">
                                    <textarea aria-label="Tool arguments" value="@entry.ToolArgumentsDraft" @oninput="@(args => UpdateToolArgumentsDraft(entry, args.Value?.ToString() ?? string.Empty))"></textarea>
                                    <button type="button" disabled="@_isRerunningTool" @onclick="@(() => RerunToolAsync(selectedTurn.Id, entry.Id))">Run Tool</button>
                                </div>
                            }
                        </details>
                    }
                </div>
            }
        </aside>
    }
</div>

@code {
    private const string ChatStorageKey = "memorysmith.chat.sessions.v1";
    private const string ChatPreferencesStorageKey = "memorysmith.chat.preferences.v1";
    private const int MaxStoredChatSessions = 30;
    private const int MaxCompactStoredChatSessions = 12;
    private const int MaxStoredHistoryMessages = 40;
    private const int MaxStoredTurnCharacters = 16000;
    private const int MaxStoredThinkingCharacters = 6000;
    private const int MaxStoredContextSnippetCharacters = 600;
    private const int MaxStoredTraceEntries = 80;
    private const int MaxStoredTraceCharacters = 3000;
    private const int MaxStoredAttachmentTextCharacters = 6000;
    private const int MaxStoredAttachmentImageCharacters = 12000;
    private static readonly JsonSerializerOptions StorageJsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };
    private readonly List<ChatSessionState> _sessions = [];
    private readonly List<ChatModelSummary> _models = [];
    private readonly List<string> _availableProviders = [];
    private readonly List<ChatAttachment> _attachments = [];
    private DotNetObjectReference<Chat>? _dotNetRef;
    private ElementReference _composerInput;
    private ElementReference _transcriptPane;
    private MemoryChatMode _mode = MemoryChatMode.Chat;
    private string _activeSessionId = string.Empty;
    private string _draft = string.Empty;
    private string _selectedProvider = "Ollama";
    private string _selectedModel = string.Empty;
    private string _agentStatus = "Ready";
    private string? _preferredActiveSessionId;
    private string? _modelError;
    private bool _historyOpen = true;
    private bool _sendOnEnter = true;
    private bool _isSending;
    private bool _isLoadingModels;
    private bool _hasLoadedSessions;
    private bool _sessionLoadFailed;
    private bool _composerRegistered;
    private bool _scrollPending;
    private bool _storageWarningShown;
    private bool _tracePanelOpen = true;
    private bool _traceShowReasoning = true;
    private bool _traceShowTools = true;
    private bool _traceShowAssistant = true;
    private bool _traceShowSystem = true;
    private bool _traceErrorsOnly;
    private bool _isRerunningTool;
    private string? _selectedTraceTurnId;
    private CancellationTokenSource? _responseTimerCts;
    private CancellationTokenSource? _sendCts;
    private ChatRunControl? _activeRunControl;
    private DateTimeOffset? _responseStartedUtc;
    private TimeSpan _responseElapsed = TimeSpan.Zero;
    private int _streamedCharacters;
    private ChatUsageSummary? _currentUsage;

    private ChatSessionState ActiveSession =>
        _sessions.FirstOrDefault(session => session.Id == _activeSessionId) ?? _sessions.First();

    private string HistorySidebarClass => _historyOpen ? "chat-history-pane" : "chat-history-pane is-collapsed";
    private string ChatWorkbenchClass => (_historyOpen, _tracePanelOpen) switch
    {
        (false, true) => "chat-workbench is-history-collapsed is-trace-open",
        (true, true) => "chat-workbench is-trace-open",
        (false, false) => "chat-workbench is-history-collapsed",
        _ => "chat-workbench"
    };
    private bool HasPendingDraft => !string.IsNullOrWhiteSpace(_draft) || _attachments.Count > 0;
    private ChatTurnState? SelectedTraceTurn =>
        ActiveSession.Turns.FirstOrDefault(turn => string.Equals(turn.Id, _selectedTraceTurnId, StringComparison.Ordinal))
        ?? ActiveSession.Turns.LastOrDefault(TurnHasInspectableState);
    private string TracePanelSubtitle => SelectedTraceTurn is { } turn
        ? $"{turn.Role} · {turn.CreatedUtc.ToLocalTime():HH:mm} · {turn.TraceEntries.Count} event(s)"
        : "No turn selected";
    private ChatUsageSummary? ActiveUsage =>
        _currentUsage
        ?? (_sessions.Count == 0 ? null : ActiveSession.Turns.LastOrDefault(turn => turn.Usage is not null)?.Usage)
        ?? SelectedModelUsage();

    protected override void OnInitialized()
    {
        var chatOptions = Options.CurrentValue.Chat;
        _availableProviders.Clear();
        _availableProviders.AddRange(ChatProviders.Select(provider => provider.Name).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(provider => provider));
        if (_availableProviders.Count == 0)
        {
            _availableProviders.Add(chatOptions.Provider);
        }

        _selectedProvider = _availableProviders.FirstOrDefault(provider => ProviderMatches(provider, chatOptions.Provider)) ?? _availableProviders[0];
        _selectedModel = DefaultModelForProvider(_selectedProvider);
        StartNewChat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("memorySmith.chat.registerComposer", _composerInput, _dotNetRef, _sendOnEnter);
            _composerRegistered = true;
            await LoadPreferencesAsync();
            await LoadSessionsAsync();
            await RefreshModelsAsync(silent: true);
            StateHasChanged();
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("memorySmith.chat.scrollToBottom", _transcriptPane);
        }
    }

    private async Task LoadPreferencesAsync()
    {
        var preferences = await LoadStorageJsonAsync<ChatPreferencesState>(ChatPreferencesStorageKey, warnOnFailure: false);
        if (preferences is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(preferences.Provider) && _availableProviders.Any(provider => ProviderMatches(provider, preferences.Provider)))
        {
            _selectedProvider = _availableProviders.First(provider => ProviderMatches(provider, preferences.Provider));
        }

        if (!string.IsNullOrWhiteSpace(preferences.Model))
        {
            _selectedModel = preferences.Model;
        }

        if (!string.IsNullOrWhiteSpace(preferences.Mode) && Enum.TryParse<MemoryChatMode>(preferences.Mode, ignoreCase: true, out var mode))
        {
            _mode = mode;
        }

        _preferredActiveSessionId = preferences.ActiveSessionId;
    }

    private async Task LoadSessionsAsync()
    {
        _sessionLoadFailed = false;
        var raw = await LoadStorageTextAsync(ChatStorageKey, warnOnFailure: true);
        var saved = string.IsNullOrWhiteSpace(raw) ? null : ParseStoredSessions(raw);
        if (_sessionLoadFailed)
        {
            _sessions.Clear();
            StartNewChat();
            _hasLoadedSessions = true;
            await SavePreferencesAsync();
            return;
        }

        _sessions.Clear();
        if (saved is not null)
        {
            _sessions.AddRange(saved.Where(session => !string.IsNullOrWhiteSpace(session.Id)));
        }

        if (_sessions.Count == 0)
        {
            StartNewChat();
        }
        else
        {
            var active = _sessions.FirstOrDefault(session => string.Equals(session.Id, _preferredActiveSessionId, StringComparison.Ordinal))
                ?? _sessions.OrderByDescending(session => session.UpdatedUtc).First();
            _activeSessionId = active.Id;
            RestoreSessionDraft(active);
            _currentUsage = null;
            _agentStatus = "Ready";
            _scrollPending = true;
        }

        _hasLoadedSessions = true;
        await SaveSessionsAsync();
        await SavePreferencesAsync();
    }

    private async Task<T?> LoadStorageJsonAsync<T>(string key, bool warnOnFailure)
    {
        var raw = await LoadStorageTextAsync(key, warnOnFailure);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return default;
        }

        try
        {
            return JsonSerializer.Deserialize<T>(raw, StorageJsonOptions);
        }
        catch (Exception)
        {
            MarkStorageLoadFailed(warnOnFailure);
            return default;
        }
    }

    private async Task<string?> LoadStorageTextAsync(string key, bool warnOnFailure)
    {
        try
        {
            return await JS.InvokeAsync<string?>("memorySmith.storage.getJsonString", key);
        }
        catch
        {
            MarkStorageLoadFailed(warnOnFailure);
            return default;
        }
    }

    private void MarkStorageLoadFailed(bool warnOnFailure)
    {
        if (!warnOnFailure)
        {
            return;
        }

        _sessionLoadFailed = true;
        Snackbar.Add("Saved chat history could not be read. A fresh local chat session was started without overwriting existing browser storage.", Severity.Warning);
    }

    private List<ChatSessionState>? ParseStoredSessions(string raw)
    {
        try
        {
            if (JsonNode.Parse(raw) is not JsonArray array)
            {
                return null;
            }

            return array.OfType<JsonObject>()
                .Select(ParseStoredSession)
                .Where(session => session is not null)
                .Select(session => session!)
                .ToList();
        }
        catch (Exception)
        {
            MarkStorageLoadFailed(warnOnFailure: true);
            return default;
        }
    }

    private static ChatSessionState? ParseStoredSession(JsonObject item)
    {
        var id = ReadJsonString(item, "id");
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        var created = ReadJsonDateTimeOffset(item, "createdUtc", DateTimeOffset.UtcNow);
        return new ChatSessionState
        {
            Id = id,
            Title = ReadJsonString(item, "title") ?? "New chat",
            CreatedUtc = created,
            UpdatedUtc = ReadJsonDateTimeOffset(item, "updatedUtc", created),
            Draft = ReadJsonString(item, "draft") ?? string.Empty,
            PendingAttachments = ReadJsonObjects(item, "pendingAttachments").Select(ParseStoredAttachment).Where(attachment => attachment is not null).Select(attachment => attachment!).ToList(),
            Turns = ReadJsonObjects(item, "turns").Select(ParseStoredTurn).ToList(),
            History = ReadJsonObjects(item, "history").Select(ParseStoredMessage).Where(message => message is not null).Select(message => message!).ToList()
        };
    }

    private static ChatTurnState ParseStoredTurn(JsonObject item)
    {
        var created = ReadJsonDateTimeOffset(item, "createdUtc", DateTimeOffset.UtcNow);
        return new ChatTurnState
        {
            Id = ReadJsonString(item, "id") ?? Guid.NewGuid().ToString("N"),
            Role = ReadJsonString(item, "role") ?? string.Empty,
            Content = ReadJsonString(item, "content") ?? string.Empty,
            CreatedUtc = created,
            Thinking = ReadJsonString(item, "thinking"),
            Context = ReadJsonObjects(item, "context").Select(ParseStoredContextItem).ToList(),
            ProposedMemoryWrites = ReadJsonObjects(item, "proposedMemoryWrites").Select(ParseStoredMemoryWriteProposal).Where(proposal => proposal is not null).Select(proposal => proposal!).ToList(),
            ProposedPageWrites = ReadJsonObjects(item, "proposedPageWrites").Select(ParseStoredPageWriteProposal).Where(proposal => proposal is not null).Select(proposal => proposal!).ToList(),
            WrittenMemories = ReadJsonStrings(item, "writtenMemories"),
            WrittenPages = ReadJsonStrings(item, "writtenPages"),
            Attachments = ReadJsonObjects(item, "attachments").Select(ParseStoredAttachment).Where(attachment => attachment is not null).Select(attachment => attachment!).ToList(),
            ProviderName = ReadJsonString(item, "providerName"),
            Model = ReadJsonString(item, "model"),
            Usage = ParseStoredUsage(item),
            DurationMilliseconds = ReadJsonLong(item, "durationMilliseconds"),
            TraceEntries = ReadJsonObjects(item, "traceEntries").Select(ParseStoredTraceEntry).Where(entry => entry is not null).Select(entry => entry!).ToList(),
            TraceDrawerOpen = false,
            ThinkingActive = false
        };
    }

    private static ChatTraceEntryState? ParseStoredTraceEntry(JsonObject item)
    {
        var kind = ReadJsonString(item, "kind") ?? string.Empty;
        var title = ReadJsonString(item, "title") ?? string.Empty;
        var content = ReadJsonString(item, "content") ?? string.Empty;
        if (string.IsNullOrWhiteSpace(kind) || string.IsNullOrWhiteSpace(content))
        {
            return null;
        }

        return new ChatTraceEntryState
        {
            Kind = kind,
            Title = string.IsNullOrWhiteSpace(title) ? kind : title,
            Content = content,
            Id = ReadJsonString(item, "id") ?? Guid.NewGuid().ToString("N"),
            IsError = ReadJsonBool(item, "isError"),
            IsActive = false,
            CreatedUtc = ReadJsonDateTimeOffset(item, "createdUtc", DateTimeOffset.UtcNow),
            ToolName = ReadJsonString(item, "toolName"),
            ToolArgumentsJson = ReadJsonString(item, "toolArgumentsJson"),
            ToolArgumentsDraft = ReadJsonString(item, "toolArgumentsJson") ?? string.Empty,
            DurationMilliseconds = ReadJsonLong(item, "durationMilliseconds"),
            EstimatedTokens = ReadJsonInt(item, "estimatedTokens")
        };
    }

    private static AgentMemoryWriteProposal? ParseStoredMemoryWriteProposal(JsonObject item)
    {
        var id = ReadJsonString(item, "id");
        var content = ReadJsonString(item, "content");
        if (string.IsNullOrWhiteSpace(id) || string.IsNullOrWhiteSpace(content))
        {
            return null;
        }

        return new AgentMemoryWriteProposal(
            id,
            ReadJsonString(item, "title") ?? id,
            content,
            ReadJsonStrings(item, "tags"),
            Enum.TryParse<MemoryStatus>(ReadJsonString(item, "status"), ignoreCase: true, out var status) ? status : MemoryStatus.Working,
            ReadJsonDouble(item, "confidence") ?? 0.7);
    }

    private static AgentPageWriteProposal? ParseStoredPageWriteProposal(JsonObject item)
    {
        var markdown = ReadJsonString(item, "markdown");
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return null;
        }

        var slug = ReadJsonString(item, "slug") ?? string.Empty;
        return new AgentPageWriteProposal(slug, ReadJsonString(item, "title") ?? slug, markdown);
    }

    private static ChatMessage? ParseStoredMessage(JsonObject item)
    {
        var role = ReadJsonString(item, "role");
        var content = ReadJsonString(item, "content");
        return string.IsNullOrWhiteSpace(role) || content is null ? null : new ChatMessage(role, content);
    }

    private static ChatContextItem ParseStoredContextItem(JsonObject item) =>
        new(
            ReadJsonString(item, "kind") ?? string.Empty,
            ReadJsonString(item, "id") ?? string.Empty,
            ReadJsonString(item, "title") ?? string.Empty,
            ReadJsonString(item, "snippet") ?? string.Empty,
            ReadJsonString(item, "origin") ?? ChatContextOrigins.Preloaded);

    private static ChatAttachment? ParseStoredAttachment(JsonObject item)
    {
        var name = ReadJsonString(item, "name");
        return string.IsNullOrWhiteSpace(name)
            ? null
            : new ChatAttachment(
                name,
                ReadJsonString(item, "contentType") ?? string.Empty,
                ReadJsonString(item, "text") ?? string.Empty,
                ReadJsonLong(item, "size") ?? 0,
                ReadJsonString(item, "base64Data"),
                ReadJsonBool(item, "isImage"),
                ReadJsonBool(item, "isTruncated"),
                ReadJsonString(item, "localPath"));
    }

    private static ChatUsageSummary? ParseStoredUsage(JsonObject item)
    {
        if (GetJsonObject(item, "usage") is not { } usage)
        {
            return null;
        }

        return new ChatUsageSummary(
            ReadJsonInt(usage, "inputTokens") ?? 0,
            ReadJsonInt(usage, "outputTokens") ?? 0,
            ReadJsonInt(usage, "contextTokens"),
            ReadJsonInt(usage, "contextWindowTokens"),
            ReadJsonString(usage, "rateLimit"),
            ReadJsonBool(usage, "isEstimate", defaultValue: true));
    }

    private static IEnumerable<JsonObject> ReadJsonObjects(JsonObject item, string name) =>
        GetJsonArray(item, name)?.OfType<JsonObject>() ?? [];

    private static List<string> ReadJsonStrings(JsonObject item, string name) =>
        GetJsonArray(item, name)?.OfType<JsonValue>()
            .Select(value => value.TryGetValue<string>(out var text) ? text : string.Empty)
            .Where(text => !string.IsNullOrWhiteSpace(text))
            .ToList() ?? [];

    private static JsonArray? GetJsonArray(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) ? node as JsonArray : null;

    private static JsonObject? GetJsonObject(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) ? node as JsonObject : null;

    private static string? ReadJsonString(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<string>(out var text)
            ? text
            : null;

    private static int? ReadJsonInt(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<int>(out var number)
            ? number
            : null;

    private static long? ReadJsonLong(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<long>(out var number)
            ? number
            : null;

    private static double? ReadJsonDouble(JsonObject item, string name) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<double>(out var number)
            ? number
            : null;

    private static bool ReadJsonBool(JsonObject item, string name, bool defaultValue = false) =>
        item.TryGetPropertyValue(name, out var node) && node is JsonValue value && value.TryGetValue<bool>(out var flag)
            ? flag
            : defaultValue;

    private static DateTimeOffset ReadJsonDateTimeOffset(JsonObject item, string name, DateTimeOffset fallback) =>
        DateTimeOffset.TryParse(ReadJsonString(item, name), out var value) ? value : fallback;

