        lines.AddRange(turn.ProposedPageWrites.Select(proposal => $"- page:{proposal.Slug} - {proposal.Title}"));
        return lines.Count == 0 ? "No writes pending." : string.Join(Environment.NewLine, lines);
    }

    private static string FormatAppliedWriteSummary(AgentWriteApplyResult result)
    {
        var lines = new List<string>();
        lines.AddRange(result.WrittenMemories.Select(id => $"- memory:{id}"));
        lines.AddRange(result.WrittenPages.Select(slug => $"- page:{slug}"));
        return lines.Count == 0 ? "No writes were applied." : string.Join(Environment.NewLine, lines);
    }

    private static string FormatSubmittedProposalSummary(AgentWriteApplyResult result)
    {
        var lines = result.SubmittedProposalIds?.Select(id => $"- proposal:{id}").ToList() ?? [];
        if (!string.IsNullOrWhiteSpace(result.BatchId) || !string.IsNullOrWhiteSpace(result.ParentProposalId) || result.Attempt > 1)
        {
            lines.Add($"- lineage: batchId={LineageValue(result.BatchId)}; parentProposalId={LineageValue(result.ParentProposalId)}; attempt={Math.Max(result.Attempt, 1)}");
        }

        return lines.Count == 0 ? "No proposals were submitted." : string.Join(Environment.NewLine, lines);
    }

    private static string LineageValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private MarkupString RenderTurnContent(ChatTurnState turn)
    {
        var isStreamingTurn = _isSending && ReferenceEquals(turn, ActiveSession.Turns.LastOrDefault());
        if (!isStreamingTurn)
        {
            var cacheKey = $"{turn.Id}\n{turn.Content}";
            if (_turnRenderCache.TryGetValue(cacheKey, out var cached))
            {
                return cached;
            }

            var rendered = RenderTurnContentCore(turn);
            if (_turnRenderCache.Count >= MaxTurnRenderCacheEntries)
            {
                _turnRenderCache.Clear();
            }

            _turnRenderCache[cacheKey] = rendered;
            return rendered;
        }

        return RenderTurnContentCore(turn);
    }

    private static MarkupString RenderTurnContentCore(ChatTurnState turn)
    {
        var html = ChatMarkdownRenderer.RenderHtml(turn.Content);
        var allowedPages = BuildPageAliasMap(turn).Values
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var allowedMemories = BuildAllowedMemoryIds(turn);

        html = ChatReferenceLinkPolicy.LinkifyInlineCodeReferences(html, allowedPages, allowedMemories);
        html = ChatReferenceLinkPolicy.FilterToAllowedTargets(html, allowedPages, allowedMemories);

        return new MarkupString(html);
    }

    private static Dictionary<string, string> BuildPageAliasMap(ChatTurnState turn)
    {
        var aliases = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in turn.Context.Where(item => string.Equals(item.Kind, "page", StringComparison.OrdinalIgnoreCase)))
        {
            AddPageAliases(item.Id, aliases);
        }

        foreach (var slug in turn.WrittenPages)
        {
            AddPageAliases(slug, aliases);
        }

        return aliases;
    }

    private static IReadOnlyCollection<string> BuildAllowedMemoryIds(ChatTurnState turn)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in turn.Context.Where(item => string.Equals(item.Kind, "memory", StringComparison.OrdinalIgnoreCase)))
        {
            var id = item.Id?.Trim();
            if (!string.IsNullOrWhiteSpace(id))
            {
                ids.Add(id);
            }
        }

        foreach (var id in turn.WrittenMemories)
        {
            if (!string.IsNullOrWhiteSpace(id))
            {
                ids.Add(id.Trim());
            }
        }

        return ids;
    }

    private static void AddPageAliases(string value, IDictionary<string, string> aliases)
    {
        if (!TryNormalizePageSlug(value, out var slug))
        {
            return;
        }

        aliases[slug] = slug;
        aliases[$"{slug}.md"] = slug;
        aliases[$"page:{slug}"] = slug;
        aliases[$"page:{slug}.md"] = slug;
    }

    private static bool TryNormalizePageSlug(string value, out string slug)
    {
        slug = string.Empty;
        var candidate = value.Trim();
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return false;
        }

        if (candidate.StartsWith("page:", StringComparison.OrdinalIgnoreCase))
        {
            candidate = candidate[5..];
        }

        candidate = candidate.TrimStart('/');
        if (candidate.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            candidate = candidate[..^3];
        }

        if (string.IsNullOrWhiteSpace(candidate) || candidate.Contains('\\') || candidate.Contains(':'))
        {
            return false;
        }

        if (!PageSlugPattern.IsMatch(candidate))
        {
            return false;
        }

        slug = candidate.ToLowerInvariant();
        return true;
    }

    private static readonly Regex PageSlugPattern = new("^[a-z0-9][a-z0-9/_-]*$", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant | RegexOptions.Compiled);

    private static int EstimateTraceTokens(string? value) =>
        string.IsNullOrWhiteSpace(value) ? 0 : Math.Max(1, (int)Math.Ceiling(value.Length / 4.0));

    private static void AppendTraceDelta(ChatTurnState turn, string kind, string title, string delta)
    {
        if (string.IsNullOrEmpty(delta))
        {
            return;
        }

        if (turn.TraceEntries.LastOrDefault() is { } last &&
            string.Equals(last.Kind, kind, StringComparison.OrdinalIgnoreCase) &&
            !last.IsError)
        {
            last.Content += delta;
            last.IsActive = true;
            last.EstimatedTokens = EstimateTraceTokens(last.Content);
            return;
        }

        FinalizeActiveTraceEntries(turn);
        turn.TraceEntries.Add(new ChatTraceEntryState
        {
            Kind = kind,
            Title = title,
            Content = delta,
            CreatedUtc = DateTimeOffset.UtcNow,
            IsActive = true,
            EstimatedTokens = EstimateTraceTokens(delta)
        });
    }

    private static void AppendTraceEvents(ChatTurnState turn, IReadOnlyList<ChatTraceEvent> events)
    {
        if (events.Count == 0)
        {
            return;
        }

        FinalizeActiveTraceEntries(turn);
        foreach (var traceEvent in events)
        {
            turn.TraceEntries.Add(new ChatTraceEntryState
            {
                Kind = string.IsNullOrWhiteSpace(traceEvent.Kind) ? ChatTraceKinds.System : traceEvent.Kind,
                Title = string.IsNullOrWhiteSpace(traceEvent.Title) ? "Trace event" : traceEvent.Title,
                Content = traceEvent.Content,
                IsError = traceEvent.IsError,
                CreatedUtc = traceEvent.TimestampUtc ?? DateTimeOffset.UtcNow,
                ToolName = traceEvent.ToolName,
                ToolArgumentsJson = traceEvent.ToolArgumentsJson,
                ToolArgumentsDraft = traceEvent.ToolArgumentsJson ?? string.Empty,
                DurationMilliseconds = traceEvent.DurationMilliseconds,
                EstimatedTokens = traceEvent.EstimatedTokens ?? EstimateTraceTokens(traceEvent.Content),
                IsActive = false
            });
        }
    }

    private static void FinalizeActiveTraceEntries(ChatTurnState turn)
    {
        foreach (var entry in turn.TraceEntries)
        {
            entry.IsActive = false;
        }
    }

