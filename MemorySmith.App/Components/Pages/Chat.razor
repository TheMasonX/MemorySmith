    private async Task<string> ApproveProposalWithOutcomeAsync(ChatTurnState turn, IReadOnlyList<AgentMemoryWriteProposal> memories, IReadOnlyList<AgentPageWriteProposal> pages, string proposalKey)
    {
        try
        {
            var result = await ChatAgent.ApplyAgentWritesAsync(memories, pages, CancellationToken.None);
            if (result.SubmittedProposalIds?.Count > 0)
            {
                turn.SubmittedProposalIds.AddRange(result.SubmittedProposalIds.Where(id => !turn.SubmittedProposalIds.Contains(id, StringComparer.OrdinalIgnoreCase)));
                RemoveAttemptedProposals(turn, memories, pages);
                AddTraceEntry(turn, ChatTraceKinds.Write, "Agent writes submitted for proposal review", FormatSubmittedProposalSummary(result), IsError: false);
                _agentStatus = $"Submitted {result.SubmittedProposalIds.Count} proposal(s) for review";
                return $"{proposalKey} -> accepted (submitted {string.Join(", ", result.SubmittedProposalIds)})";
            }

            turn.WrittenMemories.AddRange(result.WrittenMemories.Where(id => !turn.WrittenMemories.Contains(id, StringComparer.OrdinalIgnoreCase)));
            turn.WrittenPages.AddRange(result.WrittenPages.Where(slug => !turn.WrittenPages.Contains(slug, StringComparer.OrdinalIgnoreCase)));
            turn.ProposedMemoryWrites.RemoveAll(proposal => result.WrittenMemories.Contains(proposal.Id, StringComparer.OrdinalIgnoreCase));
            turn.ProposedPageWrites.RemoveAll(proposal => result.WrittenPages.Contains(proposal.Slug, StringComparer.OrdinalIgnoreCase));
            if (result.WrittenMemories.Count == 0 && result.WrittenPages.Count == 0)
            {
                RemoveAttemptedProposals(turn, memories, pages);
                AddTraceEntry(turn, ChatTraceKinds.Write, "Agent write rejected", $"{proposalKey} rejected: no file changes were needed.", IsError: false);
                _agentStatus = "No file changes were needed";
                return $"{proposalKey} -> rejected (no changes needed)";
            }

            AddTraceEntry(turn, ChatTraceKinds.Write, "Agent writes accepted", FormatAppliedWriteSummary(result), IsError: false);
            _agentStatus = $"Applied {result.WrittenMemories.Count + result.WrittenPages.Count} accepted write(s)";
            return $"{proposalKey} -> accepted";
        }
        catch (Exception ex)
        {
            // Blocked/failed approvals are terminal for this attempt; remove pending item and retain auditable trace.
            RemoveAttemptedProposals(turn, memories, pages);
            var outcome = IsBlockedApprovalException(ex) ? "blocked" : "failed";
            AddTraceEntry(turn, ChatTraceKinds.Write, $"Agent write {outcome}", $"{proposalKey} {outcome}: {ex.Message}", IsError: true);
            Snackbar.Add(ex.Message, Severity.Error);
            return $"{proposalKey} -> {outcome} ({ex.Message})";
        }
    }

    private async Task<string?> RespondProposalWithOutcomeAsync(ChatTurnState turn, IReadOnlyList<AgentMemoryWriteProposal> memories, IReadOnlyList<AgentPageWriteProposal> pages, string proposalKey)
    {
        if (!TryGetResponseComment(turn, out var comment))
        {
            return null;
        }

        try
        {
            var result = await ChatAgent.ApplyAgentWritesAsync(memories, pages, CancellationToken.None);
            if (result.SubmittedProposalIds?.Count > 0)
            {
                foreach (var proposalId in result.SubmittedProposalIds)
                {
                    var responded = await ProposalWorkflow.RespondAsync(proposalId, comment, CancellationToken.None);
                    if (!turn.SubmittedProposalIds.Contains(responded.ProposalId, StringComparer.OrdinalIgnoreCase))
                    {
                        turn.SubmittedProposalIds.Add(responded.ProposalId);
                    }
                }

                RemoveAttemptedProposals(turn, memories, pages);
                AddTraceEntry(turn, ChatTraceKinds.Write, "Agent writes sent back for revision", FormatRespondedProposalSummary(result.SubmittedProposalIds, comment), IsError: false);
                _agentStatus = $"Requested revisions for {result.SubmittedProposalIds.Count} proposal(s)";
                return $"{proposalKey} -> responded ({string.Join(", ", result.SubmittedProposalIds)})";
            }

            RemoveAttemptedProposals(turn, memories, pages);
            AddTraceEntry(turn, ChatTraceKinds.Write, "Agent write response skipped", $"{proposalKey} response skipped: no file changes were needed.", IsError: false);
            _agentStatus = "No file changes were needed";
            return $"{proposalKey} -> response skipped (no changes needed)";
        }
        catch (Exception ex)
        {
            RemoveAttemptedProposals(turn, memories, pages);
            var outcome = IsBlockedApprovalException(ex) ? "blocked" : "failed";
            AddTraceEntry(turn, ChatTraceKinds.Write, $"Agent write response {outcome}", $"{proposalKey} response {outcome}: {ex.Message}", IsError: true);
            Snackbar.Add(ex.Message, Severity.Error);
            return $"{proposalKey} -> response {outcome} ({ex.Message})";
        }
    }

    private bool TryGetResponseComment(ChatTurnState turn, out string comment)
    {
        comment = turn.ResponseCommentDraft.Trim();
        if (!string.IsNullOrWhiteSpace(comment))
        {
            return true;
        }

        Snackbar.Add("Respond requires a revision note.", Severity.Warning);
        return false;
    }

    private static string FormatRespondedProposalSummary(IReadOnlyList<string> proposalIds, string comment)
    {
        var lines = new List<string>
        {
            $"Revision note: {comment}"
        };

        lines.AddRange(proposalIds.Select(id => $"- proposal:{id} -> needs_revision"));
        return string.Join(Environment.NewLine, lines);
    }

    private static void RemoveAttemptedProposals(ChatTurnState turn, IReadOnlyList<AgentMemoryWriteProposal> memories, IReadOnlyList<AgentPageWriteProposal> pages)
    {
        turn.ProposedMemoryWrites.RemoveAll(proposal => memories.Any(memory => string.Equals(memory.Id, proposal.Id, StringComparison.OrdinalIgnoreCase)));
        turn.ProposedPageWrites.RemoveAll(proposal => pages.Any(page => string.Equals(page.Slug, proposal.Slug, StringComparison.OrdinalIgnoreCase)));
    }

    private static bool IsBlockedApprovalException(Exception ex) =>
        ex is InvalidOperationException or UnauthorizedAccessException or ArgumentException;

    private static int PendingWriteCount(ChatTurnState turn) =>
        turn.ProposedMemoryWrites.Count + turn.ProposedPageWrites.Count;

    private static int PendingWriteCount(ChatSessionState session) =>
        session.Turns.Sum(PendingWriteCount);

    private void UpdatePendingWriteStatus(string emptyStatus = "No pending write approvals") =>
        UpdatePendingWriteStatus(ActiveSession, emptyStatus);

