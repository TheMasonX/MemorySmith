    private async Task PersistDraftAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(DraftPersistDebounce, cancellationToken);
            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            await InvokeAsync(SaveActiveDraftSnapshotAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveActiveDraftSnapshotAsync()
    {
        if (!_hasLoadedSessions)
        {
            return;
        }

        PersistActiveDraft();
        var snapshot = new ChatDraftState
        {
            ActiveSessionId = _activeSessionId,
            Draft = TrimForStorage(_draft, MaxStoredTurnCharacters),
            PendingAttachments = _attachments.Select(TrimAttachmentForStorage).ToList()
        };

        await JS.InvokeVoidAsync("memorySmith.storage.setJson", ChatDraftStorageKey, snapshot);
    }

    private async Task RestoreActiveDraftSnapshotAsync()
    {
        var snapshot = await LoadStorageJsonAsync<ChatDraftState>(ChatDraftStorageKey, warnOnFailure: false);
        if (snapshot is null || string.IsNullOrWhiteSpace(snapshot.ActiveSessionId) ||
            !string.Equals(snapshot.ActiveSessionId, _activeSessionId, StringComparison.Ordinal))
        {
            return;
        }

        _draft = snapshot.Draft ?? string.Empty;
        _attachments.Clear();
        _attachments.AddRange(snapshot.PendingAttachments ?? []);
        PersistActiveDraft();
    }

