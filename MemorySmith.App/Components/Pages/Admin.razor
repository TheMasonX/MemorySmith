    private Task RefreshModelOptionsAsync() =>
        LoadModelOptionsAsync(_modelProfileEditor.Provider, _modelProfileEditor.Model, silent: false);

    private async Task LoadModelOptionsAsync(string providerName, string? currentModel, bool silent)
    {
        _isLoadingModelOptions = true;
        _modelProfileModelError = null;
        try
        {
            var provider = ResolveChatProvider(providerName);
            if (provider is null)
            {
                throw new InvalidOperationException($"Provider '{providerName}' is not registered.");
            }

            var discovered = await provider.ListModelsAsync(CancellationToken.None);
            _modelProfileModelOptions = MergeCurrentModel(discovered, currentModel, providerName);
            if (string.IsNullOrWhiteSpace(_modelProfileEditor.Model) && _modelProfileModelOptions.FirstOrDefault() is { } firstModel)
            {
                _modelProfileEditor.Model = firstModel.Name;
                ApplySelectedModelMetadata(firstModel.Name);
            }
            else
            {
                ApplySelectedModelMetadata(_modelProfileEditor.Model);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException or JsonException)
        {
            _modelProfileModelError = ex.Message;
            _modelProfileModelOptions = string.IsNullOrWhiteSpace(currentModel)
                ? []
                : [new ChatModelSummary(currentModel.Trim(), Provider: providerName, Description: "Currently configured; provider discovery did not return this model.")];
            if (!silent)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
        finally
        {
            _isLoadingModelOptions = false;
        }
    }

    private async Task SaveModelProfileAsync()
    {
        _isBusy = true;
        try
        {
            var result = await ModelProfiles.UpsertAsync(new ChatModelProfileUpsertRequest(
                _modelProfileEditor.Id,
                _modelProfileEditor.Name,
                _modelProfileEditor.Provider,
                _modelProfileEditor.Model,
                _modelProfileEditor.ContextWindowTokens,
                _modelProfileEditor.Enabled,
                _modelProfileEditor.IsDefault,
                _modelProfileEditor.IsMaintenanceRunDefault,
                _modelProfileEditor.IsProposalReviewDefault,
                _modelProfileEditor.IsAdminMaintenanceChatDefault,
                ParseRoleText(_modelProfileEditor.AllowedRolesText),
                _modelProfileEditor.Description), CancellationToken.None);
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "Model profile could not be saved.", Severity.Error);
                return;
            }

            Snackbar.Add("Model profile saved.", Severity.Success);
            _modelProfileEditor = result.Profile is null ? ModelProfileEditor.New() : ModelProfileEditor.From(result.Profile);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

