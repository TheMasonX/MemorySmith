@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MemorySmithPolicies.CanAdminMemorySmith)]
@using Microsoft.AspNetCore.Authentication
@inject IMemorySmithDatabase Database
@inject IAuthenticationSchemeProvider SchemeProvider
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ICurrentUserContext CurrentUser
@inject AuditLogService Audit
@inject AdminSettingsService Settings
@inject ChatModelProfileService ModelProfiles
@inject IEnumerable<IChatProvider> ChatProviders
@inject MemorySmithLocalAuthService Auth
@inject VarResolver VarResolver
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IJSRuntime JS
@using Microsoft.Extensions.Options
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using System.Text.Json.Nodes

<PageTitle>Admin - MemorySmith</PageTitle>

<div class="wiki-workbench admin-workbench">
    <section class="wiki-commandbar" aria-label="Admin">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Admin</MudText>
            <span class="wiki-count">Users, OAuth, models, settings, audit, history</span>
        </div>
        <MudTooltip Text="Refresh admin data">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" aria-label="Refresh" />
        </MudTooltip>
    </section>

    <section class="admin-section-summary" aria-label="Active admin section" aria-live="polite">
        <div class="admin-section-summary-copy">
            <span class="admin-table-meta">Active section</span>
            <MudText Typo="Typo.subtitle2">@ActiveAdminSectionTitle</MudText>
            <span class="admin-section-summary-text">@ActiveAdminSectionDescription</span>
        </div>
    </section>

    <MudTabs Rounded="false" Elevation="0" Class="admin-tabs" ActivePanelIndex="@_activeAdminTabIndex" ActivePanelIndexChanged="OnAdminTabChanged">
        <MudTabPanel Text="Users" Icon="@Icons.Material.Filled.People">
            <div class="admin-panel-grid">
                <section class="health-lower-card admin-form-panel" aria-label="Create local user account">
                    <div class="wiki-commandbar profile-sectionbar">
                        <div class="wiki-title-block">
                            <MudText Typo="Typo.h6">Create Local User</MudText>
                        </div>
                        <MudButton Variant="@(_showCreateUserForm ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="ToggleCreateUserForm">@(_showCreateUserForm ? "Cancel" : "Add local user")</MudButton>
                    </div>

                    @if (_showCreateUserForm)
                    {
                        if (!Options.CurrentValue.Auth.LocalPasswordEnabled)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">Local password sign-in is disabled globally. Enable it before creating local-only test accounts.</MudAlert>
                        }
                        else if (!Options.CurrentValue.Auth.AllowAdminCreateLocalUsers)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">Admin-created local users are disabled. Turn on <strong>Allow admin-created local users</strong> in Admin Configuration to create local-only test accounts from this page.</MudAlert>
                        }
                        else
                        {
                            <div class="admin-form-stack">
                                <MudTextField T="string" Value="@_newLocalUserDisplayName" ValueChanged="@((string value) => _newLocalUserDisplayName = value)" Label="Display name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy" />
                                <MudTextField T="string" Value="@_newLocalUserEmail" ValueChanged="@((string value) => _newLocalUserEmail = value)" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy" />
                                <MudSelect T="string" Value="@_newLocalUserRole" ValueChanged="@((string value) => _newLocalUserRole = value)" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@_isBusy">
                                    @foreach (var role in _assignableRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField T="string" Value="@_newLocalUserPassword" ValueChanged="@((string value) => _newLocalUserPassword = value)" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy" />
                                <MudTextField T="string" Value="@_newLocalUserConfirmPassword" ValueChanged="@((string value) => _newLocalUserConfirmPassword = value)" Label="Confirm password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy" />
                                <small class="admin-setting-key">Passwords must be at least 15 characters. Admin role requires AllowAdminCreateLocalUsers + AllowAdminAssignment.</small>
                                <div class="admin-model-editor-actions">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@_isBusy" OnClick="CreateLocalUserAsync">Create local user</MudButton>
                                    <MudButton Variant="Variant.Outlined" Disabled="@_isBusy" OnClick="ResetNewLocalUserForm">Clear</MudButton>
                                </div>
                            </div>
                        }
                    }
                </section>
            </div>

            <MudTable Items="@_userRows" Dense="true" Breakpoint="Breakpoint.Sm" Class="health-table admin-grid-table admin-users-table">
                <HeaderContent>
                    <MudTh>User</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Last login</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="User">
                        <div class="admin-user-primary">
                            <strong>@context.User.DisplayName</strong>
                            <SensitiveValue Value="@context.User.UserId" Summary="@SummarizeIdentifier(context.User.UserId)" Label="@($"{context.User.DisplayName} user ID")" Class="admin-sensitive-value admin-sensitive-compact" AllowReveal="false" />
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Email">
                        <div class="admin-user-secondary">
                            <SensitiveValue Value="@context.User.Email" Summary="@MaskEmail(context.User.Email)" Label="@($"{context.User.DisplayName} email")" Class="admin-sensitive-value" EmptyText="-" AllowReveal="false" />
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Status">@(context.User.IsDisabled ? "Disabled" : "Active")</MudTd>
                    <MudTd DataLabel="Role">
                        @if (context.IsAdmin)
                        {
                            <span class="wiki-status is-core">Admin</span>
                        }
                        else
                        {
                            <MudSelect T="string" Value="@context.SelectedRole" ValueChanged="@((string role) => ChangeUserRoleAsync(context, role))" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy">
                                @foreach (var role in _assignableRoles)
                                {
                                    <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudTd>
                    <MudTd DataLabel="Last login">@(context.User.LastLoginAtUtc?.ToLocalTime().ToString("g") ?? "-")</MudTd>
                    <MudTd DataLabel="Action">
                        <div class="admin-user-action-cell">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_isBusy || context.IsAdmin || context.User.IsDisabled)" OnClick="@(() => DisableUserAsync(context))">Disable</MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="OAuth" Icon="@Icons.Material.Filled.Link">
            <div class="admin-provider-grid" aria-label="Identity providers">
                @foreach (var provider in _providers)
                {
                    <article class="health-lower-card admin-provider-card">
                        <div class="admin-provider-card-header">
                            <div class="admin-provider-title">
                                <strong>@provider.DisplayName</strong>
                                @if (ProviderOAuthSetupUrl(provider.ProviderName) is { } setupUrl)
                                {
                                    <a class="admin-provider-setup-link" href="@setupUrl" target="_blank" rel="noopener noreferrer" title="Open @provider.DisplayName OAuth setup" aria-label="Open @provider.DisplayName OAuth setup">
                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                    </a>
                                }
                            </div>
                            <span class="@ProviderStatusClass(provider)">@ProviderStatusText(provider)</span>
                        </div>
                        <dl class="admin-provider-meta">
                            <div>
                                <dt>Configured</dt>
                                <dd>@ProviderConfigurationLabel(provider.ProviderName)</dd>
                            </div>
                            <div>
                                <dt>Links</dt>
                                <dd>@ProviderLinkCount(provider.ProviderName)</dd>
                            </div>
                            <div>
                                <dt>Updated</dt>
                                <dd>@provider.UpdatedAtUtc.ToLocalTime().ToString("g")</dd>
                            </div>
                        </dl>
                        <p class="admin-provider-impact">@ProviderActionImpact(provider)</p>
                        <div class="admin-provider-card-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@ProviderToggleColor(provider)" Disabled="@(_isBusy || !CanToggleProvider(provider))" OnClick="@(() => ToggleProviderAsync(provider))" aria-label="@ProviderToggleLabel(provider)" title="@ProviderToggleTooltip(provider)">@ProviderToggleText(provider)</MudButton>
                        </div>
                    </article>
                }
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Models" Icon="@Icons.Material.Filled.SmartToy">
            <div class="admin-model-profiles" aria-label="Model profiles">
                <MudTable Items="@_modelProfiles" Dense="true" Hover="true" Class="health-table admin-grid-table" RowsPerPage="25">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Provider</MudTh>
                        <MudTh>Model</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Provider">@context.Provider</MudTd>
                        <MudTd DataLabel="Model">@context.Model</MudTd>
                        <MudTd DataLabel="Action">
                            <div class="admin-row-actions">
                                <MudTooltip Text="@DuplicateModelTooltip(context)">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Secondary" Disabled="@_isBusy" OnClick="@(() => DuplicateModelProfileAsync(context))" aria-label="Duplicate profile" title="Duplicate" />
                                </MudTooltip>
                                <MudTooltip Text="@EditModelTooltip(context)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Disabled="@_isBusy" OnClick="@(() => EditModelProfile(context))" aria-label="Edit profile" title="Edit" />
                                </MudTooltip>
                                <MudTooltip Text="@DeleteModelTooltip(context)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@(_isBusy || context.IsDefault)" OnClick="@(() => DeleteModelProfileAsync(context))" aria-label="Delete profile" title="Delete" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>

                <div class="admin-model-editor">
                    <MudSelect T="string" Value="@_modelProfileEditor.Provider" ValueChanged="OnModelProfileProviderChangedAsync" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-model-select-field">
                        @foreach (var provider in ChatProviders)
                        {
                            <MudSelectItem T="string" Value="@provider.Name">@provider.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Value="@_modelProfileEditor.Model" ValueChanged="OnModelProfileModelChanged" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-model-select-field" Disabled="@(_isBusy || _modelProfileModelOptions.Count == 0)">
                        @foreach (var model in _modelProfileModelOptions)
                        {
                            <MudSelectItem T="string" Value="@model.Name">@model.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="admin-model-editor-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isBusy" OnClick="SaveModelProfileAsync">Save</MudButton>
                        <MudButton Variant="Variant.Outlined" Disabled="@_isBusy" OnClick="@(() => _modelProfileEditor = ModelProfileEditor.New())">Reset</MudButton>
                    </div>
                </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Tune">
            <section class="admin-config-summary" aria-label="Configuration workbench status">
                <div class="admin-config-summary-copy">
                    <span class="admin-config-summary-kicker">SETTINGS WORKBENCH</span>
                    <strong>@ConfigurationWorkbenchHeadline</strong>
                    <span>@ConfigurationWorkbenchDescription</span>
                </div>
                <div class="admin-config-summary-actions">
                    <MudTooltip Text="Reset pending changes in the current filtered settings view.">
                        <MudTooltip Text="Reset pending changes in current filter">
                        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="@(_isBusy || FilteredDirtySettingCount == 0)" OnClick="ResetFilteredSettings" aria-label="Reset visible" />
                    </MudTooltip>
                    </MudTooltip>
                </div>
            </section>

            <div class="admin-settings-nav" aria-label="Setting categories">
                <MudButton Variant="@(IsAllFilter(_settingsCategory) ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" Class="admin-settings-nav-button" OnClick="@(() => SelectSettingsCategory(AllFilterValue))">All categories</MudButton>
                @foreach (var category in SettingCategories)
                {
                    var dirtyCount = GetDirtySettingCount(category);
                    <MudButton Variant="@(string.Equals(_settingsCategory, category, StringComparison.OrdinalIgnoreCase) ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" Class="admin-settings-nav-button" OnClick="@(() => SelectSettingsCategory(category))">
                        <span>@category</span>
                        @if (dirtyCount > 0)
                        {
                            <span class="admin-settings-nav-count-chip" aria-label="@($"{dirtyCount} changed setting{(dirtyCount == 1 ? string.Empty : "s")}")">#@dirtyCount</span>
                        }
                    </MudButton>
                }
            </div>

            <div class="admin-filter-bar" aria-label="Editable settings filters">
                <MudTextField T="string" Value="@_settingsSearch" ValueChanged="@((string value) => _settingsSearch = value)" Immediate="true" Label="Search settings" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_settingsCategory" ValueChanged="@((string value) => _settingsCategory = value)" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All categories</MudSelectItem>
                    @foreach (var category in SettingCategories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch T="bool" Value="@_settingsDirtyOnly" ValueChanged="@((bool value) => _settingsDirtyOnly = value)" Label="Changed only" Color="Color.Primary" Class="admin-settings-dirty-toggle" />
            </div>

            @if (IsTrainingSettingsView)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-2">
                    Training runtime toggles are editable here. Model profiles are managed on the dedicated Models page.
                    <MudTooltip Text="Open dedicated Models page">
                        <MudIconButton Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" OnClick="OpenModelsPage" aria-label="Open Models" />
                    </MudTooltip>
                </MudAlert>
            }

            <div class="admin-settings-save-all-row">
                <MudTooltip Text="Save only the pending changes that match the current filters.">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt" Disabled="@(_isBusy || FilteredDirtySettingCount == 0)" OnClick="SaveVisibleDirtySettingsAsync">Save Visible (@FilteredDirtySettingCount)</MudButton>
                </MudTooltip>
                <MudTooltip Text="Save every pending config change, including rows outside the current filters.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_isBusy || DirtySettingCount == 0)" OnClick="SaveAllDirtySettingsAsync">Save All Changes (@DirtySettingCount)</MudButton>
                </MudTooltip>
            </div>

            <MudPaper Class="pa-4 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle2">Config Import/Export</MudText>
                <div class="admin-settings-save-all-row" style="margin-top:8px; justify-content:flex-start;">
                    <MudTooltip Text="Export the settings that match the current filters into the transfer box below.">
                        <MudIconButton Icon="@Icons.Material.Filled.UploadFile" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="@_isBusy" OnClick="ExportVisibleSettingsAsync" aria-label="Export visible" title="Export visible" />
                    </MudTooltip>
                    <MudTooltip Text="Export every editable admin setting into the transfer box below.">
                        <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="@_isBusy" OnClick="ExportAllSettingsAsync" aria-label="Export all" title="Export all" />
                    </MudTooltip>
                    <MudTooltip Text="Copy the current transfer JSON to the clipboard.">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_settingsTransferPayload))" OnClick="CopySettingsTransferPayloadAsync" aria-label="Copy JSON" title="Copy JSON" />
                    </MudTooltip>
                    <MudTooltip Text="Apply imported JSON to matching settings in the current filtered view without saving yet.">
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_settingsTransferPayload))" OnClick="ApplyImportedSettingsToVisibleAsync" aria-label="Import to visible" title="Import to visible" />
                    </MudTooltip>
                    <MudTooltip Text="Apply imported JSON to every matching editable setting without saving yet.">
                        <MudIconButton Icon="@Icons.Material.Filled.DownloadDone" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_settingsTransferPayload))" OnClick="ApplyImportedSettingsToAllAsync" aria-label="Import to all" title="Import to all" />
                    </MudTooltip>
                </div>
                <MudTextField T="string" Value="@_settingsTransferPayload" ValueChanged="@((string value) => _settingsTransferPayload = value)" Label="Settings transfer JSON" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="6" HelperText="Export writes JSON here. Paste JSON here to import matching editable settings as pending changes, then Save Visible or Save All." />
            </MudPaper>

            @if (FilteredEditableSettingGroups.Count == 0)
            {
                <div class="wiki-empty-state">No editable settings match the current filters.</div>
            }
            else
            {
                <div class="admin-settings-groups">
                    @foreach (var group in FilteredEditableSettingGroups)
                    {
                        var dirtyCount = group.Items.Count(item => item.IsDirty);
                        <details class="admin-settings-expander" open="@IsSettingGroupExpanded(group.Category)">
                            <summary @onclick="@(() => ToggleSettingGroupExpanded(group.Category))" @onclick:preventDefault>
                                <span>@group.Category</span>
                                <small>@group.Items.Count setting(s)</small>
                            </summary>
                            <div class="admin-settings-group-toolbar">
                                <span class="admin-settings-group-caption">@group.Items.Count setting(s) in this category.</span>
                                @if (dirtyCount > 0)
                                {
                                    <span class="admin-settings-group-pill">@dirtyCount changed</span>
                                }
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(_isBusy || dirtyCount == 0)" OnClick="@(() => ResetGroupSettings(group))">Reset group</MudButton>
                            </div>
                            <MudTable Items="@group.Items" Dense="true" Breakpoint="Breakpoint.Sm" Class="health-table admin-grid-table admin-settings-table" RowsPerPage="25">
                                <HeaderContent>
                                    <MudTh>Setting</MudTh>
                                    <MudTh>Value</MudTh>
                                    <MudTh>Action</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Setting">
                                        <div class="admin-setting-heading">
                                            <div class="admin-setting-heading-text">
                                                <strong>@context.Item.Label</strong>
                                                @if (context.IsDirty)
                                                {
                                                    <span class="admin-setting-dirty-indicator">Changed</span>
                                                }
                                            </div>
                                            <MudTooltip Text="@context.Item.HelpText" Placement="Placement.Right">
                                                <span class="admin-help-icon" aria-label="Help for @context.Item.Label" tabindex="0">
                                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                                </span>
                                            </MudTooltip>
                                        </div>
                                        <small class="admin-setting-key">@context.Item.Key</small>
                                        @if (context.Item.IsSensitive)
                                        {
                                            <small class="admin-sensitive-hint">@context.Item.DisplayValue; enter a replacement value to configure or rotate it, or clear the saved value explicitly.</small>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Value">@SettingEditor(context)</MudTd>
                                    <MudTd DataLabel="Action">
                                        <div class="admin-setting-actions">
                                            @if (context.IsDirty)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isBusy" OnClick="@(() => SaveSettingAsync(context))">Save setting</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_isBusy" OnClick="@(() => ResetSetting(context))">Reset</MudButton>
                                            }
                                            @if (context.CanClearSensitiveSetting)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@_isBusy" OnClick="@(() => ClearSensitiveSettingAsync(context))">Clear secret</MudButton>
                                            }
                                        </div>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </details>
                    }
                </div>

                <div class="admin-settings-save-all-row">
                    <MudTooltip Text="Save only the pending changes that match the current filters.">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt" Disabled="@(_isBusy || FilteredDirtySettingCount == 0)" OnClick="SaveVisibleDirtySettingsAsync">Save Visible (@FilteredDirtySettingCount)</MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Save every pending config change, including rows outside the current filters.">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_isBusy || DirtySettingCount == 0)" OnClick="SaveAllDirtySettingsAsync">Save All Changes (@DirtySettingCount)</MudButton>
                    </MudTooltip>
                </div>
            }

            <div class="admin-filter-bar" aria-label="Effective configuration filters">
                <MudTextField T="string" Value="@_configurationSearch" ValueChanged="@((string value) => _configurationSearch = value)" Immediate="true" Label="Search effective configuration" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
            </div>

            <MudTable Items="@FilteredConfigurationItems" Dense="true" Class="health-table" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Key</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>
                        @if (context.ExactValue is null)
                        {
                            @context.DisplayValue
                        }
                        else
                        {
                            <SensitiveValue Value="@context.ExactValue" Summary="@context.DisplayValue" Label="@($"{context.Key} value")" Class="admin-sensitive-value" AllowReveal="false" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Variables" Icon="@Icons.Material.Filled.DataObject">
            <div class="admin-filter-bar" aria-label="Path variable tools">
                <MudText Typo="Typo.body2" Style="color: var(--vscode-text-muted); flex: 1;">
                    Define Source Link path variables using <strong>%VariableName%</strong> tokens,
                    for example <code>%MemorySmithRepo%MemorySmith.App/Program.cs</code>.
                </MudText>
                <MudTooltip Text="Add a new path variable row.">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" Disabled="@_isBusy" OnClick="AddVariableRow">Add Variable</MudButton>
                </MudTooltip>
                <MudTooltip Text="Save all variable changes to the configured vars file.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Save" Disabled="@_isBusy" OnClick="SaveVariablesAsync">Save Variables</MudButton>
                </MudTooltip>
            </div>

            @if (_variableRows.Count == 0)
            {
                <div class="wiki-empty-state">No variables defined. Click Add Variable to create one.</div>
            }
            else
            {
                <div class="vars-table" style="margin-top: 8px;">
                    @foreach (var (row, index) in _variableRows.Select((row, i) => (row, i)))
                    {
                        <div class="vars-row" @key="index">
                            <MudTextField @bind-Value="row.Name"
                                          Label="Variable Name"
                                          Placeholder="MemorySmithRepo"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="vars-name-field"
                                          Disabled="@_isBusy" />
                            <MudTextField @bind-Value="row.Value"
                                          Label="Value"
                                          Placeholder="C:\path\to\folder\"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="vars-value-field"
                                          InputType="@VariableValueInputType(row)"
                                          Disabled="@_isBusy" />
                            <div class="vars-value-actions">
                                <MudIconButton Icon="@VariableRevealIcon(row)"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               Disabled="@_isBusy"
                                               OnClick="@(() => ToggleVariableValueReveal(row))"
                                               aria-label="@VariableRevealLabel(row)"
                                               title="@VariableRevealLabel(row)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               Disabled="@(_isBusy || string.IsNullOrWhiteSpace(row.Value))"
                                               OnClick="@(() => CopyVariableValueAsync(row))"
                                               aria-label="@VariableCopyLabel(row)"
                                               title="@VariableCopyLabel(row)" />
                            </div>
                            <MudTooltip Text="Remove this variable row.">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="@_isBusy"
                                               OnClick="@(() => RemoveVariableRow(index))"
                                               aria-label="Remove variable"
                                               title="Remove variable" />
                            </MudTooltip>
                        </div>
                    }
                </div>
            }
        </MudTabPanel>
        <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.FactCheck">
            <div class="admin-filter-bar" aria-label="Audit filters">
                <MudTextField T="string" Value="@_auditSearch" ValueChanged="@((string value) => _auditSearch = value)" Immediate="true" Label="Search audit" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_auditOutcomeFilter" ValueChanged="@((string value) => _auditOutcomeFilter = value)" Label="Outcome" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All outcomes</MudSelectItem>
                    @foreach (var outcome in AuditOutcomeOptions)
                    {
                        <MudSelectItem T="string" Value="@outcome">@outcome</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_auditTargetKindFilter" ValueChanged="@((string value) => _auditTargetKindFilter = value)" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All targets</MudSelectItem>
                    @foreach (var targetKind in AuditTargetKindOptions)
                    {
                        <MudSelectItem T="string" Value="@targetKind">@targetKind</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_auditSort" ValueChanged="@((string value) => _auditSort = value)" Label="Sort audit by" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    @foreach (var option in AuditSortOptions)
                    {
                        <MudSelectItem T="string" Value="@option">@AuditSortLabel(option)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_auditSortDirection" ValueChanged="@((string value) => _auditSortDirection = value)" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    @foreach (var option in SortDirectionOptions)
                    {
                        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTable Items="@FilteredAudit" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25" Class="health-table admin-grid-table">
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Seq</MudTh>
                    <MudTh>Actor</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Target</MudTh>
                    <MudTh>Outcome</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Time">@context.OccurredAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Seq">@context.Sequence</MudTd>
                    <MudTd DataLabel="Actor">@AuditActorDisplay(context)</MudTd>
                    <MudTd DataLabel="Action">@context.Action</MudTd>
                    <MudTd DataLabel="Target">
                        <div class="admin-table-stack">
                            <span class="admin-table-meta">@context.TargetKind</span>
                            <div class="admin-copy-cell">
                                <span class="admin-copy-text" title="@AuditTargetDisplay(context)">@AuditTargetDisplay(context)</span>
                                <MudTooltip Text="Copy target ID.">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   Disabled="@string.IsNullOrWhiteSpace(context.TargetId)"
                                                   OnClick="@(() => CopyAdminValueAsync(context.TargetId, $"{context.TargetKind} target ID"))"
                                                   aria-label="Copy target ID"
                                                   title="Copy target ID" />
                                </MudTooltip>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Outcome">@context.Outcome</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
            <div class="admin-filter-bar" aria-label="History filters">
                <MudTextField T="string" Value="@_historySearch" ValueChanged="@((string value) => _historySearch = value)" Immediate="true" Label="Search history" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_historyTargetKindFilter" ValueChanged="@((string value) => _historyTargetKindFilter = value)" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All targets</MudSelectItem>
                    @foreach (var targetKind in HistoryTargetKindOptions)
                    {
                        <MudSelectItem T="string" Value="@targetKind">@targetKind</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_historyFormatFilter" ValueChanged="@((string value) => _historyFormatFilter = value)" Label="Format" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All formats</MudSelectItem>
                    @foreach (var format in HistoryFormatOptions)
                    {
                        <MudSelectItem T="string" Value="@format">@format</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_historySort" ValueChanged="@((string value) => _historySort = value)" Label="Sort history by" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    @foreach (var option in HistorySortOptions)
                    {
                        <MudSelectItem T="string" Value="@option">@HistorySortLabel(option)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_historySortDirection" ValueChanged="@((string value) => _historySortDirection = value)" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    @foreach (var option in SortDirectionOptions)
                    {
                        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTable Items="@FilteredHistory" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25" Class="health-table admin-grid-table">
                <HeaderContent>
                    <MudTh>Target</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Format</MudTh>
                    <MudTh>Size</MudTh>
                    <MudTh>Artifact</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Target">
                        <div class="admin-table-stack">
                            <span class="admin-table-meta">@context.TargetKind</span>
                            <div class="admin-copy-cell">
                                <span class="admin-copy-text" title="@HistoryTargetDisplay(context)">@HistoryTargetDisplay(context)</span>
                                <MudTooltip Text="Copy target ID.">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   Disabled="@string.IsNullOrWhiteSpace(context.TargetId)"
                                                   OnClick="@(() => CopyAdminValueAsync(context.TargetId, $"{context.TargetKind} target ID"))"
                                                   aria-label="Copy target ID"
                                                   title="Copy target ID" />
                                </MudTooltip>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Version">@context.VersionNumber</MudTd>
                    <MudTd DataLabel="Created">@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Format">@context.Format</MudTd>
                    <MudTd DataLabel="Size">@FormatByteSize(context.ByteSize)</MudTd>
                    <MudTd DataLabel="Artifact">
                        <div class="admin-copy-cell">
                            <span class="admin-copy-text" title="@HistoryArtifactDisplay(context)">@HistoryArtifactDisplay(context)</span>
                            <MudTooltip Text="Copy artifact path.">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               Disabled="@string.IsNullOrWhiteSpace(context.HistoryPath)"
                                               OnClick="@(() => CopyAdminValueAsync(context.HistoryPath, "version history artifact path"))"
                                               aria-label="Copy artifact path"
                                               title="Copy artifact path" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private const string AllFilterValue = "__all__";
    private const string AscendingSortDirection = "Ascending";
    private const string DescendingSortDirection = "Descending";
    private const string AuditSortTimeValue = "time";
    private const string AuditSortSequenceValue = "sequence";
    private const string AuditSortActorValue = "actor";
    private const string AuditSortActionValue = "action";
    private const string AuditSortTargetValue = "target";
    private const string AuditSortOutcomeValue = "outcome";
    private const string HistorySortCreatedValue = "created";
    private const string HistorySortTargetValue = "target";
    private const string HistorySortVersionValue = "version";
    private const string HistorySortFormatValue = "format";
    private const string HistorySortSizeValue = "size";
    private const string HistorySortArtifactValue = "artifact";
    private const int UsersTabIndex = 0;
    private const int OAuthTabIndex = 1;
    private const int ModelsTabIndex = 2;
    private const int ConfigurationTabIndex = 3;
    private const string VariablesTabName = "variables";
    private const int VariablesTabIndex = 4;
    private const int AuditTabIndex = 5;
    private const int HistoryTabIndex = 6;
    private const int RecommendedQwen35ContextTokens = 24576;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly IReadOnlyList<string> SortDirectionOptions = [DescendingSortDirection, AscendingSortDirection];
    private static readonly IReadOnlyList<string> AuditSortOptions = [AuditSortTimeValue, AuditSortSequenceValue, AuditSortActorValue, AuditSortActionValue, AuditSortTargetValue, AuditSortOutcomeValue];
    private static readonly IReadOnlyList<string> HistorySortOptions = [HistorySortCreatedValue, HistorySortTargetValue, HistorySortVersionValue, HistorySortFormatValue, HistorySortSizeValue, HistorySortArtifactValue];
    private static readonly IReadOnlyList<ContextWindowPreset> ContextWindowPresetOptions =
    [
        new("provider-default", "Provider default", null),
        new("4096", "4,096", 4096),
        new("8192", "8,192", 8192),
        new("16384", "16,384", 16384),
        new("24576", "24,576 (Qwen3.5 4B)", RecommendedQwen35ContextTokens),
        new("32768", "32,768", 32768),
        new("65536", "65,536", 65536)
    ];
    private IReadOnlyList<UserAdminRow> _userRows = [];
    private IReadOnlyList<RoleRecord> _roles = [];
    private IReadOnlyList<RoleRecord> _assignableRoles = [];
    private IReadOnlyList<AuthProviderRecord> _providers = [];
    private HashSet<string> _supportedExternalProviders = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ChatModelProfileView> _modelProfiles = [];
    private IReadOnlyList<AuditLogEntry> _audit = [];
    private IReadOnlyList<VersionHistoryEntry> _recentVersions = [];
    private IReadOnlyList<EditableConfigurationRow> _editableSettings = [];
    private IReadOnlyList<ConfigurationItem> _configurationItems = [];
    private IReadOnlyList<ChatModelSummary> _modelProfileModelOptions = [];
    private Dictionary<string, int> _providerLinkCounts = new(StringComparer.OrdinalIgnoreCase);
    private string _settingsSearch = string.Empty;
    private string _newLocalUserDisplayName = string.Empty;
    private string _newLocalUserEmail = string.Empty;
    private string _newLocalUserRole = MemorySmithRoles.Viewer;
    private string _newLocalUserPassword = string.Empty;
    private string _newLocalUserConfirmPassword = string.Empty;
    private string _settingsCategory = AllFilterValue;
    private bool _settingsDirtyOnly;
    private string _settingsTransferPayload = string.Empty;
    private HashSet<string> _expandedSettingGroups = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _knownSettingCategories = new(StringComparer.OrdinalIgnoreCase);
    private string _configurationSearch = string.Empty;
    private string _auditSearch = string.Empty;
    private string _auditOutcomeFilter = AllFilterValue;
    private string _auditTargetKindFilter = AllFilterValue;
    private string _auditSort = AuditSortTimeValue;
    private string _auditSortDirection = DescendingSortDirection;
    private string _historySearch = string.Empty;
    private string _historyTargetKindFilter = AllFilterValue;
    private string _historyFormatFilter = AllFilterValue;
    private string _historySort = HistorySortCreatedValue;
    private string _historySortDirection = DescendingSortDirection;
    private string? _modelProfileModelError;
    private ModelProfileEditor _modelProfileEditor = ModelProfileEditor.New();
    private List<VarRow> _variableRows = [];
    private int _activeAdminTabIndex;
    private bool _isBusy;
    private bool _showCreateUserForm;
    private bool _isLoadingModelOptions;

    private IReadOnlyList<string> SettingCategories => _editableSettings
        .Select(row => row.Item.Category)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<SettingCategoryGroup> FilteredEditableSettingGroups => _editableSettings
        .Where(MatchesSettingFilter)
        .GroupBy(row => row.Item.Category)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .Select(group => new SettingCategoryGroup(group.Key, group.OrderBy(row => row.Item.Label, StringComparer.OrdinalIgnoreCase).ToList()))
        .ToList();

    private IReadOnlyList<EditableConfigurationRow> FilteredEditableSettings => FilteredEditableSettingGroups
        .SelectMany(group => group.Items)
        .ToList();

    private int DirtySettingCount => _editableSettings.Count(row => row.IsDirty);

    private int FilteredDirtySettingCount => FilteredEditableSettings.Count(row => row.IsDirty);

    private string ConfigurationWorkbenchHeadline => FilteredEditableSettingGroups.Count == 0
        ? "No editable settings match the current filters."
        : $"{FilteredEditableSettingGroups.Count} visible categor{(FilteredEditableSettingGroups.Count == 1 ? "y" : "ies")}; {FilteredDirtySettingCount} changed setting{(FilteredDirtySettingCount == 1 ? string.Empty : "s")} in view.";

    private string ConfigurationWorkbenchDescription => _settingsDirtyOnly
        ? "Changed-only filtering is active; reset visible values or save individual rows from the narrowed view."
        : $"Use category shortcuts and search to narrow {FilteredEditableSettings.Count} visible setting{(FilteredEditableSettings.Count == 1 ? string.Empty : "s")} without scanning the full catalog.";

    private IReadOnlyList<ConfigurationItem> FilteredConfigurationItems => _configurationItems
        .Where(item => IsSearchMatch(_configurationSearch, item.Key, item.DisplayValue, item.ExactValue))
        .ToList();

    private IReadOnlyList<string> AuditOutcomeOptions => DistinctSorted(_audit.Select(entry => entry.Outcome));
    private IReadOnlyList<string> AuditTargetKindOptions => DistinctSorted(_audit.Select(entry => entry.TargetKind));
    private IReadOnlyList<string> HistoryTargetKindOptions => DistinctSorted(_recentVersions.Select(entry => entry.TargetKind));
    private IReadOnlyList<string> HistoryFormatOptions => DistinctSorted(_recentVersions.Select(entry => entry.Format));

    private string ModelDiscoveryStatus => _isLoadingModelOptions
        ? "Loading provider models..."
        : !string.IsNullOrWhiteSpace(_modelProfileModelError)
            ? $"Model discovery failed: {_modelProfileModelError}"
            : _modelProfileModelOptions.Count == 0
                ? "No models were returned by this provider."
                : $"{_modelProfileModelOptions.Count} provider model(s) available.";

    private string SelectedContextPresetValue
    {
        get
        {
            if (_modelProfileEditor.ContextWindowTokens is null)
            {
                return "provider-default";
            }

            var tokenValue = _modelProfileEditor.ContextWindowTokens.Value;
            return ContextWindowPresetOptions.Any(option => option.Tokens == tokenValue)
                ? tokenValue.ToString(CultureInfo.InvariantCulture)
                : "custom";
        }
    }

    private bool HasCustomContextWindow =>
        _modelProfileEditor.ContextWindowTokens is > 0
        && ContextWindowPresetOptions.All(option => option.Tokens != _modelProfileEditor.ContextWindowTokens.Value);

    private string ModelVramEstimateHint => BuildModelVramEstimateHint(SelectedModelForEditor, _modelProfileEditor.ContextWindowTokens);

    private ChatModelSummary? SelectedModelForEditor =>
        _modelProfileModelOptions.FirstOrDefault(option => string.Equals(option.Name, _modelProfileEditor.Model, StringComparison.OrdinalIgnoreCase));

    private string ActiveAdminSectionTitle => _activeAdminTabIndex switch
    {
        UsersTabIndex => "Users",
        OAuthTabIndex => "OAuth",
        ModelsTabIndex => "Models",
        ConfigurationTabIndex => "Configuration",
        VariablesTabIndex => "Variables",
        AuditTabIndex => "Audit",
        HistoryTabIndex => "History",
        _ => "Admin"
    };

    private string ActiveAdminSectionDescription => _activeAdminTabIndex switch
    {
        UsersTabIndex => "Manage accounts, roles, and last-login state without exposing raw identifiers by default.",
        OAuthTabIndex => "Review configured providers, runtime support, and provider-link usage at a glance.",
        ModelsTabIndex => "Manage named chat model profiles, provider metadata, and defaults.",
        ConfigurationTabIndex => "Review or edit allowlisted operational settings and grouped configuration values.",
        VariablesTabIndex => "Manage variable keys and values used across prompts and workflows.",
        AuditTabIndex => "Filter recent audit events by actor, outcome, and target without relying on the scrolled tab strip.",
        HistoryTabIndex => "Scan recent version artifacts, formats, and targets with compact labeled rows on small screens.",
        _ => "Review admin-only operational data and controls."
    };

    private IReadOnlyList<AuditLogEntry> FilteredAudit => ApplyAuditSort(_audit.Where(MatchesAuditFilter)).ToList();

    private IReadOnlyList<VersionHistoryEntry> FilteredHistory => ApplyHistorySort(_recentVersions.Where(MatchesHistoryFilter)).ToList();

    protected override async Task OnInitializedAsync()
    {
        ApplyAdminTabFromUri();
        await LoadAsync();
    }

    private void ApplyAdminTabFromUri()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("tab", out var tab) && string.Equals(tab.ToString(), VariablesTabName, StringComparison.OrdinalIgnoreCase))
        {
            _activeAdminTabIndex = VariablesTabIndex;
        }
    }

    private void OnAdminTabChanged(int index)
    {
        _activeAdminTabIndex = index;
        var current = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = current.GetLeftPart(UriPartial.Path);
        var target = index == VariablesTabIndex ? $"{path}?tab={VariablesTabName}" : path;
        if (!string.Equals(current.ToString(), target, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(target, replace: true);
        }
    }

    private async Task LoadAsync()
    {
        _supportedExternalProviders = await MemorySmithExternalAuthSupport.GetSupportedExternalProvidersAsync(SchemeProvider, Options.CurrentValue.Auth, CancellationToken.None);
        var users = (await Database.Users.ListAsync(new UserQuery(PageSize: 100), CancellationToken.None)).Data;
        _roles = await Database.Roles.ListRolesAsync(CancellationToken.None);
        _assignableRoles = _roles
            .Where(role => !string.Equals(role.Name, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase)
                || Options.CurrentValue.Auth.AllowAdminCreateLocalUsers)
            .ToList();
        var rows = new List<UserAdminRow>();
        _providerLinkCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach (var user in users)
        {
            var roles = await Database.Roles.GetRolesForUserAsync(user.UserId, CancellationToken.None);
            rows.Add(new UserAdminRow(user, roles));
            var links = await Database.ProviderLinks.GetLinksForUserAsync(user.UserId, CancellationToken.None);
            foreach (var link in links)
            {
                _providerLinkCounts.TryGetValue(link.ProviderName, out var count);
                _providerLinkCounts[link.ProviderName] = count + 1;
            }
        }

        _userRows = rows;
        if (_assignableRoles.Any(role => string.Equals(role.Name, _newLocalUserRole, StringComparison.OrdinalIgnoreCase)) == false)
        {
            _newLocalUserRole = _assignableRoles.FirstOrDefault(role => string.Equals(role.Name, MemorySmithRoles.Viewer, StringComparison.OrdinalIgnoreCase))?.Name
                ?? _assignableRoles.FirstOrDefault()?.Name
                ?? MemorySmithRoles.Viewer;
        }
        _providers = await Database.ProviderLinks.ListProvidersAsync(CancellationToken.None);
        _modelProfiles = ModelProfiles.ListProfiles();
        _audit = (await Database.AuditLogs.QueryAsync(new AuditLogQuery(PageSize: 100), CancellationToken.None)).Data;
        _recentVersions = await LoadRecentVersionsAsync();
        _editableSettings = Settings.ListEditableSettings().Select(item => new EditableConfigurationRow(item)).ToList();
        foreach (var category in SettingCategories)
        {
            if (_knownSettingCategories.Add(category))
            {
                _expandedSettingGroups.Add(category); // new categories start expanded; user-collapsed state is preserved
            }
        }
        _configurationItems = BuildConfigurationItems();
        LoadVariables();
        await LoadModelOptionsAsync(_modelProfileEditor.Provider, _modelProfileEditor.Model, silent: true);
    }

    private void ToggleCreateUserForm()
    {
        _showCreateUserForm = !_showCreateUserForm;
        if (!_showCreateUserForm)
        {
            ResetNewLocalUserForm();
        }
    }

    private void ResetNewLocalUserForm()
    {
        _newLocalUserDisplayName = string.Empty;
        _newLocalUserEmail = string.Empty;
        _newLocalUserPassword = string.Empty;
        _newLocalUserConfirmPassword = string.Empty;
        _newLocalUserRole = _assignableRoles.FirstOrDefault(role => string.Equals(role.Name, MemorySmithRoles.Viewer, StringComparison.OrdinalIgnoreCase))?.Name
            ?? _assignableRoles.FirstOrDefault()?.Name
            ?? MemorySmithRoles.Viewer;
    }

    private async Task CreateLocalUserAsync()
    {
        if (!Options.CurrentValue.Auth.LocalPasswordEnabled)
        {
            Snackbar.Add("Local password sign-in is disabled.", Severity.Warning);
            return;
        }

        if (!Options.CurrentValue.Auth.AllowAdminCreateLocalUsers)
        {
            Snackbar.Add("Admin-created local users are disabled.", Severity.Warning);
            return;
        }

        if (!string.Equals(_newLocalUserPassword, _newLocalUserConfirmPassword, StringComparison.Ordinal))
        {
            Snackbar.Add("Passwords do not match.", Severity.Error);
            return;
        }

        _isBusy = true;
        var result = await Auth.CreateLocalUserAsync(
            _newLocalUserDisplayName,
            _newLocalUserEmail,
            _newLocalUserPassword,
            _newLocalUserRole,
            CurrentUser.UserId,
            CancellationToken.None);
        _isBusy = false;

        if (!result.Succeeded)
        {
            Snackbar.Add(result.Error ?? "Local user creation failed.", Severity.Error);
            return;
        }

        Snackbar.Add($"Created local user {result.User?.DisplayName ?? _newLocalUserDisplayName}.", Severity.Success);
        ResetNewLocalUserForm();
        await LoadAsync();
    }

    private async Task ChangeUserRoleAsync(UserAdminRow row, string roleName)
    {
        if (row.IsAdmin || string.Equals(roleName, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Admin roles are not changed from this view.", Severity.Warning);
            return;
        }

        _isBusy = true;
        var currentRoles = await Database.Roles.GetRolesForUserAsync(row.User.UserId, CancellationToken.None);
        if (currentRoles.Any(role => string.Equals(role.Name, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase)))
        {
            _isBusy = false;
            Snackbar.Add("Admin roles are not changed from this view.", Severity.Warning);
            return;
        }

        foreach (var role in currentRoles.Where(role => !string.Equals(role.Name, roleName, StringComparison.OrdinalIgnoreCase)))
        {
            await Database.Roles.RemoveRoleAsync(row.User.UserId, role.Name, CurrentUser.UserId, CancellationToken.None);
        }

        await Database.Roles.AssignRoleAsync(row.User.UserId, roleName, CurrentUser.UserId, CancellationToken.None);
