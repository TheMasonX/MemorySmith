            Snackbar.Add("Model profile saved.", Severity.Success);
            _modelProfileEditor = result.Profile is null ? ModelProfileEditor.New() : ModelProfileEditor.From(result.Profile);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
