    private async Task LoadModelOptionsAsync(string providerName, string? currentModel, bool silent)
    {
        _isLoadingModelOptions = true;
        _modelProfileModelError = null;
        try
        {
            var provider = ResolveChatProvider(providerName);
            if (provider is null)
            {
                throw new InvalidOperationException($"Provider '{providerName}' is not registered.");
            }

            var discovered = await provider.ListModelsAsync(CancellationToken.None);
            _modelProfileModelOptions = MergeCurrentModel(discovered, currentModel, providerName);
            if (string.IsNullOrWhiteSpace(_modelProfileEditor.Model) && _modelProfileModelOptions.FirstOrDefault() is { } firstModel)
            {
                _modelProfileEditor.Model = firstModel.Name;
                ApplySelectedModelMetadata(firstModel.Name);
            }
            else
            {
                ApplySelectedModelMetadata(_modelProfileEditor.Model);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException or JsonException)
        {
            _modelProfileModelError = ex.Message;
            _modelProfileModelOptions = string.IsNullOrWhiteSpace(currentModel)
                ? []
                : [new ChatModelSummary(currentModel.Trim(), Provider: providerName, Description: "Currently configured; provider discovery did not return this model.")];
            if (!silent)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
        finally
        {
            _isLoadingModelOptions = false;
        }
    }

