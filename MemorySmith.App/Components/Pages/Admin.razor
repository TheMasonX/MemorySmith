    private async Task SaveDirtySettingsAsync(IReadOnlyList<EditableConfigurationRow> rowsToSave, string noun)
    {
        if (rowsToSave.Count == 0)
        {
            Snackbar.Add($"No pending {noun} changes to save.", Severity.Info);
            return;
        }

        var attemptedKeys = rowsToSave.Select(row => row.Item.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var pendingToPreserve = CaptureDirtySettingValues(excludeKeys: attemptedKeys);
        _isBusy = true;
        var failureMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var errors = new List<string>();
        var successCount = 0;

        foreach (var row in rowsToSave)
        {
            var result = await Settings.UpdateAsync(new AdminSettingUpdateRequest(row.Item.Key, row.PendingValue), CancellationToken.None);
            if (result.Succeeded)
            {
                successCount++;
                continue;
            }

            failureMap[row.Item.Key] = row.PendingValue;
            errors.Add($"{row.Item.Label}: {result.Error ?? "save failed"}");
        }

        _isBusy = false;
        await LoadAsync();
        RestoreDirtySettingValues(MergePendingSettings(pendingToPreserve, failureMap));

        if (successCount > 0)
        {
            Snackbar.Add($"Saved {successCount} {noun}{(successCount == 1 ? string.Empty : "s")}.", Severity.Success);
        }

        if (errors.Count > 0)
        {
            Snackbar.Add($"{errors.Count} {noun} save error{(errors.Count == 1 ? string.Empty : "s")}.", Severity.Warning);
        }
    }

    private Dictionary<string, string> CaptureDirtySettingValues(string? excludeKey = null) =>
        CaptureDirtySettingValues(string.IsNullOrWhiteSpace(excludeKey)
            ? null
            : new HashSet<string>([excludeKey], StringComparer.OrdinalIgnoreCase));

    private Dictionary<string, string> CaptureDirtySettingValues(ISet<string>? excludeKeys)
    {
        var pending = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in _editableSettings.Where(item => item.IsDirty))
        {
            if (excludeKeys is not null && excludeKeys.Contains(row.Item.Key))
            {
                continue;
            }

            pending[row.Item.Key] = row.PendingValue;
        }

        return pending;
    }

    private void RestoreDirtySettingValues(IReadOnlyDictionary<string, string> pendingByKey)
    {
        if (pendingByKey.Count == 0)
        {
            return;
        }

        foreach (var row in _editableSettings)
        {
            if (pendingByKey.TryGetValue(row.Item.Key, out var pendingValue))
            {
                row.PendingValue = pendingValue;
            }
        }
    }

    private static Dictionary<string, string> MergePendingSettings(IReadOnlyDictionary<string, string> left, IReadOnlyDictionary<string, string> right)
    {
        var merged = new Dictionary<string, string>(left, StringComparer.OrdinalIgnoreCase);
        foreach (var (key, value) in right)
        {
            merged[key] = value;
        }

        return merged;
    }

