    private static bool IsSearchMatch(string search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        var text = search.Trim();
        return values.Any(value => !string.IsNullOrWhiteSpace(value) && value.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private static IReadOnlyList<string> DistinctSorted(IEnumerable<string?> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<ConfigurationItem> BuildConfigurationItems()
    {
        var root = JsonSerializer.SerializeToNode(Options.CurrentValue, JsonOptions);
        var items = new List<ConfigurationItem>();
        FlattenConfiguration("MemorySmith", root, items);
        return items.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static void FlattenConfiguration(string key, JsonNode? node, List<ConfigurationItem> items)
    {
        switch (node)
        {
            case JsonObject obj when obj.Count > 0:
                foreach (var child in obj.OrderBy(child => child.Key, StringComparer.OrdinalIgnoreCase))
                {
                    FlattenConfiguration($"{key}:{child.Key}", child.Value, items);
                }
                break;
            case JsonArray array when array.Count > 0:
                for (var i = 0; i < array.Count; i++)
                {
                    FlattenConfiguration($"{key}:{i}", array[i], items);
                }
                break;
            default:
                items.Add(CreateConfigurationItem(key, node));
                break;
        }
    }

    private static ConfigurationItem CreateConfigurationItem(string key, JsonNode? node)
    {
        var sensitive = IsSensitiveKey(key);
        var value = FormatConfigValue(node, sensitive);
        return !sensitive && ShouldMaskOperationalValue(value)
            ? new ConfigurationItem(key, MaskOperationalValue(value), value)
            : new ConfigurationItem(key, value, null);
    }

    private static bool IsSensitiveKey(string key)
    {
        var name = key.Split(':').Last();
        return name.Contains("Secret", StringComparison.OrdinalIgnoreCase)
            || name.Contains("ApiKey", StringComparison.OrdinalIgnoreCase)
            || name.Contains("ConnectionString", StringComparison.OrdinalIgnoreCase)
            || name.Contains("PasswordHash", StringComparison.OrdinalIgnoreCase)
            || name.Contains("BootstrapToken", StringComparison.OrdinalIgnoreCase)
            || name.Equals("ClientId", StringComparison.OrdinalIgnoreCase)
            || name.Equals("ClientSecret", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatConfigValue(JsonNode? node, bool sensitive)
    {
        if (node is null)
        {
            return sensitive ? "Not configured" : "(null)";
        }

        if (sensitive)
        {
            var raw = node.ToJsonString(JsonOptions);
            return raw is "null" or "\"\"" ? "Not configured" : "Configured";
        }

        if (node is JsonValue value)
        {
            if (value.TryGetValue<string>(out var text)) return string.IsNullOrEmpty(text) ? "(empty)" : text;
            if (value.TryGetValue<bool>(out var boolean)) return boolean ? "true" : "false";
            if (value.TryGetValue<int>(out var number)) return number.ToString();
            if (value.TryGetValue<long>(out var longNumber)) return longNumber.ToString();
            if (value.TryGetValue<double>(out var doubleNumber)) return doubleNumber.ToString("G");
        }

        return node.ToJsonString(JsonOptions);
    }

    private static bool ShouldMaskOperationalValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value is "(empty)" or "(null)" or "true" or "false")
        {
            return false;
        }

        return LooksLikeEmail(value) || LooksLikeLocalPath(value);
    }

    private static string MaskOperationalValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        if (LooksLikeEmail(value))
        {
            return MaskEmail(value);
        }

        if (LooksLikeLocalPath(value))
        {
            return MaskPath(value);
        }

        return SummarizeIdentifier(value);
    }

    private static bool LooksLikeEmail(string value)
    {
        var atIndex = value.IndexOf('@');
        return atIndex > 0 && atIndex < value.Length - 1 && value[(atIndex + 1)..].Contains('.');
    }

    private static bool LooksLikeLocalPath(string value) => value.Contains(@":\", StringComparison.Ordinal) || value.StartsWith(@"\\", StringComparison.Ordinal) || value.StartsWith("/", StringComparison.Ordinal);

    private static string MaskEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        var atIndex = value.IndexOf('@');
        if (atIndex <= 0 || atIndex == value.Length - 1)
        {
            return SummarizeIdentifier(value);
        }

        var local = value[..atIndex];
        var domain = value[(atIndex + 1)..];
        var visibleLocal = local.Length <= 2 ? local[..1] : local[..Math.Min(2, local.Length)];
        return $"{visibleLocal}...@{domain}";
    }

    private static string MaskPath(string value)
    {
        var trimmed = value.Trim();
        var separator = trimmed.Contains('\\') ? '\\' : '/';
        var parts = trimmed.Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var leaf = parts.LastOrDefault() ?? "path";

        if (trimmed.Length >= 2 && trimmed[1] == ':')
        {
            return $"{trimmed[..2]}{separator}...{separator}{leaf}";
        }

        return trimmed.StartsWith(@"\\", StringComparison.Ordinal)
            ? $@"\\...\{leaf}"
            : $"...{separator}{leaf}";
    }

    private static string SummarizeIdentifier(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        return value.Length <= 10 ? value : $"{value[..4]}...{value[^4..]}";
    }

    private static string AuditActorDisplay(AuditLogEntry entry) => FirstMeaningful(entry.ActorDisplay, entry.ActorUserId, entry.ActorKind);

