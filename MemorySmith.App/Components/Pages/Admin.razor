@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MemorySmithPolicies.CanAdminMemorySmith)]
@inject IMemorySmithDatabase Database
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ICurrentUserContext CurrentUser
@inject AuditLogService Audit
@inject AdminSettingsService Settings
@inject ChatModelProfileService ModelProfiles
@inject IEnumerable<IChatProvider> ChatProviders
@inject MaintenanceAgentService Agent
@inject ISnackbar Snackbar
@using Microsoft.Extensions.Options
@using System.Text.Json
@using System.Text.Json.Nodes

<PageTitle>Admin</PageTitle>

<div class="wiki-workbench admin-workbench">
    <section class="wiki-commandbar" aria-label="Admin">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Admin</MudText>
            <span class="wiki-count">Users, OAuth, models, settings, audit, history</span>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
    </section>

    <MudTabs Rounded="false" Elevation="0" Class="admin-tabs">
        <MudTabPanel Text="Users" Icon="@Icons.Material.Filled.People">
            <MudTable Items="@_userRows" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>User</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Last login</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <strong>@context.User.DisplayName</strong><br />
                        <small>@context.User.UserId</small>
                    </MudTd>
                    <MudTd>@(context.User.Email ?? "-")</MudTd>
                    <MudTd>@(context.User.IsDisabled ? "Disabled" : "Active")</MudTd>
                    <MudTd>
                        @if (context.IsAdmin)
                        {
                            <span class="wiki-status is-core">Admin</span>
                        }
                        else
                        {
                            <MudSelect T="string" Value="@context.SelectedRole" ValueChanged="@((string role) => ChangeUserRoleAsync(context, role))" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy">
                                @foreach (var role in _assignableRoles)
                                {
                                    <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudTd>
                    <MudTd>@(context.User.LastLoginAtUtc?.ToLocalTime().ToString("g") ?? "-")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_isBusy || context.IsAdmin || context.User.IsDisabled)" OnClick="@(() => DisableUserAsync(context))">Disable</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="OAuth" Icon="@Icons.Material.Filled.Link">
            <MudTable Items="@_providers" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Provider</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Configured</MudTh>
                    <MudTh>Links</MudTh>
                    <MudTh>Updated</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="admin-provider-cell">
                            <span>@context.DisplayName</span>
                            @if (ProviderOAuthSetupUrl(context.ProviderName) is { } setupUrl)
                            {
                                <a class="admin-provider-setup-link" href="@setupUrl" target="_blank" rel="noopener noreferrer" title="Open @context.DisplayName OAuth setup" aria-label="Open @context.DisplayName OAuth setup">
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                </a>
                            }
                        </div>
                    </MudTd>
                    <MudTd>@(context.IsEnabled ? "Enabled" : "Disabled")</MudTd>
                    <MudTd>@ProviderConfigurationLabel(context.ProviderName)</MudTd>
                    <MudTd>@ProviderLinkCount(context.ProviderName)</MudTd>
                    <MudTd>@context.UpdatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsEnabled ? Color.Warning : Color.Success)" Disabled="@_isBusy" OnClick="@(() => ToggleProviderAsync(context))">@(context.IsEnabled ? "Disable" : "Enable")</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Models" Icon="@Icons.Material.Filled.Memory">
            <div class="admin-models-layout">
                <section class="admin-model-list" aria-label="Model profiles">
                    @if (!_modelProfiles.Any(profile => profile.IsDefault && profile.Enabled))
                    {
                        <div class="wiki-empty-state">No enabled default model profile is configured. Chat is disabled until one is selected.</div>
                    }
                    <MudTable Items="@_modelProfiles" Dense="true" Class="health-table admin-models-table">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Provider</MudTh>
                            <MudTh>Model</MudTh>
                            <MudTh>Context</MudTh>
                            <MudTh>Roles</MudTh>
                            <MudTh>Assignments</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <strong>@context.Name</strong>
                                @if (context.IsDefault)
                                {
                                    <span class="wiki-status is-core">Default</span>
                                }
                                @if (context.IsImplicit)
                                {
                                    <small class="admin-setting-key">Derived from legacy Chat provider/model settings</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(context.Description))
                                {
                                    <small class="admin-setting-key">@context.Description</small>
                                }
                            </MudTd>
                            <MudTd>@context.Provider</MudTd>
                            <MudTd>@context.Model</MudTd>
                            <MudTd>@FormatContextWindow(context.ContextWindowTokens)</MudTd>
                            <MudTd>@FormatProfileRoles(context)</MudTd>
                            <MudTd>@FormatProfileAssignments(context)</MudTd>
                            <MudTd>@(context.Enabled ? "Enabled" : "Disabled")</MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@_isBusy" OnClick="@(() => EditModelProfile(context))">@(context.IsImplicit ? "Make explicit" : "Edit")</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_isBusy || context.IsImplicit)" OnClick="@(() => DeleteModelProfileAsync(context))">Delete</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </section>

                <section class="admin-model-editor" aria-label="Edit model profile">
                    <div class="admin-model-editor-header">
                        <MudText Typo="Typo.subtitle1">@(_modelProfileEditor.IsNew ? "New model profile" : "Edit model profile")</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Disabled="@_isBusy" OnClick="StartNewModelProfile">New</MudButton>
                    </div>
                    <div class="admin-model-editor-grid">
                        <MudTextField T="string" Value="@_modelProfileEditor.Name" ValueChanged="@((string value) => _modelProfileEditor.Name = value)" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy" />
                        <MudSelect T="string" Value="@_modelProfileEditor.Provider" ValueChanged="OnModelProfileProviderChangedAsync" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(_isBusy || _isLoadingModelOptions)">
                            @foreach (var provider in ModelProfiles.ProviderOptions)
                            {
                                <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                            }
                        </MudSelect>
                        <div class="admin-model-select-field">
                            <MudSelect T="string" Value="@_modelProfileEditor.Model" ValueChanged="OnModelProfileModelChanged" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(_isBusy || _isLoadingModelOptions || _modelProfileModelOptions.Count == 0)">
                                @foreach (var model in _modelProfileModelOptions)
                                {
                                    <MudSelectItem T="string" Value="@model.Name">@FormatModelOption(model)</MudSelectItem>
                                }
                            </MudSelect>
                            <div class="admin-model-select-meta">
                                <small>@ModelDiscoveryStatus</small>
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" Disabled="@(_isBusy || _isLoadingModelOptions)" OnClick="RefreshModelOptionsAsync" aria-label="Refresh provider models" />
                            </div>
                        </div>
                        <MudNumericField T="int?" Value="@_modelProfileEditor.ContextWindowTokens" ValueChanged="@((int? value) => _modelProfileEditor.ContextWindowTokens = value)" Label="Context tokens" Variant="Variant.Outlined" Margin="Margin.Dense" Min="512" Max="262144" Disabled="@_isBusy" />
                        <MudTextField T="string" Value="@_modelProfileEditor.AllowedRolesText" ValueChanged="@((string value) => _modelProfileEditor.AllowedRolesText = value)" Label="Allowed roles" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Viewer, Editor, Admin" Disabled="@_isBusy" />
                        <MudTextField T="string" Value="@_modelProfileEditor.Description" ValueChanged="@((string value) => _modelProfileEditor.Description = value)" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Disabled="@_isBusy" />
                    </div>
                    <div class="admin-model-switches">
                        <MudSwitch T="bool" Value="@_modelProfileEditor.Enabled" ValueChanged="@((bool value) => _modelProfileEditor.Enabled = value)" Label="Enabled" Disabled="@_isBusy" />
                        <MudSwitch T="bool" Value="@_modelProfileEditor.IsDefault" ValueChanged="@((bool value) => _modelProfileEditor.IsDefault = value)" Label="Default chat model" Disabled="@_isBusy" />
                        <MudSwitch T="bool" Value="@_modelProfileEditor.IsMaintenanceRunDefault" ValueChanged="@((bool value) => _modelProfileEditor.IsMaintenanceRunDefault = value)" Label="Maintenance runs" Disabled="@_isBusy" />
                        <MudSwitch T="bool" Value="@_modelProfileEditor.IsProposalReviewDefault" ValueChanged="@((bool value) => _modelProfileEditor.IsProposalReviewDefault = value)" Label="Proposal reviews" Disabled="@_isBusy" />
                        <MudSwitch T="bool" Value="@_modelProfileEditor.IsAdminMaintenanceChatDefault" ValueChanged="@((bool value) => _modelProfileEditor.IsAdminMaintenanceChatDefault = value)" Label="Admin maintenance chat" Disabled="@_isBusy" />
                    </div>
                    <small class="admin-setting-key">Leave Allowed roles blank to allow any user with chat access. Admins can use every enabled profile.</small>
                    <div class="admin-model-editor-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@_isBusy" OnClick="SaveModelProfileAsync">Save profile</MudButton>
                        <MudButton Variant="Variant.Outlined" Disabled="@_isBusy" OnClick="StartNewModelProfile">Clear</MudButton>
                    </div>
                </section>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Maintenance" Icon="@Icons.Material.Filled.Engineering">
            <div class="admin-maintenance-layout">
                <section class="admin-maintenance-chat" aria-label="Maintenance agent admin chat">
                    <MudText Typo="Typo.subtitle1">Maintenance agent</MudText>
                    <MudTextField T="string" Value="@_maintenancePrompt" ValueChanged="@((string value) => _maintenancePrompt = value)" Label="Ask the maintenance agent" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" Disabled="@_isBusy" />
                    <div class="admin-maintenance-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_maintenancePrompt))" OnClick="SendMaintenanceMessageAsync">Send</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_isBusy" OnClick="LoadMaintenanceTranscriptsAsync">Refresh transcripts</MudButton>
                    </div>
                    <small class="admin-setting-key">This conversation can use the same read-only wiki tools as Chat, but it is non-mutating. Any file, memory, page, or proposal change still needs the proposal workflow.</small>
                </section>

                <section class="admin-maintenance-transcripts" aria-label="Maintenance agent transcripts">
                    <div class="wiki-pane-header">
                        <strong>Recent transcripts</strong>
                        <span class="wiki-muted">@_maintenanceTranscripts.Count logged</span>
                    </div>
                    <div class="admin-maintenance-transcript-search">
                        <MudTextField T="string" Value="@_maintenanceTranscriptSearch" ValueChanged="@((string value) => _maintenanceTranscriptSearch = value)" Immediate="true" Label="Search transcripts" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Disabled="@_isBusy" />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" Disabled="@_isBusy" OnClick="LoadMaintenanceTranscriptsAsync">Search</MudButton>
                    </div>
                    @if (_maintenanceTranscripts.Count == 0)
                    {
                        <div class="wiki-empty-state">No maintenance-agent transcript entries have been logged yet.</div>
                    }
                    else
                    {
                        <div class="admin-maintenance-transcript-list">
                            @foreach (var entry in _maintenanceTranscripts)
                            {
                                <article class="admin-maintenance-transcript">
                                    <header>
                                        <strong>@entry.CreatedAtUtc.ToLocalTime().ToString("g")</strong>
                                        <span>@TranscriptProviderLabel(entry)</span>
                                    </header>
                                    <p><strong>Admin:</strong> @entry.UserMessage</p>
                                    <p><strong>Agent:</strong> @entry.AssistantMessage</p>
                                    @if (entry.Warnings.Count > 0)
                                    {
                                        <small class="admin-maintenance-warning">@entry.Warnings.First()</small>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Tune">
            <div class="admin-filter-bar" aria-label="Editable settings filters">
                <MudTextField T="string" Value="@_settingsSearch" ValueChanged="@((string value) => _settingsSearch = value)" Immediate="true" Label="Search settings" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_settingsCategory" ValueChanged="@((string value) => _settingsCategory = value)" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All categories</MudSelectItem>
                    @foreach (var category in SettingCategories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="admin-settings-groups">
                @foreach (var group in FilteredEditableSettingGroups)
                {
                    <details class="admin-settings-expander" open="@IsSettingGroupExpanded(group.Category)">
                        <summary @onclick="@(() => ToggleSettingGroupExpanded(group.Category))" @onclick:preventDefault>
                            <span>@group.Category</span>
                            <small>@group.Items.Count setting(s)</small>
                        </summary>
                        <MudTable Items="@group.Items" Dense="true" Class="health-table admin-settings-table" RowsPerPage="25">
                            <HeaderContent>
                                <MudTh>Setting</MudTh>
                                <MudTh>Value</MudTh>
                                <MudTh>Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div class="admin-setting-heading">
                                        <strong>@context.Item.Label</strong>
                                        <MudTooltip Text="@context.Item.HelpText" Placement="Placement.Right">
                                            <span class="admin-help-icon" title="@context.Item.HelpText" aria-label="Help for @context.Item.Label" tabindex="0">
                                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                            </span>
                                        </MudTooltip>
                                    </div>
                                    <small class="admin-setting-key">@context.Item.Key</small>
                                    @if (context.Item.IsSensitive)
                                    {
                                        <small class="admin-sensitive-hint">@context.Item.DisplayValue; enter a replacement value only when configuring or rotating it.</small>
                                    }
                                </MudTd>
                                <MudTd>@SettingEditor(context)</MudTd>
                                <MudTd>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isBusy || !context.IsDirty)" OnClick="@(() => SaveSettingAsync(context))">Save</MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </details>
                }
            </div>

            <div class="admin-filter-bar" aria-label="Effective configuration filters">
                <MudTextField T="string" Value="@_configurationSearch" ValueChanged="@((string value) => _configurationSearch = value)" Immediate="true" Label="Search effective configuration" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
            </div>

            <MudTable Items="@FilteredConfigurationItems" Dense="true" Class="health-table" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Key</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>@context.DisplayValue</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.FactCheck">
            <div class="admin-filter-bar" aria-label="Audit filters">
                <MudTextField T="string" Value="@_auditSearch" ValueChanged="@((string value) => _auditSearch = value)" Immediate="true" Label="Search audit" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_auditOutcomeFilter" ValueChanged="@((string value) => _auditOutcomeFilter = value)" Label="Outcome" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All outcomes</MudSelectItem>
                    @foreach (var outcome in AuditOutcomeOptions)
                    {
                        <MudSelectItem T="string" Value="@outcome">@outcome</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_auditTargetKindFilter" ValueChanged="@((string value) => _auditTargetKindFilter = value)" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All targets</MudSelectItem>
                    @foreach (var targetKind in AuditTargetKindOptions)
                    {
                        <MudSelectItem T="string" Value="@targetKind">@targetKind</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTable Items="@FilteredAudit" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Actor</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Target</MudTh>
                    <MudTh>Outcome</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OccurredAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@context.ActorDisplay</MudTd>
                    <MudTd>@context.Action</MudTd>
                    <MudTd>@context.TargetKind:@context.TargetId</MudTd>
                    <MudTd>@context.Outcome</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
            <div class="admin-filter-bar" aria-label="History filters">
                <MudTextField T="string" Value="@_historySearch" ValueChanged="@((string value) => _historySearch = value)" Immediate="true" Label="Search history" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_historyTargetKindFilter" ValueChanged="@((string value) => _historyTargetKindFilter = value)" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All targets</MudSelectItem>
                    @foreach (var targetKind in HistoryTargetKindOptions)
                    {
                        <MudSelectItem T="string" Value="@targetKind">@targetKind</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_historyFormatFilter" ValueChanged="@((string value) => _historyFormatFilter = value)" Label="Format" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All formats</MudSelectItem>
                    @foreach (var format in HistoryFormatOptions)
                    {
                        <MudSelectItem T="string" Value="@format">@format</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTable Items="@FilteredHistory" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Target</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Format</MudTh>
                    <MudTh>Artifact</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.TargetKind:@context.TargetId</MudTd>
                    <MudTd>@context.VersionNumber</MudTd>
                    <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@context.Format</MudTd>
                    <MudTd>@context.HistoryPath</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private const string AllFilterValue = "__all__";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<UserAdminRow> _userRows = [];
    private IReadOnlyList<RoleRecord> _roles = [];
    private IReadOnlyList<RoleRecord> _assignableRoles = [];
    private IReadOnlyList<AuthProviderRecord> _providers = [];
    private IReadOnlyList<ChatModelProfileView> _modelProfiles = [];
    private IReadOnlyList<AuditLogEntry> _audit = [];
    private IReadOnlyList<VersionHistoryEntry> _recentVersions = [];
    private IReadOnlyList<EditableConfigurationRow> _editableSettings = [];
    private IReadOnlyList<ConfigurationItem> _configurationItems = [];
    private IReadOnlyList<MaintenanceAdminTranscriptEntry> _maintenanceTranscripts = [];
    private IReadOnlyList<ChatModelSummary> _modelProfileModelOptions = [];
    private Dictionary<string, int> _providerLinkCounts = new(StringComparer.OrdinalIgnoreCase);
    private string _maintenancePrompt = string.Empty;
    private string _maintenanceTranscriptSearch = string.Empty;
    private string _settingsSearch = string.Empty;
    private string _settingsCategory = AllFilterValue;
    private HashSet<string> _expandedSettingGroups = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _knownSettingCategories = new(StringComparer.OrdinalIgnoreCase);
    private string _configurationSearch = string.Empty;
    private string _auditSearch = string.Empty;
    private string _auditOutcomeFilter = AllFilterValue;
    private string _auditTargetKindFilter = AllFilterValue;
    private string _historySearch = string.Empty;
    private string _historyTargetKindFilter = AllFilterValue;
    private string _historyFormatFilter = AllFilterValue;
    private string? _modelProfileModelError;
    private ModelProfileEditor _modelProfileEditor = ModelProfileEditor.New();
    private bool _isBusy;
    private bool _isLoadingModelOptions;

    private IReadOnlyList<string> SettingCategories => _editableSettings
        .Select(row => row.Item.Category)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<SettingCategoryGroup> FilteredEditableSettingGroups => _editableSettings
        .Where(MatchesSettingFilter)
        .GroupBy(row => row.Item.Category)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .Select(group => new SettingCategoryGroup(group.Key, group.OrderBy(row => row.Item.Label, StringComparer.OrdinalIgnoreCase).ToList()))
        .ToList();

    private IReadOnlyList<ConfigurationItem> FilteredConfigurationItems => _configurationItems
        .Where(item => IsSearchMatch(_configurationSearch, item.Key, item.DisplayValue))
        .ToList();

    private IReadOnlyList<string> AuditOutcomeOptions => DistinctSorted(_audit.Select(entry => entry.Outcome));
    private IReadOnlyList<string> AuditTargetKindOptions => DistinctSorted(_audit.Select(entry => entry.TargetKind));
    private IReadOnlyList<string> HistoryTargetKindOptions => DistinctSorted(_recentVersions.Select(entry => entry.TargetKind));
    private IReadOnlyList<string> HistoryFormatOptions => DistinctSorted(_recentVersions.Select(entry => entry.Format));

    private string ModelDiscoveryStatus => _isLoadingModelOptions
        ? "Loading provider models..."
        : !string.IsNullOrWhiteSpace(_modelProfileModelError)
            ? $"Model discovery failed: {_modelProfileModelError}"
            : _modelProfileModelOptions.Count == 0
                ? "No models were returned by this provider."
