    private bool MatchesSettingFilter(EditableConfigurationRow row)
    {
        if (!IsAllFilter(_settingsCategory) && !string.Equals(row.Item.Category, _settingsCategory, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (_settingsDirtyOnly && !row.IsDirty)
        {
            return false;
        }

        return IsSearchMatch(_settingsSearch, row.Item.Category, row.Item.Label, row.Item.Key, row.Item.ValueKind, row.Item.HelpText, row.PendingValue);
    }

    private bool MatchesAuditFilter(AuditLogEntry entry)
    {
        if (!IsAllFilter(_auditOutcomeFilter) && !string.Equals(entry.Outcome, _auditOutcomeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!IsAllFilter(_auditTargetKindFilter) && !string.Equals(entry.TargetKind, _auditTargetKindFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_auditSearch, entry.ActorDisplay, entry.ActorUserId, entry.Action, entry.TargetKind, entry.TargetId, entry.Outcome, entry.Reason, entry.RequestId, entry.CorrelationId, entry.DetailsJson);
    }

    private bool MatchesHistoryFilter(VersionHistoryEntry entry)
    {
        if (!IsAllFilter(_historyTargetKindFilter) && !string.Equals(entry.TargetKind, _historyTargetKindFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!IsAllFilter(_historyFormatFilter) && !string.Equals(entry.Format, _historyFormatFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_historySearch, entry.TargetKind, entry.TargetId, entry.VersionId, entry.ParentVersionId, entry.Format, entry.HistoryPath, entry.CreatedByUserId, entry.AuditId);
    }

    private IEnumerable<AuditLogEntry> ApplyAuditSort(IEnumerable<AuditLogEntry> entries)
    {
        var descending = IsDescendingSort(_auditSortDirection);
        return (_auditSort, descending) switch
        {
            (AuditSortSequenceValue, true) => entries.OrderByDescending(entry => entry.Sequence),
            (AuditSortSequenceValue, false) => entries.OrderBy(entry => entry.Sequence),
            (AuditSortActorValue, true) => entries.OrderByDescending(entry => AuditActorDisplay(entry), StringComparer.OrdinalIgnoreCase),
            (AuditSortActorValue, false) => entries.OrderBy(entry => AuditActorDisplay(entry), StringComparer.OrdinalIgnoreCase),
            (AuditSortActionValue, true) => entries.OrderByDescending(entry => entry.Action, StringComparer.OrdinalIgnoreCase),
            (AuditSortActionValue, false) => entries.OrderBy(entry => entry.Action, StringComparer.OrdinalIgnoreCase),
            (AuditSortTargetValue, true) => entries.OrderByDescending(entry => AuditTargetSortKey(entry), StringComparer.OrdinalIgnoreCase),
            (AuditSortTargetValue, false) => entries.OrderBy(entry => AuditTargetSortKey(entry), StringComparer.OrdinalIgnoreCase),
            (AuditSortOutcomeValue, true) => entries.OrderByDescending(entry => entry.Outcome, StringComparer.OrdinalIgnoreCase),
            (AuditSortOutcomeValue, false) => entries.OrderBy(entry => entry.Outcome, StringComparer.OrdinalIgnoreCase),
            (_, true) => entries.OrderByDescending(entry => entry.OccurredAtUtc),
            _ => entries.OrderBy(entry => entry.OccurredAtUtc)
        };
    }

    private IEnumerable<VersionHistoryEntry> ApplyHistorySort(IEnumerable<VersionHistoryEntry> entries)
    {
        var descending = IsDescendingSort(_historySortDirection);
        return (_historySort, descending) switch
        {
            (HistorySortTargetValue, true) => entries.OrderByDescending(entry => HistoryTargetSortKey(entry), StringComparer.OrdinalIgnoreCase),
            (HistorySortTargetValue, false) => entries.OrderBy(entry => HistoryTargetSortKey(entry), StringComparer.OrdinalIgnoreCase),
            (HistorySortVersionValue, true) => entries.OrderByDescending(entry => entry.VersionNumber),
            (HistorySortVersionValue, false) => entries.OrderBy(entry => entry.VersionNumber),
            (HistorySortFormatValue, true) => entries.OrderByDescending(entry => entry.Format, StringComparer.OrdinalIgnoreCase),
            (HistorySortFormatValue, false) => entries.OrderBy(entry => entry.Format, StringComparer.OrdinalIgnoreCase),
            (HistorySortSizeValue, true) => entries.OrderByDescending(entry => entry.ByteSize),
            (HistorySortSizeValue, false) => entries.OrderBy(entry => entry.ByteSize),
            (HistorySortArtifactValue, true) => entries.OrderByDescending(entry => entry.HistoryPath, StringComparer.OrdinalIgnoreCase),
            (HistorySortArtifactValue, false) => entries.OrderBy(entry => entry.HistoryPath, StringComparer.OrdinalIgnoreCase),
            (_, true) => entries.OrderByDescending(entry => entry.CreatedAtUtc),
            _ => entries.OrderBy(entry => entry.CreatedAtUtc)
        };
    }

