    private RenderFragment SettingEditor(EditableConfigurationRow row) => builder =>
    {
        switch (row.Item.ValueKind)
        {
            case nameof(AdminSettingValueKind.Boolean):
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Value", bool.TryParse(row.PendingValue, out var boolean) && boolean);
                builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, value => SetPendingValue(row, value ? "true" : "false")));
                builder.AddAttribute(3, "Disabled", _isBusy);
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.Choice):
                builder.OpenComponent<MudSelect<string>>(10);
                builder.AddAttribute(11, "Value", row.PendingValue);
                builder.AddAttribute(12, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(13, "Dense", true);
                builder.AddAttribute(14, "Variant", Variant.Outlined);
                builder.AddAttribute(15, "Margin", Margin.Dense);
                builder.AddAttribute(16, "Disabled", _isBusy);
                builder.AddAttribute(17, "ChildContent", (RenderFragment)(selectBuilder =>
                {
                    var sequence = 0;
                    foreach (var option in row.Item.Options)
                    {
                        selectBuilder.OpenComponent<MudSelectItem<string>>(sequence++);
                        selectBuilder.AddAttribute(sequence++, "Value", option);
                        selectBuilder.AddContent(sequence++, option);
                        selectBuilder.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.StringList):
                builder.OpenComponent<MudTextField<string>>(20);
                builder.AddAttribute(21, "Value", row.PendingValue);
                builder.AddAttribute(22, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(23, "Dense", true);
                builder.AddAttribute(24, "Variant", Variant.Outlined);
                builder.AddAttribute(25, "Margin", Margin.Dense);
                builder.AddAttribute(26, "Lines", 3);
                builder.AddAttribute(27, "Disabled", _isBusy);
                builder.CloseComponent();
                break;
            default:
                builder.OpenComponent<MudTextField<string>>(30);
                builder.AddAttribute(31, "Value", row.PendingValue);
                builder.AddAttribute(32, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(33, "Dense", true);
                builder.AddAttribute(34, "Variant", Variant.Outlined);
                builder.AddAttribute(35, "Margin", Margin.Dense);
                builder.AddAttribute(36, "Disabled", _isBusy);
                builder.AddAttribute(37, "InputType", row.Item.IsSensitive ? InputType.Password : InputType.Text);
                builder.CloseComponent();
                break;
        }
    };

