    }

    private Task RefreshModelOptionsAsync() =>
        LoadModelOptionsAsync(_modelProfileEditor.Provider, _modelProfileEditor.Model, silent: false);

    private async Task LoadModelOptionsAsync(string providerName, string? currentModel, bool silent)
    {
        _isLoadingModelOptions = true;
        _modelProfileModelError = null;
        try
        {
            var provider = ResolveChatProvider(providerName);
            if (provider is null)
            {
                throw new InvalidOperationException($"Provider '{providerName}' is not registered.");
            }

            var discovered = await provider.ListModelsAsync(CancellationToken.None);
            _modelProfileModelOptions = MergeCurrentModel(discovered, currentModel, providerName);
            if (string.IsNullOrWhiteSpace(_modelProfileEditor.Model) && _modelProfileModelOptions.FirstOrDefault() is { } firstModel)
            {
                _modelProfileEditor.Model = firstModel.Name;
                ApplySelectedModelMetadata(firstModel.Name);
            }
            else
            {
                ApplySelectedModelMetadata(_modelProfileEditor.Model);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException or JsonException)
        {
            _modelProfileModelError = ex.Message;
            _modelProfileModelOptions = string.IsNullOrWhiteSpace(currentModel)
                ? []
                : [new ChatModelSummary(currentModel.Trim(), Provider: providerName, Description: "Currently configured; provider discovery did not return this model.")];
            if (!silent)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
        finally
        {
            _isLoadingModelOptions = false;
        }
    }

    private async Task SaveModelProfileAsync()
    {
        _isBusy = true;
        try
        {
            var result = await ModelProfiles.UpsertAsync(new ChatModelProfileUpsertRequest(
                _modelProfileEditor.Id,
                _modelProfileEditor.Name,
                _modelProfileEditor.Provider,
                _modelProfileEditor.Model,
                _modelProfileEditor.ContextWindowTokens,
                _modelProfileEditor.Enabled,
                _modelProfileEditor.IsDefault,
                _modelProfileEditor.IsMaintenanceRunDefault,
                _modelProfileEditor.IsProposalReviewDefault,
                _modelProfileEditor.IsAdminMaintenanceChatDefault,
                ParseRoleText(_modelProfileEditor.AllowedRolesText),
                _modelProfileEditor.Description), CancellationToken.None);
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "Model profile could not be saved.", Severity.Error);
                return;
            }

            Snackbar.Add("Model profile saved.", Severity.Success);
            _modelProfileEditor = result.Profile is null ? ModelProfileEditor.New() : ModelProfileEditor.From(result.Profile);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteModelProfileAsync(ChatModelProfileView profile)
    {
        if (!await Dialogs.ConfirmDestructiveActionAsync(
            "Delete model profile?",
            $"Delete model profile \"{profile.DisplayName}\". This removes the saved profile configuration; recreate it from Admin Models if needed.",
            "Delete model profile"))
        {
            return;
        }

        _isBusy = true;
        var result = await ModelProfiles.DeleteAsync(profile.Id, CancellationToken.None);
        if (result.Succeeded)
        {
            Snackbar.Add("Model profile deleted.", Severity.Success);
            await StartNewModelProfile();
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error ?? "Model profile could not be deleted.", Severity.Error);
        }

        _isBusy = false;
    }

    private RenderFragment SettingEditor(EditableConfigurationRow row) => builder =>
    {
        switch (row.Item.ValueKind)
        {
            case nameof(AdminSettingValueKind.Boolean):
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Value", bool.TryParse(row.PendingValue, out var boolean) && boolean);
                builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, value => SetPendingValue(row, value ? "true" : "false")));
                builder.AddAttribute(3, "Disabled", _isBusy);
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.Choice):
                builder.OpenComponent<MudSelect<string>>(10);
                builder.AddAttribute(11, "Value", row.PendingValue);
                builder.AddAttribute(12, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(13, "Dense", true);
                builder.AddAttribute(14, "Variant", Variant.Outlined);
                builder.AddAttribute(15, "Margin", Margin.Dense);
                builder.AddAttribute(16, "Disabled", _isBusy);
                builder.AddAttribute(17, "ChildContent", (RenderFragment)(selectBuilder =>
                {
                    var sequence = 0;
                    foreach (var option in row.Item.Options)
                    {
                        selectBuilder.OpenComponent<MudSelectItem<string>>(sequence++);
                        selectBuilder.AddAttribute(sequence++, "Value", option);
                        selectBuilder.AddContent(sequence++, option);
                        selectBuilder.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.StringList):
                builder.OpenComponent<MudTextField<string>>(20);
                builder.AddAttribute(21, "Value", row.PendingValue);
                builder.AddAttribute(22, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(23, "Dense", true);
                builder.AddAttribute(24, "Variant", Variant.Outlined);
                builder.AddAttribute(25, "Margin", Margin.Dense);
                builder.AddAttribute(26, "Lines", 3);
                builder.AddAttribute(27, "Disabled", _isBusy);
                builder.CloseComponent();
                break;
            default:
                builder.OpenComponent<MudTextField<string>>(30);
                builder.AddAttribute(31, "Value", row.PendingValue);
                builder.AddAttribute(32, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(33, "Dense", true);
                builder.AddAttribute(34, "Variant", Variant.Outlined);
                builder.AddAttribute(35, "Margin", Margin.Dense);
                builder.AddAttribute(36, "Disabled", _isBusy);
                builder.AddAttribute(37, "InputType", row.Item.IsSensitive ? InputType.Password : InputType.Text);
                builder.CloseComponent();
                break;
        }
    };

    private static void SetPendingValue(EditableConfigurationRow row, string? value)
    {
        row.PendingValue = value ?? string.Empty;
    }

    private async Task SaveSettingAsync(EditableConfigurationRow row)
    {
        _isBusy = true;
        var result = await Settings.UpdateAsync(new AdminSettingUpdateRequest(row.Item.Key, row.PendingValue), CancellationToken.None);
        if (result.Succeeded)
        {
            Snackbar.Add($"{row.Item.Label} saved.", Severity.Success);
            _isBusy = false;
            await LoadAsync();
            return;
        }

        Snackbar.Add(result.Error ?? "Setting could not be saved.", Severity.Error);
        _isBusy = false;
    }

    private int ProviderLinkCount(string providerName) => _providerLinkCounts.TryGetValue(providerName, out var count) ? count : 0;

    private static string ProviderStatusClass(AuthProviderRecord provider) => provider.IsEnabled ? "wiki-status is-core" : "wiki-status";

    private static string ProviderToggleText(AuthProviderRecord provider) => provider.IsEnabled ? "Disable" : "Enable";

    private static Color ProviderToggleColor(AuthProviderRecord provider) => provider.IsEnabled ? Color.Warning : Color.Success;

    private string ProviderToggleLabel(AuthProviderRecord provider) => $"{ProviderToggleText(provider)} {provider.DisplayName} sign-in provider";

    private string ProviderToggleTooltip(AuthProviderRecord provider)
    {
        if (IsSystemProvider(provider))
        {
            return "Built-in system providers are managed by the app and cannot be toggled here.";
        }

        if (!provider.IsEnabled && !IsProviderConfiguredForUse(provider.ProviderName))
        {
            return $"Configure {provider.DisplayName} before enabling this sign-in provider.";
        }

        return provider.IsEnabled
            ? $"Disable {provider.DisplayName} sign-in after confirmation."
            : $"Enable {provider.DisplayName} sign-in after confirmation.";
    }

    private string ProviderActionImpact(AuthProviderRecord provider)
    {
        if (IsSystemProvider(provider))
        {
            return "Built-in provider; no manual action is available.";
        }

        if (!provider.IsEnabled && !IsProviderConfiguredForUse(provider.ProviderName))
        {
            return "Configuration is incomplete, so enabling is blocked until prerequisites are set.";
        }

        var links = ProviderLinkCount(provider.ProviderName);
        return provider.IsEnabled
            ? $"Disabling pauses this sign-in path for {links:N0} linked account(s) until it is re-enabled."
            : "Enabling makes this configured sign-in path available to users.";
    }

    private string ProviderToggleConfirmation(AuthProviderRecord provider, bool enabled)
    {
        var links = ProviderLinkCount(provider.ProviderName);
        return enabled
            ? $"Enable {provider.DisplayName} sign-in. This makes the configured provider available to users."
            : $"Disable {provider.DisplayName} sign-in. {links:N0} linked account(s) will be unable to use this provider until it is re-enabled.";
    }

    private bool CanToggleProvider(AuthProviderRecord provider) => !IsSystemProvider(provider) && (provider.IsEnabled || IsProviderConfiguredForUse(provider.ProviderName));

    private static bool IsSystemProvider(AuthProviderRecord provider) => string.Equals(provider.ProviderName, MemorySmithProviders.System, StringComparison.OrdinalIgnoreCase);

    private bool IsProviderConfiguredForUse(string providerName)
    {
        var auth = Options.CurrentValue.Auth;
        return providerName switch
        {
            MemorySmithProviders.LocalPassword => auth.LocalPasswordEnabled,
            MemorySmithProviders.ApiToken => !string.IsNullOrWhiteSpace(Options.CurrentValue.ApiKey),
            MemorySmithProviders.System => true,
            MemorySmithProviders.GitHub => auth.Providers.GitHub.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.GitHub.ClientId),
            MemorySmithProviders.Google => auth.Providers.Google.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.Google.ClientId),
            MemorySmithProviders.Microsoft => auth.Providers.Microsoft.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.Microsoft.ClientId),
            _ => false
        };
    }

    private static string FormatContextWindow(int? tokens) => tokens is null ? "Provider default" : $"{tokens.Value:n0}";

    private static string FormatModelOption(ChatModelSummary model)
    {
        var details = new List<string>();
        if (model.ContextWindowTokens is > 0) details.Add($"{model.ContextWindowTokens.Value:n0} context");
        if (!string.IsNullOrWhiteSpace(model.Description)) details.Add(model.Description);
        return details.Count == 0 ? model.Name : $"{model.Name} ({string.Join(" - ", details)})";
    }

    private void ApplySelectedModelMetadata(string? modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
        {
            return;
        }

        var model = _modelProfileModelOptions.FirstOrDefault(item => string.Equals(item.Name, modelName, StringComparison.OrdinalIgnoreCase));
        if (_modelProfileEditor.ContextWindowTokens is null && model?.ContextWindowTokens is > 0)
        {
            _modelProfileEditor.ContextWindowTokens = model.ContextWindowTokens;
        }
    }

    private IChatProvider? ResolveChatProvider(string providerName) =>
        ChatProviders.FirstOrDefault(candidate => ProviderMatches(candidate.Name, providerName));

    private static IReadOnlyList<ChatModelSummary> MergeCurrentModel(IReadOnlyList<ChatModelSummary> discovered, string? currentModel, string providerName)
    {
        var models = discovered
            .Where(model => !string.IsNullOrWhiteSpace(model.Name))
            .OrderByDescending(model => model.IsPreferred)
            .ThenBy(model => model.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!string.IsNullOrWhiteSpace(currentModel) && models.All(model => !string.Equals(model.Name, currentModel.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            models.Insert(0, new ChatModelSummary(currentModel.Trim(), Provider: providerName, Description: "Currently configured; not returned by provider discovery."));
        }

        return models;
    }

    private static bool ProviderMatches(string left, string right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(left, "GitHub", StringComparison.OrdinalIgnoreCase) && string.Equals(right, "Copilot", StringComparison.OrdinalIgnoreCase)) ||
        (string.Equals(left, "GitHubCopilot", StringComparison.OrdinalIgnoreCase) && string.Equals(right, "GitHub", StringComparison.OrdinalIgnoreCase));

    private static string FormatProfileRoles(ChatModelProfileView profile) => profile.AllowedRoles.Count == 0 ? "All chat users" : string.Join(", ", profile.AllowedRoles);

    private static string FormatProfileAssignments(ChatModelProfileView profile)
    {
        var assignments = new List<string>();
        if (profile.IsMaintenanceRunDefault) assignments.Add("Maintenance runs");
        if (profile.IsProposalReviewDefault) assignments.Add("Proposal reviews");
        if (profile.IsAdminMaintenanceChatDefault) assignments.Add("Admin maintenance chat");
        return assignments.Count == 0 ? "None" : string.Join(", ", assignments);
    }

