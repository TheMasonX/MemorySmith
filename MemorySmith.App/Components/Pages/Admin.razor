        public static ModelProfileEditor From(ChatModelProfileView profile) => new()
        {
            Id = profile.IsImplicit ? null : profile.Id,
            Name = profile.Name,
            Provider = profile.Provider,
            Model = profile.Model,
            ContextWindowTokens = profile.ContextWindowTokens,
            Enabled = profile.Enabled,
            IsDefault = profile.IsDefault,
            IsMaintenanceRunDefault = profile.IsMaintenanceRunDefault,
            IsProposalReviewDefault = profile.IsProposalReviewDefault,
            IsAdminMaintenanceChatDefault = profile.IsAdminMaintenanceChatDefault,
            AllowedRolesText = string.Join(", ", profile.AllowedRoles),
            Description = profile.Description
        };
    }
}