    private void LoadVariables()
    {
        _variableRows = VarResolver.GetVars()
            .OrderBy(kvp => kvp.Key, StringComparer.OrdinalIgnoreCase)
            .Select(kvp => new VarRow { Name = kvp.Key, Value = kvp.Value })
            .ToList();
    }

    private void AddVariableRow() => _variableRows.Add(new VarRow());

    private static InputType VariableValueInputType(VarRow row) => row.IsValueRevealed ? InputType.Text : InputType.Password;

    private static string VariableRevealIcon(VarRow row) => row.IsValueRevealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private static string VariableRevealLabel(VarRow row) => row.IsValueRevealed ? $"Hide {VariableNameLabel(row)} value" : $"Reveal {VariableNameLabel(row)} value";

    private static string VariableCopyLabel(VarRow row) => $"Copy {VariableNameLabel(row)} value";

    private static string VariableNameLabel(VarRow row) => string.IsNullOrWhiteSpace(row.Name) ? "variable" : row.Name.Trim();

    private static void ToggleVariableValueReveal(VarRow row)
    {
        row.IsValueRevealed = !row.IsValueRevealed;
    }

    private async Task CopyVariableValueAsync(VarRow row)
    {
        if (string.IsNullOrWhiteSpace(row.Value))
        {
            Snackbar.Add($"No {VariableNameLabel(row)} value to copy.", Severity.Info);
            return;
        }

        var copied = await SafeJsInterop.TryInvokeVoidAsync(JS, "navigator.clipboard.writeText", row.Value);
        Snackbar.Add(copied ? $"{VariableNameLabel(row)} value copied." : "Clipboard unavailable. Reveal the value and copy it manually.", copied ? Severity.Success : Severity.Warning);
    }

    private void RemoveVariableRow(int index)
    {
        if (index < 0 || index >= _variableRows.Count)
        {
            return;
        }

        _variableRows.RemoveAt(index);
    }

    private Task SaveVariablesAsync()
    {
        var vars = _variableRows
            .Where(row => !string.IsNullOrWhiteSpace(row.Name))
            .ToDictionary(
                row => row.Name.Trim(),
                row => row.Value.Trim(),
                StringComparer.OrdinalIgnoreCase);

        VarResolver.SaveVars(vars);
        Snackbar.Add("Variables saved.", Severity.Success);
        LoadVariables();
        return Task.CompletedTask;
    }

    private static IReadOnlyList<string> ParseRoleText(string value) => value
        .Replace("\r", string.Empty)
        .Split([',', ';', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(role => !string.IsNullOrWhiteSpace(role))
        .ToList();

    private static string? ProviderOAuthSetupUrl(string providerName) => providerName switch
    {
        MemorySmithProviders.GitHub => "https://github.com/settings/developers",
        MemorySmithProviders.Google => "https://console.cloud.google.com/apis/credentials",
        MemorySmithProviders.Microsoft => "https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade",
        _ => null
    };

    private string ProviderConfigurationLabel(string providerName)
    {
        var auth = Options.CurrentValue.Auth;
        return providerName switch
        {
            MemorySmithProviders.LocalPassword => auth.LocalPasswordEnabled ? "Configured" : "Not configured",
            MemorySmithProviders.ApiToken => string.IsNullOrWhiteSpace(Options.CurrentValue.ApiKey) ? "No shared key" : "Shared key configured",
            MemorySmithProviders.System => "Built-in",
            MemorySmithProviders.GitHub => auth.Providers.GitHub.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.GitHub.ClientId) ? "Configured" : "Not configured",
            MemorySmithProviders.Google => auth.Providers.Google.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.Google.ClientId) ? "Configured" : "Not configured",
            MemorySmithProviders.Microsoft => auth.Providers.Microsoft.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.Microsoft.ClientId) ? "Configured" : "Not configured",
            _ => "Unknown"
        };
    }

    private bool IsSettingGroupExpanded(string category) => _expandedSettingGroups.Contains(category);

    private void ToggleSettingGroupExpanded(string category)
    {
        if (!_expandedSettingGroups.Remove(category))
        {
            _expandedSettingGroups.Add(category);
        }
    }

    private bool MatchesSettingFilter(EditableConfigurationRow row)
    {
        if (!IsAllFilter(_settingsCategory) && !string.Equals(row.Item.Category, _settingsCategory, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_settingsSearch, row.Item.Category, row.Item.Label, row.Item.Key, row.Item.ValueKind, row.Item.HelpText, row.PendingValue);
    }

    private bool MatchesAuditFilter(AuditLogEntry entry)
    {
        if (!IsAllFilter(_auditOutcomeFilter) && !string.Equals(entry.Outcome, _auditOutcomeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!IsAllFilter(_auditTargetKindFilter) && !string.Equals(entry.TargetKind, _auditTargetKindFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_auditSearch, entry.ActorDisplay, entry.ActorUserId, entry.Action, entry.TargetKind, entry.TargetId, entry.Outcome, entry.Reason, entry.RequestId, entry.CorrelationId, entry.DetailsJson);
    }

    private bool MatchesHistoryFilter(VersionHistoryEntry entry)
    {
        if (!IsAllFilter(_historyTargetKindFilter) && !string.Equals(entry.TargetKind, _historyTargetKindFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!IsAllFilter(_historyFormatFilter) && !string.Equals(entry.Format, _historyFormatFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_historySearch, entry.TargetKind, entry.TargetId, entry.VersionId, entry.ParentVersionId, entry.Format, entry.HistoryPath, entry.CreatedByUserId, entry.AuditId);
    }

    private static bool IsAllFilter(string value) => string.IsNullOrWhiteSpace(value) || string.Equals(value, AllFilterValue, StringComparison.OrdinalIgnoreCase);

    private static bool IsSearchMatch(string search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        var text = search.Trim();
        return values.Any(value => !string.IsNullOrWhiteSpace(value) && value.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private static IReadOnlyList<string> DistinctSorted(IEnumerable<string?> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<ConfigurationItem> BuildConfigurationItems()
    {
        var root = JsonSerializer.SerializeToNode(Options.CurrentValue, JsonOptions);
        var items = new List<ConfigurationItem>();
        FlattenConfiguration("MemorySmith", root, items);
        return items.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static void FlattenConfiguration(string key, JsonNode? node, List<ConfigurationItem> items)
    {
        switch (node)
        {
            case JsonObject obj when obj.Count > 0:
                foreach (var child in obj.OrderBy(child => child.Key, StringComparer.OrdinalIgnoreCase))
                {
                    FlattenConfiguration($"{key}:{child.Key}", child.Value, items);
                }
                break;
            case JsonArray array when array.Count > 0:
                for (var i = 0; i < array.Count; i++)
                {
                    FlattenConfiguration($"{key}:{i}", array[i], items);
                }
                break;
            default:
                items.Add(CreateConfigurationItem(key, node));
                break;
        }
    }

    private static ConfigurationItem CreateConfigurationItem(string key, JsonNode? node)
    {
        var sensitive = IsSensitiveKey(key);
        var value = FormatConfigValue(node, sensitive);
        return !sensitive && ShouldMaskOperationalValue(value)
            ? new ConfigurationItem(key, MaskOperationalValue(value), value)
            : new ConfigurationItem(key, value, null);
    }

    private static bool IsSensitiveKey(string key)
    {
        var name = key.Split(':').Last();
        return name.Contains("Secret", StringComparison.OrdinalIgnoreCase)
            || name.Contains("ApiKey", StringComparison.OrdinalIgnoreCase)
            || name.Contains("ConnectionString", StringComparison.OrdinalIgnoreCase)
            || name.Contains("PasswordHash", StringComparison.OrdinalIgnoreCase)
            || name.Contains("BootstrapToken", StringComparison.OrdinalIgnoreCase)
            || name.Equals("ClientId", StringComparison.OrdinalIgnoreCase)
            || name.Equals("ClientSecret", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatConfigValue(JsonNode? node, bool sensitive)
    {
        if (node is null)
        {
            return sensitive ? "Not configured" : "(null)";
        }

        if (sensitive)
        {
            var raw = node.ToJsonString(JsonOptions);
            return raw is "null" or "\"\"" ? "Not configured" : "Configured";
        }

        if (node is JsonValue value)
        {
            if (value.TryGetValue<string>(out var text)) return string.IsNullOrEmpty(text) ? "(empty)" : text;
            if (value.TryGetValue<bool>(out var boolean)) return boolean ? "true" : "false";
            if (value.TryGetValue<int>(out var number)) return number.ToString();
            if (value.TryGetValue<long>(out var longNumber)) return longNumber.ToString();
            if (value.TryGetValue<double>(out var doubleNumber)) return doubleNumber.ToString("G");
        }

        return node.ToJsonString(JsonOptions);
    }

    private static bool ShouldMaskOperationalValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value is "(empty)" or "(null)" or "true" or "false")
        {
            return false;
        }

        return LooksLikeEmail(value) || LooksLikeLocalPath(value);
    }

    private static string MaskOperationalValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        if (LooksLikeEmail(value))
        {
            return MaskEmail(value);
        }

        if (LooksLikeLocalPath(value))
        {
            return MaskPath(value);
        }

        return SummarizeIdentifier(value);
    }

    private static bool LooksLikeEmail(string value)
    {
        var atIndex = value.IndexOf('@');
        return atIndex > 0 && atIndex < value.Length - 1 && value[(atIndex + 1)..].Contains('.');
    }

    private static bool LooksLikeLocalPath(string value) => value.Contains(@":\", StringComparison.Ordinal) || value.StartsWith(@"\\", StringComparison.Ordinal) || value.StartsWith("/", StringComparison.Ordinal);

    private static string MaskEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        var atIndex = value.IndexOf('@');
        if (atIndex <= 0 || atIndex == value.Length - 1)
        {
            return SummarizeIdentifier(value);
        }

        var local = value[..atIndex];
        var domain = value[(atIndex + 1)..];
        var visibleLocal = local.Length <= 2 ? local[..1] : local[..Math.Min(2, local.Length)];
        return $"{visibleLocal}...@{domain}";
    }

    private static string MaskPath(string value)
    {
        var trimmed = value.Trim();
        var separator = trimmed.Contains('\\') ? '\\' : '/';
        var parts = trimmed.Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var leaf = parts.LastOrDefault() ?? "path";

        if (trimmed.Length >= 2 && trimmed[1] == ':')
        {
            return $"{trimmed[..2]}{separator}...{separator}{leaf}";
        }

        return trimmed.StartsWith(@"\\", StringComparison.Ordinal)
            ? $@"\\...\{leaf}"
            : $"...{separator}{leaf}";
    }

    private static string SummarizeIdentifier(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        return value.Length <= 10 ? value : $"{value[..4]}...{value[^4..]}";
    }

    private async Task<IReadOnlyList<VersionHistoryEntry>> LoadRecentVersionsAsync()
    {
        var audits = await Database.AuditLogs.QueryAsync(new AuditLogQuery(PageSize: 50), CancellationToken.None);
        var versions = new List<VersionHistoryEntry>();
        foreach (var audit in audits.Data.Where(a => a.TargetKind is "Memory" or "Page" && !string.IsNullOrWhiteSpace(a.TargetId)).Take(20))
        {
            versions.AddRange(await Database.VersionHistory.GetHistoryAsync(audit.TargetKind, audit.TargetId!, CancellationToken.None));
        }

        return versions
            .GroupBy(version => version.VersionId)
            .Select(group => group.First())
            .OrderByDescending(version => version.CreatedAtUtc)
            .Take(50)
            .ToList();
    }

    private sealed record UserAdminRow(UserAccount User, IReadOnlyList<RoleRecord> Roles)
    {
        public bool IsAdmin => Roles.Any(role => string.Equals(role.Name, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase));

        public string SelectedRole => Roles.FirstOrDefault(role => string.Equals(role.Name, MemorySmithRoles.Editor, StringComparison.OrdinalIgnoreCase))?.Name
            ?? Roles.FirstOrDefault(role => string.Equals(role.Name, MemorySmithRoles.Viewer, StringComparison.OrdinalIgnoreCase))?.Name
            ?? MemorySmithRoles.Viewer;
    }

