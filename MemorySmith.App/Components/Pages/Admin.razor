    private void ApplySelectedModelMetadata(string? modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
        {
            return;
        }

        var model = _modelProfileModelOptions.FirstOrDefault(item => string.Equals(item.Name, modelName, StringComparison.OrdinalIgnoreCase));
        if (_modelProfileEditor.ContextWindowTokens is null && model?.ContextWindowTokens is > 0)
        {
            _modelProfileEditor.ContextWindowTokens = model.ContextWindowTokens;
            return;
        }

        if (_modelProfileEditor.ContextWindowTokens is null && IsQwen35FourBModel(modelName))
        {
            _modelProfileEditor.ContextWindowTokens = RecommendedQwen35ContextTokens;
        }
    }

    private static bool IsQwen35FourBModel(string modelName) =>
        modelName.Contains("qwen3.5", StringComparison.OrdinalIgnoreCase)
        && modelName.Contains(":4b", StringComparison.OrdinalIgnoreCase);

    private static string BuildModelVramEstimateHint(ChatModelSummary? model, int? contextWindowTokens)
    {
        var contextTokens = contextWindowTokens ?? RecommendedQwen35ContextTokens;
        if (model is null)
        {
            return $"VRAM estimate appears after selecting a discovered model. For qwen3.5:4b, start at {RecommendedQwen35ContextTokens:n0} tokens.";
        }

        var baseModelGiB = EstimateModelGiB(model);
        if (baseModelGiB is null)
        {
            return $"VRAM estimate unavailable for '{model.Name}'. Use {RecommendedQwen35ContextTokens:n0} tokens as the qwen3.5:4b baseline and verify on-host telemetry.";
        }

        var contextOverheadGiB = (contextTokens / 1024d) * 0.03d;
        var workingSetGiB = (baseModelGiB.Value * 1.15d) + contextOverheadGiB;
        var peakGiB = workingSetGiB * 1.35d;
        return $"Estimated VRAM envelope for {model.Name} at {contextTokens:n0} tokens: {workingSetGiB:0.0}-{peakGiB:0.0} GiB (approximate, verify on target GPU).";
    }

    private static double? EstimateModelGiB(ChatModelSummary model)
    {
        if (model.Size is > 0)
        {
            return model.Size.Value / (1024d * 1024d * 1024d);
        }

        var match = System.Text.RegularExpressions.Regex.Match(model.Name, @"(?<!\d)(\d+(?:\.\d+)?)b(?![a-z])", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!match.Success)
        {
            return null;
        }

        return double.TryParse(match.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var billions)
            ? billions * 0.9d
            : null;
    }

    private IChatProvider? ResolveChatProvider(string providerName) =>
        ChatProviders.FirstOrDefault(candidate => ProviderMatches(candidate.Name, providerName));

    private static IReadOnlyList<ChatModelSummary> MergeCurrentModel(IReadOnlyList<ChatModelSummary> discovered, string? currentModel, string providerName)
    {
        var models = discovered
            .Where(model => !string.IsNullOrWhiteSpace(model.Name))
            .OrderByDescending(model => model.IsPreferred)
            .ThenBy(model => model.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!string.IsNullOrWhiteSpace(currentModel) && models.All(model => !string.Equals(model.Name, currentModel.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            models.Insert(0, new ChatModelSummary(currentModel.Trim(), Provider: providerName, Description: "Currently configured; not returned by provider discovery."));
        }

        return models;
    }

    private static bool ProviderMatches(string left, string right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(left, "GitHub", StringComparison.OrdinalIgnoreCase) && string.Equals(right, "Copilot", StringComparison.OrdinalIgnoreCase)) ||
        (string.Equals(left, "GitHubCopilot", StringComparison.OrdinalIgnoreCase) && string.Equals(right, "GitHub", StringComparison.OrdinalIgnoreCase));

