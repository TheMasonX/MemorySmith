@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MemorySmithPolicies.CanAdminMemorySmith)]
@inject IMemorySmithDatabase Database
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ICurrentUserContext CurrentUser
@inject AuditLogService Audit
@inject AdminSettingsService Settings
@inject ISnackbar Snackbar
@using Microsoft.Extensions.Options
@using System.Text.Json
@using System.Text.Json.Nodes

<PageTitle>Admin</PageTitle>

<div class="wiki-workbench admin-workbench">
    <section class="wiki-commandbar" aria-label="Admin">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Admin</MudText>
            <span class="wiki-count">Users, providers, settings, audit, history</span>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
    </section>

    <MudTabs Rounded="false" Elevation="0" Class="admin-tabs">
        <MudTabPanel Text="Users" Icon="@Icons.Material.Filled.People">
            <MudTable Items="@_userRows" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>User</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Last login</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <strong>@context.User.DisplayName</strong><br />
                        <small>@context.User.UserId</small>
                    </MudTd>
                    <MudTd>@(context.User.Email ?? "-")</MudTd>
                    <MudTd>@(context.User.IsDisabled ? "Disabled" : "Active")</MudTd>
                    <MudTd>
                        @if (context.IsAdmin)
                        {
                            <span class="wiki-status is-core">Admin</span>
                        }
                        else
                        {
                            <MudSelect T="string" Value="@context.SelectedRole" ValueChanged="@((string role) => ChangeUserRoleAsync(context, role))" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isBusy">
                                @foreach (var role in _assignableRoles)
                                {
                                    <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudTd>
                    <MudTd>@(context.User.LastLoginAtUtc?.ToLocalTime().ToString("g") ?? "-")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_isBusy || context.IsAdmin || context.User.IsDisabled)" OnClick="@(() => DisableUserAsync(context))">Disable</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Providers" Icon="@Icons.Material.Filled.Link">
            <MudTable Items="@_providers" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Provider</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Configured</MudTh>
                    <MudTh>Links</MudTh>
                    <MudTh>Updated</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="admin-provider-cell">
                            <span>@context.DisplayName</span>
                            @if (ProviderOAuthSetupUrl(context.ProviderName) is { } setupUrl)
                            {
                                <a class="admin-provider-setup-link" href="@setupUrl" target="_blank" rel="noopener noreferrer" title="Open @context.DisplayName OAuth setup" aria-label="Open @context.DisplayName OAuth setup">
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                </a>
                            }
                        </div>
                    </MudTd>
                    <MudTd>@(context.IsEnabled ? "Enabled" : "Disabled")</MudTd>
                    <MudTd>@ProviderConfigurationLabel(context.ProviderName)</MudTd>
                    <MudTd>@ProviderLinkCount(context.ProviderName)</MudTd>
                    <MudTd>@context.UpdatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsEnabled ? Color.Warning : Color.Success)" Disabled="@_isBusy" OnClick="@(() => ToggleProviderAsync(context))">@(context.IsEnabled ? "Disable" : "Enable")</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Tune">
            <div class="admin-filter-bar" aria-label="Editable settings filters">
                <MudTextField T="string" Value="@_settingsSearch" ValueChanged="@((string value) => _settingsSearch = value)" Immediate="true" Label="Search settings" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_settingsCategory" ValueChanged="@((string value) => _settingsCategory = value)" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All categories</MudSelectItem>
                    @foreach (var category in SettingCategories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="admin-settings-groups">
                @foreach (var group in FilteredEditableSettingGroups)
                {
                    <details class="admin-settings-expander" open="@IsSettingGroupExpanded(group.Category)">
                        <summary @onclick="@(() => ToggleSettingGroupExpanded(group.Category))" @onclick:preventDefault>
                            <span>@group.Category</span>
                            <small>@group.Items.Count setting(s)</small>
                        </summary>
                        <MudTable Items="@group.Items" Dense="true" Class="health-table admin-settings-table" RowsPerPage="25">
                            <HeaderContent>
                                <MudTh>Setting</MudTh>
                                <MudTh>Value</MudTh>
                                <MudTh>Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <strong>@context.Item.Label</strong><br />
                                    <small>@context.Item.Key</small>
                                </MudTd>
                                <MudTd>@SettingEditor(context)</MudTd>
                                <MudTd>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isBusy || !context.IsDirty)" OnClick="@(() => SaveSettingAsync(context))">Save</MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </details>
                }
            </div>

            <div class="admin-filter-bar" aria-label="Effective configuration filters">
                <MudTextField T="string" Value="@_configurationSearch" ValueChanged="@((string value) => _configurationSearch = value)" Immediate="true" Label="Search effective configuration" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
            </div>

            <MudTable Items="@FilteredConfigurationItems" Dense="true" Class="health-table" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Key</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>@context.DisplayValue</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.FactCheck">
            <div class="admin-filter-bar" aria-label="Audit filters">
                <MudTextField T="string" Value="@_auditSearch" ValueChanged="@((string value) => _auditSearch = value)" Immediate="true" Label="Search audit" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_auditOutcomeFilter" ValueChanged="@((string value) => _auditOutcomeFilter = value)" Label="Outcome" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All outcomes</MudSelectItem>
                    @foreach (var outcome in AuditOutcomeOptions)
                    {
                        <MudSelectItem T="string" Value="@outcome">@outcome</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_auditTargetKindFilter" ValueChanged="@((string value) => _auditTargetKindFilter = value)" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All targets</MudSelectItem>
                    @foreach (var targetKind in AuditTargetKindOptions)
                    {
                        <MudSelectItem T="string" Value="@targetKind">@targetKind</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTable Items="@FilteredAudit" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Actor</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Target</MudTh>
                    <MudTh>Outcome</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OccurredAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@context.ActorDisplay</MudTd>
                    <MudTd>@context.Action</MudTd>
                    <MudTd>@context.TargetKind:@context.TargetId</MudTd>
                    <MudTd>@context.Outcome</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
            <div class="admin-filter-bar" aria-label="History filters">
                <MudTextField T="string" Value="@_historySearch" ValueChanged="@((string value) => _historySearch = value)" Immediate="true" Label="Search history" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="admin-filter-input" />
                <MudSelect T="string" Value="@_historyTargetKindFilter" ValueChanged="@((string value) => _historyTargetKindFilter = value)" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All targets</MudSelectItem>
                    @foreach (var targetKind in HistoryTargetKindOptions)
                    {
                        <MudSelectItem T="string" Value="@targetKind">@targetKind</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="@_historyFormatFilter" ValueChanged="@((string value) => _historyFormatFilter = value)" Label="Format" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="admin-filter-select">
                    <MudSelectItem T="string" Value="@AllFilterValue">All formats</MudSelectItem>
                    @foreach (var format in HistoryFormatOptions)
                    {
                        <MudSelectItem T="string" Value="@format">@format</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTable Items="@FilteredHistory" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Target</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Format</MudTh>
                    <MudTh>Artifact</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.TargetKind:@context.TargetId</MudTd>
                    <MudTd>@context.VersionNumber</MudTd>
                    <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@context.Format</MudTd>
                    <MudTd>@context.HistoryPath</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private const string AllFilterValue = "__all__";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<UserAdminRow> _userRows = [];
    private IReadOnlyList<RoleRecord> _roles = [];
    private IReadOnlyList<RoleRecord> _assignableRoles = [];
    private IReadOnlyList<AuthProviderRecord> _providers = [];
    private IReadOnlyList<AuditLogEntry> _audit = [];
    private IReadOnlyList<VersionHistoryEntry> _recentVersions = [];
    private IReadOnlyList<EditableConfigurationRow> _editableSettings = [];
    private IReadOnlyList<ConfigurationItem> _configurationItems = [];
    private Dictionary<string, int> _providerLinkCounts = new(StringComparer.OrdinalIgnoreCase);
    private string _settingsSearch = string.Empty;
    private string _settingsCategory = AllFilterValue;
    private HashSet<string> _expandedSettingGroups = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _knownSettingCategories = new(StringComparer.OrdinalIgnoreCase);
    private string _configurationSearch = string.Empty;
    private string _auditSearch = string.Empty;
    private string _auditOutcomeFilter = AllFilterValue;
    private string _auditTargetKindFilter = AllFilterValue;
    private string _historySearch = string.Empty;
    private string _historyTargetKindFilter = AllFilterValue;
    private string _historyFormatFilter = AllFilterValue;
    private bool _isBusy;

    private IReadOnlyList<string> SettingCategories => _editableSettings
        .Select(row => row.Item.Category)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<SettingCategoryGroup> FilteredEditableSettingGroups => _editableSettings
        .Where(MatchesSettingFilter)
        .GroupBy(row => row.Item.Category)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .Select(group => new SettingCategoryGroup(group.Key, group.OrderBy(row => row.Item.Label, StringComparer.OrdinalIgnoreCase).ToList()))
        .ToList();

    private IReadOnlyList<ConfigurationItem> FilteredConfigurationItems => _configurationItems
        .Where(item => IsSearchMatch(_configurationSearch, item.Key, item.DisplayValue))
        .ToList();

    private IReadOnlyList<string> AuditOutcomeOptions => DistinctSorted(_audit.Select(entry => entry.Outcome));
    private IReadOnlyList<string> AuditTargetKindOptions => DistinctSorted(_audit.Select(entry => entry.TargetKind));
    private IReadOnlyList<string> HistoryTargetKindOptions => DistinctSorted(_recentVersions.Select(entry => entry.TargetKind));
    private IReadOnlyList<string> HistoryFormatOptions => DistinctSorted(_recentVersions.Select(entry => entry.Format));

    private IReadOnlyList<AuditLogEntry> FilteredAudit => _audit
        .Where(MatchesAuditFilter)
        .ToList();

    private IReadOnlyList<VersionHistoryEntry> FilteredHistory => _recentVersions
        .Where(MatchesHistoryFilter)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var users = (await Database.Users.ListAsync(new UserQuery(PageSize: 100), CancellationToken.None)).Data;
        _roles = await Database.Roles.ListRolesAsync(CancellationToken.None);
        _assignableRoles = _roles.Where(role => !string.Equals(role.Name, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase)).ToList();
        var rows = new List<UserAdminRow>();
        _providerLinkCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach (var user in users)
        {
            var roles = await Database.Roles.GetRolesForUserAsync(user.UserId, CancellationToken.None);
            rows.Add(new UserAdminRow(user, roles));
            var links = await Database.ProviderLinks.GetLinksForUserAsync(user.UserId, CancellationToken.None);
            foreach (var link in links)
            {
                _providerLinkCounts.TryGetValue(link.ProviderName, out var count);
                _providerLinkCounts[link.ProviderName] = count + 1;
            }
        }

        _userRows = rows;
        _providers = await Database.ProviderLinks.ListProvidersAsync(CancellationToken.None);
        _audit = (await Database.AuditLogs.QueryAsync(new AuditLogQuery(PageSize: 100), CancellationToken.None)).Data;
        _recentVersions = await LoadRecentVersionsAsync();
        _editableSettings = Settings.ListEditableSettings().Select(item => new EditableConfigurationRow(item)).ToList();
        foreach (var category in SettingCategories)
        {
            if (_knownSettingCategories.Add(category))
            {
                _expandedSettingGroups.Add(category); // new categories start expanded; user-collapsed state is preserved
            }
        }
        _configurationItems = BuildConfigurationItems();
    }

    private async Task ChangeUserRoleAsync(UserAdminRow row, string roleName)
    {
        if (row.IsAdmin || string.Equals(roleName, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Admin roles are not changed from this view.", Severity.Warning);
            return;
        }

        _isBusy = true;
        var currentRoles = await Database.Roles.GetRolesForUserAsync(row.User.UserId, CancellationToken.None);
        if (currentRoles.Any(role => string.Equals(role.Name, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase)))
        {
            _isBusy = false;
            Snackbar.Add("Admin roles are not changed from this view.", Severity.Warning);
            return;
        }

        foreach (var role in currentRoles.Where(role => !string.Equals(role.Name, roleName, StringComparison.OrdinalIgnoreCase)))
        {
            await Database.Roles.RemoveRoleAsync(row.User.UserId, role.Name, CurrentUser.UserId, CancellationToken.None);
        }

        await Database.Roles.AssignRoleAsync(row.User.UserId, roleName, CurrentUser.UserId, CancellationToken.None);
        await Audit.RecordAsync("user.role.changed", "User", row.User.UserId, MemorySmithAuditOutcomes.Success, details: new { roleName }, cancellationToken: CancellationToken.None);
        Snackbar.Add($"{row.User.DisplayName} is now {roleName}.", Severity.Success);
        _isBusy = false;
        await LoadAsync();
    }

    private async Task DisableUserAsync(UserAdminRow row)
    {
        if (row.IsAdmin)
        {
            Snackbar.Add("Admin accounts are not disabled from this view.", Severity.Warning);
            return;
        }

        _isBusy = true;
        await Database.Users.DisableAsync(row.User.UserId, CurrentUser.UserId ?? MemorySmithProviders.System, CancellationToken.None);
        await Audit.RecordAsync("user.disabled", "User", row.User.UserId, MemorySmithAuditOutcomes.Success, cancellationToken: CancellationToken.None);
        Snackbar.Add($"{row.User.DisplayName} disabled.", Severity.Success);
        _isBusy = false;
        await LoadAsync();
    }

    private async Task ToggleProviderAsync(AuthProviderRecord provider)
    {
        _isBusy = true;
        var enabled = !provider.IsEnabled;
        await Database.ProviderLinks.SetProviderEnabledAsync(provider.ProviderName, enabled, CurrentUser.UserId, CancellationToken.None);
        await Audit.RecordAsync("provider.enabled.changed", "Provider", provider.ProviderName, MemorySmithAuditOutcomes.Success, details: new { enabled }, cancellationToken: CancellationToken.None);
        Snackbar.Add($"{provider.DisplayName} {(enabled ? "enabled" : "disabled")}.", Severity.Success);
        _isBusy = false;
        await LoadAsync();
    }

    private RenderFragment SettingEditor(EditableConfigurationRow row) => builder =>
    {
        switch (row.Item.ValueKind)
        {
            case nameof(AdminSettingValueKind.Boolean):
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Value", bool.TryParse(row.PendingValue, out var boolean) && boolean);
                builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, value => SetPendingValue(row, value ? "true" : "false")));
                builder.AddAttribute(3, "Disabled", _isBusy);
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.Choice):
                builder.OpenComponent<MudSelect<string>>(10);
                builder.AddAttribute(11, "Value", row.PendingValue);
                builder.AddAttribute(12, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(13, "Dense", true);
                builder.AddAttribute(14, "Variant", Variant.Outlined);
                builder.AddAttribute(15, "Margin", Margin.Dense);
                builder.AddAttribute(16, "Disabled", _isBusy);
                builder.AddAttribute(17, "ChildContent", (RenderFragment)(selectBuilder =>
                {
                    var sequence = 0;
                    foreach (var option in row.Item.Options)
                    {
                        selectBuilder.OpenComponent<MudSelectItem<string>>(sequence++);
                        selectBuilder.AddAttribute(sequence++, "Value", option);
                        selectBuilder.AddContent(sequence++, option);
                        selectBuilder.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            default:
                builder.OpenComponent<MudTextField<string>>(20);
                builder.AddAttribute(21, "Value", row.PendingValue);
                builder.AddAttribute(22, "ValueChanged", EventCallback.Factory.Create<string>(this, value => SetPendingValue(row, value)));
                builder.AddAttribute(23, "Dense", true);
                builder.AddAttribute(24, "Variant", Variant.Outlined);
                builder.AddAttribute(25, "Margin", Margin.Dense);
                builder.AddAttribute(26, "Disabled", _isBusy);
                builder.CloseComponent();
                break;
        }
    };

    private static void SetPendingValue(EditableConfigurationRow row, string? value)
    {
        row.PendingValue = value ?? string.Empty;
    }

    private async Task SaveSettingAsync(EditableConfigurationRow row)
    {
        _isBusy = true;
        var result = await Settings.UpdateAsync(new AdminSettingUpdateRequest(row.Item.Key, row.PendingValue), CancellationToken.None);
        if (result.Succeeded)
        {
            Snackbar.Add($"{row.Item.Label} saved.", Severity.Success);
            _isBusy = false;
            await LoadAsync();
            return;
        }

        Snackbar.Add(result.Error ?? "Setting could not be saved.", Severity.Error);
        _isBusy = false;
    }

    private int ProviderLinkCount(string providerName) => _providerLinkCounts.TryGetValue(providerName, out var count) ? count : 0;

    private static string? ProviderOAuthSetupUrl(string providerName) => providerName switch
    {
        MemorySmithProviders.GitHub => "https://github.com/settings/developers",
        MemorySmithProviders.Google => "https://console.cloud.google.com/apis/credentials",
        MemorySmithProviders.Microsoft => "https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade",
        _ => null
    };

    private string ProviderConfigurationLabel(string providerName)
    {
        var auth = Options.CurrentValue.Auth;
        return providerName switch
        {
            MemorySmithProviders.LocalPassword => auth.LocalPasswordEnabled ? "Configured" : "Not configured",
            MemorySmithProviders.ApiToken => string.IsNullOrWhiteSpace(Options.CurrentValue.ApiKey) ? "No shared key" : "Shared key configured",
            MemorySmithProviders.System => "Built-in",
            MemorySmithProviders.GitHub => auth.Providers.GitHub.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.GitHub.ClientId) ? "Configured" : "Not configured",
            MemorySmithProviders.Google => auth.Providers.Google.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.Google.ClientId) ? "Configured" : "Not configured",
            MemorySmithProviders.Microsoft => auth.Providers.Microsoft.Enabled && !string.IsNullOrWhiteSpace(auth.Providers.Microsoft.ClientId) ? "Configured" : "Not configured",
            _ => "Unknown"
        };
    }

    private bool IsSettingGroupExpanded(string category) => _expandedSettingGroups.Contains(category);

    private void ToggleSettingGroupExpanded(string category)
    {
        if (!_expandedSettingGroups.Remove(category))
        {
            _expandedSettingGroups.Add(category);
        }
    }

    private bool MatchesSettingFilter(EditableConfigurationRow row)
    {
        if (!IsAllFilter(_settingsCategory) && !string.Equals(row.Item.Category, _settingsCategory, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_settingsSearch, row.Item.Category, row.Item.Label, row.Item.Key, row.Item.ValueKind, row.PendingValue);
    }

    private bool MatchesAuditFilter(AuditLogEntry entry)
    {
        if (!IsAllFilter(_auditOutcomeFilter) && !string.Equals(entry.Outcome, _auditOutcomeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!IsAllFilter(_auditTargetKindFilter) && !string.Equals(entry.TargetKind, _auditTargetKindFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_auditSearch, entry.ActorDisplay, entry.ActorUserId, entry.Action, entry.TargetKind, entry.TargetId, entry.Outcome, entry.Reason, entry.RequestId, entry.CorrelationId, entry.DetailsJson);
    }

    private bool MatchesHistoryFilter(VersionHistoryEntry entry)
    {
        if (!IsAllFilter(_historyTargetKindFilter) && !string.Equals(entry.TargetKind, _historyTargetKindFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!IsAllFilter(_historyFormatFilter) && !string.Equals(entry.Format, _historyFormatFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return IsSearchMatch(_historySearch, entry.TargetKind, entry.TargetId, entry.VersionId, entry.ParentVersionId, entry.Format, entry.HistoryPath, entry.CreatedByUserId, entry.AuditId);
    }

    private static bool IsAllFilter(string value) => string.IsNullOrWhiteSpace(value) || string.Equals(value, AllFilterValue, StringComparison.OrdinalIgnoreCase);

    private static bool IsSearchMatch(string search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        var text = search.Trim();
        return values.Any(value => !string.IsNullOrWhiteSpace(value) && value.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private static IReadOnlyList<string> DistinctSorted(IEnumerable<string?> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<ConfigurationItem> BuildConfigurationItems()
    {
        var root = JsonSerializer.SerializeToNode(Options.CurrentValue, JsonOptions);
        var items = new List<ConfigurationItem>();
        FlattenConfiguration("MemorySmith", root, items);
        return items.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static void FlattenConfiguration(string key, JsonNode? node, List<ConfigurationItem> items)
    {
        switch (node)
        {
            case JsonObject obj when obj.Count > 0:
                foreach (var child in obj.OrderBy(child => child.Key, StringComparer.OrdinalIgnoreCase))
                {
                    FlattenConfiguration($"{key}:{child.Key}", child.Value, items);
                }
                break;
            case JsonArray array when array.Count > 0:
                for (var i = 0; i < array.Count; i++)
                {
                    FlattenConfiguration($"{key}:{i}", array[i], items);
                }
                break;
            default:
                items.Add(new ConfigurationItem(key, FormatConfigValue(node, IsSensitiveKey(key))));
                break;
        }
    }

    private static bool IsSensitiveKey(string key)
    {
        var name = key.Split(':').Last();
        return name.Contains("Secret", StringComparison.OrdinalIgnoreCase)
            || name.Contains("ApiKey", StringComparison.OrdinalIgnoreCase)
            || name.Contains("ConnectionString", StringComparison.OrdinalIgnoreCase)
            || name.Contains("PasswordHash", StringComparison.OrdinalIgnoreCase)
            || name.Contains("BootstrapToken", StringComparison.OrdinalIgnoreCase)
            || name.Equals("ClientId", StringComparison.OrdinalIgnoreCase)
            || name.Equals("ClientSecret", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatConfigValue(JsonNode? node, bool sensitive)
    {
        if (node is null)
        {
            return sensitive ? "Not configured" : "(null)";
        }

        if (sensitive)
        {
            var raw = node.ToJsonString(JsonOptions);
            return raw is "null" or "\"\"" ? "Not configured" : "Configured";
        }

        if (node is JsonValue value)
        {
            if (value.TryGetValue<string>(out var text)) return string.IsNullOrEmpty(text) ? "(empty)" : text;
            if (value.TryGetValue<bool>(out var boolean)) return boolean ? "true" : "false";
            if (value.TryGetValue<int>(out var number)) return number.ToString();
            if (value.TryGetValue<long>(out var longNumber)) return longNumber.ToString();
            if (value.TryGetValue<double>(out var doubleNumber)) return doubleNumber.ToString("G");
        }

        return node.ToJsonString(JsonOptions);
    }

    private async Task<IReadOnlyList<VersionHistoryEntry>> LoadRecentVersionsAsync()
    {
        var audits = await Database.AuditLogs.QueryAsync(new AuditLogQuery(PageSize: 50), CancellationToken.None);
        var versions = new List<VersionHistoryEntry>();
        foreach (var audit in audits.Data.Where(a => a.TargetKind is "Memory" or "Page" && !string.IsNullOrWhiteSpace(a.TargetId)).Take(20))
        {
            versions.AddRange(await Database.VersionHistory.GetHistoryAsync(audit.TargetKind, audit.TargetId!, CancellationToken.None));
        }

        return versions
            .GroupBy(version => version.VersionId)
            .Select(group => group.First())
            .OrderByDescending(version => version.CreatedAtUtc)
            .Take(50)
            .ToList();
    }

    private sealed record UserAdminRow(UserAccount User, IReadOnlyList<RoleRecord> Roles)
    {
        public bool IsAdmin => Roles.Any(role => string.Equals(role.Name, MemorySmithRoles.Admin, StringComparison.OrdinalIgnoreCase));

        public string SelectedRole => Roles.FirstOrDefault(role => string.Equals(role.Name, MemorySmithRoles.Editor, StringComparison.OrdinalIgnoreCase))?.Name
            ?? Roles.FirstOrDefault(role => string.Equals(role.Name, MemorySmithRoles.Viewer, StringComparison.OrdinalIgnoreCase))?.Name
            ?? MemorySmithRoles.Viewer;
    }

    private sealed class EditableConfigurationRow
    {
        public EditableConfigurationRow(AdminSettingItem item)
        {
            Item = item;
            PendingValue = item.Value;
        }

        public AdminSettingItem Item { get; }
        public string PendingValue { get; set; }
        public bool IsDirty => !string.Equals(PendingValue, Item.Value, StringComparison.Ordinal);
    }

    private sealed record SettingCategoryGroup(string Category, IReadOnlyList<EditableConfigurationRow> Items);

    private sealed record ConfigurationItem(string Key, string DisplayValue);
}