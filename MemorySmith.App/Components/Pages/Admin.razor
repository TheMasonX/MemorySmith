    private Task ApplyImportedSettingsAsync(IReadOnlyList<EditableConfigurationRow> rows, string scopeLabel)
    {
        if (!TryParseImportedSettingValues(_settingsTransferPayload, out var values, out var error))
        {
            Snackbar.Add(error ?? "Settings JSON could not be parsed.", Severity.Error);
            return Task.CompletedTask;
        }

        var applied = 0;
        foreach (var row in rows)
        {
            if (values.TryGetValue(row.Item.Key, out var importedValue))
            {
                row.PendingValue = importedValue;
                applied++;
            }
        }

        Snackbar.Add(applied == 0
            ? $"No imported settings matched the {scopeLabel} scope."
            : $"Applied {applied} imported setting value{(applied == 1 ? string.Empty : "s")} to the {scopeLabel} scope as pending changes.", applied == 0 ? Severity.Info : Severity.Success);
        return Task.CompletedTask;
    }

    private static string SerializeSettingValues(IEnumerable<EditableConfigurationRow> rows)
    {
        var payload = new JsonObject();
        foreach (var row in rows.OrderBy(item => item.Item.Key, StringComparer.OrdinalIgnoreCase))
        {
            payload[row.Item.Key] = row.PendingValue;
        }

        return payload.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
    }

    private static bool TryParseImportedSettingValues(string payload, out Dictionary<string, string> values, out string? error)
    {
        values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        error = null;
        if (string.IsNullOrWhiteSpace(payload))
        {
            error = "Paste exported settings JSON into the transfer box first.";
            return false;
        }

        try
        {
            using var document = JsonDocument.Parse(payload);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                error = "Settings import JSON must be an object keyed by config setting name.";
                return false;
            }

            foreach (var property in document.RootElement.EnumerateObject())
            {
                values[property.Name] = property.Value.ValueKind switch
                {
                    JsonValueKind.String => property.Value.GetString() ?? string.Empty,
                    JsonValueKind.True => "true",
                    JsonValueKind.False => "false",
                    JsonValueKind.Null => string.Empty,
                    JsonValueKind.Array => string.Join(Environment.NewLine, property.Value.EnumerateArray().Select(element => element.ToString())),
                    _ => property.Value.ToString()
                };
            }

            return true;
        }
        catch (JsonException ex)
        {
            error = ex.Message;
            return false;
        }
    }

