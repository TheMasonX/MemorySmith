    private static string FirstMeaningful(params string?[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? "-";

    private static string FormatByteSize(long value)
    {
        if (value < 1024)
        {
            return $"{value} B";
        }

        var units = new[] { "KB", "MB", "GB", "TB" };
        double size = value;
        var unitIndex = -1;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return unitIndex < 0 ? $"{value} B" : $"{size:0.#} {units[unitIndex]}";
    }

    private async Task CopyAdminValueAsync(string? value, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Snackbar.Add($"No {label} to copy.", Severity.Info);
            return;
        }

        var copied = await SafeJsInterop.TryInvokeVoidAsync(JS, "navigator.clipboard.writeText", value);
        Snackbar.Add(copied ? $"{CapitalizeLabel(label)} copied." : "Clipboard unavailable. Copy it manually from the table.", copied ? Severity.Success : Severity.Warning);
    }

    private static string CapitalizeLabel(string value) => string.IsNullOrWhiteSpace(value) ? "Value" : char.ToUpperInvariant(value[0]) + value[1..];

    private async Task<IReadOnlyList<VersionHistoryEntry>> LoadRecentVersionsAsync()
    {
        var audits = await Database.AuditLogs.QueryAsync(new AuditLogQuery(PageSize: 50), CancellationToken.None);
        var versions = new List<VersionHistoryEntry>();
        foreach (var audit in audits.Data.Where(a => a.TargetKind is "Memory" or "Page" && !string.IsNullOrWhiteSpace(a.TargetId)).Take(20))
        {
            versions.AddRange(await Database.VersionHistory.GetHistoryAsync(audit.TargetKind, audit.TargetId!, CancellationToken.None));
        }

        return versions
            .GroupBy(version => version.VersionId)
            .Select(group => group.First())
            .OrderByDescending(version => version.CreatedAtUtc)
            .Take(50)
            .ToList();
    }

