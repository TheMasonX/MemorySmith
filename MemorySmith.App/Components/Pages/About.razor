@page "/about"
@rendermode InteractiveServer

<PageTitle>About - MemorySmith</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">About MemorySmith</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    MemorySmith is a personal knowledge and memory management system. This application is released under the MIT License.
</MudText>

<MudDivider Class="my-4" />

<MudText Typo="Typo.h5" GutterBottom="true">Third-Party Licenses</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    MemorySmith uses the following open-source packages. Each is used under its respective license as noted.
</MudText>

<MudTable Items="_licenses" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="1">
    <HeaderContent>
        <MudTh>Package</MudTh>
        <MudTh>Version</MudTh>
        <MudTh>License</MudTh>
        <MudTh>Project URL</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Package"><MudText Typo="Typo.body2">@context.Name</MudText></MudTd>
        <MudTd DataLabel="Version"><MudText Typo="Typo.body2">@context.Version</MudText></MudTd>
        <MudTd DataLabel="License"><MudChip T="string" Size="Size.Small" Color="@LicenseColor(context.License)">@context.License</MudChip></MudTd>
        <MudTd DataLabel="Project URL">
            <MudLink Href="@context.Url" Target="_blank" Typo="Typo.body2">@context.Url</MudLink>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDivider Class="my-6" />

<MudText Typo="Typo.h6" GutterBottom="true">MemorySmith License (MIT)</MudText>
<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.body2" Style="white-space: pre-wrap; font-family: monospace;">@_mitLicenseText</MudText>
</MudPaper>

@code {
    private record LicenseEntry(string Name, string Version, string License, string Url);

    private static readonly Color[] _licenseColors = [Color.Success, Color.Info, Color.Warning];

    private Color LicenseColor(string license) => license switch
    {
        "MIT"         => Color.Success,
        "Apache-2.0"  => Color.Info,
        _             => Color.Default,
