@page "/about"
@rendermode InteractiveServer

<PageTitle>About - MemorySmith</PageTitle>

<div class="wiki-workbench about-workbench">
    <section class="wiki-commandbar about-commandbar" aria-label="About">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h4">About MemorySmith</MudText>
            <span class="wiki-count">MIT licensed</span>
        </div>
        <MudText Typo="Typo.body2" Class="about-summary-copy">
            MemorySmith is a personal knowledge and memory management system.
        </MudText>
    </section>

    <section class="about-overview-grid" aria-label="License overview">
        <div class="health-lower-card about-stat-card">
            <span>Packages</span>
            <strong>@_licenses.Length</strong>
        </div>
        <div class="health-lower-card about-stat-card">
            <span>License Families</span>
            <strong>@LicenseFamilies.Count()</strong>
        </div>
        <div class="health-lower-card about-stat-card">
            <span>Visible</span>
            <strong>@FilteredLicenses.Count</strong>
        </div>
    </section>

    <section class="health-lower-card about-license-panel" aria-label="Third-party licenses">
        <div class="about-section-header">
            <div>
                <MudText Typo="Typo.h5">Third-Party Licenses</MudText>
                <MudText Typo="Typo.body2" Class="about-muted">@FilteredLicenses.Count of @_licenses.Length packages shown</MudText>
            </div>
        </div>

        <div class="about-filter-row">
            <MudTextField T="string"
                          Value="@_licenseSearch"
                          ValueChanged="OnLicenseSearchChanged"
                          Immediate="true"
                          Label="Search dependencies"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="about-search-input" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" Disabled="@(!HasActiveFilter)" OnClick="ClearFilters">Clear</MudButton>
        </div>

        <div class="about-license-filters" aria-label="License filters">
            <MudButton Size="Size.Small" Variant="@LicenseFilterVariant(null)" Color="@LicenseFilterColor(null)" OnClick="@(() => SetLicenseFilter(null))">All</MudButton>
            @foreach (var license in LicenseFamilies)
            {
                <MudButton Size="Size.Small" Variant="@LicenseFilterVariant(license)" Color="@LicenseFilterColor(license)" OnClick="@(() => SetLicenseFilter(license))">@license (@CountLicenseFamily(license))</MudButton>
            }
        </div>

        @if (FilteredLicenses.Count == 0)
        {
            <div class="wiki-empty-state about-empty-state">No dependency licenses match the current filters.</div>
        }
        else
        {
            <MudTable Items="FilteredLicenses" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="0" Class="about-table">
                <HeaderContent>
                    <MudTh>Package</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>License</MudTh>
                    <MudTh>Project</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Package"><MudText Typo="Typo.body2">@context.Name</MudText></MudTd>
                    <MudTd DataLabel="Version"><MudText Typo="Typo.body2">@context.Version</MudText></MudTd>
                    <MudTd DataLabel="License"><MudChip T="string" Size="Size.Small" Color="@LicenseColor(context.License)">@context.License</MudChip></MudTd>
                    <MudTd DataLabel="Project" Class="about-url-cell">
                        <MudLink Href="@context.Url" Target="_blank" Typo="Typo.body2" title="@context.Url">@ProjectHost(context.Url)</MudLink>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </section>

    <details class="health-lower-card about-license-details">
        <summary>MemorySmith License (MIT)</summary>
        <pre class="about-license-text">@_mitLicenseText</pre>
    </details>
</div>

@code {
    private record LicenseEntry(string Name, string Version, string License, string Url);

    private string _licenseSearch = string.Empty;
    private string? _licenseFilter;

    private IReadOnlyList<LicenseEntry> FilteredLicenses => _licenses.Where(MatchesLicense).ToArray();
    private IEnumerable<string> LicenseFamilies => _licenses.Select(item => item.License).Distinct().OrderBy(item => item, StringComparer.OrdinalIgnoreCase);
    private bool HasActiveFilter => !string.IsNullOrWhiteSpace(_licenseSearch) || !string.IsNullOrWhiteSpace(_licenseFilter);

    private Color LicenseColor(string license) => license switch
    {
        "MIT"         => Color.Success,
        "Apache-2.0"  => Color.Info,
        _             => Color.Default,
    };

    private Variant LicenseFilterVariant(string? license) => IsSelectedLicenseFilter(license) ? Variant.Filled : Variant.Outlined;

    private Color LicenseFilterColor(string? license) => IsSelectedLicenseFilter(license) ? Color.Primary : Color.Default;

    private void OnLicenseSearchChanged(string value) => _licenseSearch = value;

    private void SetLicenseFilter(string? license) => _licenseFilter = string.IsNullOrWhiteSpace(license) ? null : license;

    private void ClearFilters()
    {
        _licenseSearch = string.Empty;
        _licenseFilter = null;
    }

    private bool IsSelectedLicenseFilter(string? license)
    {
        if (string.IsNullOrWhiteSpace(license))
        {
            return string.IsNullOrWhiteSpace(_licenseFilter);
        }

        return string.Equals(_licenseFilter, license, StringComparison.OrdinalIgnoreCase);
    }

    private int CountLicenseFamily(string license) => _licenses.Count(item => string.Equals(item.License, license, StringComparison.OrdinalIgnoreCase));

    private bool MatchesLicense(LicenseEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(_licenseFilter) && !string.Equals(entry.License, _licenseFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_licenseSearch))
        {
            return true;
        }

        return Contains(entry.Name, _licenseSearch)
            || Contains(entry.Version, _licenseSearch)
            || Contains(entry.License, _licenseSearch)
            || Contains(entry.Url, _licenseSearch);
    }

    private static bool Contains(string value, string search) => value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string ProjectHost(string url) => Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Host : url;

    private readonly LicenseEntry[] _licenses =
    [
        new("BenchmarkDotNet",                         "0.14.0",             "MIT",        "https://github.com/dotnet/BenchmarkDotNet"),
        new("coverlet.collector",                      "6.0.4",              "MIT",        "https://github.com/coverlet-coverage/coverlet"),
        new("GitHub.Copilot.SDK",                      "0.2.2",              "MIT",        "https://github.com/github/CopilotSdk"),
        new("Lucene.Net",                              "4.8.0-beta00017",    "Apache-2.0", "https://lucenenet.apache.org/"),
        new("Lucene.Net.Analysis.Common",              "4.8.0-beta00017",    "Apache-2.0", "https://lucenenet.apache.org/"),
        new("Markdig",                                 "0.38.0",             "BSD-2-Clause","https://github.com/xoofx/markdig"),
        new("Microsoft.AspNetCore.Mvc.Testing",        "10.0.7",             "MIT",        "https://github.com/dotnet/aspnetcore"),
        new("Microsoft.AspNetCore.OpenApi",            "10.0.6",             "MIT",        "https://github.com/dotnet/aspnetcore"),
        new("Microsoft.AspNetCore.SignalR.Client",     "10.0.7",             "MIT",        "https://github.com/dotnet/aspnetcore"),
        new("Microsoft.Extensions.Hosting.WindowsServices", "10.0.0",       "MIT",        "https://github.com/dotnet/runtime"),
        new("Microsoft.Extensions.Logging",            "10.0.7",             "MIT",        "https://github.com/dotnet/runtime"),
        new("Microsoft.NET.Test.Sdk",                  "17.14.0",            "MIT",        "https://github.com/microsoft/vstest"),
        new("MudBlazor",                               "9.4.0",              "MIT",        "https://mudblazor.com/"),
        new("Nerdbank.MessagePack",                    "1.1.62",             "MIT",        "https://github.com/AArnott/Nerdbank.MessagePack"),
        new("NUnit",                                   "4.3.2",              "MIT",        "https://nunit.org/"),
        new("NUnit.Analyzers",                         "4.7.0",              "MIT",        "https://github.com/nunit/nunit.analyzers"),
        new("NUnit3TestAdapter",                       "5.0.0",              "MIT",        "https://github.com/nunit/nunit3-vs-adapter"),
        new("Serilog.AspNetCore",                      "10.0.0",             "Apache-2.0", "https://github.com/serilog/serilog-aspnetcore"),
        new("Swashbuckle.AspNetCore",                  "10.1.7",             "MIT",        "https://github.com/domaindrivendev/Swashbuckle.AspNetCore"),
    ];

    private const string _mitLicenseText =
        """
        MIT License

        Copyright (c) 2026 Lucas Norr

        Permission is hereby granted, free of charge, to any person obtaining a copy
        of this software and associated documentation files (the "Software"), to deal
        in the Software without restriction, including without limitation the rights
        to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
        copies of the Software, and to permit persons to whom the Software is
        furnished to do so, subject to the following conditions:

        The above copyright notice and this permission notice shall be included in
        all copies or substantial portions of the Software.

        THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
        IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
        FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
        AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
        LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
        OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
        SOFTWARE.
        """;
}
