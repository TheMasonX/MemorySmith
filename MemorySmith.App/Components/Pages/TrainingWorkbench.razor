    private Task<IEnumerable<string>> SearchTrainingSettingsAsync(string? value, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        IEnumerable<TrainingSettingRow> matches = _trainingSettings;
        if (!string.IsNullOrWhiteSpace(value))
        {
            matches = matches.Where(row => row.Item.Label.Contains(value, StringComparison.OrdinalIgnoreCase)
                || row.Item.Key.Contains(value, StringComparison.OrdinalIgnoreCase)
                || row.Item.HelpText.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(matches.Select(row => row.Item.Key));
    }

    private string TrainingSettingDisplay(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return string.Empty;
        }

        var row = _trainingSettings.FirstOrDefault(item => string.Equals(item.Item.Key, key, StringComparison.OrdinalIgnoreCase));
        return row is null ? key : $"{row.Item.Label} ({row.Item.Key})";
    }

