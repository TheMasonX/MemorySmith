@page "/training-workbench"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MemorySmithPolicies.CanAdminMemorySmith)]
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject AdminSettingsService Settings
@inject VarResolver VarResolver
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject TrainingHarnessRunnerService TrainingRunner
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.Extensions.Options
@using MemorySmith.Core.Models
@using MemorySmith.App.Services.Training
@implements IDisposable

<PageTitle>Training Workbench - MemorySmith</PageTitle>

<div class="health-workbench">
    <div class="health-header">
        <MudText Typo="Typo.h4">Training Workbench</MudText>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@_isBusy">Refresh</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Tune" Disabled="@_isBusy" OnClick="OpenTrainingConfig">Training settings</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SmartToy" Disabled="@_isBusy" OnClick="OpenModels">Models</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@(_isBusy || _isLaunchingRun || _activeRun?.IsRunning == true)" OnClick="StartTrainingRunAsync">Start training run</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Science" Disabled="@(_isBusy || _isLaunchingRun || _activeRun?.IsRunning == true)" OnClick="StartDryRunAsync">Start dry run</MudButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-2">@_error</MudAlert>
    }

    @if (_snapshot is not null && !_snapshot.DependencyProbeReady)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-2">
            Training runs are currently in simulated mode. @_snapshot.DependencyProbeSummary
        </MudAlert>
    }

    <MudPaper Class="pa-4 mt-3" Outlined="true">
        <MudText Typo="Typo.subtitle2">Training Settings Proxy</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">These controls edit the same underlying admin configuration values used by the central Admin Configuration surface.</MudText>

        <div class="admin-filter-bar" aria-label="Training setting proxy controls">
            <MudAutocomplete T="string"
                             Value="@_selectedTrainingSettingKey"
                             ValueChanged="OnTrainingSettingSelectedAsync"
                             SearchFunc="SearchTrainingSettingsAsync"
                             ToStringFunc="TrainingSettingDisplay"
                             Label="Training setting"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Dense="true"
                             Clearable="false"
                             ResetValueOnEmptyText="false"
                             CoerceText="true"
                             Class="admin-filter-input" />
            <MudTooltip Text="Save the currently selected training setting only.">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_isBusy || SelectedTrainingSetting is null || !SelectedTrainingSetting.IsDirty)" OnClick="SaveSelectedTrainingSettingAsync">Save Selected</MudButton>
            </MudTooltip>
            <MudTooltip Text="Reset the currently selected training setting back to its last saved value.">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" Disabled="@(_isBusy || SelectedTrainingSetting is null || !SelectedTrainingSetting.IsDirty)" OnClick="ResetSelectedTrainingSetting">Reset Selected</MudButton>
            </MudTooltip>
            <MudTooltip Text="Save every pending training-setting change on this page.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.DoneAll" Disabled="@(_isBusy || TrainingDirtyCount == 0)" OnClick="SaveAllTrainingSettingsAsync">Save Training Changes (@TrainingDirtyCount)</MudButton>
            </MudTooltip>
        </div>

        @if (SelectedTrainingSetting is { } selectedSetting)
        {
            <div class="health-config-grid" style="margin-top:8px;">
                <span>Setting</span><strong>@selectedSetting.Item.Label</strong>
                <span>Key</span><strong>@selectedSetting.Item.Key</strong>
                <span>Category</span><strong>@selectedSetting.Item.Category</strong>
                <span>Status</span><strong>@(selectedSetting.IsDirty ? "Pending changes" : "Saved")</strong>
            </div>
            <MudText Typo="Typo.body2" Class="mt-2">@selectedSetting.Item.HelpText</MudText>
            <div class="mt-2">@TrainingSettingEditor(selectedSetting)</div>
        }

        <div class="admin-settings-save-all-row" style="margin-top:8px; justify-content:flex-start;">
            <MudTooltip Text="Export the current training-setting values into the transfer box below.">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="@_isBusy" OnClick="ExportTrainingSettingsAsync">Export Training Settings</MudButton>
            </MudTooltip>
            <MudTooltip Text="Copy the current training-settings JSON to the clipboard.">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_trainingSettingsTransferPayload))" OnClick="CopyTrainingSettingsTransferPayloadAsync">Copy JSON</MudButton>
            </MudTooltip>
            <MudTooltip Text="Apply imported JSON to matching training settings as pending changes without saving yet.">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_trainingSettingsTransferPayload))" OnClick="ApplyImportedTrainingSettingsAsync">Import Training Settings</MudButton>
            </MudTooltip>
        </div>
        <MudTextField T="string" Value="@_trainingSettingsTransferPayload" ValueChanged="@((string value) => _trainingSettingsTransferPayload = value)" Label="Training settings transfer JSON" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="5" HelperText="Export writes JSON here. Paste JSON here to import matching training settings as pending changes, then save the selected setting or all training changes." />
    </MudPaper>

    @if (_snapshot is not null)
    {
        @if (_activeRun is not null)
        {
            <MudAlert Severity="@(_activeRun.IsRunning ? Severity.Info : (_activeRun.ExitCode == 0 ? Severity.Success : Severity.Warning))" Dense="true" Variant="Variant.Outlined" Class="mt-2">
                Run @_activeRun.RunId - @(_activeRun.IsRunning ? "running" : (_activeRun.ExitCode == 0 ? "completed" : "finished with issues"))
                <span> (HF auth: @(_activeRun.HfAuthConfigured ? "configured" : "not configured"))</span>
                @if (!string.IsNullOrWhiteSpace(_activeRun.LastError))
                {
                    <span> (@_activeRun.LastError)</span>
                }
            </MudAlert>
        }

        <div class="health-stat-row">
            <div class="health-stat-card @(_snapshot.ChatTranscriptEnabled ? "is-core" : "is-deprecated")">
                <span class="health-stat-label">Chat Transcript</span>
                <span class="health-stat-value" style="font-size:1rem">@BoolLabel(_snapshot.ChatTranscriptEnabled)</span>
            </div>
            <div class="health-stat-card @(_snapshot.FeedbackEnabled ? "is-core" : "is-deprecated")">
                <span class="health-stat-label">Feedback</span>
                <span class="health-stat-value" style="font-size:1rem">@BoolLabel(_snapshot.FeedbackEnabled)</span>
            </div>
            <div class="health-stat-card @(_snapshot.PythonExecutableExists ? "is-core" : "is-deprecated")">
                <span class="health-stat-label">Python Venv</span>
                <span class="health-stat-value" style="font-size:1rem">@BoolLabel(_snapshot.PythonExecutableExists)</span>
            </div>
            <div class="health-stat-card @(_snapshot.HarnessScriptExists ? "is-core" : "is-deprecated")">
                <span class="health-stat-label">Harness Script</span>
                <span class="health-stat-value" style="font-size:1rem">@BoolLabel(_snapshot.HarnessScriptExists)</span>
            </div>
            <div class="health-stat-card @(_snapshot.DependencyProbeReady ? "is-core" : "is-deprecated")">
                <span class="health-stat-label">Training Deps</span>
                <span class="health-stat-value" style="font-size:1rem">@(_snapshot.DependencyProbeReady ? "Ready" : "Simulated")</span>
            </div>
            <div class="health-stat-card @(_snapshot.TrainingReady ? "is-core" : "is-deprecated")">
                <span class="health-stat-label">Readiness</span>
                <span class="health-stat-value" style="font-size:1rem">@(_snapshot.TrainingReady ? "Ready" : "Needs setup")</span>
            </div>
        </div>

        <div class="health-lower-grid" style="margin-top: 12px;">
            <div class="health-lower-card">
                <div class="health-section-title">Prerequisites</div>
                <div class="health-config-grid">
                    <span>Transcript path</span><strong>@_snapshot.TranscriptDirectory</strong>
                    <span>Transcript files</span><strong>@_snapshot.TranscriptFileCount</strong>
                    <span>Feedback enabled</span><strong>@BoolLabel(_snapshot.FeedbackEnabled)</strong>
                    <span>Export path</span><strong>@_snapshot.ExportDirectory</strong>
                    <span>Export files (.jsonl)</span><strong>@_snapshot.ExportFileCount</strong>
                    <span>Runs path</span><strong>@_snapshot.RunsDirectory</strong>
                    <span>Run directories</span><strong>@_snapshot.RunDirectoryCount</strong>
                    <span>Python executable</span><strong>@_snapshot.PythonExecutablePath</strong>
                    <span>Python version</span><strong>@_snapshot.DependencyProbePythonVersion</strong>
                    <span>Training dependencies</span><strong>@_snapshot.DependencyProbeSummary</strong>
                    <span>Harness script</span><strong>@_snapshot.HarnessScriptPath</strong>
                </div>
            </div>

            <div class="health-lower-card">
                <div class="health-section-title">Current Contract</div>
                <div class="health-config-grid">
                    <span>Preference format</span><strong>@_snapshot.PreferenceFormat</strong>
                    <span>Max run minutes</span><strong>@_snapshot.MaxRunMinutes</strong>
                    <span>Active model tag</span><strong>@_snapshot.ActiveModelTag</strong>
                    <span>Fallback model tag</span><strong>@_snapshot.FallbackModelTag</strong>
                    <span>Store chat content</span><strong>@BoolLabel(_snapshot.StoreChatContent)</strong>
                    <span>Transcript redaction</span><strong>@BoolLabel(_snapshot.TranscriptRedactionEnabled)</strong>
                </div>
            </div>
        </div>
    }

    <MudPaper Class="pa-0 mt-4" Outlined="true">
        <MudTable Items="@_runs" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="15" Class="health-table">
            <HeaderContent>
                <MudTh>Run</MudTh>
                <MudTh>Phase</MudTh>
                <MudTh>Last Event</MudTh>
                <MudTh>Event Time</MudTh>
                <MudTh>Elapsed (s)</MudTh>
                <MudTh>Records</MudTh>
                <MudTh>Throughput</MudTh>
                <MudTh>Loss</MudTh>
                <MudTh>Artifacts</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Run">@context.RunId</MudTd>
                <MudTd DataLabel="Phase">@context.Phase</MudTd>
                <MudTd DataLabel="Last Event">@context.LastEvent</MudTd>
                <MudTd DataLabel="Event Time">@context.LastEventTimestampText</MudTd>
                <MudTd DataLabel="Elapsed">@context.ElapsedSecondsText</MudTd>
                <MudTd DataLabel="Records">@context.RecordCountText</MudTd>
                <MudTd DataLabel="Throughput">@context.RecordsPerSecondText</MudTd>
                <MudTd DataLabel="Loss">@context.FinalLossText</MudTd>
                <MudTd DataLabel="Artifacts">
                    <div style="display:flex; gap:4px; align-items:center; flex-wrap:wrap;">
                        <MudTooltip Text="Copy status.json path">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => CopyTextAsync(context.StatusPath))" aria-label="Copy status path" title="Copy status path" />
                        </MudTooltip>
                        <MudTooltip Text="Open status.json in default app">
                            <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenArtifactAsync(context.StatusPath))" aria-label="Open status artifact" title="Open status artifact" />
                        </MudTooltip>
                        @if (File.Exists(context.EventsPath))
                        {
                            <MudTooltip Text="Open events.jsonl in default app">
                                <MudIconButton Icon="@Icons.Material.Filled.Stream" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenArtifactAsync(context.EventsPath))" aria-label="Open events artifact" title="Open events artifact" />
                            </MudTooltip>
                        }
                        @if (File.Exists(context.BenchmarkPath))
                        {
                            <MudTooltip Text="Open benchmark.json in default app">
                                <MudIconButton Icon="@Icons.Material.Filled.Insights" Size="Size.Small" Color="Color.Success" OnClick="@(() => OpenArtifactAsync(context.BenchmarkPath))" aria-label="Open benchmark artifact" title="Open benchmark artifact" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">No run artifacts found yet. Start a run from this page to generate telemetry and artifacts.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>

    @if (_latestRunEvents.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.subtitle2">Latest Run Events</MudText>
            <MudTable Items="@_latestRunEvents" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="health-table mt-2">
                <HeaderContent>
                    <MudTh>Timestamp</MudTh>
                    <MudTh>Event</MudTh>
                    <MudTh>Data</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Timestamp">@context.TimestampText</MudTd>
                    <MudTd DataLabel="Event">@context.EventName</MudTd>
                    <MudTd DataLabel="Data"><pre style="margin:0; white-space: pre-wrap;">@context.DataSummary</pre></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</div>

@code {
    private const string LastTrainingSettingStorageKey = "memorysmith.training.last-setting";

    private bool _isBusy;
    private bool _isLaunchingRun;
    private string? _error;
    private TrainingReadinessSnapshot? _snapshot;
    private IReadOnlyList<TrainingRunSummary> _runs = [];
    private IReadOnlyList<TrainingRunEvent> _latestRunEvents = [];
    private TrainingHarnessActiveRun? _activeRun;
    private IReadOnlyList<TrainingSettingRow> _trainingSettings = [];
    private string? _selectedTrainingSettingKey;
    private string _trainingSettingsTransferPayload = string.Empty;
    private bool _hydratedLastTrainingSetting;
    private readonly CancellationTokenSource _pollingCts = new();

    private TrainingSettingRow? SelectedTrainingSetting => _trainingSettings.FirstOrDefault(row => string.Equals(row.Item.Key, _selectedTrainingSettingKey, StringComparison.OrdinalIgnoreCase))
        ?? _trainingSettings.FirstOrDefault();

    private int TrainingDirtyCount => _trainingSettings.Count(row => row.IsDirty);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollRunsAsync(_pollingCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydratedLastTrainingSetting)
        {
            return;
        }

        _hydratedLastTrainingSetting = true;
        var lastUsed = await JS.InvokeAsync<string?>("localStorage.getItem", LastTrainingSettingStorageKey);
        if (!string.IsNullOrWhiteSpace(lastUsed) && _trainingSettings.Any(row => string.Equals(row.Item.Key, lastUsed, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedTrainingSettingKey = lastUsed;
        }
        else if (SelectedTrainingSetting is { } selected)
        {
            _selectedTrainingSettingKey = selected.Item.Key;
            await JS.InvokeVoidAsync("localStorage.setItem", LastTrainingSettingStorageKey, selected.Item.Key);
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _pollingCts.Cancel();
        _pollingCts.Dispose();
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        _error = null;
        try
        {
            var training = Options.CurrentValue.Training;
            var dependencyProbe = await TrainingRunner.ProbeDependenciesAsync(CancellationToken.None);
            _snapshot = BuildSnapshot(training, dependencyProbe);
            LoadTrainingSettings();
            _runs = await LoadRunSummariesAsync(_snapshot.RunsDirectory);
            _latestRunEvents = _runs.Count > 0
                ? await LoadRecentEventsAsync(_runs[0].EventsPath)
                : [];
            _activeRun = TrainingRunner.GetActiveRun();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void LoadTrainingSettings()
    {
        var pendingByKey = _trainingSettings
            .Where(row => row.IsDirty)
            .ToDictionary(row => row.Item.Key, row => row.PendingValue, StringComparer.OrdinalIgnoreCase);

        _trainingSettings = Settings.ListEditableSettings()
            .Where(item => string.Equals(item.Category, "Training", StringComparison.OrdinalIgnoreCase))
            .Select(item => new TrainingSettingRow(item, pendingByKey.TryGetValue(item.Key, out var pendingValue) ? pendingValue : null))
            .OrderBy(row => row.Item.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (_trainingSettings.Count == 0)
        {
            _selectedTrainingSettingKey = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedTrainingSettingKey)
            || _trainingSettings.All(row => !string.Equals(row.Item.Key, _selectedTrainingSettingKey, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedTrainingSettingKey = _trainingSettings[0].Item.Key;
        }
    }

    private static TrainingReadinessSnapshot BuildSnapshot(TrainingOptions training, TrainingDependencyProbeResult dependencyProbe)
    {
        var transcriptDirectory = Path.GetFullPath(training.TranscriptDirectory);
        var exportDirectory = Path.GetFullPath(training.TrainingDataExportPath);
        var runsDirectory = Path.GetFullPath(training.RunsDirectory);
        var pythonExecutablePath = ResolveTrainingPythonExecutablePath(training.PythonVenvPath);
        var harnessScriptPath = Path.GetFullPath(training.PythonHarnessScript);

        var transcriptFileCount = SafeCountFiles(transcriptDirectory, "*.jsonl");
        var exportFileCount = SafeCountFiles(exportDirectory, "*.jsonl");
        var runDirectoryCount = SafeCountDirectories(runsDirectory);

        var transcriptPathReady = Directory.Exists(transcriptDirectory);
        var exportPathReady = Directory.Exists(exportDirectory);
        var runsPathReady = Directory.Exists(runsDirectory);
        var pythonReady = File.Exists(pythonExecutablePath);
        var harnessReady = File.Exists(harnessScriptPath);
        var ready = training.ChatTranscriptEnabled
            && training.FeedbackEnabled
            && transcriptPathReady
            && exportPathReady
            && runsPathReady
            && pythonReady
            && harnessReady
            && dependencyProbe.Ready;

        return new TrainingReadinessSnapshot(
            training.ChatTranscriptEnabled,
            training.StoreChatContent,
            training.TranscriptRedactionEnabled,
            training.FeedbackEnabled,
            transcriptDirectory,
            transcriptFileCount,
            exportDirectory,
            exportFileCount,
            runsDirectory,
            runDirectoryCount,
            pythonExecutablePath,
            pythonReady,
            dependencyProbe.PythonVersion,
            dependencyProbe.Ready,
            dependencyProbe.Summary,
            harnessScriptPath,
            harnessReady,
            training.PreferenceFormat.ToString(),
            training.MaxRunMinutes,
            training.ActiveModelTag,
            training.FallbackModelTag,
            ready);
    }

    private static string ResolveTrainingPythonExecutablePath(string pythonVenvPath)
    {
        var venvRoot = Path.GetFullPath(pythonVenvPath);
        var windowsPython = Path.Combine(venvRoot, "Scripts", "python.exe");
        if (File.Exists(windowsPython) || OperatingSystem.IsWindows())
        {
            return windowsPython;
        }

        return Path.Combine(venvRoot, "bin", "python");
    }

    private static async Task<IReadOnlyList<TrainingRunSummary>> LoadRunSummariesAsync(string runsDirectory)
    {
        if (!Directory.Exists(runsDirectory))
        {
            return [];
        }

        var runDirectories = Directory.GetDirectories(runsDirectory)
            .OrderByDescending(path => path, StringComparer.OrdinalIgnoreCase)
            .Take(40)
            .ToList();

        var results = new List<TrainingRunSummary>(runDirectories.Count);
        foreach (var runDirectory in runDirectories)
        {
            var statusPath = Path.Combine(runDirectory, "status.json");
            if (!File.Exists(statusPath))
            {
                continue;
            }

            var summary = await ParseRunSummaryAsync(runDirectory, statusPath);
            if (summary is not null)
            {
                results.Add(summary);
            }
        }

        return results;
    }

    private static async Task<TrainingRunSummary?> ParseRunSummaryAsync(string runDirectory, string statusPath)
    {
        try
        {
            await using var stream = File.OpenRead(statusPath);
            using var document = await JsonDocument.ParseAsync(stream);
            var root = document.RootElement;

            var eventsPath = Path.Combine(runDirectory, "events.jsonl");
            var benchmarkPath = Path.Combine(runDirectory, "benchmark.json");

            var runId = GetString(root, "runId") ?? Path.GetFileName(runDirectory);
            var phase = GetString(root, "phase") ?? "unknown";
            var lastEvent = GetString(root, "lastEvent") ?? "-";
            var elapsed = root.TryGetProperty("elapsedSeconds", out var elapsedElement) && elapsedElement.ValueKind == JsonValueKind.Number
                ? elapsedElement.GetDouble().ToString("0.###")
                : "-";
            var lastEventTimestamp = await ReadLastEventTimestampAsync(eventsPath);

            var recordCount = "-";
            if (root.TryGetProperty("metrics", out var metricsElement)
                && metricsElement.ValueKind == JsonValueKind.Object
                && metricsElement.TryGetProperty("records", out var recordsElement)
                && recordsElement.ValueKind == JsonValueKind.Number)
            {
                recordCount = recordsElement.GetInt32().ToString();
            }

            var benchmark = await ReadBenchmarkSummaryAsync(benchmarkPath);

            return new TrainingRunSummary(
                runId,
                phase,
                lastEvent,
                lastEventTimestamp,
                elapsed,
                recordCount,
                benchmark.RecordsPerSecond,
                benchmark.FinalLoss,
                statusPath,
                eventsPath,
                benchmarkPath);
        }
        catch
        {
            return null;
        }
    }

    private static async Task<string> ReadLastEventTimestampAsync(string eventsPath)
    {
        if (!File.Exists(eventsPath))
        {
            return "-";
        }

        var lines = await File.ReadAllLinesAsync(eventsPath);
        for (var index = lines.Length - 1; index >= 0; index--)
        {
            var candidate = lines[index].Trim();
            if (string.IsNullOrWhiteSpace(candidate))
            {
                continue;
            }

            try
            {
                using var document = JsonDocument.Parse(candidate);
                var ts = GetString(document.RootElement, "ts");
                if (DateTimeOffset.TryParse(ts, out var parsed))
                {
                    return parsed.ToLocalTime().ToString("g");
                }

                return ts ?? "-";
            }
            catch
            {
                return "-";
            }
        }

        return "-";
    }

    private static async Task<(string RecordsPerSecond, string FinalLoss)> ReadBenchmarkSummaryAsync(string benchmarkPath)
    {
        if (!File.Exists(benchmarkPath))
        {
            return ("-", "-");
        }

        try
        {
            await using var stream = File.OpenRead(benchmarkPath);
            using var document = await JsonDocument.ParseAsync(stream);
            var root = document.RootElement;

            var recordsPerSecond = "-";
            if (root.TryGetProperty("throughput", out var throughput)
                && throughput.ValueKind == JsonValueKind.Object
                && throughput.TryGetProperty("recordsPerSecond", out var rps)
                && rps.ValueKind == JsonValueKind.Number)
            {
                recordsPerSecond = rps.GetDouble().ToString("0.###");
            }

            var finalLoss = "-";
            if (root.TryGetProperty("train", out var train)
                && train.ValueKind == JsonValueKind.Object
                && train.TryGetProperty("finalLoss", out var loss)
                && loss.ValueKind == JsonValueKind.Number)
            {
                finalLoss = loss.GetDouble().ToString("0.####");
            }

            return (recordsPerSecond, finalLoss);
        }
        catch
        {
            return ("-", "-");
        }
    }

    private static async Task<IReadOnlyList<TrainingRunEvent>> LoadRecentEventsAsync(string eventsPath)
    {
        if (!File.Exists(eventsPath))
        {
            return [];
        }

        var allLines = await File.ReadAllLinesAsync(eventsPath);
        var lines = allLines
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .TakeLast(20)
            .ToList();

        var events = new List<TrainingRunEvent>(lines.Count);
        foreach (var line in lines)
        {
            try
            {
                using var document = JsonDocument.Parse(line);
                var root = document.RootElement;
                var name = GetString(root, "event") ?? "-";
                var ts = GetString(root, "ts") ?? "-";
                var timestampText = DateTimeOffset.TryParse(ts, out var parsed)
                    ? parsed.ToLocalTime().ToString("g")
                    : ts;

                var dataSummary = root.TryGetProperty("data", out var dataElement)
                    ? dataElement.GetRawText()
                    : "{}";

                events.Add(new TrainingRunEvent(timestampText, name, dataSummary));
            }
            catch
            {
                // Ignore malformed lines so one bad event does not break telemetry rendering.
            }
        }

        return events;
    }

    private static int SafeCountFiles(string directory, string pattern)
    {
        if (!Directory.Exists(directory))
        {
            return 0;
        }

        return Directory.GetFiles(directory, pattern, SearchOption.TopDirectoryOnly).Length;
    }

    private static int SafeCountDirectories(string directory)
    {
        if (!Directory.Exists(directory))
        {
            return 0;
        }

        return Directory.GetDirectories(directory, "*", SearchOption.TopDirectoryOnly).Length;
    }

