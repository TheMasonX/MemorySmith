    private sealed class TrainingSettingRow
    {
        public TrainingSettingRow(AdminSettingItem item, string? pendingValue = null)
        {
            Item = item;
            PendingValue = pendingValue ?? item.Value;
        }

        public AdminSettingItem Item { get; }
        public string PendingValue { get; set; }
        public bool IsDirty => !string.Equals(PendingValue, Item.Value, StringComparison.Ordinal);

        public void Reset() => PendingValue = Item.Value;
    }

