    private async Task SaveSelectedTrainingSettingAsync()
    {
        if (SelectedTrainingSetting is not { } row || !row.IsDirty)
        {
            return;
        }

        await SaveTrainingSettingsAsync([row]);
    }

    private async Task SaveAllTrainingSettingsAsync()
    {
        var dirtyRows = _trainingSettings.Where(row => row.IsDirty).ToList();
        if (dirtyRows.Count == 0)
        {
            Snackbar.Add("No pending training-setting changes to save.", Severity.Info);
            return;
        }

        await SaveTrainingSettingsAsync(dirtyRows);
    }

    private async Task SaveTrainingSettingsAsync(IReadOnlyList<TrainingSettingRow> rowsToSave)
    {
        var preserve = _trainingSettings
            .Where(row => row.IsDirty && rowsToSave.All(candidate => !string.Equals(candidate.Item.Key, row.Item.Key, StringComparison.OrdinalIgnoreCase)))
            .ToDictionary(row => row.Item.Key, row => row.PendingValue, StringComparer.OrdinalIgnoreCase);
        var failures = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var saved = 0;

        _isBusy = true;
        try
        {
            foreach (var row in rowsToSave)
            {
                var result = await Settings.UpdateAsync(new AdminSettingUpdateRequest(row.Item.Key, row.PendingValue), CancellationToken.None);
                if (result.Succeeded)
                {
                    saved++;
                    continue;
                }

                failures[row.Item.Key] = row.PendingValue;
                Snackbar.Add(result.Error ?? $"{row.Item.Label} could not be saved.", Severity.Error);
            }
        }
        finally
        {
            _isBusy = false;
        }

        await LoadAsync();
        foreach (var row in _trainingSettings)
        {
            if (preserve.TryGetValue(row.Item.Key, out var pendingValue) || failures.TryGetValue(row.Item.Key, out pendingValue))
            {
                row.PendingValue = pendingValue;
            }
        }

        if (saved > 0)
        {
            Snackbar.Add($"Saved {saved} training setting{(saved == 1 ? string.Empty : "s")}.", Severity.Success);
        }
    }

    private Task ExportTrainingSettingsAsync()
    {
        var payload = new JsonObject();
        foreach (var row in _trainingSettings.OrderBy(row => row.Item.Key, StringComparer.OrdinalIgnoreCase))
        {
            payload[row.Item.Key] = row.PendingValue;
        }

        _trainingSettingsTransferPayload = payload.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
        Snackbar.Add("Training settings exported to the transfer box.", Severity.Success);
        return Task.CompletedTask;
    }

    private async Task CopyTrainingSettingsTransferPayloadAsync()
    {
        if (string.IsNullOrWhiteSpace(_trainingSettingsTransferPayload))
        {
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _trainingSettingsTransferPayload);
        Snackbar.Add("Training settings JSON copied.", Severity.Success);
    }

    private Task ApplyImportedTrainingSettingsAsync()
    {
        if (string.IsNullOrWhiteSpace(_trainingSettingsTransferPayload))
        {
            Snackbar.Add("Paste training-settings JSON into the transfer box first.", Severity.Info);
            return Task.CompletedTask;
        }

        try
        {
            using var document = JsonDocument.Parse(_trainingSettingsTransferPayload);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                Snackbar.Add("Training settings import JSON must be an object keyed by setting name.", Severity.Error);
                return Task.CompletedTask;
            }

            var applied = 0;
            foreach (var property in document.RootElement.EnumerateObject())
            {
                var row = _trainingSettings.FirstOrDefault(item => string.Equals(item.Item.Key, property.Name, StringComparison.OrdinalIgnoreCase));
                if (row is null)
                {
                    continue;
                }

                row.PendingValue = property.Value.ValueKind switch
                {
                    JsonValueKind.String => property.Value.GetString() ?? string.Empty,
                    JsonValueKind.True => "true",
                    JsonValueKind.False => "false",
                    JsonValueKind.Null => string.Empty,
                    JsonValueKind.Array => string.Join(Environment.NewLine, property.Value.EnumerateArray().Select(element => element.ToString())),
                    _ => property.Value.ToString()
                };
                applied++;
            }

            Snackbar.Add(applied == 0
                ? "No imported values matched the training settings list."
                : $"Applied {applied} imported training setting value{(applied == 1 ? string.Empty : "s")} as pending changes.", applied == 0 ? Severity.Info : Severity.Success);
        }
        catch (JsonException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        return Task.CompletedTask;
    }

    private static string? GetString(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) || value.ValueKind != JsonValueKind.String)
        {
            return null;
        }

        return value.GetString();
    }

