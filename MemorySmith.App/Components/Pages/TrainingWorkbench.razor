    private RenderFragment TrainingSettingEditor(TrainingSettingRow row) => builder =>
    {
        switch (row.Item.ValueKind)
        {
            case nameof(AdminSettingValueKind.Boolean):
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Value", bool.TryParse(row.PendingValue, out var boolean) && boolean);
                builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, value => row.PendingValue = value ? "true" : "false"));
                builder.AddAttribute(3, "Disabled", _isBusy || _isLaunchingRun);
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.Choice):
                builder.OpenComponent<MudSelect<string>>(10);
                builder.AddAttribute(11, "Value", row.PendingValue);
                builder.AddAttribute(12, "ValueChanged", EventCallback.Factory.Create<string>(this, value => row.PendingValue = value ?? string.Empty));
                builder.AddAttribute(13, "Dense", true);
                builder.AddAttribute(14, "Variant", Variant.Outlined);
                builder.AddAttribute(15, "Margin", Margin.Dense);
                builder.AddAttribute(16, "Disabled", _isBusy || _isLaunchingRun);
                builder.AddAttribute(17, "ChildContent", (RenderFragment)(selectBuilder =>
                {
                    var sequence = 0;
                    foreach (var option in row.Item.Options)
                    {
                        selectBuilder.OpenComponent<MudSelectItem<string>>(sequence++);
                        selectBuilder.AddAttribute(sequence++, "Value", option);
                        selectBuilder.AddContent(sequence++, option);
                        selectBuilder.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case nameof(AdminSettingValueKind.StringList):
                builder.OpenComponent<MudTextField<string>>(20);
                builder.AddAttribute(21, "Value", row.PendingValue);
                builder.AddAttribute(22, "ValueChanged", EventCallback.Factory.Create<string>(this, value => row.PendingValue = value ?? string.Empty));
                builder.AddAttribute(23, "Variant", Variant.Outlined);
                builder.AddAttribute(24, "Margin", Margin.Dense);
                builder.AddAttribute(25, "Lines", 3);
                builder.AddAttribute(26, "Disabled", _isBusy || _isLaunchingRun);
                builder.CloseComponent();
                break;
            default:
                builder.OpenComponent<MudTextField<string>>(30);
                builder.AddAttribute(31, "Value", row.PendingValue);
                builder.AddAttribute(32, "ValueChanged", EventCallback.Factory.Create<string>(this, value => row.PendingValue = value ?? string.Empty));
                builder.AddAttribute(33, "Variant", Variant.Outlined);
                builder.AddAttribute(34, "Margin", Margin.Dense);
                builder.AddAttribute(35, "Disabled", _isBusy || _isLaunchingRun);
                builder.AddAttribute(36, "InputType", row.Item.IsSensitive ? InputType.Password : InputType.Text);
                builder.CloseComponent();
                break;
        }
    };

