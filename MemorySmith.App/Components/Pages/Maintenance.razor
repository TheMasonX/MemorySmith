@page "/maintenance"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MemorySmithPolicies.CanAdminMemorySmith)]
@inject MaintenanceAgentService Agent
@inject MaintenanceProposalWorkflow ProposalWorkflow
@inject MaintenanceTopicMapService TopicMapService
@inject ISnackbar Snackbar

<PageTitle>Maintenance</PageTitle>

<div class="wiki-workbench maintenance-workbench">
    <section class="wiki-commandbar maintenance-commandbar" aria-label="Maintenance">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Maintenance</MudText>
            <span class="wiki-count">Task trace, admin chat, transcripts, and proposal actions</span>
        </div>
        <div class="wiki-search-strip">
            <MudSelect T="string" Value="@_selectedTask" ValueChanged="@((string value) => _selectedTask = value)" Label="Task" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="wiki-filter">
                @foreach (var task in TaskOptions)
                {
                    <MudSelectItem T="string" Value="@task">@TaskLabel(task)</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_isBusy" OnClick="LoadAsync">Refresh</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Psychology" Disabled="@_isBusy" OnClick="RunNowAsync">Run Now</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@_isBusy" OnClick="RunTaskAsync">Run Task</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountTree" Disabled="@_isBusy" OnClick="RefreshTopicMapAsync">Topic Map</MudButton>
        </div>
    </section>

    @if (CurrentActiveRun is not null)
    {
        <section class="maintenance-active-run" role="status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
            <strong>@ActiveRunLabel(CurrentActiveRun)</strong>
            <span>@ActiveRunDetail(CurrentActiveRun)</span>
            <small>Started @CurrentActiveRun.StartedAtUtc.ToLocalTime().ToString("g")</small>
        </section>
    }

    <section class="maintenance-body">
        <div class="maintenance-primary-pane">
            <section class="maintenance-panel maintenance-trace-panel" aria-label="Maintenance task trace history">
                <div class="wiki-pane-header">
                    <strong>Task trace history</strong>
                    <span class="wiki-muted">@_activity.Count logged</span>
                </div>
                @if (_lastRun?.Warnings.Count > 0)
                {
                    <div class="proposal-run-warnings">
                        @foreach (var warning in _lastRun.Warnings.Take(3))
                        {
                            <span>@warning</span>
                        }
                    </div>
                }
                @if (_activity.Count == 0)
                {
                    <div class="wiki-empty-state">No maintenance task activity has been logged yet.</div>
                }
                else
                {
                    <div class="maintenance-activity-list maintenance-page-activity-list">
                        @foreach (var activity in _activity)
                        {
                            <article class="maintenance-activity-row @(activity.Skipped ? "is-skipped" : null)">
                                <span class="maintenance-activity-main">
                                    <strong>@ActivitySummary(activity)</strong>
                                    <small>@activity.FinishedAtUtc.ToLocalTime().ToString("g")</small>
                                </span>
                                <span>@activity.FindingCount finding(s) - @activity.ProposalCount proposal(s)</span>
                                @if (activity.ProposalIds.Count > 0)
                                {
                                    <div class="maintenance-activity-proposals" aria-label="Maintenance proposals from this run">
                                        @foreach (var proposalId in activity.ProposalIds)
                                        {
                                            <a href="@ProposalHref(proposalId)">@proposalId</a>
                                        }
                                    </div>
                                }
                                @foreach (var warning in activity.Warnings.Take(3))
                                {
                                    <small class="maintenance-activity-warning">@warning</small>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="maintenance-panel maintenance-action-history" aria-label="Maintenance proposal action history">
                <div class="wiki-pane-header">
                    <strong>Proposal action history</strong>
                    <span class="wiki-muted">@ProposalActionRows.Count action(s)</span>
                </div>
                @if (ProposalActionRows.Count == 0)
                {
                    <div class="wiki-empty-state">No proposal actions have been recorded yet.</div>
                }
                else
                {
                    <div class="maintenance-action-list">
                        @foreach (var action in ProposalActionRows)
                        {
                            <article class="maintenance-action-row">
                                <header>
                                    <strong>@action.Action</strong>
                                    <a href="@ProposalHref(action.ProposalId)">@action.ProposalId</a>
                                </header>
                                <small>@action.User at @action.Timestamp.ToLocalTime().ToString("g")</small>
                                @if (!string.IsNullOrWhiteSpace(action.Comment))
                                {
                                    <p>@action.Comment</p>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="maintenance-secondary-pane">
            <section class="admin-maintenance-chat" aria-label="Maintenance agent admin chat">
                <MudText Typo="Typo.subtitle1">Maintenance agent chat</MudText>
                <MudTextField T="string" Value="@_maintenancePrompt" ValueChanged="@((string value) => _maintenancePrompt = value)" Label="Ask the maintenance agent" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" Disabled="@_isBusy" />
                <div class="admin-maintenance-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_maintenancePrompt))" OnClick="SendMaintenanceMessageAsync">Send</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_isBusy" OnClick="LoadMaintenanceTranscriptsAsync">Refresh transcripts</MudButton>
                </div>
                <small class="admin-setting-key">This conversation can use the same read-only wiki tools as Chat, but it is non-mutating. Any file, memory, page, or proposal change still needs the proposal workflow.</small>
            </section>

            <section class="admin-maintenance-transcripts" aria-label="Maintenance agent chat history">
                <div class="wiki-pane-header">
                    <strong>Chat history</strong>
                    <span class="wiki-muted">@_maintenanceTranscripts.Count logged</span>
                </div>
                <div class="admin-maintenance-transcript-search">
                    <MudTextField T="string" Value="@_maintenanceTranscriptSearch" ValueChanged="@((string value) => _maintenanceTranscriptSearch = value)" Immediate="true" Label="Search transcripts" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Disabled="@_isBusy" />
                    <MudTooltip Text="Search">
                        <MudIconButton Icon="@Icons.Material.Filled.Search"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Class="wiki-search-submit"
                                       Disabled="@_isBusy"
                                       OnClick="LoadMaintenanceTranscriptsAsync"
                                       aria-label="Search" />
                    </MudTooltip>
                </div>
                @if (_maintenanceTranscripts.Count == 0)
                {
                    <div class="wiki-empty-state">No maintenance-agent transcript entries have been logged yet.</div>
                }
                else
                {
                    <div class="admin-maintenance-transcript-list">
                        @foreach (var entry in _maintenanceTranscripts)
                        {
                            <article class="admin-maintenance-transcript">
                                <header>
                                    <strong>@entry.CreatedAtUtc.ToLocalTime().ToString("g")</strong>
                                    <span>@TranscriptProviderLabel(entry)</span>
                                </header>
                                <p><strong>Admin:</strong> @entry.UserMessage</p>
                                <p><strong>Agent:</strong> @entry.AssistantMessage</p>
                                @if (entry.Warnings.Count > 0)
                                {
                                    <small class="admin-maintenance-warning">@entry.Warnings.First()</small>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </aside>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<string> TaskOptions = ["staleness_scan", "relationship_integrity", "topic_map", "embedding_chunking_maintenance", "spot_checks", "consistency_checks", "synthesis"];
    private IReadOnlyList<MaintenanceRunActivity> _activity = [];
    private IReadOnlyList<MaintenanceWriteProposal> _proposals = [];
    private IReadOnlyList<MaintenanceAdminTranscriptEntry> _maintenanceTranscripts = [];
    private MaintenanceRunResult? _lastRun;
    private MaintenanceActiveRunSnapshot? _activeRun;
    private MaintenanceActiveRunSnapshot? _localActiveRun;
    private TopicMapDocument? _topicMap;
    private string _selectedTask = "staleness_scan";
    private string _maintenancePrompt = string.Empty;
    private string _maintenanceTranscriptSearch = string.Empty;
    private bool _isBusy;

    private MaintenanceActiveRunSnapshot? CurrentActiveRun => _activeRun ?? _localActiveRun;

    private IReadOnlyList<ProposalActionRow> ProposalActionRows => _proposals
        .SelectMany(proposal => proposal.History.Select(history => new ProposalActionRow(proposal.ProposalId, history.Action, history.User, history.Timestamp, history.Comment)))
        .OrderByDescending(action => action.Timestamp)
        .Take(50)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _topicMap = await TopicMapService.LoadCachedAsync(CancellationToken.None);
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        try
        {
            _activity = await Agent.ListRecentActivityAsync(50, CancellationToken.None);
            _proposals = await ProposalWorkflow.ListAsync(CancellationToken.None);
            _maintenanceTranscripts = await Agent.ListRecentTranscriptsAsync(50, CancellationToken.None, _maintenanceTranscriptSearch);
            _activeRun = Agent.GetActiveRun();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RunNowAsync()
    {
        await BeginRunAsync("run_maintenance_now", null);
        try
        {
            _lastRun = await Agent.RunMaintenanceNowAsync(CancellationToken.None);
            _topicMap = await TopicMapService.LoadCachedAsync(CancellationToken.None);
            await LoadAsync();
            Snackbar.Add(RunSummary(_lastRun), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            EndRun();
        }
    }

    private async Task RunTaskAsync()
    {
        await BeginRunAsync("run_maintenance_on_demand", _selectedTask);
        try
        {
            _lastRun = await Agent.RunMaintenanceOnDemandAsync(_selectedTask, CancellationToken.None);
            _topicMap = await TopicMapService.LoadCachedAsync(CancellationToken.None);
            await LoadAsync();
            Snackbar.Add(RunSummary(_lastRun), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            EndRun();
        }
    }

    private async Task BeginRunAsync(string trigger, string? task)
    {
        _isBusy = true;
        _localActiveRun = new MaintenanceActiveRunSnapshot(Guid.NewGuid().ToString("N"), trigger, task, DateTimeOffset.UtcNow);
        _activeRun = Agent.GetActiveRun();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private void EndRun()
    {
        _isBusy = false;
        _localActiveRun = null;
        _activeRun = Agent.GetActiveRun();
    }

    private async Task RefreshTopicMapAsync()
    {
        _isBusy = true;
        try
        {
            _topicMap = await TopicMapService.BuildAsync(CancellationToken.None);
            Snackbar.Add($"Topic map refreshed with {_topicMap.Nodes.Count} node(s) and {_topicMap.Edges.Count} edge(s).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadMaintenanceTranscriptsAsync()
    {
        _isBusy = true;
        try
        {
            _maintenanceTranscripts = await Agent.ListRecentTranscriptsAsync(50, CancellationToken.None, _maintenanceTranscriptSearch);
            Snackbar.Add("Maintenance transcripts refreshed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SendMaintenanceMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_maintenancePrompt))
        {
            Snackbar.Add("Enter a maintenance-agent message first.", Severity.Warning);
            return;
        }

        _isBusy = true;
        try
        {
            var entry = await Agent.SendAdminMessageAsync(_maintenancePrompt, CancellationToken.None);
            _maintenancePrompt = string.Empty;
            _maintenanceTranscripts = await Agent.ListRecentTranscriptsAsync(50, CancellationToken.None, _maintenanceTranscriptSearch);
            Snackbar.Add(entry.Warnings.Count > 0 ? entry.Warnings[0] : "Maintenance agent response logged.", entry.Warnings.Count > 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string TaskLabel(string task) => task.Replace('_', ' ');
    private static string ProposalHref(string proposalId) => "/proposals";
    private static string TranscriptProviderLabel(MaintenanceAdminTranscriptEntry entry) =>
        string.IsNullOrWhiteSpace(entry.Provider) ? "No provider" : $"{entry.Provider} / {entry.Model ?? "default model"}";

    private static string ActivitySummary(MaintenanceRunActivity activity)
    {
        var status = activity.Skipped ? "Skipped" : "Completed";
        var tasks = activity.Tasks.Count == 0 ? "No tasks" : string.Join(", ", activity.Tasks.Select(TaskLabel));
        return $"{status}: {tasks}";
    }

    private static string ActiveRunLabel(MaintenanceActiveRunSnapshot activeRun) => activeRun.Trigger switch
    {
        "run_maintenance_now" => "Maintenance review",
        "run_maintenance_weekly" => "Weekly maintenance review",
        "run_maintenance_on_demand" when !string.IsNullOrWhiteSpace(activeRun.Task) => TaskLabel(activeRun.Task),
        _ => activeRun.Trigger
    };

    private static string ActiveRunDetail(MaintenanceActiveRunSnapshot activeRun)
    {
        var trigger = activeRun.Trigger switch
        {
            "run_maintenance_now" => "manual run",
            "run_maintenance_weekly" => "scheduled run",
            "run_maintenance_on_demand" => "single task",
            _ => activeRun.Trigger
        };

        return string.IsNullOrWhiteSpace(activeRun.Task)
            ? $"{trigger} in progress"
            : $"{trigger}: {TaskLabel(activeRun.Task)}";
    }

    private static string RunSummary(MaintenanceRunResult run) =>
        $"Maintenance run completed with {run.Outputs.Sum(output => output.Findings.Count)} finding(s) and {run.Outputs.Sum(output => output.Proposals.Count)} proposal(s).";

    private sealed record ProposalActionRow(string ProposalId, string Action, string User, DateTimeOffset Timestamp, string? Comment);
}