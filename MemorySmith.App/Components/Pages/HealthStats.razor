@page "/health"
@rendermode InteractiveServer
@inject MemoryApplicationService Memories
@inject IMemoryChangePublisher Publisher
@inject OperationalDiagnosticsService Diagnostics
@implements IDisposable

<PageTitle>Health</PageTitle>

<div class="health-header">
    <MudText Typo="Typo.h4">Health &amp; Activity</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">Refresh</MudButton>
</div>

@if (_stats is not null)
{
    <div class="health-stat-row">
        <div class="health-stat-card">
            <span class="health-stat-label">Total</span>
            <span class="health-stat-value">@_stats.TotalCount</span>
        </div>
        <div class="health-stat-card is-core">
            <span class="health-stat-label">Core</span>
            <span class="health-stat-value">@_stats.Core</span>
        </div>
        <div class="health-stat-card is-working">
            <span class="health-stat-label">Working</span>
            <span class="health-stat-value">@_stats.Working</span>
        </div>
        <div class="health-stat-card">
            <span class="health-stat-label">Unconsolidated</span>
            <span class="health-stat-value">@_stats.Unconsolidated</span>
        </div>
        <div class="health-stat-card is-deprecated">
            <span class="health-stat-label">Deprecated</span>
            <span class="health-stat-value">@_stats.Deprecated</span>
        </div>
        <div class="health-stat-card">
            <span class="health-stat-label">Avg Confidence</span>
            <span class="health-stat-value">@(_stats.AverageConfidence.ToString("P0"))</span>
        </div>
        <div class="health-stat-card">
            <span class="health-stat-label">Total Usage</span>
            <span class="health-stat-value">@_stats.TotalUsage</span>
        </div>
        <div class="health-stat-card @(_readiness == "Ready" ? "is-core" : "is-deprecated")">
            <span class="health-stat-label">Readiness</span>
            <span class="health-stat-value" style="font-size:1rem">@_readiness</span>
        </div>
    </div>
}

@if (_activityBuckets.Count > 0)
{
    <div class="health-charts-row">
        <div class="health-chart-card">
            <div class="health-chart-title">Queries / Day (last @_chartDays days)</div>
            <MudChart T="double" ChartType="ChartType.Line"
                      ChartSeries="@_querySeries"
                      ChartLabels="@_chartLabels"
                      ChartOptions="@_lineChartOptions"
                      Width="100%" Height="200px" />
        </div>
        <div class="health-chart-card">
            <div class="health-chart-title">Memory Changes / Day (last @_chartDays days)</div>
            <MudChart T="double" ChartType="ChartType.Bar"
                      ChartSeries="@_changeSeries"
                      ChartLabels="@_chartLabels"
                      ChartOptions="@_barChartOptions"
                      Width="100%" Height="200px" />
        </div>
    </div>
}

@if (_diagnostics is not null)
{
    <div class="health-lower-grid health-operations-grid">
        <div class="health-lower-card">
            <div class="health-section-title">Runtime Configuration</div>
            <div class="health-config-grid">
                <span>Data Path</span><strong>@_diagnostics.Configuration.DataPath</strong>
                <span>Event Log</span><strong>@_diagnostics.Configuration.EventLogPath</strong>
                <span>Variables</span><strong>@_diagnostics.Configuration.VarsPath</strong>
                <span>URLs</span><strong>@FormatUrls(_diagnostics.Configuration.ConfiguredUrls)</strong>
                <span>Service</span><strong>@_diagnostics.Configuration.WindowsServiceName</strong>
                <span>API Key</span><strong>@(_diagnostics.Configuration.ApiKeyConfigured ? "Configured" : "Not configured")</strong>
                <span>Remote API</span><strong>@(_diagnostics.Configuration.AllowRemoteApi ? "Allowed" : "Local only")</strong>
                <span>Maintenance</span><strong>@(_diagnostics.Configuration.Maintenance.Enabled ? "Enabled" : "Disabled")</strong>
                <span>Source Roots</span><strong>@FormatSourceRoots(_diagnostics.Configuration.SourceLinks)</strong>
            </div>
        </div>

        <div class="health-lower-card">
            <div class="health-section-title">Storage Paths</div>
            <MudTable Items="@_diagnostics.Paths" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@(context.Exists ? "Exists" : "Missing")</MudTd>
                    <MudTd>@FormatPathDetails(context)</MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <div class="health-lower-card">
            <div class="health-section-title">Endpoints</div>
            <div class="health-endpoint-list">
                @foreach (var endpoint in _diagnostics.Endpoints)
                {
                    <a href="@endpoint.Path">@endpoint.Path</a>
                }
            </div>
        </div>

        <div class="health-lower-card">
            <div class="health-section-title">Storage Diagnostics</div>
            @if (_diagnostics.StorageDiagnostics.CorruptFiles.Count == 0)
            {
                <span class="wiki-muted">No corrupt files observed.</span>
            }
            else
            {
                <MudTable Items="@_diagnostics.StorageDiagnostics.CorruptFiles" Dense="true" Class="health-table">
                    <HeaderContent>
                        <MudTh>Path</MudTh>
                        <MudTh>Observed</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Path</MudTd>
                        <MudTd>@context.ObservedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </div>
    </div>
}

<div class="health-lower-grid">
    <div class="health-lower-card">
        <div class="health-section-title">Maintenance Telemetry</div>
        <MudTable Items="@_telemetry" Dense="true" Class="health-table">
            <HeaderContent>
                <MudTh>Service</MudTh>
                <MudTh>Interval</MudTh>
                <MudTh>Last Run</MudTh>
                <MudTh>Last Success</MudTh>
                <MudTh>Duration</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ServiceName</MudTd>
                <MudTd>@context.Interval</MudTd>
                <MudTd>@FormatTime(context.LastRunUtc)</MudTd>
                <MudTd>@FormatTime(context.LastSuccessUtc)</MudTd>
                <MudTd>@(context.LastDurationMs?.ToString("N0") ?? "-") ms</MudTd>
            </RowTemplate>
        </MudTable>
    </div>
    <div class="health-lower-card">
        <div class="health-section-title">Recent Events (this session)</div>
        @if (_recentEvents.Count == 0)
        {
            <span class="wiki-muted">No events yet — create, edit, or search a memory.</span>
        }
        else
        {
            <MudList T="MemoryUpdateEvent" Dense="true">
                @foreach (var update in _recentEvents)
                {
                    <MudListItem Text="@($"{update.Action}: {update.Id}")" SecondaryText="@update.Timestamp.ToLocalTime().ToString("g")" />
                }
            </MudList>
        }
    </div>
</div>

@code {
    private StatsSnapshot? _stats;
    private IReadOnlyList<BackgroundServiceTelemetry> _telemetry = [];
    private IReadOnlyList<ActivityBucket> _activityBuckets = [];
    private OperationalDiagnosticsSnapshot? _diagnostics;
    private readonly List<MemoryUpdateEvent> _recentEvents = [];
    private string _readiness = "Checking";
    private const int _chartDays = 30;

    private List<ChartSeries<double>> _querySeries = [];
    private List<ChartSeries<double>> _changeSeries = [];
    private string[] _chartLabels = [];

    private readonly ChartOptions _lineChartOptions = new()
    {
        ChartPalette = ["#4fc1ff"]
    };

    private readonly ChartOptions _barChartOptions = new()
    {
        ChartPalette = ["#89d185"]
    };

    protected override async Task OnInitializedAsync()
    {
        Publisher.MemoryChanged += OnMemoryChangedAsync;
        Publisher.StatsChanged += OnStatsChangedAsync;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _stats = await Memories.GetStatsAsync(CancellationToken.None);
            _telemetry = await Memories.GetTelemetryAsync(CancellationToken.None);
            _activityBuckets = await Memories.GetActivityBucketsAsync(_chartDays, CancellationToken.None);
            _diagnostics = Diagnostics.GetSnapshot();
            _chartLabels = _activityBuckets.Select(b => b.Date.ToString("M/d")).ToArray();
            _querySeries = [new ChartSeries<double> { Name = "Queries", Data = _activityBuckets.Select(b => (double)b.Queries).ToArray() }];
            _changeSeries = [new ChartSeries<double> { Name = "Changes", Data = _activityBuckets.Select(b => (double)b.Changes).ToArray() }];
            _readiness = "Ready";
        }
        catch
        {
            _readiness = "Not ready";
        }
    }

    private Task OnMemoryChangedAsync(MemoryUpdateEvent update)
    {
        _recentEvents.Insert(0, update);
        if (_recentEvents.Count > 20)
        {
            _recentEvents.RemoveAt(_recentEvents.Count - 1);
        }
        return InvokeAsync(StateHasChanged);
    }

    private Task OnStatsChangedAsync(StatsSnapshot stats)
    {
        _stats = stats;
        return InvokeAsync(StateHasChanged);
    }

    private static string FormatTime(DateTime? timestamp) =>
        timestamp.HasValue ? timestamp.Value.ToLocalTime().ToString("g") : "-";

    private static string FormatUrls(IReadOnlyList<string> urls) =>
        urls.Count == 0 ? $"http://localhost:{WindowsServiceCommands.DefaultPort}" : string.Join(", ", urls);

    private static string FormatSourceRoots(SourceLinkOptions sourceLinks)
    {
        var roots = sourceLinks.AllowedFileRootVariables.Select(name => $"%{name}%")
            .Concat(sourceLinks.AllowedFileRoots)
            .Distinct(StringComparer.OrdinalIgnoreCase);
        return string.Join(", ", roots.DefaultIfEmpty("None"));
    }

    private static string FormatPathDetails(StoragePathStatus path) => path switch
    {
        { Error: not null } => path.Error,
        { FileCount: not null } => $"{path.FileCount:N0} files, {FormatBytes(path.AvailableFreeBytes)} free",
        { SizeBytes: not null } => $"{FormatBytes(path.SizeBytes)}, {FormatBytes(path.AvailableFreeBytes)} free",
        _ => $"{FormatBytes(path.AvailableFreeBytes)} free"
    };

    private static string FormatBytes(long? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)value.Value;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.#} {units[unit]}";
    }

    public void Dispose()
    {
        Publisher.MemoryChanged -= OnMemoryChangedAsync;
        Publisher.StatsChanged -= OnStatsChangedAsync;
    }
}