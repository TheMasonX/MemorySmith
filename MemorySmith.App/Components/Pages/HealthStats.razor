@page "/health"
@rendermode InteractiveServer
@inject MemoryApplicationService Memories
@inject IMemoryChangePublisher Publisher
@inject OperationalDiagnosticsService Diagnostics
@inject LoggingObservabilityService LogObservability
@implements IDisposable

<PageTitle>Health - MemorySmith</PageTitle>

<div class="health-workbench">
<div class="health-header">
    <MudText Typo="Typo.h4">Health &amp; Activity</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">Refresh</MudButton>
</div>

@if (_stats is not null)
{
    <div class="health-stat-row">
        <div class="health-stat-card">
            <span class="health-stat-label">Total</span>
            <span class="health-stat-value">@_stats.TotalCount</span>
        </div>
        <div class="health-stat-card is-core">
            <span class="health-stat-label">Core</span>
            <span class="health-stat-value">@_stats.Core</span>
        </div>
        <div class="health-stat-card is-working">
            <span class="health-stat-label">Working</span>
            <span class="health-stat-value">@_stats.Working</span>
        </div>
        <div class="health-stat-card">
            <span class="health-stat-label">Unconsolidated</span>
            <span class="health-stat-value">@_stats.Unconsolidated</span>
        </div>
        <div class="health-stat-card is-deprecated">
            <span class="health-stat-label">Deprecated</span>
            <span class="health-stat-value">@_stats.Deprecated</span>
        </div>
        <div class="health-stat-card">
            <span class="health-stat-label">Avg Confidence</span>
            <span class="health-stat-value">@(_stats.AverageConfidence.ToString("P0"))</span>
        </div>
        <div class="health-stat-card">
            <span class="health-stat-label">Total Usage</span>
            <span class="health-stat-value">@_stats.TotalUsage</span>
        </div>
        <div class="health-stat-card @(_readiness == "Ready" ? "is-core" : "is-deprecated")">
            <span class="health-stat-label">Readiness</span>
            <span class="health-stat-value" style="font-size:1rem">@_readiness</span>
        </div>
    </div>
}

@if (_activityBuckets.Count > 0)
{
    <div class="health-charts-row">
        <div class="health-chart-card">
            <div class="health-chart-title">Queries / Day (last @_chartDays days)</div>
            <MudChart T="double" ChartType="ChartType.Line"
                      ChartSeries="@_querySeries"
                      ChartLabels="@_chartLabels"
                      ChartOptions="@_lineChartOptions"
                      Width="100%" Height="200px" />
        </div>
        <div class="health-chart-card">
            <div class="health-chart-title">Memory Changes / Day (last @_chartDays days)</div>
            <MudChart T="double" ChartType="ChartType.Bar"
                      ChartSeries="@_changeSeries"
                      ChartLabels="@_chartLabels"
                      ChartOptions="@_barChartOptions"
                      Width="100%" Height="200px" />
        </div>
    </div>
}

@if (_logMetrics is not null && _logMetrics.Buckets.Count > 0)
{
    <div class="health-charts-row">
        <div class="health-chart-card">
            <div class="health-chart-title">Errors / Day (last @_logMetrics.WindowDays days)</div>
            <MudChart T="double" ChartType="ChartType.Bar"
                      ChartSeries="@_errorSeries"
                      ChartLabels="@_logChartLabels"
                      ChartOptions="@_barChartOptions"
                      Width="100%" Height="200px" />
        </div>
        <div class="health-chart-card">
            <div class="health-chart-title">P95 Request Latency / Day (ms)</div>
            <MudChart T="double" ChartType="ChartType.Line"
                      ChartSeries="@_latencySeries"
                      ChartLabels="@_logChartLabels"
                      ChartOptions="@_lineChartOptions"
                      Width="100%" Height="200px" />
        </div>
    </div>
}

@if (_diagnostics is not null)
{
    <div class="health-lower-grid health-operations-grid">
        @if (_diagnostics.Warnings.Count > 0)
        {
            <div class="health-lower-card health-warning-card">
                <div class="health-section-title">Warnings</div>
                @foreach (var warning in _diagnostics.Warnings)
                {
                    <div class="health-warning-item">
                        <strong>@warning.Severity</strong>
                        <span>@warning.Message</span>
                    </div>
                }
            </div>
        }

        <div class="health-lower-card">
            <div class="health-section-title">Runtime Configuration</div>
            <div class="health-config-grid">
                <span>Data Path</span><strong><SensitiveValue Value="@_diagnostics.Configuration.DataPath" Summary="@MaskOperationalValue(_diagnostics.Configuration.DataPath)" Label="data path" Class="health-sensitive-value" /></strong>
                <span>Pages Path</span><strong><SensitiveValue Value="@_diagnostics.Configuration.PagesPath" Summary="@MaskOperationalValue(_diagnostics.Configuration.PagesPath)" Label="pages path" Class="health-sensitive-value" /></strong>
                <span>Event Log</span><strong><SensitiveValue Value="@_diagnostics.Configuration.EventLogPath" Summary="@MaskOperationalValue(_diagnostics.Configuration.EventLogPath)" Label="event log path" Class="health-sensitive-value" /></strong>
                <span>Variables</span><strong><SensitiveValue Value="@_diagnostics.Configuration.VarsPath" Summary="@MaskOperationalValue(_diagnostics.Configuration.VarsPath)" Label="variables path" Class="health-sensitive-value" /></strong>
                <span>URLs</span><strong>@FormatUrls(_diagnostics.Configuration.ConfiguredUrls)</strong>
                <span>Service</span><strong>@_diagnostics.Configuration.WindowsServiceName</strong>
                <span>API Key</span><strong>@(_diagnostics.Configuration.ApiKeyConfigured ? "Configured" : "Not configured")</strong>
                <span>Remote API</span><strong>@(_diagnostics.Configuration.AllowRemoteApi ? "Allowed" : "Local only")</strong>
                <span>Maintenance</span><strong>@(_diagnostics.Configuration.Maintenance.Enabled ? "Enabled" : "Disabled")</strong>
                <span>Source Roots</span><strong><SensitiveValue Value="@FormatSourceRoots(_diagnostics.Configuration.SourceLinks)" Summary="@MaskSourceRoots(_diagnostics.Configuration.SourceLinks)" Label="source roots" Class="health-sensitive-value" /></strong>
                <span>Open Sources</span><strong>@(_diagnostics.Configuration.SourceLinks.AllowOpenWithDefaultApp ? "Enabled" : "Disabled")</strong>
                <span>Semantic Search</span><strong>@FormatSemanticSearch(_diagnostics.Configuration.SemanticSearch, _diagnostics.SemanticEmbeddings)</strong>
                <span>Chat</span><strong><SensitiveValue Value="@FormatChatProvider(_diagnostics.Configuration.Chat)" Summary="@FormatChatProviderSummary(_diagnostics.Configuration.Chat)" Label="chat provider configuration" Class="health-sensitive-value" /></strong>
                <span>Telemetry</span><strong>@(_diagnostics.Configuration.Telemetry.Enabled ? "Enabled" : "Disabled")</strong>
                <span>Tracing</span><strong>@(_diagnostics.Configuration.Telemetry.TracingEnabled ? "Enabled" : "Disabled")</strong>
                <span>Metrics</span><strong>@(_diagnostics.Configuration.Telemetry.MetricsEnabled ? "Enabled" : "Disabled")</strong>
                <span>Trace sampling</span><strong>@(_diagnostics.Configuration.Telemetry.TraceSamplingPercentage)%</strong>
                <span>OTLP export</span><strong>@FormatTelemetryExport(_diagnostics.Configuration.Telemetry)</strong>
                @if (_logMetrics is not null)
                {
                    <span>Log entries (@_logMetrics.WindowDays d)</span><strong>@_logMetrics.TotalEntries</strong>
                    <span>Error count</span><strong>@_logMetrics.ErrorCount</strong>
                    <span>Warning count</span><strong>@_logMetrics.WarningCount</strong>
                    <span>Request count</span><strong>@_logMetrics.RequestCount</strong>
                    <span>P95 latency</span><strong>@FormatLatency(_logMetrics.P95LatencyMs)</strong>
                }
            </div>
        </div>

        <div class="health-lower-card">
            <div class="health-section-title">Storage Paths</div>
            <MudTable Items="@_diagnostics.Paths" Dense="true" Class="health-table">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@(context.Exists ? "Exists" : "Missing")</MudTd>
                    <MudTd>@FormatPathDetails(context)</MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <div class="health-lower-card">
            <div class="health-section-title">Endpoints</div>
            <div class="health-endpoint-list">
                @foreach (var endpoint in _diagnostics.Endpoints)
                {
                    <a href="@endpoint.Path">@endpoint.Path</a>
                }
            </div>
        </div>

        <div class="health-lower-card">
            <div class="health-section-title">Storage Diagnostics</div>
            @if (_diagnostics.StorageDiagnostics.CorruptFiles.Count == 0)
            {
                <span class="wiki-muted">No corrupt files observed.</span>
            }
            else
            {
                <MudTable Items="@_diagnostics.StorageDiagnostics.CorruptFiles" Dense="true" Class="health-table">
                    <HeaderContent>
                        <MudTh>Path</MudTh>
                        <MudTh>Observed</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><SensitiveValue Value="@context.Path" Summary="@MaskOperationalValue(context.Path)" Label="corrupt file path" Class="health-sensitive-value" /></MudTd>
                        <MudTd>@context.ObservedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </div>
    </div>
}

<div class="health-lower-grid">
    <div class="health-lower-card">
        <div class="health-section-title">Maintenance Telemetry</div>
        <MudTable Items="@_telemetry" Dense="true" Class="health-table">
            <HeaderContent>
                <MudTh>Service</MudTh>
                <MudTh>Interval</MudTh>
                <MudTh>Last Run</MudTh>
                <MudTh>Last Success</MudTh>
                <MudTh>Duration</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ServiceName</MudTd>
                <MudTd>@context.Interval</MudTd>
                <MudTd>@FormatTime(context.LastRunUtc)</MudTd>
                <MudTd>@FormatTime(context.LastSuccessUtc)</MudTd>
                <MudTd>@(context.LastDurationMs?.ToString("N0") ?? "-") ms</MudTd>
            </RowTemplate>
        </MudTable>
    </div>
    <div class="health-lower-card">
        <div class="health-section-title">Recent Events (this session)</div>
        @if (_recentEvents.Count == 0)
        {
            <span class="wiki-muted">No events yet — create, edit, or search a memory.</span>
        }
        else
        {
            <MudList T="MemoryUpdateEvent" Dense="true">
                @foreach (var update in _recentEvents)
                {
                    <MudListItem Text="@($"{update.Action}: {update.Id}")" SecondaryText="@update.Timestamp.ToLocalTime().ToString("g")" />
                }
            </MudList>
        }
    </div>
</div>
</div>

@code {
    private StatsSnapshot? _stats;
    private IReadOnlyList<BackgroundServiceTelemetry> _telemetry = [];
    private IReadOnlyList<ActivityBucket> _activityBuckets = [];
    private OperationalDiagnosticsSnapshot? _diagnostics;
    private LogMetricsSnapshot? _logMetrics;
    private readonly List<MemoryUpdateEvent> _recentEvents = [];
    private string _readiness = "Checking";
    private const int _chartDays = 30;

    private List<ChartSeries<double>> _querySeries = [];
    private List<ChartSeries<double>> _changeSeries = [];
    private string[] _chartLabels = [];
    private List<ChartSeries<double>> _errorSeries = [];
    private List<ChartSeries<double>> _latencySeries = [];
    private string[] _logChartLabels = [];

    private readonly ChartOptions _lineChartOptions = new()
    {
        ChartPalette = ["#4fc1ff"]
    };

    private readonly ChartOptions _barChartOptions = new()
    {
        ChartPalette = ["#89d185"]
    };

    protected override async Task OnInitializedAsync()
    {
        Publisher.MemoryChanged += OnMemoryChangedAsync;
        Publisher.StatsChanged += OnStatsChangedAsync;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _stats = await Memories.GetStatsAsync(CancellationToken.None);
            _telemetry = await Memories.GetTelemetryAsync(CancellationToken.None);
            _activityBuckets = await Memories.GetActivityBucketsAsync(_chartDays, CancellationToken.None);
            _diagnostics = Diagnostics.GetSnapshot();
            _logMetrics = await LogObservability.GetMetricsAsync(_chartDays, CancellationToken.None);
            _chartLabels = _activityBuckets.Select(b => b.Date.ToString("M/d")).ToArray();
            _querySeries = [new ChartSeries<double> { Name = "Queries", Data = _activityBuckets.Select(b => (double)b.Queries).ToArray() }];
            _changeSeries = [new ChartSeries<double> { Name = "Changes", Data = _activityBuckets.Select(b => (double)b.Changes).ToArray() }];
            _logChartLabels = _logMetrics.Buckets.Select(bucket => bucket.Date.ToString("M/d")).ToArray();
            _errorSeries = [new ChartSeries<double> { Name = "Errors", Data = _logMetrics.Buckets.Select(bucket => (double)bucket.Errors).ToArray() }];
            _latencySeries = [new ChartSeries<double> { Name = "P95 latency (ms)", Data = _logMetrics.Buckets.Select(bucket => bucket.P95LatencyMs ?? 0d).ToArray() }];
            _readiness = "Ready";
        }
        catch
        {
            _readiness = "Not ready";
        }
    }

    private Task OnMemoryChangedAsync(MemoryUpdateEvent update)
    {
        _recentEvents.Insert(0, update);
        if (_recentEvents.Count > 20)
        {
            _recentEvents.RemoveAt(_recentEvents.Count - 1);
        }
        return InvokeAsync(StateHasChanged);
    }

    private Task OnStatsChangedAsync(StatsSnapshot stats)
    {
        _stats = stats;
        return InvokeAsync(StateHasChanged);
    }

    private static string FormatTime(DateTime? timestamp) =>
        timestamp.HasValue ? timestamp.Value.ToLocalTime().ToString("g") : "-";

    private static string FormatUrls(IReadOnlyList<string> urls) =>
        urls.Count == 0 ? $"http://localhost:{WindowsServiceCommands.DefaultPort}" : string.Join(", ", urls);

    private static string FormatSourceRoots(SourceLinkOptions sourceLinks)
    {
        var roots = sourceLinks.AllowedFileRootVariables.Select(name => $"%{name}%")
            .Concat(sourceLinks.AllowedFileRoots)
            .Distinct(StringComparer.OrdinalIgnoreCase);
        return string.Join(", ", roots.DefaultIfEmpty("None"));
    }

    private static string MaskSourceRoots(SourceLinkOptions sourceLinks)
    {
        var roots = sourceLinks.AllowedFileRootVariables.Select(name => $"%{name}%")
            .Concat(sourceLinks.AllowedFileRoots.Select(MaskOperationalValue))
            .Distinct(StringComparer.OrdinalIgnoreCase);
        return string.Join(", ", roots.DefaultIfEmpty("None"));
    }

    private static string FormatChatProvider(ChatOptions chat) =>
        $"{chat.Provider} / Ollama:{chat.OllamaModel} / GitHub:{chat.GitHubModel} / {chat.SystemPromptPath}";

    private static string FormatChatProviderSummary(ChatOptions chat) =>
        $"{chat.Provider} / Ollama:{chat.OllamaModel} / GitHub:{chat.GitHubModel} / {MaskOperationalValue(chat.SystemPromptPath)}";

    private static string FormatSemanticSearch(SemanticSearchOptions semanticSearch, EmbeddingProviderStatus status) =>
        semanticSearch.EmbeddingsEnabled
            ? $"{(status.Available ? "Embeddings available" : "Token fallback")} / {status.Reason}"
            : "Token scoring only";

    private static string FormatTelemetryExport(TelemetryOptions telemetry)
    {
        if (!telemetry.ExporterEnabled)
        {
            return "Disabled";
        }

        var protocol = string.IsNullOrWhiteSpace(telemetry.OtlpProtocol) ? "grpc" : telemetry.OtlpProtocol;
        var endpoint = string.IsNullOrWhiteSpace(telemetry.OtlpEndpoint) ? "(unset endpoint)" : telemetry.OtlpEndpoint;
        return $"{protocol} -> {endpoint}";
    }

    private static string MaskOperationalValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        if (LooksLikeEmail(value))
        {
            return MaskEmail(value);
        }

        if (LooksLikeLocalPath(value))
        {
            return MaskPath(value);
        }

        return SummarizeIdentifier(value);
    }

    private static bool LooksLikeEmail(string value)
    {
        var atIndex = value.IndexOf('@');
        return atIndex > 0 && atIndex < value.Length - 1 && value[(atIndex + 1)..].Contains('.');
    }

    private static bool LooksLikeLocalPath(string value) => value.Contains(@":\", StringComparison.Ordinal) || value.StartsWith(@"\\", StringComparison.Ordinal) || value.StartsWith("/", StringComparison.Ordinal);

    private static string MaskEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        var atIndex = value.IndexOf('@');
        if (atIndex <= 0 || atIndex == value.Length - 1)
        {
            return SummarizeIdentifier(value);
        }

        var local = value[..atIndex];
        var domain = value[(atIndex + 1)..];
        var visibleLocal = local.Length <= 2 ? local[..1] : local[..Math.Min(2, local.Length)];
        return $"{visibleLocal}...@{domain}";
    }

    private static string MaskPath(string value)
    {
        var trimmed = value.Trim();
        var separator = trimmed.Contains('\\') ? '\\' : '/';
        var parts = trimmed.Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var leaf = parts.LastOrDefault() ?? "path";

        if (trimmed.Length >= 2 && trimmed[1] == ':')
        {
            return $"{trimmed[..2]}{separator}...{separator}{leaf}";
        }

        return trimmed.StartsWith(@"\\", StringComparison.Ordinal)
            ? $@"\\...\{leaf}"
            : $"...{separator}{leaf}";
    }

    private static string SummarizeIdentifier(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not set";
        }

        return value.Length <= 10 ? value : $"{value[..4]}...{value[^4..]}";
    }

    private static string FormatPathDetails(StoragePathStatus path) => path switch
    {
        { Error: not null } => path.Error,
        { FileCount: not null } => $"{path.FileCount:N0} files, {FormatBytes(path.AvailableFreeBytes)} free",
        { SizeBytes: not null } => $"{FormatBytes(path.SizeBytes)}, {FormatBytes(path.AvailableFreeBytes)} free",
        _ => $"{FormatBytes(path.AvailableFreeBytes)} free"
    };

    private static string FormatLatency(double? value) => value.HasValue ? $"{value.Value:0.##} ms" : "-";

    private static string FormatBytes(long? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)value.Value;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.#} {units[unit]}";
    }

    public void Dispose()
    {
        Publisher.MemoryChanged -= OnMemoryChangedAsync;
        Publisher.StatsChanged -= OnStatsChangedAsync;
    }
}