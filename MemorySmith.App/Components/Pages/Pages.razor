@page "/pages"
@page "/pages/{*Slug}"
@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.Extensions.Options
@inject IPageService PageService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IOptionsMonitor<MemorySmithOptions> Options
@inject ICurrentUserContext CurrentUser

<PageTitle>Pages</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<div class="wiki-workbench pages-workbench">
    <section class="wiki-commandbar" aria-label="Page search">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Pages</MudText>
            <span class="wiki-count">@_pages.Count pages</span>
        </div>

        <div class="wiki-search-strip">
            <MudTextField @bind-Value="_searchQuery"
                          Label="Search pages"
                          Placeholder="Title or markdown"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyUp="OnSearchKeyUp"
                          Class="wiki-search-box" />
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="wiki-mode-toggle">
                <MudButton Variant="@NavigationModeVariant(TreeMode)" OnClick="@(() => SetNavigationModeAsync(TreeMode))">Tree</MudButton>
                <MudButton Variant="@NavigationModeVariant(FlatMode)" OnClick="@(() => SetNavigationModeAsync(FlatMode))">Flat</MudButton>
            </MudButtonGroup>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync">Search</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="ClearAsync" aria-label="Clear" />
            <MudTooltip Text="@(_isNavigationVisible ? "Hide navigation" : "Show navigation")">
                <MudIconButton Icon="@(_isNavigationVisible ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                               Size="Size.Small"
                               OnClick="ToggleNavigationVisibilityAsync"
                               aria-label="Toggle navigation" />
            </MudTooltip>
            <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Success" OnClick="NewPageAsync" aria-label="New" />
                </Authorized>
            </AuthorizeView>
        </div>
    </section>

    <section class="@PagesBodyClass">
        @if (_isNavigationVisible)
        {
        <aside class="wiki-results-pane pages-navigation-pane" aria-label="Pages">
            <div class="wiki-pane-header">
                <MudText Typo="Typo.subtitle2">@(_navigationMode == TreeMode ? "Tree" : "Flat list")</MudText>
            </div>

            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_pages.Count == 0)
            {
                <div class="wiki-empty-state">No pages found.</div>
            }
            else if (_navigationMode == TreeMode)
            {
                <div class="pages-tree-list">
                    @foreach (var row in TreeRows)
                    {
                        if (row.Node.IsFolder)
                        {
                            <button type="button"
                                    class="pages-tree-row pages-tree-folder"
                                    style="@TreeIndentStyle(row.Depth)"
                                    @onclick="@(() => ToggleFolderAsync(row.Node.Key))"
                                    aria-label="Toggle folder @row.Node.Label">
                                <MudIcon Icon="@(row.IsExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" Class="pages-tree-icon" />
                                <span class="pages-tree-label">@row.Node.Label</span>
                                <span class="wiki-count">@row.Node.PageCount page@(row.Node.PageCount == 1 ? string.Empty : "s")</span>
                            </button>
                        }
                        else if (row.Node.Slug is not null)
                        {
                            <button type="button"
                                    class="@TreePageRowClass(row.Node)"
                                    style="@TreeIndentStyle(row.Depth)"
                                    @onclick="@(() => SelectAsync(row.Node.Slug, navigate: true))"
                                    aria-label="Open @row.Node.Label">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="pages-tree-icon" />
                                <span class="pages-tree-label">@row.Node.Label</span>
                            </button>
                        }
                    }
                </div>
            }
            else
            {
                <div class="wiki-results-list">
                    @foreach (var summary in _pages)
                    {
                        <article class="@PageRowClass(summary)" @onclick="@(() => SelectAsync(summary.Slug, navigate: true))">
                            <div class="wiki-result-main">
                                <div class="wiki-result-title">@summary.Title</div>
                                <div class="wiki-result-meta">
                                    <span class="wiki-status">Markdown</span>
                                    <span class="wiki-status">@VisibilityLabel(summary.MinimumRole)</span>
                                    <span>@summary.LastUpdatedUtc.ToLocalTime().ToString("M/d HH:mm")</span>
                                </div>
                                <div class="wiki-result-snippet">@summary.Snippet</div>
                            </div>
                        </article>
                    }
                </div>
            }
        </aside>
        }

        <main class="@DetailPaneClass" aria-label="Selected page">
            @if (_isEditing)
            {
                <div class="wiki-pane-header page-editor-header">
                    <div>
                        <MudText Typo="Typo.subtitle2">@(_editingExisting ? "Edit Page" : "New Page")</MudText>
                        @if (HasUnsavedChanges)
                        {
                            <span class="wiki-count">Unsaved changes</span>
                        }
                    </div>
                    <MudSpacer />
                    <MudTooltip Text="@(_isFocusMode ? "Exit focus reading" : "Focus reading")">
                        <MudIconButton Icon="@(_isFocusMode ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="ToggleFocusModeAsync"
                                       aria-label="Toggle focus reading" />
                    </MudTooltip>
                    <MudCheckBox T="bool" Value="_livePreview" ValueChanged="SetLivePreviewAsync" Label="Live preview" Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" OnClick="RefreshPreview" aria-label="Refresh preview" />
                    <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                        <Authorized>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save</MudButton>
                        </Authorized>
                    </AuthorizeView>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelEditAsync">Cancel</MudButton>
                </div>
                <div class="page-editor-shell">
                    <div class="wiki-editor-grid page-editor-fields">
                        <MudTextField @bind-Value="_editSlug" Label="Slug" Disabled="@_editingExisting" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_editTitle" Label="Title" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        @if (EditableMinimumRoleOptions.Count > 0)
                        {
                            <MudSelect T="string" Value="_editMinimumRole" ValueChanged="@((string value) => _editMinimumRole = value)" Label="Visibility" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var role in EditableMinimumRoleOptions)
                                {
                                    <MudSelectItem T="string" Value="@role">@VisibilityLabel(role)</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </div>

                    <div class="page-editor-toolbar" role="toolbar" aria-label="Markdown tools">
                        <MudTooltip Text="Bold">
                            <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small" OnClick="@(() => InsertMarkdownAsync("**", "**", "bold text"))" aria-label="Bold" />
                        </MudTooltip>
                        <MudTooltip Text="Italic">
                            <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" Size="Size.Small" OnClick="@(() => InsertMarkdownAsync("*", "*", "italic text"))" aria-label="Italic" />
                        </MudTooltip>
                        <MudTooltip Text="Page link">
                            <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" OnClick='@(() => InsertMarkdownAsync("[", "](../relative/path.md)", "Page"))' aria-label="Page link" />
                        </MudTooltip>
                        <MudTooltip Text="Web link">
                            <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" OnClick="@(() => InsertMarkdownAsync("[", "](https://)", "link text"))" aria-label="Link" />
                        </MudTooltip>
                        <MudTooltip Text="Checkbox">
                            <MudIconButton Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Size="Size.Small" OnClick="@(() => InsertMarkdownAsync("- [ ] ", "", "Task"))" aria-label="Checkbox" />
                        </MudTooltip>
                        <MudTooltip Text="Table">
                            <MudIconButton Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" OnClick="@(() => InsertMarkdownAsync("\n| Column | Value |\n| --- | --- |\n| Item | Detail |\n", "", ""))" aria-label="Table" />
                        </MudTooltip>
                        <MudTooltip Text="Upload image">
                            <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                                <Authorized>
                                    <label class="page-toolbar-file-button" aria-label="Upload image">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                        <InputFile OnChange="OnImageSelectedAsync" accept="image/*" class="page-toolbar-file-input" />
                                    </label>
                                </Authorized>
                            </AuthorizeView>
                        </MudTooltip>
                    </div>

                    <div class="page-editor-panels">
                        <div class="page-editor-pane">
                            <div class="page-pane-label">Markdown</div>
                            <textarea @ref="_markdownEditor"
                                      class="page-editor-raw"
                                      aria-label="Markdown editor"
                                      maxlength="524288"
                                      value="@_editMarkdown"
                                      @oninput="OnMarkdownInput"></textarea>
                        </div>
                        <div class="page-preview-pane">
                            <div class="page-pane-label">Preview</div>
                            <div class="page-rendered page-editor-preview" @ref="_previewPane">@((MarkupString)_previewHtml)</div>
                        </div>
                    </div>
                </div>
            }
            else if (_selectedPage is null)
            {
                <div class="wiki-empty-state">Select a page to inspect.</div>
            }
            else
            {
                <div class="wiki-pane-header wiki-detail-header">
                    <div class="wiki-detail-title-block">
                        <MudText Typo="Typo.h6">@_selectedPage.Title</MudText>
                        <div class="wiki-result-meta">
                            <span class="wiki-status">Markdown</span>
                            <span class="wiki-status">@VisibilityLabel(_selectedPage.MinimumRole)</span>
                            <span>@_selectedPage.RelativePath</span>
                            <span>@_selectedPage.LastUpdatedUtc.ToLocalTime().ToString("g")</span>
                        </div>
                    </div>
                    <MudSpacer />
                    <MudTooltip Text="@(_isFocusMode ? "Exit focus reading" : "Focus reading")">
                        <MudIconButton Icon="@(_isFocusMode ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="ToggleFocusModeAsync"
                                       aria-label="Toggle focus reading" />
                    </MudTooltip>
                    <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                        <Authorized>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="EditSelected" aria-label="Edit" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="DeleteSelectedAsync" aria-label="Delete" />
                        </Authorized>
                    </AuthorizeView>
                </div>
                <div class="page-rendered" @ref="_renderedPagePane">@((MarkupString)_selectedPage.Html)</div>
            }
        </main>
    </section>
</div>

@code {
    private const string TreeMode = "tree";
    private const string FlatMode = "flat";
    private const string PagesUiStateStorageKey = "memorysmith.pages.preferences.v1";

    [Parameter] public string? Slug { get; set; }

    private List<PageSummary> _pages = [];
    private IReadOnlyList<PageNavigationNode> _treeNodes = [];
    private PageDocument? _selectedPage;
    private ElementReference _markdownEditor;
    private ElementReference _previewPane;
    private ElementReference _renderedPagePane;
    private string _searchQuery = string.Empty;
    private string _editSlug = string.Empty;
    private string _editTitle = string.Empty;
    private string _editMarkdown = string.Empty;
    private string _editMinimumRole = PageAccessLevels.Anonymous;
    private string _previewHtml = string.Empty;
    private string _originalSlug = string.Empty;
    private string _originalTitle = string.Empty;
    private string _originalMarkdown = string.Empty;
    private string _originalMinimumRole = PageAccessLevels.Anonymous;
    private bool _isLoading;
    private bool _isEditing;
    private bool _editingExisting;
    private bool _livePreview = true;
    private bool _previewEnhancementsPending;
    private bool _renderedPageEnhancementsPending;
    private bool _isNavigationVisible = true;
    private bool _isFocusMode;
    private bool _uiStateLoaded;
    private string _navigationMode = TreeMode;
    private readonly HashSet<string> _expandedTreeKeys = new(StringComparer.OrdinalIgnoreCase);

    private bool HasUnsavedChanges => _isEditing &&
        (!string.Equals(_editSlug, _originalSlug, StringComparison.Ordinal) ||
         !string.Equals(_editTitle, _originalTitle, StringComparison.Ordinal) ||
         !string.Equals(_editMarkdown, _originalMarkdown, StringComparison.Ordinal) ||
         !string.Equals(_editMinimumRole, _originalMinimumRole, StringComparison.Ordinal));

    private IReadOnlyList<string> EditableMinimumRoleOptions => PageAccessLevels.EditableOptions(CurrentUser, Options.CurrentValue.Auth);
    private IReadOnlyList<PageNavigationTreeRow> TreeRows => PageNavigationTreeBuilder.Flatten(_treeNodes, _expandedTreeKeys);
    private string PagesBodyClass => _isNavigationVisible && !_isFocusMode ? "wiki-body pages-body" : "wiki-body pages-body is-nav-hidden";
    private string DetailPaneClass => _isFocusMode ? "wiki-detail-pane page-detail-pane is-focus-mode" : "wiki-detail-pane page-detail-pane";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(Slug);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_uiStateLoaded)
        {
            _uiStateLoaded = true;
            await RestoreUiStateAsync();
            StateHasChanged();
            return;
        }

        if (_isEditing && _previewEnhancementsPending)
        {
            _previewEnhancementsPending = false;
            await JS.InvokeVoidAsync("memorySmith.markdown.renderEnhancements", _previewPane);
        }
        else if (_selectedPage is not null && _renderedPageEnhancementsPending)
        {
            _renderedPageEnhancementsPending = false;
            await JS.InvokeVoidAsync("memorySmith.markdown.renderEnhancements", _renderedPagePane);
        }
    }

    private async Task LoadAsync(string? selectedSlug = null)
    {
        _isLoading = true;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            var pages = await PageService.ListAsync(CancellationToken.None);
            _pages = pages
                .Where(page => PageAccessLevels.CanView(page.MinimumRole, CurrentUser, Options.CurrentValue.Auth))
                .ToList();
        }
        else
        {
            _pages = (await PageService.SearchVisibleAsync(
                    _searchQuery,
                    page => PageAccessLevels.CanView(page.MinimumRole, CurrentUser, Options.CurrentValue.Auth),
                    CancellationToken.None))
                .ToList();
        }

        RebuildTree();
        _isLoading = false;

        if (!string.IsNullOrWhiteSpace(selectedSlug))
        {
            await SelectAsync(selectedSlug, navigate: false);
        }
        else if (_selectedPage is null && _pages.Count > 0)
        {
            await SelectAsync(_pages[0].Slug, navigate: false);
        }
    }

    private async Task SearchAsync()
    {
        if (!await ConfirmDiscardChangesAsync())
        {
            return;
        }

        _selectedPage = null;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        _searchQuery = string.Empty;
        await LoadAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SelectAsync(string slug, bool navigate)
    {
        if (_isEditing && !string.Equals(_selectedPage?.Slug, slug, StringComparison.OrdinalIgnoreCase) && !await ConfirmDiscardChangesAsync())
        {
            return;
        }

        var page = await PageService.GetAsync(slug, CancellationToken.None);
        if (page is null)
        {
            Snackbar.Add("Page not found", Severity.Warning);
            return;
        }

        if (!PageAccessLevels.CanView(page.MinimumRole, CurrentUser, Options.CurrentValue.Auth))
        {
            Snackbar.Add("Page not found", Severity.Warning);
            return;
        }

        _selectedPage = page;
        _isEditing = false;
        _renderedPageEnhancementsPending = true;
        PopulateEditor(page, editingExisting: true);
        ExpandAncestorsForSelectedPage();
        await PersistUiStateAsync();
        if (navigate)
        {
            Navigation.NavigateTo($"/pages/{EncodePageSlug(page.Slug)}");
        }
    }

    private async Task NewPageAsync()
    {
        if (!await ConfirmDiscardChangesAsync())
        {
            return;
        }

        _selectedPage = null;
        _editSlug = string.Empty;
        _editTitle = string.Empty;
        _editMarkdown = string.Empty;
        _editMinimumRole = PageAccessLevels.DefaultForEditor(CurrentUser, Options.CurrentValue.Auth, Options.CurrentValue.Pages.DefaultMinimumRole);
        _originalSlug = string.Empty;
        _originalTitle = string.Empty;
        _originalMarkdown = string.Empty;
        _originalMinimumRole = _editMinimumRole;
        _previewHtml = string.Empty;
        _previewEnhancementsPending = true;
        _editingExisting = false;
        _isEditing = true;
    }

    private void EditSelected()
    {
        if (_selectedPage is null)
        {
            return;
        }

        PopulateEditor(_selectedPage, editingExisting: true);
        _isEditing = true;
    }

    private async Task CancelEditAsync()
    {
        if (!await ConfirmDiscardChangesAsync())
        {
            return;
        }

        _isEditing = false;
        if (_selectedPage is not null)
        {
            _renderedPageEnhancementsPending = true;
            PopulateEditor(_selectedPage, editingExisting: true);
        }
    }

    private async Task SaveAsync()
    {
        var requestedMinimumRole = EditableMinimumRoleOptions.Count > 0 ? _editMinimumRole : null;
        var page = await PageService.SaveAsync(new PageSaveRequest(_editSlug, _editTitle, _editMarkdown, requestedMinimumRole), CancellationToken.None);
        Snackbar.Add("Page saved", Severity.Success);
        _selectedPage = page;
        _isEditing = false;
        await LoadAsync(page.Slug);
        Navigation.NavigateTo($"/pages/{EncodePageSlug(page.Slug)}");
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedPage is null)
        {
            return;
        }

        var deleted = await PageService.DeleteAsync(_selectedPage.Slug, CancellationToken.None);
        Snackbar.Add(deleted ? "Page deleted" : "Delete failed", deleted ? Severity.Success : Severity.Error);
        _selectedPage = null;
        await LoadAsync();
        Navigation.NavigateTo("/pages");
    }

    private void PopulateEditor(PageDocument page, bool editingExisting)
    {
        _editSlug = page.Slug;
        _editTitle = page.Title;
        _editMarkdown = page.Markdown;
        _editMinimumRole = PageAccessLevels.Normalize(page.MinimumRole);
        _originalSlug = page.Slug;
        _originalTitle = page.Title;
        _originalMarkdown = page.Markdown;
        _originalMinimumRole = _editMinimumRole;
        _editingExisting = editingExisting;
        RefreshPreview();
    }

    private static string VisibilityLabel(string minimumRole) => PageAccessLevels.Label(minimumRole);

    private void OnMarkdownInput(ChangeEventArgs args)
    {
        _editMarkdown = args.Value?.ToString() ?? string.Empty;
        if (_livePreview)
        {
            RefreshPreview();
        }
    }

    private Task SetLivePreviewAsync(bool enabled)
    {
        _livePreview = enabled;
        if (enabled)
        {
            RefreshPreview();
        }

        return Task.CompletedTask;
    }

    private void RefreshPreview()
    {
        _previewHtml = PageService.RenderHtml(_editMarkdown ?? string.Empty);
        _previewEnhancementsPending = true;
    }

    private async Task InsertMarkdownAsync(string prefix, string suffix, string placeholder)
    {
        _editMarkdown = await JS.InvokeAsync<string>("memorySmith.markdown.insert", _markdownEditor, prefix, suffix, placeholder);
        if (_livePreview)
        {
            RefreshPreview();
        }
    }

    private async Task OnImageSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Choose an image file.", Severity.Warning);
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        var asset = await PageService.SaveAssetAsync(file.Name, stream, CancellationToken.None);
        var alt = Path.GetFileNameWithoutExtension(asset.FileName).Replace('-', ' ');
        await InsertMarkdownAsync($"![{alt}](", ")", asset.MarkdownPath);
        Snackbar.Add($"Image uploaded: {asset.FileName}", Severity.Success);
    }

    private async Task ConfirmInternalNavigation(LocationChangingContext context)
    {
        if (HasUnsavedChanges && !await ConfirmDiscardChangesAsync())
        {
            context.PreventNavigation();
        }
    }

    private async Task<bool> ConfirmDiscardChangesAsync()
    {
        if (!HasUnsavedChanges)
        {
            return true;
        }

        return await JS.InvokeAsync<bool>("confirm", "Discard unsaved page changes?");
    }

    private string PageRowClass(PageSummary page) =>
        string.Equals(_selectedPage?.Slug, page.Slug, StringComparison.OrdinalIgnoreCase)
            ? "wiki-result-row is-selected"
            : "wiki-result-row";

    private string TreePageRowClass(PageNavigationNode node) =>
        string.Equals(_selectedPage?.Slug, node.Slug, StringComparison.OrdinalIgnoreCase)
            ? "pages-tree-row pages-tree-page is-selected"
            : "pages-tree-row pages-tree-page";

    private static string TreeIndentStyle(int depth) => $"--tree-depth:{depth};";

    private Variant NavigationModeVariant(string mode) =>
        string.Equals(_navigationMode, mode, StringComparison.OrdinalIgnoreCase) ? Variant.Filled : Variant.Outlined;

    private async Task SetNavigationModeAsync(string mode)
    {
        _navigationMode = string.Equals(mode, FlatMode, StringComparison.OrdinalIgnoreCase) ? FlatMode : TreeMode;
        await PersistUiStateAsync();
    }

    private async Task ToggleNavigationVisibilityAsync()
    {
        _isNavigationVisible = !_isNavigationVisible;
        if (_isNavigationVisible)
        {
            _isFocusMode = false;
        }

        await PersistUiStateAsync();
    }

    private async Task ToggleFocusModeAsync()
    {
        _isFocusMode = !_isFocusMode;
        _isNavigationVisible = !_isFocusMode;
        await PersistUiStateAsync();
    }

    private async Task ToggleFolderAsync(string key)
    {
        if (_expandedTreeKeys.Contains(key))
        {
            _expandedTreeKeys.Remove(key);
        }
        else
        {
            _expandedTreeKeys.Add(key);
        }

        await PersistUiStateAsync();
    }

    private void RebuildTree()
    {
        _treeNodes = PageNavigationTreeBuilder.Build(_pages);
        var validKeys = new HashSet<string>(CollectFolderKeys(_treeNodes), StringComparer.OrdinalIgnoreCase);
        _expandedTreeKeys.RemoveWhere(key => !validKeys.Contains(key));
        if (_expandedTreeKeys.Count == 0)
        {
            foreach (var key in _treeNodes.Where(node => node.IsFolder).Select(node => node.Key))
            {
                _expandedTreeKeys.Add(key);
            }
        }

        ExpandAncestorsForSelectedPage();
    }

    private void ExpandAncestorsForSelectedPage()
    {
        foreach (var key in PageNavigationTreeBuilder.AncestorKeysForSlug(_treeNodes, _selectedPage?.Slug))
        {
            _expandedTreeKeys.Add(key);
        }
    }

    private static IEnumerable<string> CollectFolderKeys(IReadOnlyList<PageNavigationNode> nodes)
    {
        foreach (var node in nodes.Where(node => node.IsFolder))
        {
            yield return node.Key;
            foreach (var child in CollectFolderKeys(node.Children))
            {
                yield return child;
            }
        }
    }

    private async Task RestoreUiStateAsync()
    {
        var json = await JS.InvokeAsync<string?>("memorySmith.storage.getJsonString", PagesUiStateStorageKey);
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }

        try
        {
            var state = JsonSerializer.Deserialize<PagesUiState>(json);
            if (state is null)
            {
                return;
            }

            _navigationMode = string.Equals(state.NavigationMode, FlatMode, StringComparison.OrdinalIgnoreCase) ? FlatMode : TreeMode;
            _isNavigationVisible = state.NavigationVisible;
            _isFocusMode = state.FocusMode;
            _expandedTreeKeys.Clear();
            foreach (var key in state.ExpandedKeys ?? [])
            {
                if (!string.IsNullOrWhiteSpace(key))
                {
                    _expandedTreeKeys.Add(key);
                }
            }

            if (_isFocusMode)
            {
                _isNavigationVisible = false;
            }

            RebuildTree();
        }
        catch (JsonException)
        {
        }
    }

    private async Task PersistUiStateAsync()
    {
        if (!_uiStateLoaded)
        {
            return;
        }

        await JS.InvokeAsync<bool>(
            "memorySmith.storage.setJson",
            PagesUiStateStorageKey,
            new PagesUiState(_navigationMode, _isNavigationVisible, _isFocusMode, [.. _expandedTreeKeys]));
    }

    private static string EncodePageSlug(string slug) =>
        string.Join('/', slug.Split('/', StringSplitOptions.RemoveEmptyEntries).Select(Uri.EscapeDataString));

    private sealed record PagesUiState(string NavigationMode, bool NavigationVisible, bool FocusMode, string[] ExpandedKeys);
}