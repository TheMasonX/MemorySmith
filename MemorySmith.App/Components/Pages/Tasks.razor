        await SelectAsync(id);
    }

    private static bool IsLocalTaskAttachmentUri(string? value) =>
        !string.IsNullOrWhiteSpace(value) && value.Replace('\\', '/').StartsWith("/artifacts/task-attachments/", StringComparison.OrdinalIgnoreCase);

