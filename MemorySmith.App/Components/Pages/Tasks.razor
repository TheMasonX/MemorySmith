    private async Task<IEnumerable<TaskSummary>> SearchRelatedTaskAttachmentsAsync(string value, CancellationToken cancellationToken)
    {
        if (_selectedTask is null)
        {
            return [];
        }

        var search = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        var candidates = await TaskService.ListAsync(search, null, null, 12, cancellationToken);
        return candidates
            .Where(task => !string.Equals(task.Id, _selectedTask.Id, StringComparison.OrdinalIgnoreCase))
            .Where(task => !_selectedTask.Attachments.Any(attachment => string.Equals(TryReadTaskAttachmentId(attachment.Uri), task.Id, StringComparison.OrdinalIgnoreCase)))
            .Take(8)
            .ToList();
    }

    private static bool CanOpenAttachmentUri(string? value)
    {
        if (IsLocalTaskAttachmentUri(value))
        {
            return true;
        }

        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri))
        {
            return false;
        }

        return uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps;
    }

    private static bool IsTaskAttachment(TaskAttachment attachment) =>
        string.Equals(attachment.Kind, "task", StringComparison.OrdinalIgnoreCase) && TryReadTaskAttachmentId(attachment.Uri) is not null;

    private static string? TryReadTaskAttachmentId(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri) || !uri.StartsWith("task:", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var id = uri[5..].Trim();
        return string.IsNullOrWhiteSpace(id) ? null : id;
    }

    private static string FormatTaskAttachmentLabel(TaskAttachment attachment) =>
        TryReadTaskAttachmentId(attachment.Uri) is { } id ? id : attachment.Uri;

    private static string FormatRelatedTaskOption(TaskSummary? task) =>
        task is null ? string.Empty : $"{task.Key} - {task.Title}";

    private async Task SelectRelatedTaskAttachmentAsync(string uri)
    {
        var id = TryReadTaskAttachmentId(uri);
        if (string.IsNullOrWhiteSpace(id))
