    private static string BuildSlugSuggestion(string title)
    {
        var source = string.IsNullOrWhiteSpace(title) ? string.Empty : title.Trim().ToLowerInvariant();
        source = System.Text.RegularExpressions.Regex.Replace(source, "[^a-z0-9]+", "-").Trim('-');
        return source;
    }

