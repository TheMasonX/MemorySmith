        _editAssigneeMode = string.IsNullOrWhiteSpace(task.AssigneeMode) ? TaskAssigneeModes.Directory : task.AssigneeMode;
        _editAssigneeDirectoryId = task.AssigneeDirectoryId;
        _editAssigneeCustomText = task.AssigneeCustomText;
        _editAssigneeUser = TryGetCachedUser(task.AssigneeDirectoryId);
        _editLabelsText = string.Join(", ", task.Labels);
    }

