@page "/tasks"
@rendermode InteractiveServer
@inject IMemorySmithDatabase Database
@inject ITaskService TaskService
@inject ICurrentUserContext CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Tasks - MemorySmith</PageTitle>

<div class="wiki-workbench tasks-workbench">
    <section class="wiki-commandbar" aria-label="Tasks workbench">
        <div class="wiki-title-block">
            <MudText Typo="Typo.h5">Tasks</MudText>
            <span class="wiki-count">@_tasks.Count task(s)</span>
        </div>
        <div class="wiki-search-strip">
            <div class="wiki-search-main">
                <MudTextField @bind-Value="_query"
                              Label="Search tasks"
                              Placeholder="Title, id, key, labels"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyUp="OnSearchKeyUp"
                              Class="wiki-search-box" />
                <MudTooltip Text="Search">
                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="wiki-search-submit"
                                   OnClick="LoadAsync"
                                   aria-label="Search" />
                </MudTooltip>
            </div>
            <MudSelect T="string" Value="@_statusFilter" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="wiki-filter">
                @foreach (var option in StatusOptions)
                {
                    <MudSelectItem Value="@option">@option</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Value="@_sortMode" ValueChanged="OnSortModeChanged" Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="wiki-filter">
                @foreach (var option in SortOptions)
                {
                    <MudSelectItem Value="@option">@SortLabel(option)</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
            <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                <Authorized>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenQuickCreatePane">Quick Add</MudButton>
                </Authorized>
            </AuthorizeView>
            <div class="tasks-sidebar-toggle">
                <MudTooltip Text="@TaskListToggleTooltip">
                    <MudIconButton Icon="@(IsTaskListCollapsed ? Icons.Material.Filled.Menu : Icons.Material.Filled.MenuOpen)"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   Disabled="@(!CanToggleTaskListCollapse)"
                                   OnClick="ToggleListCollapse"
                                   aria-label="Toggle task list" />
                </MudTooltip>
            </div>
        </div>

        @if (_showQuickCreatePane)
        {
            <div class="tasks-quick-create-pane" role="region" aria-label="Create task">
                <MudTextField T="string"
                              Value="@_createTitle"
                              ValueChanged="OnCreateTitleChanged"
                              Label="Title"
                              Placeholder="Describe the task"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              Class="tasks-quick-create-title" />
                <MudTextField T="string"
                              Value="@_createSlug"
                              ValueChanged="OnCreateSlugChanged"
                              Label="Slug"
                              Placeholder="Optional: nav-grouping"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="Used in task id. Letters, numbers, spaces, underscores, and hyphens only."
                              Class="tasks-quick-create-slug" />
                <MudTextField T="string"
                              Value="@_createDescription"
                              ValueChanged="OnCreateDescriptionChanged"
                              Label="Description"
                              Placeholder="Add task context"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              Class="tasks-quick-create-description" />
                <div class="tasks-quick-create-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="CreateQuickTaskAsync">Create</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelQuickCreate">Cancel</MudButton>
                </div>
            </div>
        }
    </section>

    <section class="@TasksBodyClass">
        @if (!IsTaskListCollapsed)
        {
            <aside class="wiki-results-pane tasks-list-pane" aria-label="Task list">
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_tasks.Count == 0)
                {
                    <div class="wiki-empty-state">No tasks found.</div>
                }
                else
                {
                    <div class="wiki-results-list">
                        @foreach (var task in _tasks)
                        {
                            <article class="@(task.Id == _selectedTask?.Id ? "proposal-row is-selected" : "proposal-row")" @onclick="@(() => SelectAsync(task.Id))">
                                <div class="wiki-result-main">
                                    <div class="wiki-result-title tasks-result-title" title="@task.Title">
                                        @if (task.HasLoadError)
                                        {
                                            <MudTooltip Text="@($"Task file needs repair: {task.SourceFilePath ?? task.Id}. {task.LoadError}")">
                                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Warning" Size="Size.Small" Class="tasks-load-error-icon" />
                                            </MudTooltip>
                                        }
                                        <span>@task.Key - @task.Title</span>
                                    </div>
                                    <div class="wiki-result-meta">
                                        <span class="wiki-status">@task.Status</span>
                                        <span class="wiki-status" title="Severity">@task.Priority</span>
                                        <span>@GetAssigneeDisplay(task)</span>
                                        <span>@task.UpdatedAtUtc.ToLocalTime().ToString("g")</span>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </aside>
        }

        @if (_selectedTask is not null)
        {
        <main class="wiki-detail-pane tasks-detail-pane" aria-label="Task detail">
                <div class="wiki-pane-header wiki-detail-header tasks-detail-header">
                    <div class="tasks-detail-header-main">
                        <div class="tasks-detail-title-text">@_selectedTask.Key - @_selectedTask.Title</div>
                        <div class="wiki-result-meta tasks-detail-meta">
                            <span class="wiki-status">@_selectedTask.Status</span>
                            <span class="wiki-status" title="Severity">@_selectedTask.Priority</span>
                            <span>@GetAssigneeDisplay(_selectedTask)</span>
                        </div>
                        @if (_selectedTask.Labels.Count > 0)
                        {
                            <div class="wiki-tag-line">
                                @foreach (var label in _selectedTask.Labels)
                                {
                                    <span class="wiki-tag">@label</span>
                                }
                            </div>
                        }
                        @if (_selectedTask.HasLoadError)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="tasks-load-error-alert">
                                This task file could not be fully parsed and is read-only until fixed.
                                @if (!string.IsNullOrWhiteSpace(_selectedTask.SourceFilePath))
                                {
                                    <span> File: @_selectedTask.SourceFilePath.</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_selectedTask.LoadError))
                                {
                                    <span> Error: @_selectedTask.LoadError</span>
                                }
                            </MudAlert>
                        }
                    </div>
                    <div class="tasks-detail-actions">
                        <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                            <Authorized>
                                @if (_selectedTask.HasLoadError)
                                {
                                    <MudTooltip Text="Task has malformed JSON and must be repaired before editing.">
                                        <MudIconButton Icon="@Icons.Material.Filled.ErrorOutline"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       Disabled="true"
                                                       Class="tasks-header-icon-action" />
                                    </MudTooltip>
                                }
                                else if (_isEditingTask)
                                {
                                    <MudTooltip Text="Save task edits">
                                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Class="tasks-header-icon-action"
                                                       OnClick="SaveTaskEditsAsync" />
                                    </MudTooltip>
                                    <MudTooltip Text="Cancel editing">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Color="Color.Default"
                                                       Size="Size.Small"
                                                       Class="tasks-header-icon-action"
                                                       OnClick="CancelTaskEdits" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudTooltip Text="Edit task">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Default"
                                                       Size="Size.Small"
                                                       Class="tasks-header-icon-action"
                                                       OnClick="BeginTaskEdit" />
                                    </MudTooltip>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>

                <div class="wiki-editor-grid tasks-editor-grid">
                    <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                        <Authorized>
                            @if (_selectedTask.HasLoadError)
                            {
                                <MudTextField T="string" Value="@_selectedTask.Status" Label="Status" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            }
                            else
                            {
                                <MudSelect T="string"
                                           Value="@_selectedStatus"
                                           ValueChanged="OnTaskStatusChanged"
                                           Label="Status"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Class="tasks-status-combobox">
                                    @foreach (var option in TaskStatusOptions)
                                    {
                                        <MudSelectItem Value="@option">@option</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <MudTextField T="string" Value="@_selectedTask.Status" Label="Status" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </NotAuthorized>
                    </AuthorizeView>
                    @if (_isEditingTask)
                    {
                        <MudTextField T="string" Value="@_editTitle" ValueChanged="OnEditTitleChanged" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                        <MudSelect T="string" Value="@_editPriority" ValueChanged="OnEditPriorityChanged" Label="Severity" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            @foreach (var option in TaskPriorityOptions)
                            {
                                <MudSelectItem Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" Value="@_editAssigneeMode" ValueChanged="OnEditAssigneeModeChanged" Label="Assignee Mode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@TaskAssigneeModes.Directory">@TaskAssigneeModes.Directory</MudSelectItem>
                            <MudSelectItem Value="@TaskAssigneeModes.Custom">@TaskAssigneeModes.Custom</MudSelectItem>
                        </MudSelect>
                        @if (string.Equals(_editAssigneeMode, TaskAssigneeModes.Directory, StringComparison.OrdinalIgnoreCase))
                        {
                            <MudAutocomplete T="UserAccount"
                                             Value="@_editAssigneeUser"
                                             ValueChanged="OnEditAssigneeUserChanged"
                                             SearchFunc="SearchAssignableUsersAsync"
                                             ToStringFunc="FormatAssigneeUser"
                                             Label="Assignee Username"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true"
                                             Clearable="true"
                                             HelperText="Type a display name or email and choose a matching user." />
                            @if (!string.IsNullOrWhiteSpace(_editAssigneeDirectoryId) && _editAssigneeUser is null)
                            {
                                <MudText Typo="Typo.caption" Class="mud-secondary-text">Current assignee could not be resolved. Saving will keep the existing assignment unless you choose a different user.</MudText>
                            }
                        }
                        else
                        {
                            <MudTextField T="string" Value="@_editAssigneeCustomText" ValueChanged="OnEditAssigneeCustomTextChanged" Label="Assignee (Custom)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        <MudTextField T="string" Value="@_editLabelsText" ValueChanged="OnEditLabelsTextChanged" Label="Task Tags" Placeholder="governance, tasks" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Comma-separated labels." />
                        <MudTextField T="string" Value="@_editDescription" ValueChanged="OnEditDescriptionChanged" Label="Description" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" Class="tasks-description-field" />
                    }
                    else
                    {
                        <MudTextField T="string" Value="@_selectedTask.Type" Label="Type" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField T="string" Value="@_selectedTask.Reporter" Label="Reporter" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField T="string" Value="@_selectedTask.Description" Label="Description" Lines="5" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="tasks-description-field" />
                    }
                </div>

                @if (!_selectedTask.HasLoadError && IsImportedTask(_selectedTask))
                {
                    <div class="proposal-evidence-item">
                        <strong>Imported Task Review</strong>
                        <span>Apply triage metadata for imported backlog governance.</span>
                        <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                            <Authorized>
                                <div class="tasks-quick-create-actions">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MarkImportedVettedAsync">Mark Vetted</MudButton>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MarkImportedNeedsRewriteAsync">Needs Rewrite</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="MarkImportedObsoleteAsync">Mark Obsolete</MudButton>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }

                <MudTabs Rounded="false" Elevation="0" Class="proposal-tabs">
                    <MudTabPanel Text="Comments" Icon="@Icons.Material.Filled.Forum">
                        <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                            <Authorized>
                                <MudTextField T="string" Value="@_commentDraft" ValueChanged="OnCommentDraftChanged" Placeholder="Add a comment" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="AddCommentAsync">Add Comment</MudButton>
                            </Authorized>
                        </AuthorizeView>
                        @if (_selectedTask.Comments.Count == 0)
                        {
                            <div class="wiki-empty-state">No comments yet.</div>
                        }
                        else
                        {
                            <div class="proposal-evidence-list">
                                @foreach (var comment in _selectedTask.Comments.OrderByDescending(item => item.CreatedAtUtc))
                                {
                                    <div class="proposal-evidence-item">
                                        <strong>@comment.Author</strong>
                                        <span>@comment.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                                        <p>@comment.Body</p>
                                    </div>
                                }
                            </div>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="Links" Icon="@Icons.Material.Filled.Link">
                        <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                            <Authorized>
                                <div class="wiki-editor-grid">
                                    <MudTextField T="string" Value="@_pageLinkDraft" ValueChanged="OnPageLinkDraftChanged" Label="Page slug" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudButton Variant="Variant.Outlined" OnClick="AddPageLinkAsync">Add Page Link</MudButton>
                                    <MudTextField T="string" Value="@_externalLinkLabel" ValueChanged="OnExternalLabelChanged" Label="External label" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" Value="@_externalLinkUrl" ValueChanged="OnExternalUrlChanged" Label="External url" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudButton Variant="Variant.Outlined" OnClick="AddExternalLinkAsync">Add External Link</MudButton>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                        <div class="proposal-evidence-list">
                            @foreach (var slug in _selectedTask.LinkedPages)
                            {
                                <div class="proposal-evidence-item">
                                    <strong>Page</strong>
                                    <a href="@ToPageHref(slug)">@slug</a>
                                </div>
                            }
                            @foreach (var link in _selectedTask.ExternalLinks)
                            {
                                <div class="proposal-evidence-item">
                                    <strong>@link.Label</strong>
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Url</a>
                                </div>
                            }
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Attachments" Icon="@Icons.Material.Filled.Attachment">
                        <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                            <Authorized>
                                <div class="wiki-editor-grid">
                                    <MudTextField T="string" Value="@_attachmentName" ValueChanged="OnAttachmentNameChanged" Label="Attachment name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" Value="@_attachmentUri" ValueChanged="OnAttachmentUriChanged" Label="Attachment uri" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudButton Variant="Variant.Outlined" OnClick="AddAttachmentAsync">Add Attachment</MudButton>
                                    <MudAutocomplete T="TaskSummary"
                                                     Value="@_relatedTaskAttachment"
                                                     ValueChanged="OnRelatedTaskAttachmentChanged"
                                                     SearchFunc="SearchRelatedTaskAttachmentsAsync"
                                                     ToStringFunc="FormatRelatedTaskOption"
                                                     Label="Related task"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Dense="true"
                                                     Clearable="true" />
                                    <MudButton Variant="Variant.Outlined" OnClick="AddRelatedTaskAttachmentAsync" Disabled="@(_relatedTaskAttachment is null)">Add Related Task</MudButton>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                        <div class="proposal-evidence-list">
                            @foreach (var attachment in _selectedTask.Attachments)
                            {
                                <div class="proposal-evidence-item">
                                    <strong>@attachment.Name</strong>
                                    @if (IsTaskAttachment(attachment))
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectRelatedTaskAttachmentAsync(attachment.Uri))">@FormatTaskAttachmentLabel(attachment)</MudButton>
                                    }
                                    else if (CanOpenAttachmentUri(attachment.Uri))
                                    {
                                        <a href="@attachment.Uri" target="_blank" rel="noopener noreferrer">@attachment.Uri</a>
                                    }
                                    else
                                    {
                                        <span>@attachment.Uri</span>
                                    }
                                    <AuthorizeView Policy="@MemorySmithPolicies.CanEditMemorySmith">
                                        <Authorized>
                                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveAttachmentAsync(attachment.Id))">Remove</MudButton>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            }
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
                        @if (_history.Count == 0)
                        {
                            <div class="wiki-empty-state">No history entries found.</div>
                        }
                        else
                        {
                            <div class="proposal-evidence-list">
                                @foreach (var entry in _history)
                                {
                                    <div class="proposal-evidence-item">
                                        <strong>@entry.Action</strong>
                                        <span>@entry.Actor • @entry.OccurredAtUtc.ToLocalTime().ToString("g")</span>
                                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                                        {
                                            <p>@entry.Note</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </MudTabPanel>
                </MudTabs>
        </main>
        }
    </section>
</div>

@code {
    private static readonly IReadOnlyList<string> StatusOptions = ["All", TaskStatuses.Backlog, TaskStatuses.Ready, TaskStatuses.InProgress, TaskStatuses.Blocked, TaskStatuses.Rejected, TaskStatuses.Done, TaskStatuses.Archived];
    private static readonly IReadOnlyList<string> TaskStatusOptions = [TaskStatuses.Backlog, TaskStatuses.Ready, TaskStatuses.InProgress, TaskStatuses.Blocked, TaskStatuses.Rejected, TaskStatuses.Done, TaskStatuses.Archived];
    private static readonly IReadOnlyList<string> TaskPriorityOptions = [TaskPriorities.Critical, TaskPriorities.High, TaskPriorities.Medium, TaskPriorities.Low];
    private static readonly IReadOnlyList<string> SortOptions = ["updated-desc", "updated-asc", "key-asc", "key-desc", "severity-desc", "severity-asc", "title-asc", "title-desc"];
    private IReadOnlyList<TaskSummary> _tasks = [];
    private TaskItem? _selectedTask;
    private IReadOnlyList<TaskActivityEntry> _history = [];
    private string _selectedStatus = TaskStatuses.Backlog;
    private string _query = string.Empty;
    private string _statusFilter = "All";
    private string _commentDraft = string.Empty;
    private string _pageLinkDraft = string.Empty;
    private string _externalLinkLabel = string.Empty;
    private string _externalLinkUrl = string.Empty;
    private string _attachmentName = string.Empty;
    private string _attachmentUri = string.Empty;
    private TaskSummary? _relatedTaskAttachment;
    private string _createTitle = string.Empty;
    private string _createDescription = string.Empty;
    private string _createSlug = string.Empty;
    private bool _showQuickCreatePane;
    private bool _isListCollapsed;
    private bool _isLoading = true;
    private bool _isEditingTask;
    private string _sortMode = "updated-desc";
    private string _editTitle = string.Empty;
    private string _editDescription = string.Empty;
    private string _editPriority = TaskPriorities.Medium;
    private string _editAssigneeMode = TaskAssigneeModes.Directory;
    private string? _editAssigneeDirectoryId;
    private string? _editAssigneeCustomText;
    private UserAccount? _editAssigneeUser;
    private string _editLabelsText = string.Empty;
    private readonly Dictionary<string, UserAccount> _userAccountsById = new(StringComparer.OrdinalIgnoreCase);

    private bool CanToggleTaskListCollapse => _selectedTask is not null;
    private bool IsTaskListCollapsed => _isListCollapsed && CanToggleTaskListCollapse;
    private string TaskListToggleTooltip => !CanToggleTaskListCollapse
        ? "Select a task first"
        : IsTaskListCollapsed
            ? "Show task list"
            : "Hide task list";
    private string TasksBodyClass => string.Join(' ', new[]
    {
        "wiki-body",
        "tasks-body",
        IsTaskListCollapsed ? "is-list-collapsed" : null,
        _selectedTask is null ? "is-detail-empty" : null
    }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private static string ToPageHref(string slug) => PageSlugPolicy.ToPageHref(slug);

    private async Task LoadAsync()
    {
        _isLoading = true;
        var status = _statusFilter == "All" ? null : _statusFilter;
        var loaded = await TaskService.ListAsync(_query, status, null, 200, CancellationToken.None);
        _tasks = ApplySort(loaded);
        await WarmAssigneeCacheAsync(_tasks
            .Where(task => string.Equals(task.AssigneeMode, TaskAssigneeModes.Directory, StringComparison.OrdinalIgnoreCase))
            .Select(task => task.AssigneeDirectoryId));
        _isLoading = false;

        if (_selectedTask is not null)
        {
            await SelectAsync(_selectedTask.Id);
        }
    }

    private async Task SelectAsync(string id)
    {
        _selectedTask = await TaskService.GetAsync(id, CancellationToken.None);
        await WarmAssigneeCacheAsync([_selectedTask?.AssigneeDirectoryId]);
        _selectedStatus = _selectedTask?.Status ?? TaskStatuses.Backlog;
        _history = _selectedTask is null
            ? []
            : await TaskService.GetHistoryAsync(_selectedTask.Id, 100, CancellationToken.None);

        if (_selectedTask is not null && _isEditingTask)
        {
            PopulateEditDraft(_selectedTask);
        }
    }

    private async Task CreateQuickTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_createTitle))
        {
            Snackbar.Add("Title is required.", Severity.Warning);
            return;
        }

        try
        {
            var created = await TaskService.CreateAsync(
                new TaskCreateRequest(
                    Title: _createTitle,
                    Description: _createDescription,
                    Type: "Task",
                    Status: TaskStatuses.Backlog,
                    Priority: TaskPriorities.Medium,
                    AssigneeMode: CurrentUser.IsAuthenticated ? TaskAssigneeModes.Directory : TaskAssigneeModes.Custom,
                    AssigneeDirectoryId: CurrentUser.IsAuthenticated ? CurrentUser.UserId : null,
                    AssigneeCustomText: CurrentUser.IsAuthenticated ? null : "Copilot",
                    Reporter: CurrentUser.DisplayName,
                    Labels: ["future"],
                    DueDateUtc: null,
                    EpicId: null,
                    ParentId: null,
                    Slug: string.IsNullOrWhiteSpace(_createSlug) ? null : _createSlug),
                CurrentUser.DisplayName,
                CancellationToken.None);

            ResetQuickCreateDraft();
            _showQuickCreatePane = false;
            await LoadAsync();
            await SelectAsync(created.Id);
            Snackbar.Add($"Created {created.Key}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OpenQuickCreatePane()
    {
        if (!_showQuickCreatePane)
        {
            ResetQuickCreateDraft();
        }

        _showQuickCreatePane = true;
    }

    private void CancelQuickCreate()
    {
        _showQuickCreatePane = false;
