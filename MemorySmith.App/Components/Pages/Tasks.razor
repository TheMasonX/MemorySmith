    private async Task<IEnumerable<UserAccount>> SearchAssignableUsersAsync(string value, CancellationToken cancellationToken)
    {
        var search = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        var users = (await Database.Users.ListAsync(new UserQuery(search, 1, 8), cancellationToken)).Data
            .Where(user => !user.IsDisabled)
            .ToList();

        CacheUsers(users);
        return users;
    }

    private async Task WarmAssigneeCacheAsync(IEnumerable<string?> userIds)
    {
        var missingUserIds = userIds
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(id => !_userAccountsById.ContainsKey(id))
            .ToList();

        foreach (var userId in missingUserIds)
        {
            var user = await Database.Users.GetByIdAsync(userId, CancellationToken.None);
            if (user is not null)
            {
                _userAccountsById[userId] = user;
            }
        }
    }

    private void CacheUsers(IEnumerable<UserAccount> users)
    {
        foreach (var user in users)
        {
            if (!string.IsNullOrWhiteSpace(user.UserId))
            {
                _userAccountsById[user.UserId] = user;
            }
        }
    }

    private UserAccount? TryGetCachedUser(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
        {
            return null;
        }

        return _userAccountsById.TryGetValue(userId, out var user) ? user : null;
    }

    private string GetAssigneeDisplay(TaskSummary task)
    {
        return GetAssigneeDisplay(task.AssigneeMode, task.AssigneeDirectoryId, task.AssigneeCustomText);
    }

    private string GetAssigneeDisplay(TaskItem task)
    {
        return GetAssigneeDisplay(task.AssigneeMode, task.AssigneeDirectoryId, task.AssigneeCustomText);
    }

    private string GetAssigneeDisplay(string assigneeMode, string? assigneeDirectoryId, string? assigneeCustomText)
    {
        if (string.Equals(assigneeMode, TaskAssigneeModes.Directory, StringComparison.OrdinalIgnoreCase))
        {
            var user = TryGetCachedUser(assigneeDirectoryId);
            if (!string.IsNullOrWhiteSpace(user?.DisplayName))
            {
                return user.DisplayName;
            }

            return string.IsNullOrWhiteSpace(assigneeDirectoryId) ? "unassigned" : "Unknown user";
        }

        return string.IsNullOrWhiteSpace(assigneeCustomText) ? "unassigned" : assigneeCustomText;
    }

    private static string FormatAssigneeUser(UserAccount? user)
    {
        if (user is null)
        {
            return string.Empty;
        }

        if (string.IsNullOrWhiteSpace(user.Email))
        {
            return user.DisplayName;
        }

        return $"{user.DisplayName} ({user.Email})";
    }
