    private async Task ApplyImportedReviewAsync(string note, IReadOnlyList<string> labelsToAdd, IReadOnlyList<string> labelsToRemove)
    {
        if (_selectedTask is null)
        {
            return;
        }

        var labels = _selectedTask.Labels.ToList();
        foreach (var remove in labelsToRemove)
        {
            labels.RemoveAll(existing => string.Equals(existing, remove, StringComparison.OrdinalIgnoreCase));
        }

        foreach (var add in labelsToAdd)
        {
            if (labels.All(existing => !string.Equals(existing, add, StringComparison.OrdinalIgnoreCase)))
            {
                labels.Add(add);
            }
        }

        try
        {
            await TaskService.UpdateAsync(
                _selectedTask.Id,
                new TaskUpdateRequest(
                    Title: _selectedTask.Title,
                    Description: _selectedTask.Description,
                    Type: null,
                    Priority: _selectedTask.Priority,
                    AssigneeMode: _selectedTask.AssigneeMode,
                    AssigneeDirectoryId: _selectedTask.AssigneeDirectoryId,
                    AssigneeCustomText: _selectedTask.AssigneeCustomText,
                    Reporter: null,
                    Labels: labels,
                    DueDateUtc: _selectedTask.DueDateUtc,
                    EpicId: _selectedTask.EpicId,
                    ParentId: _selectedTask.ParentId),
                CurrentUser.DisplayName,
                CancellationToken.None);

            await TaskService.AddCommentAsync(_selectedTask.Id, new TaskCommentRequest(note), CurrentUser.DisplayName, CancellationToken.None);
            await LoadAsync();
            await SelectAsync(_selectedTask.Id);
            Snackbar.Add(note, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

