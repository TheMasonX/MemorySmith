    private async Task SaveTaskEditsAsync()
    {
        if (_selectedTask is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            Snackbar.Add("Title is required.", Severity.Warning);
            return;
        }

        if (string.Equals(_editAssigneeMode, TaskAssigneeModes.Directory, StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(_editAssigneeDirectoryId))
        {
            Snackbar.Add("Directory assignee mode requires a selected username.", Severity.Warning);
            return;
        }

        if (string.Equals(_editAssigneeMode, TaskAssigneeModes.Custom, StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(_editAssigneeCustomText))
        {
            Snackbar.Add("Custom assignee mode requires Assignee text.", Severity.Warning);
            return;
        }

        try
        {
            var labels = SplitLabels(_editLabelsText);
            var updated = await TaskService.UpdateAsync(
                _selectedTask.Id,
                new TaskUpdateRequest(
                    Title: _editTitle,
                    Description: _editDescription,
                    Type: null,
                    Priority: _editPriority,
                    AssigneeMode: _editAssigneeMode,
                    AssigneeDirectoryId: string.Equals(_editAssigneeMode, TaskAssigneeModes.Directory, StringComparison.OrdinalIgnoreCase) ? _editAssigneeDirectoryId : null,
                    AssigneeCustomText: string.Equals(_editAssigneeMode, TaskAssigneeModes.Custom, StringComparison.OrdinalIgnoreCase) ? _editAssigneeCustomText : null,
                    Reporter: null,
                    Labels: labels,
                    DueDateUtc: null,
                    EpicId: null,
                    ParentId: null),
                CurrentUser.DisplayName,
                CancellationToken.None);

            if (updated is null)
            {
                Snackbar.Add("Task could not be updated.", Severity.Error);
                return;
            }

            _isEditingTask = false;
            await LoadAsync();
            await SelectAsync(updated.Id);
            Snackbar.Add($"Updated {updated.Key}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

