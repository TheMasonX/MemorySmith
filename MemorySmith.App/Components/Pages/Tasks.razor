    private static string SortLabel(string mode) => mode switch
    {
        "updated-desc" => "Updated (newest)",
        "updated-asc" => "Updated (oldest)",
        "key-asc" => "Key (asc)",
        "key-desc" => "Key (desc)",
        "severity-desc" => "Severity (high to low)",
        "severity-asc" => "Severity (low to high)",
        "title-asc" => "Title (A-Z)",
        "title-desc" => "Title (Z-A)",
        _ => "Updated (newest)"
    };

    private IReadOnlyList<TaskSummary> ApplySort(IReadOnlyList<TaskSummary> source)
    {
        var ordered = _sortMode switch
        {
            "updated-asc" => source.OrderBy(task => task.UpdatedAtUtc),
            "key-asc" => source.OrderBy(task => ExtractTaskKeyNumber(task.Key)).ThenBy(task => task.Key, StringComparer.OrdinalIgnoreCase),
            "key-desc" => source.OrderByDescending(task => ExtractTaskKeyNumber(task.Key)).ThenByDescending(task => task.Key, StringComparer.OrdinalIgnoreCase),
            "severity-desc" => source.OrderBy(task => PriorityRank(task.Priority)).ThenBy(task => task.UpdatedAtUtc),
            "severity-asc" => source.OrderByDescending(task => PriorityRank(task.Priority)).ThenBy(task => task.UpdatedAtUtc),
            "title-asc" => source.OrderBy(task => task.Title, StringComparer.OrdinalIgnoreCase),
            "title-desc" => source.OrderByDescending(task => task.Title, StringComparer.OrdinalIgnoreCase),
            _ => source.OrderByDescending(task => task.UpdatedAtUtc)
        };

        return ordered.ToList();
    }

    private static int ExtractTaskKeyNumber(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return int.MaxValue;
        }

        var parts = key.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length >= 2 && int.TryParse(parts[1], out var value) ? value : int.MaxValue;
    }

    private static int PriorityRank(string priority) => priority switch
    {
        TaskPriorities.Critical => 0,
        TaskPriorities.High => 1,
        TaskPriorities.Medium => 2,
        TaskPriorities.Low => 3,
        _ => 4
    };

    private static IReadOnlyList<string> SplitLabels(string labelsText) =>
        labelsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

