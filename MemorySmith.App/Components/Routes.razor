@inject Microsoft.Extensions.Options.IOptionsMonitor<MemorySmithOptions> Options

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <LayoutView Layout="typeof(MainLayout)">
                        <MudText Typo="Typo.h4">Sign In</MudText>
                        <MudText>You need an @InstanceName account for this area.</MudText>
                        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">Sign in</MudButton>
                    </LayoutView>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <MudText Typo="Typo.h4">Not Found</MudText>
                <MudText>The requested page does not exist.</MudText>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private string InstanceName => Options.CurrentValue.InstanceName;
}