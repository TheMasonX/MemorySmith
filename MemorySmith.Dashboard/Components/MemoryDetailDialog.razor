@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "New Memory" : "Edit Memory")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="Record.Title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          MaxLength="200" />

            <MudTextField @bind-Value="Record.Content"
                          Label="Content"
                          Variant="Variant.Outlined"
                          Lines="6"
                          Required="true"
                          RequiredError="Content is required"
                          Class="mb-3" />

            <MudSelect T="MemoryStatus" @bind-Value="Record.Status"
                       Label="Status" Variant="Variant.Outlined" Class="mb-3">
                @foreach (MemoryStatus s in Enum.GetValues(typeof(MemoryStatus)))
                {
                    <MudSelectItem Value="s">@s</MudSelectItem>
                }
            </MudSelect>

            <MudSlider @bind-Value="Record.Confidence"
                       Min="0" Max="1" Step="0.05"
                       Color="Color.Info"
                       Class="mb-3" />
            <MudText Typo="Typo.body2" Class="mb-3">Confidence: @Record.Confidence.ToString("P0")</MudText>

            <MudTextField @bind-Value="_tagsInput"
                          Label="Tags (comma separated)"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Placeholder="e.g. architecture, design, api"
                          HelperText="Separate tags with commas" />

            <MudTextField @bind-Value="_refsInput"
                          Label="References (comma separated IDs)"
                          Variant="Variant.Outlined"
                          Class="mb-1"
                          Placeholder="e.g. id1, id2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Submit" Disabled="@(!_isValid)">
            @(IsNew ? "Create" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public MemoryRecord Record { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = default!;
    private bool _isValid;
    private string _tagsInput = "";
    private string _refsInput = "";

    protected override void OnParametersSet()
    {
        _tagsInput = string.Join(", ", Record.Tags);
        _refsInput = string.Join(", ", Record.References);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _form != null)
        {
            try
            {
                // Validate form on initial render to set proper initial state
                await _form.ValidateAsync();
            }
            catch (Exception ex)
            {
                // Log error but don't crash
                System.Diagnostics.Debug.WriteLine($"Form validation error: {ex.Message}");
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (_form != null)
        {
            try
            {
                await _form.ValidateAsync();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Form validation error in Submit: {ex.Message}");
                return;
            }
        }
        
        if (!_isValid) return;

        Record.Tags = _tagsInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        Record.References = _refsInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        MudDialog.Close(DialogResult.Ok(Record));
    }
}
