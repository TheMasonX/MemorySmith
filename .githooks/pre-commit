#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Scripts/Test-TaskRecords.ps1"
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Scripts/Test-PageLinks.ps1"
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Scripts/Test-PagePathLiterals.ps1"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Scripts/Test-TaskRecords.ps1"
  powershell -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Scripts/Test-PageLinks.ps1"
  powershell -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Scripts/Test-PagePathLiterals.ps1"
else
  echo "pre-commit: PowerShell is required to run repository validation scripts" >&2
  exit 1
fi

# ── Secret pattern check ─────────────────────────────────────────────
staged_changes=$(git diff --cached --name-only)
if [ -n "$staged_changes" ]; then
  secret_patterns='X-Api-Key|ClientSecret|ApiKey["\r\n\t ]*:'
  matched=$(echo "$staged_changes" | xargs git diff --cached -G "$secret_patterns" --name-only 2>/dev/null || true)
  if [ -n "$matched" ]; then
    echo "⚠️  pre-commit: Potential secret patterns detected in staged files:" >&2
    echo "$matched" | sed 's/^/    /' >&2
    echo "Please verify these files do not contain actual secrets before committing." >&2
  fi
fi
